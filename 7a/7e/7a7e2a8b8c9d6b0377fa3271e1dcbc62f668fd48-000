# 14 October 2026: the final calibration as PARAMETERS (zrmd/audio/calibration.py), proven in both directions on synthetic music with no reference
# sample. GREEN: the stored calibration, replayed on the render it was made from, gives the trimmed signal (more than 80 dB SNR) with the reference
# unreachable; a variation keeps the edit (a +6 dB render comes out 6 dB above the calibrated one) and a tempo change follows the warp. RED: a
# replay never touches the reference (its measuring functions are made to raise), a missing or foreign calibration file raises an error that names
# it, and re-calibrating the +6 dB render against the reference WOULD have cancelled the edit. FR : calibration rejouable sans la reference.
import copy
import sys
import tempfile
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(Path(__file__).resolve().parent))
import test_trim as TT  # noqa: E402
from zrmd.audio import calibration as CAL, trim as T  # noqa: E402

SR = TT.SR
FAIL = []


def check(name, cond, detail=""):
    print(("ok   " if cond else "FAIL ") + name + (f"  {detail}" if detail and not cond else ""))
    if not cond:
        FAIL.append(name)


def snr_db(a, b):
    e = a - b
    return float(10 * np.log10((b.astype(np.float64) ** 2).sum() / ((e.astype(np.float64) ** 2).sum() + 1e-30)))


def critic(ref, ours, c):
    return T.score_spec(T.mono(ref).astype(np.float64), T.mono(ours).astype(np.float64), SR, c["specs"]["critic"])["score"]


def run() -> int:
    c = T.cfg()
    c["iterations"], c["scoreEvery"] = 4, 99
    c["fill"]["rounds"] = 2
    c["jitter"]["train"]["count"], c["jitter"]["audit"]["count"] = 3, 2
    ref = TT.music()
    bad = TT.distort(ref)
    y_c, rep, cal = T.trim_calibrated(ref, bad, SR, c)
    y_plain, _ = T.trim(ref, bad, SR, c)
    check("trim_calibrated gives the same signal as trim", float(np.abs(y_c - y_plain).max()) == 0.0)

    # --- GREEN: save, load, replay with the reference unreachable
    with tempfile.TemporaryDirectory() as tmp:
        f = Path(tmp) / "calibration.npz"
        blk = CAL.save(f, {"mix": cal})
        loaded = CAL.load(f)["mix"]
        keep = (T.reference_targets, T.reference_channels)

        def boom(*a, **k):
            raise AssertionError("the reference was touched during a replay")
        T.reference_targets, T.reference_channels = boom, boom
        try:
            y_r, info = T.replay(bad, loaded, SR)
        finally:
            T.reference_targets, T.reference_channels = keep
        check("GREEN: replay from the stored file equals the trimmed signal (more than 80 dB SNR)", snr_db(y_r, y_c) > 80.0, snr_db(y_r, y_c))
        check("GREEN: the replayed signal has the same critic score as the trimmed one (within 0.01)", abs(critic(ref, y_r, c) - critic(ref, y_c, c)) < 0.01,
              (critic(ref, y_r, c), critic(ref, y_c, c)))
        check("RED/GREEN: the replay never called a reference measuring function (they raise)", True)
        check("the calibration block names its file, size and hash", blk["file"] == "calibration.npz" and blk["bytes"] > 1000 and len(blk["sha256"]) == 64, blk)

        # --- RED: a missing file and a foreign file raise an error that names them
        missing = Path(tmp) / "nowhere" / "calibration.npz"
        try:
            CAL.load(missing)
            ok_missing = False
        except CAL.CalibrationError as e:
            ok_missing = str(missing) in str(e)
        check("RED: a missing calibration file raises CalibrationError naming the file", ok_missing)
        foreign = Path(tmp) / "foreign.npz"
        np.savez(foreign, meta=np.array('{"schema": "other@9"}'))
        try:
            CAL.load(foreign)
            ok_foreign = False
        except CAL.CalibrationError as e:
            ok_foreign = str(foreign) in str(e) and "schema" in str(e)
        check("RED: a file of another schema raises CalibrationError naming the file", ok_foreign)
        try:
            CAL.locate({"calibration": {"file": "calibration.npz", "version": "V_999"}}, Path(tmp) / "V_010")
            located = True
        except CAL.CalibrationError:
            located = False
        check("a params block that points at another version resolves to that version's file path", located)
        try:
            CAL.apply({"calibration": {"file": "calibration.npz", "version": "V_999"}}, Path(tmp) / "V_010", {"drums": bad}, lambda s: bad, SR)
            ok_apply = False
        except CAL.CalibrationError as e:
            ok_apply = "calibration.npz" in str(e)
        check("RED: applying a version whose calibration file does not exist raises an error that names the file", ok_apply)

        # --- 15 October 2026: a signal the replay moves beyond the limit keeps its exact render, the others keep their calibration
        f2 = Path(tmp) / "cal2.npz"
        CAL.save(f2, {"drums": cal, "mix": cal})
        prm2 = {"calibration": {"file": "cal2.npz"}}
        free = CAL.apply(prm2, Path(tmp), {"drums": bad}, lambda st: st["drums"], SR)
        tight = CAL.apply(prm2, Path(tmp), {"drums": bad}, lambda st: st["drums"], SR, max_level_delta_db=0.0001)
        check("GREEN: without a limit the drums are calibrated (not refused)", not free["info"]["drums"].get("refused"))
        check("RED: with a tight limit the drums are refused and keep the exact render, the info says by how much",
              tight["info"]["drums"].get("refused") is True and np.array_equal(tight["stems"]["drums"], bad) and "levelDeltaDb" in tight["info"]["drums"])

        # --- variation: an edit survives (relative), re-calibrating against the reference would cancel it
        up = (bad * 2.0).astype(np.float32)             # +6 dB everywhere, as a voice macro gainDb 6 would do on a stem
        y_up, info_up = T.replay(up, loaded, SR)
        check("GREEN: a +6 dB render replays to 6 dB above the calibrated signal (SNR of y/2 against y_c above 50 dB)", snr_db(y_up / 2.0, y_c) > 50.0,
              snr_db(y_up / 2.0, y_c))
        y_re, _ = T.trim(ref, up, SR, c)
        lvl = lambda x: 20 * np.log10(np.sqrt((x ** 2).mean()) + 1e-12)  # noqa: E731
        check("RED: re-calibrating the +6 dB render against the reference cancels the edit (within 2 dB of the reference level)",
              abs(lvl(y_re) - lvl(y_c)) < 2.0, (lvl(y_re), lvl(y_c)))
        check("GREEN: the replay kept the edit (level 5.5 to 6.5 dB above the calibrated signal)", 5.5 < lvl(y_up) - lvl(y_c) < 6.5, lvl(y_up) - lvl(y_c))

        # --- tempo: the calibration moves with the time warp
        import librosa
        rate = 1.0 / 1.25                                # 25 percent slower: the render is 1.25 times as long
        slow_ours = np.stack([librosa.effects.time_stretch(bad[:, i].astype(np.float32), rate=rate) for i in range(2)], axis=1)
        slow_ref = np.stack([librosa.effects.time_stretch(ref[:, i].astype(np.float32), rate=rate) for i in range(2)], axis=1)
        n = min(len(slow_ours), len(slow_ref))
        slow_ours, slow_ref = slow_ours[:n], slow_ref[:n]
        before = critic(slow_ref, slow_ours, c)
        # maxDeviationDb 0 keeps the warped field unbounded here: this render is deliberately far off (the production default bounds it, see below)
        y_w, info_w = T.replay(slow_ours, loaded, SR, {"timeRatio": 1.25, "semitones": 0.0, "maxDeviationDb": 0})
        y_nw, _ = T.replay(slow_ours, loaded, SR, {"timeRatio": 1.0, "semitones": 0.0, "maxDeviationDb": 0})
        after_w, after_nw = critic(slow_ref, y_w, c), critic(slow_ref, y_nw, c)
        check("GREEN: with the time warp the calibration improves a slowed render a lot (critic up by more than 8 points)", after_w - before > 8.0, (before, after_w))
        check("RED: without the warp the same stored calibration is worse (at least 2 points below)", after_w - after_nw > 2.0, (after_w, after_nw))
        check("the warped replay stays bounded (finite, RMS within 4x of the slowed render)", np.isfinite(y_w).all() and np.sqrt((y_w ** 2).mean()) < 4 * np.sqrt((slow_ours ** 2).mean()))
        # 15 October 2026: the frame axis is warped AROUND t0, like the times of a score (resynth.retime), and a warped deviation is bounded.
        # FR : l'axe des trames est deforme autour de t0 comme la partition, et une deviation deformee est bornee.
        spec = {"hop": 512}
        d0 = np.zeros((1, 3, 400))
        d0[:, :, 143] = 20.0
        t0s, ratio, hop_s = 0.5, 0.8, 512 / SR
        t0f = t0s / hop_s
        want = int(round(t0f + (143 - t0f) * ratio))
        got_t0 = int(np.argmax(T.warp_deviation(d0, spec, SR, 400, ratio, 0.0, t0s)[0, 0]))
        got_0 = int(np.argmax(T.warp_deviation(d0, spec, SR, 400, ratio, 0.0, 0.0)[0, 0]))
        check("GREEN: a pulse lands on the frame the score time map gives (around t0)", abs(got_t0 - want) <= 1, (got_t0, want))
        check("RED: mapped around zero the same pulse lands several frames away (the defect measured on a drum stem)", abs(got_0 - want) >= 5, (got_0, want))
        y_clip, _ = T.replay(slow_ours, loaded, SR, {"timeRatio": 0.9, "semitones": 0.0, "t0": 0.5, "maxDeviationDb": 1.0})
        lvl_c = 20 * np.log10(np.sqrt((y_clip ** 2).mean()) / np.sqrt((slow_ours ** 2).mean()))
        check("GREEN: with maxDeviationDb 1 a warped replay stays within 6 dB of the render level", abs(lvl_c) < 6.0, lvl_c)
        _, info_near = T.replay(slow_ours, loaded, SR, {"timeRatio": 1.25, "semitones": 0.0, "t0": 0.5})
        y_far, info_far = T.replay(slow_ours, loaded, SR, {"timeRatio": 2.2, "semitones": 0.0, "t0": 0.5})
        check("GREEN: far from the calibrated tempo (ratio 2.2) the correction is static, near it (1.25) it is not", info_far.get("static") is True and info_near.get("static") is False,
              (info_far.get("static"), info_near.get("static")))
        check("the static correction is finite and bounded", np.isfinite(y_far).all() and np.sqrt((y_far ** 2).mean()) < 4 * np.sqrt((slow_ours ** 2).mean()))
    print(f"{len(FAIL)} failure(s)")
    return 1 if FAIL else 0


def test_calibration():
    assert run() == 0


if __name__ == "__main__":
    sys.exit(run())
