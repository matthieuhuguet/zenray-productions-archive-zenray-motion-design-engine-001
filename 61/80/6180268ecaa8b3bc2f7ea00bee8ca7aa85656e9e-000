"""Numbers, not looks, for a glowing title (22 October 2026): the same measure (box of the bright pixels, core colour by thirds) on the reference and on the rendered motion, side by side.
FR : la meme mesure sur la reference et sur le motion rendu, cote a cote. Usage: python3 Scripts/AppleCompare.py <project> --offset 0 --at 0.2,0.4,... [--region x0,y0,x1,y1] [--thr 70]"""
import argparse
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

import numpy as np
from PIL import Image

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / "motion")); sys.path.insert(0, str(REPO / "Scripts"))
import banks  # noqa: E402
import server  # noqa: E402
from RefText import core  # noqa: E402


def measure(im, thr, region):
    x0, y0, x1, y1 = region; a = im[y0:y1, x0:x1]; lum = a.mean(2); m = lum > thr
    if m.sum() < 30:
        return None
    ys, xs = np.where(m); bx0, bx1, by0, by1 = xs.min(), xs.max(), ys.min(), ys.max(); w = max(1, bx1 - bx0); cols = []
    for k in range(3):
        sel = m & (np.arange(m.shape[1])[None, :] >= bx0 + w * k / 3) & (np.arange(m.shape[1])[None, :] < bx0 + w * (k + 1) / 3); cols.append("#%02x%02x%02x" % tuple(int(v) for v in core(a, sel)))
    return f"{bx0 + x0}-{bx1 + x0} x {by0 + y0}-{by1 + y0} pk {lum.max():.0f} {' '.join(cols)}"


def main() -> None:
    ap = argparse.ArgumentParser(); ap.add_argument("project"); ap.add_argument("--at", required=True); ap.add_argument("--offset", type=float, default=0)
    ap.add_argument("--region", default="0,0,1920,1080"); ap.add_argument("--thr", type=float, default=70); ap.add_argument("--save", default="")
    a = ap.parse_args(); times = [float(x) for x in a.at.split(",")]; region = [int(v) for v in a.region.split(",")]
    p = server.read_project(a.project); ref = banks.reference_video(p.get("reference", "")); work = Path(tempfile.mkdtemp(prefix="zrmd-ac-"))
    try:
        page = server.cook(a.project, work / "page"); snaps = work / "snaps"
        server.hyperframes(page, "snapshot", "--at", ",".join(f"{t:.3f}" for t in times), "--no-end", "-o", str(snaps), timeout=300)
        files = sorted(snaps.glob("frame-*.png"))
        for t, f in zip(times, files):
            mine = np.asarray(Image.open(f).convert("RGB").resize((1920, 1080))).astype(float)
            r = work / "r.png"; subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", f"{t + a.offset:.3f}", "-i", str(ref), "-frames:v", "1", str(r)], check=True)
            theirs = np.asarray(Image.open(r).convert("RGB")).astype(float)
            print(f"{t:5.2f} ref  {measure(theirs, a.thr, region)}\n      mine {measure(mine, a.thr, region)}")
            if a.save:
                Path(a.save).mkdir(parents=True, exist_ok=True); Image.open(f).save(Path(a.save) / f"mine-{t:.2f}.png")
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    main()
