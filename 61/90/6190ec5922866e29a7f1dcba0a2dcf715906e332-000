#!/usr/bin/env python3
# 14 October 2026: the music studio. A local page (127.0.0.1 only) where eight procedural values of a music track are changed and the result is
# compared with the reference by a switch. The engine renders the variation from the version's params.json with the reference UNREACHABLE (so
# nothing of the reference can leak into a render); the page mixes the rendered stems for an instant preview of the level and tilt values.
#   MusicStudio.py serve            http://127.0.0.1:3105/
#   MusicStudio.py render --slug S --set bpm=100 --set bass=6     one render from the command line (same code path as the page)
# The base of a variation is the RAW chain version of the member (the trim's base). The preview quality is a raw render (the page says so); the
# final quality (15 October 2026) replays the stored calibration (calibration.npz of the trim version) when the member has one, then polishes. FR : studio de variations musicales, rendu par le moteur sans acces a la reference.
from __future__ import annotations

import argparse
import copy
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlparse

ENGINE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ENGINE))
sys.path.insert(0, str(ENGINE / "Scripts"))
from zrmd import registry, settings  # noqa: E402

CFG = json.loads((ENGINE / "params" / "music-studio.json").read_text(encoding="utf-8"))
SERVER = CFG["server"]
SLIDERS = CFG["sliders"]
STEMS = ("drums", "bass", "other", "vocals")
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,80}$")
VERSION_RE = re.compile(r"^V_\d{3}$")
if len(SLIDERS) > CFG["maxSliders"]:
    raise SystemExit(f"music-studio exposes {len(SLIDERS)} values, above {CFG['maxSliders']} (HDA law)")


class Refusal(Exception):
    def __init__(self, msg: str, status: int = 400):
        super().__init__(msg)
        self.status = status


def scratch() -> Path:
    return Path(CFG["paths"]["scratch"].replace("{workshop}", str(settings.path("workshop"))))


def bench_of(slug: str) -> Path:
    return settings.path("sound_out") / slug / "music-bench"


def members() -> list[dict]:
    """Members that have a trim version (the calibrated result) and its raw base (the editable one)."""
    out = []
    for p in sorted(settings.path("sound_out").glob("*/music-bench")):
        slug = p.parent.name
        trims = sorted(v for v in p.glob("V_*") if (v / "trim.json").exists())
        if not trims:
            continue
        v = trims[-1]
        prm = json.loads((v / "params.json").read_text(encoding="utf-8"))
        base = (prm.get("trim") or {}).get("base")
        if not base or not (p / base / "params.json").exists():
            continue
        t = json.loads((v / "trim.json").read_text(encoding="utf-8"))
        crit = lambda d: d.get("gateCritic")  # noqa: E731
        out.append({"slug": slug, "trimVersion": v.name, "baseVersion": base,
                    "mix": crit(t["mix"]), "stems": {k: crit(x) for k, x in t["stems"].items()}})
    return out


def reference_audio(slug: str) -> Path:
    """The reference as a 44.1 kHz stereo WAV in the scratch folder (decoded once)."""
    dst = scratch() / slug / "reference.wav"
    if not dst.exists():
        ref = settings.path("refcache") / slug / f"{slug}.flac"
        src = ref if ref.exists() else Path(registry.reference_file(slug))
        dst.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(src), "-vn", "-ac", "2", "-ar", "44100", str(dst)], check=True)
    return dst


def base_params(slug: str, version: str) -> dict:
    return json.loads((bench_of(slug) / version / "params.json").read_text(encoding="utf-8"))


def defaults(prm: dict) -> dict:
    d = {}
    for s in SLIDERS:
        if s["apply"]["kind"] == "tempo":
            d[s["id"]] = prm["tempo"]["bpm"]
        else:
            d[s["id"]] = s.get("default", 0)
    return d


def apply_values(prm: dict, values: dict) -> dict:
    """Edit a copy of the version's params with the slider values. Unknown ids are refused; nothing is guessed."""
    out = copy.deepcopy(prm)
    known = {s["id"]: s for s in SLIDERS}
    for k in values:
        if k not in known:
            raise Refusal(f"unknown value '{k}' (allowed: {', '.join(known)})")
    base = defaults(prm)
    for sid, s in known.items():
        v = float(values.get(sid, base[sid]))
        if not (s["min"] <= v <= s["max"]):
            raise Refusal(f"{sid}={v} outside [{s['min']}, {s['max']}]")
        a = s["apply"]
        if a["kind"] == "tempo":
            out["tempo"]["bpm"] = v
        elif a["kind"] == "transpose":
            out["transposeSemitones"] = v
        elif a["kind"] == "stemGain":
            out.setdefault("stemGainsDb", {})[a["stem"]] = v
        elif a["kind"] == "voiceMacro":
            for voice in out["voices"].values():
                if a["macro"] in voice.get("macros", {}):
                    voice["macros"][a["macro"]] = v
        elif a["kind"] == "voiceMacroFor":  # named voices only, from the voice's own calibrated value (add or scale)
            if v == float(s.get("default", 0)):
                continue  # the default leaves the calibrated voice byte-identical
            for name in a["voices"]:
                m = out["voices"].get(name, {}).get("macros", {})
                if a["macro"] not in m:
                    continue
                own = float(prm["voices"][name]["macros"][a["macro"]])
                m[a["macro"]] = round(own + v, 6) if a.get("op", "add") == "add" else round(own * v, 6)
        elif a["kind"] == "voiceMacroScale":
            for name, voice in out["voices"].items():
                m = voice.get("macros", {})
                if a["macro"] in m and voice.get("kind") == "tonal":
                    m[a["macro"]] = round(float(prm["voices"][name]["macros"][a["macro"]]) * v, 6)
    out["variationOf"] = prm.get("version")
    return out


COOK = None
COOK_LOCK = threading.Lock()


def _paths_override(slug: str) -> dict:
    """The version bench of the member, with the reference paths pointing nowhere: nothing of the reference can enter a cook."""
    return {"paths": {"score": str(bench_of(slug) / "score.json"), "bench": str(bench_of(slug)), "stems": f"{CFG['referenceUnreachable']}/stems",
                      "referenceVideo": f"{CFG['referenceUnreachable']}/ref.mp4", "cache": str(scratch() / slug / "cache"), "instruments": "music-instruments"}}


QUALITIES = ("preview", "final")
PIPELINE = "15 October 2026 c: exact voices, stored calibration replayed (refused when it deforms), polish under a fidelity guard"


def cook_variation(slug: str, version: str, values: dict, quality: str = "preview") -> dict:
    """Cook the variation in this process with the persistent, cached cook (zrmd/audio/cook.py), then write the stems and the mix as float WAVs.
    quality "preview": the compiled kernel, a raw render in a few seconds (what the sliders play while they move). quality "final" (15 October
    2026): the exact voices (no compiled shortcut) THEN the production polish of every stem and of the mix (zrmd/audio/polish.py: DC and rumble,
    clicks repaired, crackle softened, harsh resonances tamed, bass foundation, true-peak limiter), so that whatever value a person chooses the
    result is pleasant to listen to; it takes tens of seconds to minutes and nobody waits for it in real time. The raw render of the same cook is
    kept next to it (raw-*.wav) for the A/B. FR : qualite finale = voix exactes puis polish, quelle que soit la valeur choisie."""
    global COOK, COOK_FINAL
    import numpy as np
    import soundfile as sf
    from zrmd.audio import cook as CK, polish as PL, resynth as RS
    if quality not in QUALITIES:
        raise Refusal(f"quality must be one of {', '.join(QUALITIES)}")
    prm = apply_values(base_params(slug, version), values)
    # the key carries what the final pipeline depends on (its settings and the pipeline stamp), so a cook made by an older pipeline is never
    # served as the current one. FR : la cle porte la version du pipeline, un ancien rendu ne se fait pas passer pour le courant.
    pipe = [PIPELINE, CFG.get("finalExtraPasses"), CFG.get("finalFidelityFloor"), CFG.get("finalDropOrder"), CFG.get("finalMaxLevelDeltaDb")] if quality == "final" else [PIPELINE]
    key = hashlib.sha256(json.dumps([slug, version, values, quality, pipe], sort_keys=True).encode()).hexdigest()[:12]
    work = scratch() / slug / "cook" / key
    done = work / "done.json"
    if done.exists():
        return json.loads(done.read_text(encoding="utf-8"))
    with COOK_LOCK:
        P = RS.params(_paths_override(slug))
        RS.install(P)
        if quality == "final":
            if COOK_FINAL is None:
                COOK_FINAL = CK.Cook(P, fast=False)
            engine = COOK_FINAL
        else:
            if COOK is None:
                COOK = CK.Cook(P)
            engine = COOK
        score = json.loads((bench_of(slug) / version / "score.json").read_text(encoding="utf-8"))
        t0 = time.time()
        out = engine.render(prm, score, P)
        sec = round(time.time() - t0, 2)
        work.mkdir(parents=True, exist_ok=True)
        sr = out["sr"]
        res = {"key": key, "dir": str(work), "seconds": sec, "values": values, "stats": engine.stats, "quality": quality, "calibrated": False}
        if quality == "final":
            pc, t1 = PL.cfg(), time.time()
            report = {}
            tv = next((m["trimVersion"] for m in members() if m["slug"] == slug), None)
            raws = {st: np.asarray(out["stems"][st] if st != "mix" else out["mix"], np.float32) for st in (*STEMS, "mix")}
            for st, raw in raws.items():
                sf.write(str(work / f"raw-{st}.wav"), raw, sr, subtype="FLOAT")
            # 15 October 2026: the stored 99.9 calibration (numbers, calibration.npz of the trim version) is replayed on the exact render BEFORE the
            # polish, time-warped with the tempo and moved with the transposition of the chosen values; a missing calibration is reported, never hidden.
            # FR : la calibration finale rejouee depuis ses nombres, avant le polish.
            calibrated, cal_info = False, None
            if tv:
                try:
                    out_cal, cal_info = _replay_calibration(slug, version, tv, prm, out, score, P)
                    calibrated = cal_info is not None
                    if calibrated:
                        # a replay that moved a signal by more than finalMaxLevelDeltaDb (or made it non finite) is a deformation, not a correction
                        # (a drum stem came out 17 dB too loud on another tempo before the t0 fix): it is refused and the exact render is kept, and
                        # the result says which signals. FR : un rejeu qui deforme est refuse, le rendu exact est garde et le dit.
                        lim = float(CFG.get("finalMaxLevelDeltaDb", 6.0))
                        bad = {}
                        for st in (*STEMS, "mix"):
                            c_sig = np.asarray(out_cal["stems"][st] if st != "mix" else out_cal["mix"], np.float64)
                            r_sig = raws[st].astype(np.float64)
                            dlt = 20 * np.log10((np.sqrt((c_sig ** 2).mean()) + 1e-12) / (np.sqrt((r_sig ** 2).mean()) + 1e-12))
                            if not np.isfinite(c_sig).all() or abs(dlt) > lim:
                                bad[st] = round(float(dlt), 2)
                        if bad:
                            calibrated, res["calibrationRejected"] = False, {"limitDb": lim, "levelDeltaDb": bad}
                        else:
                            out = out_cal
                except Exception as e:  # noqa: BLE001
                    res["calibrationError"] = f"{type(e).__name__}: {e}"
            res["calibrated"] = calibrated
            for st in (*STEMS, "mix"):
                raw = np.asarray(out["stems"][st] if st != "mix" else out["mix"], np.float32)
                # the cleanliness criteria are RELATIVE to OUR calibrated version of the same member (a hi-hat stem has crackle bursts by the
                # detector's definition): its own audio, never the reference's. FR : critere relatif a notre version calee, pas a la reference.
                ref = None
                if tv:
                    rp = bench_of(slug) / tv / ("mix.wav" if st == "mix" else f"stems/{st}.wav")
                    if rp.is_file():
                        ref, rsr = sf.read(str(rp), dtype="float32")
                        ref = ref if rsr == sr else None
                kind = "mix" if st == "mix" else "stem"
                y, rep, guard = _polish_guarded(raw, sr, pc, ref, kind, anchor=raw if calibrated else None)
                sf.write(str(work / f"{st}.wav"), np.asarray(y, np.float32), sr, subtype="FLOAT")
                report[st] = {"clean": rep["clean"], "cleanAbsolute": rep["cleanAbsolute"], "stages": rep["stages"], "fidelity": guard}
            sane = {}
            for st in (*STEMS, "mix"):
                y_f, _ = sf.read(str(work / f"{st}.wav"), dtype="float32")
                r_s = raws[st].astype(np.float64)
                sane[st] = {"peak": round(float(np.abs(y_f).max()), 3), "finite": bool(np.isfinite(y_f).all()),
                            "levelVsRenderDb": round(float(20 * np.log10((np.sqrt((y_f.astype(np.float64) ** 2).mean()) + 1e-12) / (np.sqrt((r_s ** 2).mean()) + 1e-12))), 2)}
            res["sanity"] = sane
            res.update(polished=True, polishSeconds=round(time.time() - t1, 2), polish=report, calibrationInfo=cal_info,
                       note=("exact voices, the stored 99.9 calibration replayed from its numbers, then the production polish of every stem and of the mix"
                             if calibrated else "exact voices, then the production polish of every stem and of the mix; no stored calibration was replayed"))
        else:
            for st in STEMS:
                sf.write(str(work / f"{st}.wav"), np.asarray(out["stems"][st], np.float32), sr, subtype="FLOAT")
            sf.write(str(work / "mix.wav"), np.asarray(out["mix"], np.float32), sr, subtype="FLOAT")
            res.update(polished=False, note="raw preview of the base version: the final quality (exact voices and polish) follows")
        done.write_text(json.dumps(res), encoding="utf-8")
        return res


def _polish_guarded(raw, sr: int, pc: dict, ref, kind: str, anchor=None):
    """The production polish of one signal, with a FIDELITY GUARD (15 October 2026). When `anchor` is given (the calibrated render, which the
    official critic scores at 99.99 and above against the reference: measured on memo-m1), the polished signal is scored against it with the same
    critic; while it is under finalFidelityFloor the stages of finalDropOrder are removed one by one (bass foundation first, which measurably moves
    the spectrum on purpose: bass 99.15, drums 99.84, mix 99.85 with every stage), and the report names what was dropped and the score reached.
    The true-peak limiter and the click repair are never dropped. FR : le polish ne s'eloigne jamais de la version calee plus que le plancher."""
    import numpy as np
    from zrmd.audio import polish as PL, trim as T
    all_stages = ["dc", "declick", "decrackle", "resonance", "bass", "limiter"]
    floor = float(CFG.get("finalFidelityFloor", 99.9))
    order = [x for x in CFG.get("finalDropOrder", ["bass", "resonance", "decrackle"]) if x in all_stages and x not in ("limiter", "declick", "dc")]
    spec = json.loads((ENGINE / "params" / "music-trim.json").read_text(encoding="utf-8"))["specs"]["critic"]
    base = T.mono(np.asarray(anchor, np.float64)) if anchor is not None else None

    def run(stages):
        y, rep = PL.polish(raw, sr, pc, stages=stages, reference=ref, kind=kind)
        for _ in range(int(CFG.get("finalExtraPasses", 2))):      # time is not the constraint: another gentle pass while it is not clean
            if rep["clean"]:
                break
            extra = [x for x in ("decrackle", "resonance", "limiter") if x in stages]
            y2, rep2 = PL.polish(y, sr, pc, stages=extra, reference=ref, kind=kind)
            if rep2["after"]["cracklePerSecond"] + rep2["after"]["clicksPerSecond"] >= rep["after"]["cracklePerSecond"] + rep["after"]["clicksPerSecond"]:
                break
            y, rep = y2, {**rep2, "stages": {**rep["stages"], **{f"extra:{k}": v for k, v in rep2["stages"].items()}}}
        return y, rep

    def fidelity(y):
        m = T.mono(np.asarray(y, np.float64))
        n = min(len(base), len(m))
        return round(float(T.score_spec(base[:n], m[:n], sr, spec)["score"]), 3)

    stages, dropped = list(all_stages), []
    y, rep = run(stages)
    if base is None:
        return y, rep, None
    score = fidelity(y)
    for name in order:
        if score >= floor:
            break
        stages.remove(name)
        dropped.append(name)
        y, rep = run(stages)
        score = fidelity(y)
    return y, rep, {"floor": floor, "score": score, "ok": score >= floor, "dropped": dropped}


COOK_FINAL = None


def _replay_calibration(slug: str, base_version: str, trim_version: str, prm: dict, out: dict, score: dict, P: dict) -> tuple[dict, dict | None]:
    """The calibration of the member's trim version replayed on `out`, the exact render of `prm` (the base version with the slider values).
    Returns (out, info), or (out, None) when the trim version stores no calibration. The tempo ratio and the transposition are RELATIVE to the base
    version the calibration was made on, so the default values give the calibrated version back and a changed value moves the calibration with it."""
    import ResynthMusic as RM
    from zrmd.audio import calibration as CAL
    trim_dir = bench_of(slug) / trim_version
    tp = json.loads((trim_dir / "params.json").read_text(encoding="utf-8"))
    if not tp.get("calibration"):
        return out, None
    cal_file = CAL.locate(tp, trim_dir)
    if not cal_file.is_file():
        raise CAL.CalibrationError(f"calibration file not found: {cal_file}")
    base = base_params(slug, base_version)
    ratio = float(base["tempo"]["bpm"]) / float(prm["tempo"]["bpm"])
    semi = float(prm.get("transposeSemitones", 0.0)) - float(base.get("transposeSemitones", 0.0))
    t0 = time.time()
    got = RM.apply_calibration({**prm, "calibration": tp["calibration"]}, out, score, P, trim_dir, ratio, semi)
    return got, {"timeRatio": round(ratio, 6), "semitones": round(semi, 4), "seconds": round(time.time() - t0, 1),
                 "trimVersion": trim_version, "signals": got.get("calibrationInfo")}


# ------------------------------------------------------------------------------------------------ http
def audio_path(slug: str, kind: str, stem: str, version: str | None, key: str | None) -> Path:
    if kind == "reference":
        return reference_audio(slug)
    if kind == "ours":
        m = next((x for x in members() if x["slug"] == slug), None)
        if not m:
            raise Refusal("unknown member", 404)
        return bench_of(slug) / m["trimVersion"] / ("mix.wav" if stem == "mix" else f"stems/{stem}.wav")
    if kind == "cook":
        if not key or not re.fullmatch(r"[0-9a-f]{12}", key):
            raise Refusal("bad key")
        d = scratch() / slug / "cook" / key
        if not (d / "done.json").exists():
            raise Refusal("no such cook", 404)
        return d / f"{stem}.wav"
    raise Refusal("unknown kind")


class Handler(BaseHTTPRequestHandler):
    server_version = "ZenRayMusicStudio/1"

    def log_message(self, fmt, *args):
        pass

    def _json(self, data, status=200):
        body = json.dumps(data, ensure_ascii=False, default=float).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _guard(self, post: bool):
        origin = self.headers.get("Origin")
        port = self.server.server_port
        if origin and origin not in {f"http://{SERVER['host']}:{port}", f"http://localhost:{port}"}:
            raise Refusal("origin refused", 403)
        if post and self.headers.get(SERVER["clientHeader"]) != SERVER["clientValue"]:
            raise Refusal("missing client header", 403)

    def _file(self, path: Path, mime: str):
        size = path.stat().st_size
        start, end, status = 0, size - 1, 200
        rng = self.headers.get("Range")
        if rng:
            m = re.fullmatch(r"bytes=(\d*)-(\d*)", rng.strip())
            if not m:
                raise Refusal("bad range", 416)
            if m.group(1):
                start = int(m.group(1))
                end = int(m.group(2)) if m.group(2) else size - 1
            else:
                start = max(0, size - int(m.group(2)))
            end = min(end, size - 1)
            status = 206
        self.send_response(status)
        self.send_header("Content-Type", mime)
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Length", str(end - start + 1))
        self.send_header("Cache-Control", "no-store")
        if status == 206:
            self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
        self.end_headers()
        with open(path, "rb") as f:
            f.seek(start)
            left = end - start + 1
            while left > 0:
                block = f.read(min(1 << 20, left))
                if not block:
                    break
                try:
                    self.wfile.write(block)
                except (BrokenPipeError, ConnectionResetError):
                    return
                left -= len(block)

    def do_GET(self):
        try:
            self._guard(False)
            u = urlparse(self.path)
            q = {k: v[0] for k, v in parse_qs(u.query).items()}
            p = unquote(u.path)
            if p == "/":
                return self._file(ENGINE / "app" / "music-studio.html", "text/html; charset=utf-8")
            if p == "/api/config":
                return self._json({"ok": True, "sliders": SLIDERS, "members": members()})
            if p == "/api/state":
                slug = q.get("slug", "")
                m = next((x for x in members() if x["slug"] == slug), None)
                if not m:
                    raise Refusal("unknown member", 404)
                return self._json({"ok": True, "member": m, "defaults": defaults(base_params(slug, m["baseVersion"]))})
            if p == "/audio":
                slug = q.get("slug", "")
                if not SLUG_RE.match(slug):
                    raise Refusal("bad slug")
                stem = q.get("stem", "mix")
                if stem not in STEMS + ("mix",):
                    raise Refusal("bad stem")
                return self._file(audio_path(slug, q.get("kind", ""), stem, None, q.get("key")), "audio/wav")
            raise Refusal("not found", 404)
        except Refusal as e:
            self._json({"ok": False, "error": str(e)}, e.status)
        except Exception as e:
            self._json({"ok": False, "error": f"{type(e).__name__}: {e}"}, 500)

    def do_POST(self):
        try:
            self._guard(True)
            u = urlparse(self.path)
            n = int(self.headers.get("Content-Length") or 0)
            if n > 65536:
                raise Refusal("body too large", 413)
            body = json.loads(self.rfile.read(n) or b"{}")
            if u.path == "/api/cook":
                slug = str(body.get("slug", ""))
                m = next((x for x in members() if x["slug"] == slug), None)
                if not m:
                    raise Refusal("unknown member", 404)
                values = {k: float(v) for k, v in (body.get("values") or {}).items()}
                apply_values(base_params(slug, m["baseVersion"]), values)  # refuses unknown or out-of-range values before any work
                return self._json({"ok": True, **cook_variation(slug, m["baseVersion"], values, str(body.get("quality") or "preview"))})
            raise Refusal("not found", 404)
        except Refusal as e:
            self._json({"ok": False, "error": str(e)}, e.status)
        except Exception as e:
            self._json({"ok": False, "error": f"{type(e).__name__}: {e}"}, 500)


def main() -> int:
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("serve")
    r = sub.add_parser("render")
    r.add_argument("--slug", required=True)
    r.add_argument("--set", action="append", default=[], help="id=value (see params/music-studio.json)")
    r.add_argument("--quality", choices=QUALITIES, default="preview", help="preview: compiled kernel, raw; final: exact voices, stored calibration, polish")
    a = ap.parse_args()
    if a.cmd == "serve":
        srv = ThreadingHTTPServer((SERVER["host"], SERVER["port"]), Handler)
        print(json.dumps({"ok": True, "url": f"http://{SERVER['host']}:{srv.server_port}/"}), flush=True)
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            pass
        return 0
    m = next((x for x in members() if x["slug"] == a.slug), None)
    if not m:
        raise SystemExit(f"unknown member {a.slug}")
    values = {k: float(v) for k, v in (s.split("=", 1) for s in a.set)}
    print(json.dumps(cook_variation(a.slug, m["baseVersion"], values, a.quality), indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
