// 12 October 2026: Lens halo: a gaussian ring around the optical centre with per-channel radius dispersion (rainbow edge). Colour block.
// generated by Scripts/HarvestNoisePost.py. Licence: original (written from the mathematics), same licence as the engine.
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
vec4 flare_halo(vec2 uv, vec2 center, float radius, float width, float dispersion, vec3 color, float intensity, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float r = length(p);
  vec3 band;
  for (int k = 0; k < 3; k++) {
    float rk = radius * (1.0 + (float(k) - 1.0) * dispersion);
    float e = (r - rk) / width;
    band[k] = exp(-e * e);
  }
  return vec4(clamp(intensity * color * band, 0.0, 1.0), 1.0);
}
