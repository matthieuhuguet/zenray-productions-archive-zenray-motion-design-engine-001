// 23 October 2026: turn a logo SVG into the data file read by the ps-open template (workflow Premier Plan Mesure).
// The exact bounding box of the paths is read in the managed browser (getBBox), the logo is scaled to `--width` pixels and centred on the tile of the opening.
// Usage: node Scripts/LogoData.mjs <logo.svg> <name> [--width 326] [--cx 960] [--cy 492] [--reg 0]   -> motion/runtime/zs-templates-playstation-logo-<name>-1.js (window.ZSLogos[name])
// FR : convertit un logo SVG en donnees pour le gabarit ps-open (boite exacte lue dans le navigateur gere, mise a l'echelle et centrage sur la tuile).
import { spawnSync } from "node:child_process";
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { createRequire } from "node:module";
const ROOT = dirname(dirname(fileURLToPath(import.meta.url))), TOOLING = join(ROOT, "tooling");
const require = createRequire(join(TOOLING, "package.json"));
const puppeteer = require("puppeteer-core");
const args = process.argv.slice(2), opt = (k, d) => (args.includes(k) ? Number(args[args.indexOf(k) + 1]) : d);
const [svgPath, name] = args;
if (!svgPath || !name) { console.error("usage: node Scripts/LogoData.mjs <logo.svg> <name> [--width 326] [--cx 960] [--cy 492] [--reg 0]"); process.exit(2); }
const width = opt("--width", 326), cx = opt("--cx", 960), cy = opt("--cy", 492), reg = opt("--reg", 0);
const svg = readFileSync(svgPath, "utf8"), ds = [...svg.matchAll(/<path[^>]*\sd="([^"]+)"/g)].map((m) => m[1]);
if (!ds.length) { console.error("no <path d> found in", svgPath); process.exit(2); }
const env = { ...process.env, HYPERFRAMES_NO_TELEMETRY: "1", DO_NOT_TRACK: "1", HYPERFRAMES_NO_UPDATE_CHECK: "1" };
const browserPath = spawnSync(join(TOOLING, "node_modules", ".bin", "hyperframes"), ["browser", "path"], { env, encoding: "utf8" }).stdout.trim();
const browser = await puppeteer.launch({ executablePath: browserPath, headless: true, args: ["--no-first-run"] });
try {
  const page = await browser.newPage();
  await page.setContent(`<svg xmlns="http://www.w3.org/2000/svg" width="2000" height="2000">${ds.map((d) => `<path d="${d}"/>`).join("")}</svg>`);
  const bb = await page.evaluate(() => { let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9; document.querySelectorAll("path").forEach((p) => { const b = p.getBBox(); x0 = Math.min(x0, b.x); y0 = Math.min(y0, b.y); x1 = Math.max(x1, b.x + b.width); y1 = Math.max(y1, b.y + b.height); }); return { x: x0, y: y0, w: x1 - x0, h: y1 - y0 }; });
  const k = width / bb.w, h = bb.h * k, r2 = (v) => Math.round(v * 100) / 100;
  const data = { name, box: [r2(cx - width / 2), r2(cy - h / 2), r2(width), r2(h)], viewBox: `0 0 ${r2(bb.w)} ${r2(bb.h)}`, transform: `translate(${r2(-bb.x)},${r2(-bb.y)})`, unit: 1, d: ds.join(" "), tile: [744, 282, 1176, 702], registered: !!reg };
  const out = join(ROOT, "motion", "runtime", `zs-templates-playstation-logo-${name}-1.js`);
  writeFileSync(out, `// 23 October 2026: logo "${name}" for the ps-open template, written by Scripts/LogoData.mjs from ${svgPath.split("/").pop()}. FR : donnees du logo.\nwindow.ZSLogos = window.ZSLogos || {};\nwindow.ZSLogos[${JSON.stringify(name)}] = ${JSON.stringify(data)};\n`);
  console.log(JSON.stringify({ out, bbox: bb, box: data.box }));
} finally { await browser.close(); }
