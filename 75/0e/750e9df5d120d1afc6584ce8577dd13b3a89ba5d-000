// 26 October 2026: ZenRay Motion Design, the SOUND CLIPS of a film (project.clips), with no screen in it so that node proves it (motion/tests/test_clips.mjs).
// A clip is a capsule on the "Sons" lane: a sound with 1 to 3 versions to choose from (v1, v2, v3), a start in seconds of the film, a level, and an ANCHOR
// (a cue of the film, the instant of the sound that must land on it) so that "recaler" puts it back on the cue to the millisecond. The choices live in
// project.clips and are saved with the project; a one-line text (ZRSON1) copies ALL the choices and pastes them back. Matthieu's words (26 October 2026):
// "comme sur DaVinci Resolve", "avoir tous les choix, je te remets une ligne et tu copies et tu sauves". FR : les capsules de son d'un film, logique pure.
(function (root, factory) {
  if (typeof module === "object" && module.exports) module.exports = factory(); else root.ZSClips = factory();
})(typeof self !== "undefined" ? self : this, function () {
  "use strict";
  const FORMAT = "ZRSON1";
  const r3 = (x) => Math.round(Number(x) * 1000) / 1000;
  const num = (x, d) => (Number.isFinite(Number(x)) && x !== "" && x !== null && x !== undefined ? Number(x) : d);
