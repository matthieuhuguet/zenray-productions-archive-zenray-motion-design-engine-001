// 12 October 2026: Two-colour ramp along an angle shaped by Schlick bias then gain (rational curves). Colour block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: angle (degrees (0 = left to right, 90 = top to bottom)), c0 (sRGB 0..1), c1 (sRGB 0..1), bias (0.5 = linear), gain (0.5 = linear).
float ease_bias_gain_ramp_axis(vec2 uv, float angle) {
  float a = radians(angle);
  vec2 dir = vec2(cos(a), sin(a));
  return 0.5 + dot(uv - 0.5, dir) / (abs(dir.x) + abs(dir.y));
}
vec4 ease_bias_gain_ramp(vec2 uv, float angle, vec3 c0, vec3 c1, float bias, float gain) {
  float t = clamp(ease_bias_gain_ramp_axis(uv, angle), 0.0, 1.0);
  float b = t / ((1.0 / bias - 2.0) * (1.0 - t) + 1.0);
  float x = b < 0.5 ? 2.0 * b : 2.0 - 2.0 * b;
  float h = x / ((1.0 / gain - 2.0) * (1.0 - x) + 1.0);
  float e = b < 0.5 ? 0.5 * h : 1.0 - 0.5 * h;
  return vec4(mix(c0, c1, e), 1.0);
}
