// the dancing photographed figure is NOT reproduced (a pink or blue silhouette tile is out of scope). FR : panneaux, mascotte, mots chantes, cartes ; jamais la danseuse filmee.
(function () {
  const ZS = window.ZS, h = ZS.h;
  const P = (key, label, type, def, tier, extra) => Object.assign({ key, label, type, default: def, tier }, extra || {});
  const N = (key, label, def, min, max, step, tier, unit) => ({ key, label, type: "number", default: def, min, max, step, tier, unit });
  const SANS = "InterVariable", MONO = "JetBrainsMono", SERIF = "InstrumentSerif";
  const abs = (parent, css, text) => { const e = h.css(h.el("div", "zs-abs", parent), css); if (text !== undefined) { if (/[<&]/.test(String(text))) e.innerHTML = text; else e.textContent = text; } return e; };
  const rows = (lines) => lines.map((l) => l.split("|").map((s) => s.trim())).filter((r) => r.length >= 3);
  const num = Number;
  const PINK = "#ff2f92", BLUE = "#2f5bff", LAV = "#a9a7f5", CREAM = "#f0ede2", INK = "#0b0b0e", BUB = "#a7a4f2";
  const PW = 1280, PH = 720;

  function mascot(parent, x, y, s, face) {
    const g = abs(parent, { left: x + "px", top: y + "px", width: s + "px", height: s * 0.9 + "px" });
    abs(g, { left: "0", top: "0", width: s + "px", height: s * 0.74 + "px", borderRadius: s * 0.22 + "px", background: BUB, border: `${Math.max(2, s * 0.03)}px solid ${LAV}`, boxShadow: `0 0 0 ${s * 0.02}px #6c63e8 inset` });
    const eye = (cx) => abs(g, { left: cx - s * 0.05 + "px", top: s * 0.2 + "px", width: s * 0.1 + "px", height: s * 0.2 + "px", borderRadius: s * 0.04 + "px", background: face === "calm" ? "transparent" : "#e8207a", border: face === "calm" ? `${s * 0.025}px solid #1a1440` : "none" });
    eye(s * 0.3); eye(s * 0.7);
    abs(g, { left: s * 0.4 + "px", top: s * 0.42 + "px", width: s * 0.2 + "px", height: s * 0.1 + "px", borderBottom: `${s * 0.03}px solid #1a1440`, borderRadius: "0 0 50% 50%" });
    abs(g, { left: s * 0.18 + "px", top: s * 0.7 + "px", width: 0, height: 0, borderLeft: s * 0.06 + "px solid transparent", borderRight: s * 0.08 + "px solid transparent", borderTop: s * 0.16 + "px solid " + BUB });
    abs(g, { left: -s * 0.18 + "px", top: s * 0.12 + "px", fontFamily: h.font(MONO), fontSize: s * 0.42 + "px", color: "#6a74d8" }, "{"); abs(g, { left: s * 1.02 + "px", top: s * 0.12 + "px", fontFamily: h.font(MONO), fontSize: s * 0.42 + "px", color: "#6a74d8" }, "}");
    return g;
  }
  const bar = (parent, text, dark) => { const b = abs(parent, { left: "0", top: "0", width: PW + "px", height: "22px", background: dark ? INK : PINK, borderBottom: "1px solid #000" }); abs(b, { left: "8px", top: "4px", fontFamily: h.font(MONO), fontSize: "11px", color: dark ? PINK : "#111", whiteSpace: "nowrap" }, text); return b; };

  ZS.register({
    id: "ly-ui", label: "Clip : panneaux colorés, mascotte, mots chantés, cartes (sans danseuse)", group: "Interface", duration: 100,
    params: [
      P("items", "Éléments (début | fin | type | texte | x | y | taille | couleur | fond)", "lines", [], 1), P("ink", "Encre", "color", INK, 2), P("pink", "Rose", "color", PINK, 2), P("blue", "Bleu", "color", BLUE, 2),
      N("sizeScale", "Échelle des textes", 1.5, 0.5, 3, 0.05, 3), N("cps", "Caractères par seconde (frappe)", 18, 1, 80, 0.5, 3), N("tallScale", "Échelle en format haut", 1.5, 1, 3, 0.05, 3), N("film0", "Début dans le film (s)", 0, 0, 200, 0.01, 4, "s"),
    ],
    build(ctx) {
      const { el, p, tl, t0, dur } = ctx, { st, tall, w, h: sh } = ZS.stageAdaptive(ctx);
      const k = tall ? (w / PW) * p.tallScale : Math.min(w / PW, sh / PH);
      h.css(el, { background: INK });
      const plane = abs(st, { left: (w - PW * k) / 2 + "px", top: (sh - PH * k) / 2 + "px", width: PW + "px", height: PH + "px", transformOrigin: "0 0", transform: `scale(${k})`, overflow: "hidden" });
      rows(p.items).forEach((r) => {
        const a = num(r[0]), b = num(r[1]), kind = r[2], text = r[3] || "", x = num(r[4] || 0) * PW, y = num(r[5] || 0) * PH, size = num(r[6] || 40) * (r[2] === "mascot" ? 1 : p.sizeScale), col = r[7] || p.ink, bg = r[8] || "";
        const g = abs(plane, { left: "0", top: "0", width: PW + "px", height: PH + "px", opacity: 0 });
        let typed = null, full = "";
        if (kind === "bg") abs(g, { left: "0", top: "0", width: PW + "px", height: PH + "px", background: col });
        else if (kind === "bar") bar(g, text, bg === "dark");
        else if (kind === "mascot") mascot(g, x, y, size, text || "wide");
        else if (kind === "big") abs(g, { left: x + "px", top: y + "px", fontFamily: h.font(SANS), fontWeight: 900, fontSize: size + "px", color: col, whiteSpace: "pre", lineHeight: 0.92, letterSpacing: "-0.03em", textTransform: "uppercase", background: bg || "transparent", padding: bg ? "0 12px" : 0, transform: "scaleX(0.9)", transformOrigin: "0 0" }, text.replace(/\\n/g, "\n"));
        else if (kind === "script") abs(g, { left: x + "px", top: y + "px", fontFamily: h.font(SERIF), fontStyle: "italic", fontSize: size + "px", color: col, whiteSpace: "pre", lineHeight: 1.05, background: bg || "transparent" }, text.replace(/\\n/g, "\n"));
        else if (kind === "mono") { typed = abs(g, { left: x + "px", top: y + "px", fontFamily: h.font(MONO), fontSize: size + "px", color: col, whiteSpace: "pre", lineHeight: 1.45, background: bg || "transparent", padding: bg ? "2px 6px" : 0 }, ""); full = text.replace(/\\n/g, "\n"); }
        else if (kind === "sans") { typed = abs(g, { left: x + "px", top: y + "px", fontFamily: h.font(SANS), fontWeight: 600, fontSize: size + "px", color: col, whiteSpace: "pre", lineHeight: 1.15, background: bg || "transparent", padding: bg ? "2px 8px" : 0 }, ""); full = text.replace(/\\n/g, "\n"); }
        else if (kind === "card") { const [tt, body] = text.split("//"); const c = abs(g, { left: x + "px", top: y + "px", width: size * 3.2 + "px", height: size * 1.5 + "px", background: "#fff", border: `${Math.max(2, size * 0.04)}px solid #111`, borderRadius: size * 0.12 + "px", boxShadow: "6px 6px 0 #111" }); abs(c, { left: size * 0.2 + "px", top: size * 0.15 + "px", fontFamily: h.font(SANS), fontSize: size * 0.28 + "px", fontWeight: 700, color: "#111", whiteSpace: "nowrap" }, "⚠ " + tt); abs(c, { left: size * 0.2 + "px", top: size * 0.62 + "px", fontFamily: h.font(MONO), fontSize: size * 0.42 + "px", fontWeight: 700, border: "2px solid #111", padding: "0 10px", color: "#111", whiteSpace: "nowrap" }, body || "[Ignore]"); }
        else if (kind === "toggle") { abs(g, { left: x + "px", top: y + "px", width: size * 4 + "px", height: size * 1.4 + "px", borderRadius: size + "px", background: "#ffb11b", border: "3px solid #111" }); abs(g, { left: x + size * 0.3 + "px", top: y + size * 0.25 + "px", fontFamily: h.font(SANS), fontWeight: 800, fontSize: size * 0.45 + "px", color: "#111" }, "ON"); abs(g, { left: x + size * 2.7 + "px", top: y + size * 0.15 + "px", width: size * 1.1 + "px", height: size * 1.1 + "px", borderRadius: "50%", background: "#fff", border: "3px solid #111" }); }
        else if (kind === "window") { const [tt, body] = text.split("//"); const wd = size * 7, c = abs(g, { left: x + "px", top: y + "px", width: wd + "px", height: size * 4 + "px", background: "#fbfaf4", border: "3px solid #111", boxShadow: "6px 6px 0 #111" }); abs(c, { left: "0", top: "0", width: wd + "px", height: size * 0.7 + "px", background: "#111" }); abs(c, { left: "10px", top: size * 0.12 + "px", fontFamily: h.font(MONO), fontSize: size * 0.4 + "px", color: "#fff", whiteSpace: "nowrap" }, tt); abs(c, { left: "14px", top: size * 1.0 + "px", fontFamily: h.font(MONO), fontSize: size * 0.4 + "px", color: "#111", whiteSpace: "pre", lineHeight: 1.5 }, (body || "").replace(/\\n/g, "\n")); }
        tl.set(g, { opacity: 1 }, t0 + a); if (b < dur - 0.02) tl.set(g, { opacity: 0 }, t0 + b);
        if (typed && full) { const pr = { n: 0 }; tl.fromTo(pr, { n: 0 }, { n: full.length, duration: Math.max(0.1, Math.min(full.length / p.cps, Math.max(0.1, b - a - 0.1))), ease: "none", onUpdate: () => { typed.textContent = full.slice(0, Math.round(pr.n)); } }, t0 + a); }
      });
    },
  });
})();
