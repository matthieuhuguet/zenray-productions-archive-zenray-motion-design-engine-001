"""ZenRay Motion Design, the banks the motion module plays from (15 October 2026).

music_bank(): every reference music reproduced by the 99.9 % workflow (the latest `music-trim` version of each member under
{workshop}/sound/<member>/music-bench, its polished mix when it exists), with its four stems, its tempo and key, and the
variations the agent proposed for it (motion/params/music-variations.json). The browser mixes the stems live: nothing is
recomputed.

sfx_bank(): the sound effects isolated from the references (events.json + sfx.wav of the latest version of each member),
cut once into short WAV files under paths.bank/sfx, plus the 71 synthesised blocks of datasets/sound-bank.

reference_video(slug): the reference video of the cache, the input of a "convert a video into motion" project.
FR : les banques du module Motion ; musiques reproduites a 99,9 %, effets isoles des references, videos de reference.
"""
from __future__ import annotations

import json
import os
import re
from pathlib import Path

MOTION = Path(__file__).resolve().parent
REPO = MOTION.parent
CFG = json.loads((MOTION / "params" / "motion.json").read_text(encoding="utf-8"))
P = {k: Path(os.path.expanduser(v)) for k, v in CFG["paths"].items()}
WORKSHOP = P.get("workshop", Path(os.path.expanduser("~/.claude/tmp/tmp-zenray-motion-design")))
REFCACHE = P.get("refcache", Path(os.path.expanduser("~/.claude/tmp/tmp-zenray-motion-design-refcache")))
SOUND = WORKSHOP / "sound"
REFERENCES = WORKSHOP / "references"
BANK = P["bank"]
SYNTH = REPO / "datasets" / "sound-bank"
STEMS = ("drums", "bass", "other", "vocals")
VIDEO_EXT = (".mp4", ".mov", ".webm", ".mkv", ".m4v")
SAFE = re.compile(r"^[A-Za-z0-9._-]+$")


def _json(p: Path, default=None):
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return default


def _vkey(p: Path) -> int:
    m = re.search(r"V_(\d+)$", p.name)
    return int(m.group(1)) if m else -1


def final_version(member: Path) -> Path | None:
    """The 99.9 % version of a member: the latest music-trim whose stems and final mix were written."""
    best = None
    for v in sorted((member / "music-bench").glob("V_*"), key=_vkey):
        meta = _json(v / "meta.json", {}) or {}
        if meta.get("kind") == "music-trim" and (v / "mix.wav").is_file():
            best = v
    return best


def _fidelity(v: Path) -> float | None:
    head = (_json(v / "scores.json", {}) or {}).get("headline", {})
    vals = [s.get("plossFull") for s in head.values() if isinstance(s, dict) and isinstance(s.get("plossFull"), (int, float))]
    return round(sum(vals) / len(vals), 2) if vals else None


def _variations() -> dict:
    return _json(MOTION / "params" / "music-variations.json", {}) or {}


def music_bank() -> dict:
    out, var = [], _variations()
    for member in sorted(SOUND.iterdir()) if SOUND.is_dir() else []:
        v = final_version(member)
        if not v:
            continue
        polish = v / "polish"
        mix = polish / "mix.wav" if (polish / "mix.wav").is_file() else v / "mix.wav"
        stem_dir = polish / "stems" if all((polish / "stems" / f"{s}.wav").is_file() for s in STEMS) else v / "stems"
        stems = {s: f"/motion/bank/music/{(stem_dir / f'{s}.wav').relative_to(SOUND)}" for s in STEMS if (stem_dir / f"{s}.wav").is_file()}
        score = _json(v / "score.json", {}) or {}
        tempo, key = score.get("tempo", {}), score.get("key", {})
        ref = re.sub(r"-m\d+$", "", member.name)
        out.append({
            "id": member.name, "reference": ref, "version": v.name, "polished": mix.parent == polish,
            "mix": f"/motion/bank/music/{mix.relative_to(SOUND)}", "stems": stems,
            "bpm": round(float(tempo.get("bpm") or 0), 2), "key": key.get("name", ""), "duration": float(tempo.get("duration") or 0),
            "fidelity": _fidelity(v), "variations": var.get(member.name) or var.get("_default", []),
        })
    return {"music": out, "count": len(out), "root": str(SOUND)}


def _cut(src: Path, dst: Path, a: float, b: float) -> bool:
    """One event of an isolated SFX layer, written once as 16 bit WAV with 5 ms fades (soundfile, no resampling)."""
    import numpy as np
    import soundfile as sf
    if dst.is_file():
        return True
    info = sf.info(str(src))
    s0, s1 = max(0, int(a * info.samplerate)), min(info.frames, int(b * info.samplerate))
    if s1 - s0 < info.samplerate * 0.02:
        return False
    x, sr = sf.read(str(src), start=s0, stop=s1, dtype="float32", always_2d=True)
    f = min(len(x) // 4, int(sr * 0.005))
    if f > 0:
        ramp = np.linspace(0, 1, f, dtype="float32")[:, None]
        x[:f] *= ramp
        x[-f:] *= ramp[::-1]
    dst.parent.mkdir(parents=True, exist_ok=True)
    tmp = dst.with_suffix(".part.wav")
    sf.write(str(tmp), x, sr, subtype="PCM_16")
    tmp.replace(dst)
    return True


def sfx_bank() -> dict:
    """The isolated effects of every reference, by kind. Cut once (a cut file is reused), so a later call costs a directory listing."""
    items = []
    for member in sorted(SOUND.iterdir()) if SOUND.is_dir() else []:
        vs = [v for v in sorted(member.glob("V_*"), key=_vkey) if (v / "events.json").is_file() and (v / "sfx.wav").is_file()]
        if not vs:
            continue
        v = vs[-1]
        ev = _json(v / "events.json", {}) or {}
        for e in (ev.get("events") if isinstance(ev, dict) else ev) or []:
            kind = str(e.get("kind") or "other")
            a, b = float(e.get("windowStart", e.get("t", 0))), float(e.get("windowEnd", float(e.get("t", 0)) + 0.4))
            name = f"{member.name}/{v.name}-{e.get('id', len(items))}-{kind}.wav"
            if _cut(v / "sfx.wav", BANK / "sfx" / name, a, b):
                items.append({"id": f"{member.name}:{e.get('id')}", "kind": kind, "reference": re.sub(r"-m\d+$", "", member.name),
                              "duration": round(b - a, 3), "url": f"/motion/bank/sfx/{name}"})
    for blk in sorted(SYNTH.iterdir()) if SYNTH.is_dir() else []:
        if (blk / "demo.wav").is_file():
            items.append({"id": f"synth:{blk.name}", "kind": "synth", "reference": "sound-bank", "name": blk.name,
                          "url": f"/motion/bank/synth/{blk.name}/demo.wav"})
    kinds: dict = {}
    for it in items:
        kinds[it["kind"]] = kinds.get(it["kind"], 0) + 1
    return {"sfx": items, "count": len(items), "kinds": kinds}


def excerpt(src: Path, a: float, b: float) -> bytes:
    """[a, b] seconds of a WAV as 16 bit WAV bytes (b = 0: to the end). Read by slice, so a 3 minute stem costs only what is asked."""
    import io
    import soundfile as sf
    info = sf.info(str(src))
    s0 = max(0, min(info.frames, int(a * info.samplerate)))
    s1 = info.frames if b <= 0 else max(s0, min(info.frames, int(b * info.samplerate)))
    x, sr = sf.read(str(src), start=s0, stop=s1, dtype="float32", always_2d=True)
    buf = io.BytesIO()
    sf.write(buf, x, sr, subtype="PCM_16", format="WAV")
    return buf.getvalue()


def reference_video(slug: str) -> Path | None:
    if not SAFE.match(slug or ""):
        return None
    d = REFCACHE / slug
    vids = sorted([p for p in d.glob("*") if p.suffix.lower() in VIDEO_EXT and p.is_file()], key=lambda p: -p.stat().st_size) if d.is_dir() else []
    return vids[0] if vids else None


def references() -> list:
    """The measured references (bible.json), with their video and their reproduced musics."""
    out, music = [], {m["id"]: m for m in music_bank()["music"]}
    for d in sorted(REFERENCES.iterdir()) if REFERENCES.is_dir() else []:
        bible = d / "bible.json"
        if not bible.is_file() or re.search(r"-m\d+$", d.name):
            continue
        b = _json(bible, {}) or {}
        shots = b.get("shots") or []
        out.append({"slug": d.name, "shots": len(shots), "duration": round(max([float(x.get("end", 0)) for x in shots] or [0]), 2),
                    "video": bool(reference_video(d.name)), "musics": sorted(k for k, m in music.items() if m["reference"] == d.name)})
    return out


def bank_file(kind: str, rel: str) -> Path:
    """A file of a bank, refused outside its root (no '..', no absolute path)."""
    roots = {"music": SOUND, "sfx": BANK / "sfx", "synth": SYNTH}
    if kind == "ref":
        p = reference_video(rel)
        if not p:
            raise FileNotFoundError(rel)
        return p
    root = roots.get(kind)
    if not root:
        raise FileNotFoundError(kind)
    p = (root / rel).resolve()
    if not str(p).startswith(str(root.resolve()) + os.sep) or not p.is_file():
        raise FileNotFoundError(rel)
    return p


# ---------------------------------------------------------------------------------------------------- gallery pictures (15 October 2026)
def _cache(*parts) -> Path:
    p = BANK.joinpath("gallery", *parts)
    p.parent.mkdir(parents=True, exist_ok=True)
    return p


def video_thumb(src: Path, key: str, at: float = 1.0, width: int = 480) -> Path:
    """A JPEG frame of a video, made once (ffmpeg) and kept in the bank's gallery cache."""
    import subprocess
    out = _cache("thumbs", re.sub(r"[^A-Za-z0-9._-]+", "-", key) + ".jpg")
    if not out.is_file() or out.stat().st_mtime < src.stat().st_mtime:
        tmp = out.with_suffix(".part.jpg")
        subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", str(at), "-i", str(src), "-frames:v", "1", "-vf", f"scale={width}:-2", "-q:v", "4", str(tmp)],
                       check=True, timeout=60)
        tmp.replace(out)
    return out


def reference_thumb(slug: str) -> Path:
    src = reference_video(slug)
    if not src:
        raise FileNotFoundError(slug)
    return video_thumb(src, "ref-" + slug, at=min(3.0, 1.0))


def waveform(track_id: str, w: int = 600, h: int = 90) -> Path:
    """A PNG waveform of a reproduced music (its final mix), made once."""
    import numpy as np
    import soundfile as sf
    from PIL import Image, ImageDraw
    m = next((x for x in music_bank()["music"] if x["id"] == track_id), None)
    if not m:
        raise FileNotFoundError(track_id)
    src = bank_file("music", m["mix"].split("/motion/bank/music/", 1)[1])
    out = _cache("waves", re.sub(r"[^A-Za-z0-9._-]+", "-", track_id) + ".png")
    if not out.is_file() or out.stat().st_mtime < src.stat().st_mtime:
        x, _ = sf.read(str(src), dtype="float32", always_2d=True)
        x = np.abs(x).max(1)
        cols = np.array_split(x, w)
        # the energy of each column (RMS), not its peak: a loud master would otherwise draw a full block
        peak = np.array([np.sqrt(np.mean(np.square(c))) if len(c) else 0 for c in cols])
        peak = peak / max(1e-6, np.percentile(peak, 99))
        peak = np.clip(peak, 0, 1)
        img = Image.new("RGBA", (w, h), (0, 0, 0, 0))
        d = ImageDraw.Draw(img)
        for i, v in enumerate(peak):
            hh = max(1, v * (h - 4) / 2)
            d.line([(i, h / 2 - hh), (i, h / 2 + hh)], fill=(226, 85, 47, 255))
        tmp = out.with_suffix(".part.png")
        img.save(tmp)
        tmp.replace(out)
    return out
