their overlay, the full A-Z alphabet and the title typed with the font. One self-contained HTML with live sliders (the font parameters), written next to the traced data.
Run with /Users/zenray/.venvs/zenray-motion/bin/python -I. Usage: ZhongKuiFontSheet.py [--out FILE]"""
import argparse, base64, io, json
from PIL import Image

ROOT = "/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayMotionDesign"
TR = "/Users/zenray/.claude/tmp/tmp-zenray-motion-design/zhongkui-font"
STILL = "/Users/zenray/.claude/tmp/tmp-zenray-motion-design-refcache/_stills/still-zhong-kui.png"
ORIGIN = {"Z": (468, 222, 582, 350), "H": (598, 226, 708, 350), "O": (732, 222, 862, 350), "N": (880, 226, 992, 350), "G": (1008, 222, 1128, 350), "K": (606, 364, 714, 490), "U": (742, 364, 856, 490), "I": (910, 364, 966, 490)}
CAPTOP = {"Z": 236, "H": 236, "O": 236, "N": 236, "G": 236, "K": 374, "U": 374, "I": 374}

def b64(im):
    b = io.BytesIO(); im.save(b, "PNG"); return "data:image/png;base64," + base64.b64encode(b.getvalue()).decode()

def main():
    ap = argparse.ArgumentParser(); ap.add_argument("--out", default=TR + "/FontSheet.html"); a = ap.parse_args()
    traced = json.load(open(TR + "/traced.json")); iou = json.load(open(TR + "/iou.json"))
    still = Image.open(STILL).convert("RGB"); crops = {k: b64(still.crop(b)) for k, b in ORIGIN.items()}
    title = b64(still.crop((440, 215, 1150, 500)))
    def frame(p): return b64(Image.open(p).convert("RGB").crop((0, 139, 1920, 941)).resize((960, 401), Image.LANCZOS))
    subref = b64(still.crop((495, 338, 1095, 376)).resize((1320, 84), Image.LANCZOS))
    frames = {"ref": b64(still.resize((960, 401), Image.LANCZOS)), "font": frame("/tmp/zk_frame_font.png"), "dec": frame("/tmp/zk_frame_dec.png")}
    lib = open(ROOT + "/motion/runtime/zs-templates-brushfont-1.js").read()
    data = {"traced": traced, "origin": ORIGIN, "captop": CAPTOP, "iou": iou, "crops": crops, "title": title, "frames": frames, "subref": subref}
    html = HTML.replace("/*LIB*/", lib).replace("/*DATA*/", json.dumps(data))
    open(a.out, "w").write(html); print(a.out, len(html) // 1024, "KiB")

