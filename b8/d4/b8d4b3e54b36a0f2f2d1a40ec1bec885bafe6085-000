<script>/*LIB*/</script>
<script>
const D=/*DATA*/, F=window.ZSBrushFont, NS="http://www.w3.org/2000/svg", RED="#c9484c";
const PARAMS=[["width","Épaisseur du trait",12,6,22,.5],["taper","Effilage de la fin",.55,0,1,.01],["flare","Attaque du pinceau",.12,0,.5,.01],["wobble","Tremblement",0,0,4,.1],["slant","Inclinaison (°)",0,-20,20,.5],["tracking","Espacement",24,0,50,1],["rough","Rugosité du bord",1.2,0,10,.1],["seed","Graine",1,1,99,1],["cap","Hauteur de capitale (px)",103,60,160,1]];
const V={};PARAMS.forEach(p=>V[p[0]]=p[2]);const panel=document.getElementById("panel");
PARAMS.forEach(([k,l,d,mn,mx,st])=>{const lab=document.createElement("label");lab.innerHTML=`<b><span>${l}</span><span id="v_${k}">${d}</span></b><input type="range" min="${mn}" max="${mx}" step="${st}" value="${d}">`;lab.querySelector("input").oninput=e=>{V[k]=+e.target.value;document.getElementById("v_"+k).textContent=V[k];draw()};panel.appendChild(lab)});
const btn=document.createElement("button");btn.textContent="Copier les valeurs";btn.onclick=()=>navigator.clipboard&&navigator.clipboard.writeText(document.getElementById("vals").textContent);panel.appendChild(btn);
const el=(t,a,p)=>{const e=document.createElementNS(NS,t);for(const k in a||{})e.setAttribute(k,a[k]);if(p)p.appendChild(e);return e};
function roughFilter(svg,id){const d=el("defs",{},svg),f=el("filter",{id,x:"-10%",y:"-10%",width:"120%",height:"120%"},d);el("feTurbulence",{type:"fractalNoise",baseFrequency:"0.07",numOctaves:2,seed:V.seed},f);el("feDisplacementMap",{in:"SourceGraphic",scale:V.rough},f);return V.rough>0?`url(#${id})`:null}
const KERN={UI:38};const opts=()=>({kern:KERN,width:V.width,taper:V.taper,flare:V.flare,wobble:V.wobble,slant:V.slant,tracking:V.tracking,seed:V.seed,cap:V.cap});
function glyphPaths(ch,ox,oy){const r=F.layout(ch,Object.assign(opts(),{tracking:0}));return r.polygons.map(p=>F.toPath(p.poly,ox,oy))}
function draw(){
  const rows=document.getElementById("rows");rows.innerHTML="";
  Object.keys(D.origin).forEach(k=>{const [x0,y0,x1,y1]=D.origin[k],w=x1-x0,h=y1-y0,bb=D.traced[k].bbox,kk=V.cap/100;
    const row=document.createElement("div");row.className="row";row.innerHTML=`<div class="k">${k}</div>`;rows.appendChild(row);
    const cell=(t,s)=>{const c=document.createElement("div");c.className="cell";c.innerHTML=`<span class="t">${t}</span>${s||""}`;row.appendChild(c);return c};
    const c1=cell("référence");const im=new Image();im.src=D.crops[k];c1.appendChild(im);
    const mk=(c)=>el("svg",{viewBox:`0 0 ${w} ${h}`},c);
    const ox=bb[0]-x0-8*kk,oy=D.captop[k]-y0;
    const c2=cell("décalque");const s2=mk(c2);el("path",{d:D.traced[k].d.replace(/(-?[\d.]+),(-?[\d.]+)/g,(m,a,b)=>(a-x0).toFixed(2)+","+(b-y0).toFixed(2)),fill:RED},s2);
    const c3=cell("police","<span class='s'>iou "+D.iou[k]+"</span>");const s3=mk(c3);const flt=roughFilter(s3,"r"+k);const g3=el("g",flt?{filter:flt}:{},s3);glyphPaths(k,ox,oy).forEach(d=>el("path",{d,fill:RED},g3));
    const c4=cell("superposition");const s4=mk(c4);el("path",{d:D.traced[k].d.replace(/(-?[\d.]+),(-?[\d.]+)/g,(m,a,b)=>(a-x0).toFixed(2)+","+(b-y0).toFixed(2)),fill:"#ff5050",opacity:.85},s4);const g4=el("g",{style:"mix-blend-mode:screen"},s4);glyphPaths(k,ox,oy).forEach(d=>el("path",{d,fill:"#4aa0ff",opacity:.85},g4));
  });
  // title composed
  document.getElementById("titleRef").src=D.title;document.getElementById("subRef").src=D.subref;document.getElementById("fr0").src=D.frames.ref;document.getElementById("fr1").src=D.frames.font;document.getElementById("fr2").src=D.frames.dec;
  const T=document.getElementById("titleTrace");T.innerHTML="";T.setAttribute("viewBox","440 215 710 285");Object.keys(D.origin).forEach(k=>el("path",{d:D.traced[k].d,fill:RED},T));
  const TF=document.getElementById("titleFont");TF.innerHTML="";TF.setAttribute("viewBox","440 215 710 285");const f2=roughFilter(TF,"rt");const gg=el("g",f2?{filter:f2}:{},TF);
  const line=(text,cx,top)=>{const r=F.layout(text,opts()),sx=cx-r.width/2;r.polygons.forEach(p=>el("path",{d:F.toPath(p.poly,sx,top),fill:RED},gg))};
  line("ZHONG",798,236);line("KUI",780,374);
  // alphabet
  const A=document.getElementById("alpha");A.innerHTML="";const measured="ZHONGKUI";
  F.alphabet.split("").forEach(ch=>{const c=document.createElement("div");c.className="cell";const r=F.layout(ch,Object.assign(opts(),{tracking:0})),pad=24;const s=el("svg",{viewBox:`0 -${pad} ${r.width+pad*2} ${V.cap+pad*2}`},c);const fl=roughFilter(s,"a"+ch);const g=el("g",fl?{filter:fl}:{},s);r.polygons.forEach(p=>el("path",{d:F.toPath(p.poly,pad,0),fill:RED},g));
    const tg=document.createElement("span");tg.className="tag";tg.textContent=ch+(measured.includes(ch)?"  mesurée":"  dessinée");c.appendChild(tg);A.appendChild(c)});
  { const sv=document.getElementById("subFont");sv.innerHTML="";sv.setAttribute("viewBox","0 0 1320 84");const k=2.2,pos=[505,558,610,665,719,undefined,859,929,997,1062].map(x=>x===undefined?undefined:(x-495)*k);
    const r=F.layout("BLACK MYTH",{width:V.width,taper:V.taper,flare:V.flare,cap:18*k,style:"fine",positions:pos,tracking:200});const gs=el("g",{},sv);r.polygons.forEach(p=>el("path",{d:F.toPath(p.poly,0,(349-338)*k),fill:RED},gs)); }
  freeDraw();
  document.getElementById("vals").textContent=JSON.stringify(V,null,1);
}
function freeDraw(){const s=document.getElementById("freeSvg");s.innerHTML="";const r=F.layout(document.getElementById("free").value,opts());s.setAttribute("viewBox",`-20 -20 ${r.width+40} ${V.cap+60}`);const fl=roughFilter(s,"rf");const g=el("g",fl?{filter:fl}:{},s);r.polygons.forEach(p=>el("path",{d:F.toPath(p.poly,0,0),fill:RED},g))}
document.getElementById("free").oninput=freeDraw;draw();
</script></body></html>'''
