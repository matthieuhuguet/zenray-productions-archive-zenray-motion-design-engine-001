// 12 October 2026: Gaussian light sweep band across the frame along an angle (animate 'position' for a shine pass). Colour block for add or screen.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: color (sRGB 0..1), angle (degrees (0 = left to right, 90 = top to bottom)), position (ramp position), width (ramp units), intensity (gain).
float light_sweep_axis(vec2 uv, float angle) {
  float a = radians(angle);
  vec2 dir = vec2(cos(a), sin(a));
  return 0.5 + dot(uv - 0.5, dir) / (abs(dir.x) + abs(dir.y));
}
vec4 light_sweep(vec2 uv, vec3 color, float angle, float position, float width, float intensity) {
  float t = light_sweep_axis(uv, angle);
  float d = t - position;
  float g = intensity * exp(-d * d / (2.0 * width * width));
  return vec4(clamp(color * g, 0.0, 1.0), 1.0);
}
