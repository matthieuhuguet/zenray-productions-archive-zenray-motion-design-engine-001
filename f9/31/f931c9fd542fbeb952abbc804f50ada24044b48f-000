"""Christopher Nolan collection 01 (TOKYO): wide extended heavy capitals, cream, widely tracked, in front of the scene (18 October 2026). Native still 2000 x 1250 (the picture sits between two black bars).
The letters are cream (about 201,194,180) over a sky that is warmer: they are separated by the BLUE channel, the contour is then refined on it. Run: /Users/zenray/.venvs/zenray-motion/bin/python -I Scripts/CardNolan.py"""
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import numpy as np
from scipy import ndimage as ndi
import CardTrace as C

img, A = C.load("nolan"); H, W = A.shape[:2]; R, G, B = A[..., 0], A[..., 1], A[..., 2]
box = lambda *a: C.box_mask((H, W), *a)  # noqa: E731
mask = ndi.binary_opening((B >= 160) & (R - B < 42) & box(480, 520, 1540, 700), iterations=2)
Bs = ndi.gaussian_filter(B.astype(float), 1.3)
cream = C.color_of(A, ndi.binary_erosion(mask, iterations=3))
tokyo = C.glyphs_of(mask, Bs, box(480, 520, 1540, 700), list("TOKYO"), mincontrast=20.0, minpx=1000, band=3, sigma=0.8, closing=3, opening=2, plain=(105, 185))
lines = [C.line_data("l1", "TOKYO", "wide", 0, tokyo, "center", {"w": 1.15, "sw": 0.2, "c": 0.12})]
C.emit("nolan", W, H, {"main": cream, "second": cream}, lines, note="TOKYO.", alpha={"wide": "nolan-wide"})
