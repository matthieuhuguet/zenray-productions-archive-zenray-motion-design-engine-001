import numpy as np

U32 = np.uint32


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)
EPS = 0.000731


def render(params, u, v):
    q = params
    dy = v - q['horizon']
    below = (dy > 0.0)[..., None]
    t = np.clip(dy / max(1.0 - q['horizon'], 1e-4), 0.0, 1.0)[..., None]
    floor = _v(q['c_floor_top']) + (_v(q['c_floor_bottom']) - _v(q['c_floor_top'])) * t
    bw = q['blur'] * dy + 0.002
    ry = 1.0 - _ss(q['refl_height'] - bw, q['refl_height'] + bw, dy)
    dx = np.abs(u - q['refl_x'][0]) * q['aspect']
    hw = q['refl_x'][1] * q['aspect']
    rx = 1.0 - _ss(hw - bw, hw + bw, dx)
    refl = _v(q['refl_color']) * (q['strength'] * np.exp(-dy / q['falloff']) * ry * rx)[..., None]
    col = np.where(below, floor + refl, np.ones(dy.shape + (3,)) * _v(q['c_sky']))
    return np.clip(col, 0.0, 1.0) * 255.0
