"""Measure a camera by finding one fixed element in every frame, at every scale (15 October 2026).

A crop of a reference frame (the anchor: a title, a logo, a button) is searched in each frame by normalised cross-correlation over a
range of scales; the best match gives the scale of the camera relative to the anchor frame and the anchor's position. Robust where a
global tracker fails because the rest of the picture changes (a preview playing inside a window).
FR : mesurer une camera en retrouvant un element fixe dans chaque image, a toutes les echelles.
Usage: python3 Scripts/TrackAnchor.py <video> --anchor-time 11.6 --box x0,y0,x1,y1 --from 11 --to 27 [--fps 10] [--smin 0.8 --smax 1.8]
Box and positions in pixels of a 1920x1080 frame. Prints JSON lines {t, s, x, y, score}: x, y = top-left of the anchor in the frame.
"""
import argparse
import json
import subprocess

import cv2
import numpy as np


def frames(video, t0, t1, fps, w, h):
    raw = subprocess.run(["ffmpeg", "-v", "error", "-ss", f"{t0:.3f}", "-to", f"{t1:.3f}", "-i", video, "-vf", f"fps={fps},scale={w}:{h}",
                          "-f", "rawvideo", "-pix_fmt", "gray", "-"], capture_output=True, check=True).stdout
    return np.frombuffer(raw, np.uint8).reshape(-1, h, w)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("video"); ap.add_argument("--anchor-time", type=float, required=True); ap.add_argument("--box", required=True)
    ap.add_argument("--from", dest="t0", type=float, required=True); ap.add_argument("--to", dest="t1", type=float, required=True)
    ap.add_argument("--fps", type=float, default=10); ap.add_argument("--smin", type=float, default=0.8); ap.add_argument("--smax", type=float, default=1.8)
    a = ap.parse_args()
    W, H = 1920, 1080
    ref = frames(a.video, a.anchor_time, a.anchor_time + 0.04, 30, W, H)[0]
    x0, y0, x1, y1 = (int(v) for v in a.box.split(","))
    tpl = ref[y0:y1, x0:x1]
    F = frames(a.video, a.t0, a.t1, a.fps, W, H)
    for i, f in enumerate(F):
        best = (-1, 1, 0, 0)
        for s in np.arange(a.smin, a.smax + 1e-9, 0.02):
            t = cv2.resize(tpl, None, fx=s, fy=s, interpolation=cv2.INTER_AREA if s < 1 else cv2.INTER_CUBIC)
            if t.shape[0] >= H or t.shape[1] >= W:
                continue
            r = cv2.matchTemplate(f, t, cv2.TM_CCOEFF_NORMED)
            _, mv, _, ml = cv2.minMaxLoc(r)
            if mv > best[0]:
                best = (mv, s, ml[0], ml[1])
        sc, s, x, y = best
        for s2 in np.arange(s - 0.02, s + 0.021, 0.004):         # refine the scale
            t = cv2.resize(tpl, None, fx=s2, fy=s2, interpolation=cv2.INTER_CUBIC)
            if t.shape[0] >= H or t.shape[1] >= W:
                continue
            r = cv2.matchTemplate(f, t, cv2.TM_CCOEFF_NORMED)
            _, mv, _, ml = cv2.minMaxLoc(r)
            if mv > sc:
                sc, s, x, y = mv, s2, ml[0], ml[1]
        print(json.dumps({"t": round(a.t0 + i / a.fps, 3), "s": round(float(s), 4), "x": int(x), "y": int(y), "score": round(float(sc), 3)}))


if __name__ == "__main__":
    main()
