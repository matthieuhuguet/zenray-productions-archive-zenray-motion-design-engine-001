  const PALETTES = { "Rouge vif": [1, 0.07, 0.1], "Vert": [0.12, 1, 0.28], "Turquoise": [0.02, 0.92, 0.88], "Jaune": [1, 0.86, 0.04], "Magenta": [1, 0.08, 0.78] };
