#!/usr/bin/env python3
# 14 October 2026: spectral trim of a music bench for ANY reference (zrmd/audio/trim.py). Every stem (drums, bass, other, vocals) is
# calibrated against its reference stem at several resolutions; only when EVERY stem passes the gate (its worst spec, train or audit, at the
# target) is the final mix trimmed too (Matthieu, 14 October 2026: the final mix comes after, never before, every cut is right). Audit specs
# are never optimised: they are what the 99.9 claim stands on. The result is a NEW bench version (never overwritten): trimmed stems,
# a mix, params.json, scores.json, trim.json with every number, and the ear checks (cleanliness) of the mix before and after.
#   MusicTrim.py --slug claude-opus-5-5 [--from V_NNN] [--force-mix]
# 14 October 2026: the version also gets calibration.npz (and params.json["calibration"]): the calibration as numbers, replayable without the
# reference by ResynthMusic.py render --params <version>/params.json and moved with the tempo by ResynthMusic.py variation.
# Exit 0 when the version was written (the gate result is in the JSON and in trim.json, never hidden), 1 on a failure.
# FR : calibration spectrale du banc musical d'une reference ; le mixage final seulement si chaque piste passe la porte.
from __future__ import annotations

import argparse
import json
import os
import sys
import time
from pathlib import Path

import numpy as np

ENGINE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ENGINE))
sys.path.insert(0, str(ENGINE / "Scripts"))
import MusicRun  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--slug", required=True)
    ap.add_argument("--from", dest="base", default="")
    ap.add_argument("--force-mix", action="store_true", help="trim the final mix even when a stem is below the gate (reported as such)")
    a = ap.parse_args()
    MusicRun.ensure_stems(a.slug)
    os.environ["ZRMD_RESYNTH_OVERRIDES"] = MusicRun.env_for(a.slug)["ZRMD_RESYNTH_OVERRIDES"]
    import ResynthMusic as RM
    from zrmd import registry
    from zrmd.audio import earcheck, resynth as RS, trim as T
    P = RS.params()
    sr = P["sampleRate"]
    bench = Path(P["paths"]["bench"])
    best = registry._music_state(a.slug)["best"]
    base = a.base or (best["version"] if best else None)
    if not base:
        print(json.dumps({"ok": False, "error": f"no scored bench version for {a.slug}: build the music first"}))
        return 1
    ref = RS.load_reference(P)
    c = T.cfg()
    target = c["targets"]
    prm = json.loads((bench / base / "params.json").read_text(encoding="utf-8"))
    # a trim always starts from the RAW chain version: gains stack when a trim is trimmed again (the cumulative cap is measured from the base)
    while prm.get("trim", {}).get("base") and (bench / prm["trim"]["base"] / "params.json").exists():
        base = prm["trim"]["base"]
        prm = json.loads((bench / base / "params.json").read_text(encoding="utf-8"))
    score = json.loads((bench / base / "score.json").read_text(encoding="utf-8"))
    t0 = time.time()
    # the four stems are independent: one process each, side by side (the mix waits for them, it is built from the trimmed stems)
    jobs = {stem: (np.asarray(ref["stems"][stem]), RS._read(bench / base / "stems" / f"{stem}.wav", sr)) for stem in c["targets"]["gateStems"]}
    done = T.trim_parallel(jobs, sr, c, workers=int(c.get("workers", 4)), calibration=True)
    stems = {k: done[k][0] for k in jobs}
    reports = {k: done[k][1] for k in jobs}
    cals = {k: done[k][2] for k in jobs}
    stems_gate = {k: v["gateCritic"] for k, v in reports.items()}
    stems_audit = {k: v["auditMean"] for k, v in reports.items()}
    stems_ok = all(g >= target["stem"] for g in stems_gate.values())
    # the bus of the base version (fitted on the base stems) puts the trimmed stems back into one mix
    mix_raw = RS.apply_mix_bus(stems, prm.get("mixBus"), sr, P)
    ref_mix = np.asarray(ref["mix"])
    # 14 October 2026: the mix is always trimmed so there is something to listen to; it is a FINAL mix only when every stem passed the gate
    # (mixFinal), otherwise it is a preview and the report says so. FR : le mix est toujours calibre, "final" seulement si chaque piste passe.
    mix_final = stems_ok
    mix, mix_rep, mix_cal = T.trim_calibrated(ref_mix, mix_raw, sr, c)
    mix_gate = mix_rep["gateCritic"]
    out = {"stems": stems, "mix": mix}
    rows = RS.score_all(ref, out, score, P, RM.ref_analysis(P, ref))
    d = RM.next_version(bench)
    # 14 October 2026: the calibration as PARAMETERS (zrmd/audio/calibration.py): numbers next to params.json, so a re-render of this version, or a
    # variation of it, keeps the 99.9 calibration without the reference. FR : la calibration finale rangee en parametres.
    from zrmd.audio import calibration as CAL
    blk = CAL.save(d / CAL.FILE_NAME, {**cals, "mix": mix_cal}, {"slug": a.slug, "base": base, "date": "14 October 2026"})
    prm["calibration"] = {**blk, "version": d.name, "base": base}
    prm["trim"] = {"base": base, "date": time.strftime("%Y-%m-%d"), "stemsGate": stems_gate, "stemsAuditMean": stems_audit, "stemsOk": stems_ok, "mixFinal": mix_final, "mixGate": mix_gate, "mixAuditMean": mix_rep["auditMean"],
                   "params": {k: c[k] for k in ("iterations", "strength", "maxBoostDb", "maxCutDb", "train", "audit")}}
    clean = {"before": earcheck.cleanliness(np.asarray(RS._read(bench / base / "mix.wav", sr)), sr), "after": earcheck.cleanliness(mix, sr)}
    RM.write_version(d, prm, score, out, rows, {"kind": "music-trim", "stage": "trim", "parent": base, "stemsOk": stems_ok, "mixFinal": mix_final,
                                                "seconds": round(time.time() - t0, 1)}, P)
    (d / "trim.json").write_text(json.dumps({"stems": reports, "mix": mix_rep, "cleanliness": clean, "targets": target}, indent=1, default=float) + "\n", encoding="utf-8")
    print(json.dumps({"ok": True, "slug": a.slug, "version": d.name, "base": base, "stemsGate": stems_gate, "stemsAuditMean": stems_audit, "stemsOk": stems_ok,
                      "mixFinal": mix_final, "mixGate": mix_gate, "mixAuditMean": mix_rep["auditMean"], "seconds": round(time.time() - t0, 1)}), flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
