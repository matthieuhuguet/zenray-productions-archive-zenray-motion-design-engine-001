"""Zoomed reference | render pairs of the Sony reveal (23 October 2026). Usage: SonyCrop.py <frames dir of the render (frame-<t>.png)> out.png t1 t2 ... [--box x0,y0,w,h]  FR : paires zoomees reference | rendu."""
import sys
from PIL import Image, ImageDraw
d, out, *ts = sys.argv[1:]
box = (480, 320, 420, 160)
if "--box" in ts:
    i = ts.index("--box"); box = tuple(int(v) for v in ts[i + 1].split(",")); ts = ts[:i]
ts = [float(t) for t in ts]; x0, y0, w, h = box
S = Image.new("RGB", (w * 4, h * 2 * len(ts)), (0, 0, 0)); dr = ImageDraw.Draw(S)
for i, t in enumerate(ts):
    r = Image.open(f"/Users/zenray/.claude/tmp/tmp-zenray-motion-design/trailer-PjJ5VYkdgXI/frames/{int(round(t * 30)) + 1:04d}.png").convert("RGB").crop((x0, y0, x0 + w, y0 + h)).resize((w * 2, h * 2), Image.LANCZOS)
    m = Image.open(f"{d}/frame-{t:.2f}.png").convert("RGB").resize((1280, 720), Image.LANCZOS).crop((x0, y0, x0 + w, y0 + h)).resize((w * 2, h * 2), Image.LANCZOS)
    S.paste(r, (0, i * h * 2)); S.paste(m, (w * 2, i * h * 2)); dr.text((4, i * h * 2 + 4), f"ref {t}s", fill=(255, 255, 0)); dr.text((w * 2 + 4, i * h * 2 + 4), "render", fill=(255, 255, 0))
S.save(out); print(out, S.size)
