#!/usr/bin/env python3
"""Reference against its vector keyframes, side by side (16 October 2026).
For the given shots, at N instants of each: the reference picture (left) and the SVG keyframe on screen at that instant, rasterised
(right), with the measured share of pixels within the tolerance. Reads the traced shots of the project of the reference.
Usage: VectorSheet.py <slug> S06,S08 [--n 3] [--width 480] [--out PATH]
FR : la reference et ses images cles vectorielles, cote a cote, aux memes instants."""
import argparse
import json
import sys
from pathlib import Path

import cv2
import numpy as np

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / "motion"))
import htmlvec as H  # noqa: E402
import banks  # noqa: E402
import server  # noqa: E402


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("slug")
    ap.add_argument("shots")
    ap.add_argument("--n", type=int, default=3)
    ap.add_argument("--width", type=int, default=480)
    ap.add_argument("--out", default="")
    a = ap.parse_args()
    assets = server.project_dir(f"{a.slug}-motion") / "assets"
    video = str(banks.reference_video(a.slug))
    rows = []
    for sid in a.shots.split(","):
        m = json.loads((assets / f"{sid}.json").read_text())
        for j in range(a.n):
            t = m["start"] + (m["duration"] * (j + 0.5) / a.n)
            rel = t - m["start"]
            k = max((k for k in m["keys"] if k["t"] <= rel + 1e-6), key=lambda k: k["t"], default=m["keys"][0])
            ref = H.grab(video, t, a.width)
            h, w = ref.shape[:2]
            ras = H.render_svg((assets / k["file"]).read_text(), w, h)
            if ras is None:
                ras = np.zeros_like(ref)
            sh = H.rendered_share(ras, ref)
            tag = f"{sid} t={t:.2f} key@{k['t']:.2f} share {sh['share']:.2f} dE {sh['meanDeltaE']:.1f}"
            cv2.putText(ref, tag, (6, 18), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 2, cv2.LINE_AA)
            cv2.putText(ref, tag, (6, 18), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 0), 1, cv2.LINE_AA)
            rows.append(np.hstack([ref, ras]))
    out = Path(a.out) if a.out else Path.home() / ".claude/tmp/tmp-zenray-motion-design-refcache" / a.slug / f"vsheet-{a.shots.replace(',', '_')}.jpg"
    cv2.imwrite(str(out), np.vstack(rows), [cv2.IMWRITE_JPEG_QUALITY, 88])
    print(out)


if __name__ == "__main__":
    main()
