  "host": "127.0.0.1",
  "port": 3105,
  "clientHeader": "x-zr-studio-client",
  "clientValue": "1",
  "renderTimeoutS": 900
 },
 "paths": {
  "scratch": "{workshop}/studio"
 },
 "referenceUnreachable": "/nonexistent",
