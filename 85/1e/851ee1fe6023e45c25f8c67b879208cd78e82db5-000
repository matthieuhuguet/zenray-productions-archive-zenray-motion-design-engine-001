  // ------------------------------------------------------------------ live miniatures (15 October 2026)
  // A scene alone, built into a small stage with the reference footage hidden: frozen on a meaningful frame, played in a loop under
  // the mouse. Built only when the card scrolls into view, so a gallery of hundreds of animations stays light.
  const isMotion = (sc) => {
    if (sc.template === "media-text") { const pa = sc.params || {}; return (pa.style || "sous-titre") !== "aucun" && !!(pa.text || pa.text2); }
    return sc.template !== "media-showcase";
  };
  // 16 October 2026: the miniatures stay light however many cards there are. A card is built only near the screen, one build per frame
  // (the page never freezes), and torn down again once it is far away (its timeline and its DOM are freed), so memory does not grow
  // while scrolling. A build in "thumb" mode never loads more than one picture of a vector scene.
  const buildQueue = [];
  let pumping = false;
  const pump = () => {
    if (pumping) return;
    pumping = true;
    const step = () => {
      const job = buildQueue.shift();
      if (job) job();
      if (buildQueue.length) requestAnimationFrame(step); else pumping = false;
    };
    requestAnimationFrame(step);
  };
  const observer = new IntersectionObserver((entries) => entries.forEach((e) => {
    const pic = e.target;
    if (e.isIntersecting) {
      if (pic.zsWanted) return;
      pic.zsWanted = true;
      buildQueue.push(() => { if (pic.zsWanted && pic.zsBuild) pic.zsBuild(); });
      pump();
    } else {
      pic.zsWanted = false;
      if (pic.zsTear) pic.zsTear();
    }
  }), { rootMargin: "400px" });
  const REST = (built) => Math.min(built.duration * 0.6, Math.max(0.5, built.duration - 0.3));
  function mini(pic, project, w) {
    const [W, H] = ZS.size(project), k = w / W;
    pic.style.background = "#0f0f0e";
    const inner = el("div", "");
    inner.style.cssText = `position:absolute;left:0;top:0;width:${W}px;height:${H}px;transform:scale(${k});transform-origin:0 0;pointer-events:none`;
    pic.appendChild(inner);
    let built = null;
    pic.zsBuild = () => {
      if (built) return;
      inner.style.transform = `scale(${(pic.clientWidth || w) / W})`;   // the card's real width
      const keep = window.__timelines && window.__timelines.main;
      try { built = ZS.build(project, inner, { hideRefs: true, thumb: true, assetBase: project.__assetBase || "" }); } catch (e) { inner.textContent = e.message; return; }
      if (window.__timelines) window.__timelines.main = keep;
      built.tl.seek(REST(built), false);
      document.fonts && document.fonts.ready.then(() => { if (built) ZS.refit(built); });
    };
    pic.zsTear = () => {
      if (!built) return;
      try { built.tl.kill(); } catch (e) { /* already gone */ }
      inner.innerHTML = ""; built = null;
    };
    observer.observe(pic);
    const card = pic.closest(".card") || pic;
    // 18 October 2026: the hover player (hoverplay.js). The pointer plays the animation in a loop from its beginning; space pauses and plays (it goes on from where it stopped), the arrows move by one image,
    // a held arrow scrolls fast; leaving stops it on the resting frame. A seek by key suppresses the events, so the loop never restarts under the arrows.
    let fresh = false;
    const adapter = {
      stopOnLeave: true,
      play() { pic.zsBuild(); if (!built) return; built.tl.eventCallback("onComplete", () => built && built.tl.restart()); if (fresh) { fresh = false; built.tl.restart(); } else built.tl.play(); },
      pause() { if (built) built.tl.pause(); },
      playing() { return !!built && !built.tl.paused(); },
      time() { return built ? built.tl.time() : 0; },
      duration() { return built ? built.duration : 0; },
      seek(t) { if (built) built.tl.seek(t, true); },
      fps() { return Number(project.fps) || 30; },
    };
    const rest = () => { if (built) { built.tl.pause(); built.tl.seek(REST(built), false); } };
    if (window.ZSHover) window.ZSHover.attach(card, adapter, { hudHost: pic, onEnter() { fresh = true; pic.zsBuild(); }, onLeave: rest });
    else {
      card.addEventListener("mouseenter", () => { pic.zsBuild(); if (built) { built.tl.eventCallback("onComplete", () => built && built.tl.restart()); built.tl.restart(); } });
      card.addEventListener("mouseleave", rest);
    }
  }
  const one = (project, scene) => ({ ...project, scenes: [{ ...JSON.parse(JSON.stringify(scene)), id: "g" }], __assetBase: `/motion/files/${project.id}/` });

  let renderToken = 0;   // a new render of the Animations page stops the packets of the previous one
  async function anim(body) {
    const { projects: list } = await A().api("GET", "/api/motion/projects");
    const full = await Promise.all(list.map((p) => A().api("GET", `/api/motion/projects/${p.id}`).then((j) => j.project).catch(() => null)));
    const items = [];
    full.filter(Boolean).forEach((pr) => pr.scenes.forEach((sc, i) => {
      if (isMotion(sc)) items.push({ pr, sc, i, k: null, start: pr.scenes.slice(0, i).reduce((a, x) => a + Number(x.duration || 0), 0) });
      (sc.children || []).forEach((c, k) => items.push({ pr, sc: c, i, k, start: pr.scenes.slice(0, i).reduce((a, x) => a + Number(x.duration || 0), 0) + (Number(c.start) || 0) }));
    }));
    const labelOf = (id) => (ZS.templates[id] || {}).label || id;
    head(body, "Animations", `${items.length} animations reproduites, une par carte, plan d'origine masqué. Survole une carte pour la jouer, clique pour l'ouvrir dans l'éditeur à cet instant.`);
    const f1 = el("div", "filters"), f2 = el("div", "filters");
    const projs = [...new Set(items.map((x) => x.pr.id))], tpls = [...new Set(items.map((x) => x.sc.template))];
    [["", "Toutes les vidéos"], ...projs.map((id) => [id, (full.find((p) => p && p.id === id) || {}).title || id])].forEach(([v, l]) => {
      const n = v ? items.filter((x) => x.pr.id === v).length : items.length;
      const b = btn(`${l} · ${n}`, () => { G.proj = v; render(); }); if (G.proj === v) b.className = "on"; f1.appendChild(b);
    });
    [["", "Tous les effets"], ...tpls.map((t) => [t, labelOf(t)])].forEach(([v, l]) => {
      const n = items.filter((x) => (!G.proj || x.pr.id === G.proj) && (!v || x.sc.template === v)).length;
      if (v && !n) return;
      const b = btn(`${l} · ${n}`, () => { G.tpl = v; render(); }); if (G.tpl === v) b.className = "on"; f2.appendChild(b);
    });
    body.append(f1, f2);
    const grid = el("div", "cards");
    const shown = items.filter((x) => (!G.proj || x.pr.id === G.proj) && (!G.tpl || x.sc.template === G.tpl));
    // the cards arrive by packets, one packet per frame: hundreds of cards never block the page
    const PACKET = 48, token = ++renderToken;
    let at = 0;
    const fill = () => {
      if (token !== renderToken) return;
      shown.slice(at, at + PACKET).forEach(addCard);
      at += PACKET;
      if (at < shown.length) requestAnimationFrame(fill);
    };
    const addCard = (x) => {
      const c = el("div", "card"), pic = el("div", "pic");
      const pa = x.sc.params || {}, word = pa.text || pa.title || pa.word || pa.prompt || pa.name || pa.sentence || pa.tokens || "";
      const b = el("div", "body");
      b.appendChild(el("div", "title", A().esc(labelOf(x.sc.template) + (word ? " · " + String(word).split("\n")[0] : ""))));
      b.appendChild(el("div", "meta", `${A().esc(x.pr.title || x.pr.id)} · ${x.start.toFixed(1)} s · ${Number(x.sc.duration).toFixed(1)} s${x.k != null ? " · sous-scène" : ""}`));
      c.append(pic, b); grid.appendChild(c);
      mini(pic, one(x.pr, x.sc), 280);
      c.onclick = async () => {
        await A().openProject(x.pr.id);
        const S = A().S; S.sel = x.i; S.child = x.k; window.ZS_MODE("edit"); A().renderScenes(); A().setTab("scene"); A().renderTrack(); A().seek(x.start + Math.min(0.6, Number(x.sc.duration) / 2));
      };
    };
    body.appendChild(grid);
    fill();
  }

  async function models(body) {
    const S = A().S, groups = {};
    Object.values(ZS.templates).forEach((t) => { (groups[t.group || "Autres"] = groups[t.group || "Autres"] || []).push(t); });
    head(body, "Modèles", `${Object.keys(ZS.templates).length} modèles, joués avec leurs valeurs par défaut. Survole pour voir l'animation ; « Ajouter » l'insère après la scène choisie.`);
    Object.entries(groups).forEach(([g, ts]) => {
      body.appendChild(el("p", "sub", `<b>${A().esc(g)}</b>`));
      const grid = el("div", "cards");
      ts.forEach((t) => {
        const c = el("div", "card"), pic = el("div", "pic"), b = el("div", "body");
        b.appendChild(el("div", "title", A().esc(t.label)));
        b.appendChild(el("div", "meta", `${t.params.length} valeurs · ${t.duration} s par défaut`));
        const acts = el("div", "acts");
        acts.appendChild(btn("Ajouter au projet", () => {
          A().change((p) => { p.scenes.splice(S.sel + 1, 0, { id: "s" + Date.now().toString(36), template: t.id, duration: t.duration || 3, params: {} }); S.sel = S.sel + 1; S.child = null; });
          window.ZS_MODE("edit"); A().toast(`« ${t.label} » ajouté après la scène ${S.sel}`);
        }));
        b.appendChild(acts); c.append(pic, b); grid.appendChild(c);
        mini(pic, { schema: "zrmd/motion-project@1", format: "16x9", fps: 30, theme: S.project.theme || {}, scenes: [{ id: "m", template: t.id, duration: t.duration || 3, params: {} }] }, 280);
      });
      body.appendChild(grid);
    });
  }

  const SECTIONS = { anim, models, projects, refs, media, music, sfx };
  async function render() {
    if (!A() || !A().S.project) return;
    // a render builds its page apart and shows it only if no newer render started meanwhile (two quick clicks never mix two sections)
    const token = (G.token = (G.token || 0) + 1), host = $("#gbody"), top = host.scrollTop, page = document.createElement("div");
    [...$("#gnav").children].forEach((b) => b.classList.toggle("on", b.dataset.g === G.section));
    try { await SECTIONS[G.section](page); } catch (e) { page.appendChild(el("p", "hint", "Erreur : " + A().esc(e.message))); }
    if (token !== G.token) return;
    host.replaceChildren(page);
    host.scrollTop = top;
  }
  $("#gnav").onclick = (e) => { if (e.target.dataset.g) { G.section = e.target.dataset.g; $("#gbody").scrollTop = 0; render(); } };
  window.ZSGallery = { render };
})();
