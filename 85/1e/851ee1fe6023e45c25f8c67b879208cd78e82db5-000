// ZenRay Motion Design, the gallery of the Motion page (15 October 2026): every project, the 12 reference videos, the media of the open
// project, the 33 musics reproduced at 99.9 % with their variations, and the 226 sound effects, each playable and usable in one click.
// It reads the editor's state and calls the editor's own actions (window.ZS_APP), so a choice made here is undoable and saved like any edit.
// FR : la galerie de la page Motion ; tout se retrouve, s'ecoute et s'utilise en un clic, avec les actions de l'editeur.
(function () {
  "use strict";
  const $ = (q) => document.querySelector(q);
  const A = () => window.ZS_APP;
  const G = { section: "anim", kind: "", cache: {}, proj: "", tpl: "" };
  const CUE_LABELS = { whoosh: "Souffles", pop: "Pops", click: "Clics", type: "Frappe", tick: "Tics", riser: "Montées", impact: "Impacts", shimmer: "Scintillements" };
  let audio = null, playingUrl = "";
  const listen = (url, btn) => {
    if (audio) { audio.pause(); document.querySelectorAll(".playing").forEach((b) => { b.classList.remove("playing"); b.textContent = "▶"; }); }
    if (playingUrl === url) { playingUrl = ""; audio = null; return; }
    audio = new Audio(url); playingUrl = url; audio.play().catch(() => {});
    if (btn) { btn.classList.add("playing"); btn.textContent = "■"; }
