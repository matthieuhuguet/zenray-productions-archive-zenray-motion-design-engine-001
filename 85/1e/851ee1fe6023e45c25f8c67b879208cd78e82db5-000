// 26 October 2026: the shared script of the two galleries (Motion and SFX): the deck (view sliders, theme, body font, copy of the CSS values), the search, the hover play of the sounds and the render of the cards.
// The data come from /api/motion/gallery and /api/motion/gallery/sounds; every number of the view comes from params/gallery.json (view) and is kept in the browser. FR : le script commun des deux galeries.
(function () {
  "use strict";
  const $ = (q, r) => (r || document).querySelector(q), root = document.documentElement;
  const esc = (s) => String(s == null ? "" : s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  const LS = (k, v) => { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } };
  const mmss = (s) => { s = Math.round(s * 10) / 10; return s >= 60 ? `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, "0")}` : `${s.toFixed(s % 1 ? 1 : 0)} s`; };
  const api = async (p) => { const r = await fetch(p), j = await r.json(); if (!j.ok) throw new Error(j.error || r.status); return j; };
  const G = (window.ZSGallery = {});
  G.esc = esc; G.mmss = mmss; G.api = api;

  // ---- the deck: the view values (columns, gap, radius, ratio, fit) as CSS variables, saved in the browser; defaults come from the server (params/gallery.json)
  G.deck = (view, page) => {
    const key = (k) => `zg-${k}`, get = (k, d) => LS(key(k)) || String(d);
    const set = { cols: get("cols", view.columns), gap: get("gap", view.gap), radius: get("radius", view.radius), ratio: get("ratio", view.ratio), fit: get("fit", view.fit), theme: get("theme", view.theme), font: get("font", view.bodyFont) };
    const apply = () => {
      root.style.setProperty("--gal-cols", set.cols); root.style.setProperty("--gal-gap", set.gap + "px"); root.style.setProperty("--gal-radius", set.radius + "px");
      root.style.setProperty("--gal-ratio", set.ratio); root.style.setProperty("--gal-fit", set.fit); root.setAttribute("data-theme", set.theme); root.setAttribute("data-body-font", set.font);
      $("#fGt").classList.toggle("on", set.font !== "literata"); $("#fLit").classList.toggle("on", set.font === "literata");
      [["cols", "#colV", ""], ["gap", "#gapV", "px"], ["radius", "#radV", "px"]].forEach(([k, id, u]) => { $(id).textContent = set[k] + u; });
    };
    const bind = (id, k, ev) => { const e = $(id); e.value = set[k]; e.addEventListener(ev || "input", () => { set[k] = e.value; LS(key(k), set[k]); apply(); }); };
    bind("#colS", "cols"); bind("#gapS", "gap"); bind("#radS", "radius"); bind("#ratioS", "ratio", "change"); bind("#fitS", "fit", "change");
    $("#fGt").onclick = () => { set.font = "gtstandard"; LS(key("font"), set.font); apply(); }; $("#fLit").onclick = () => { set.font = "literata"; LS(key("font"), set.font); apply(); };
    $("#themeB").onclick = () => { set.theme = set.theme === "dark" ? "light" : "dark"; LS(key("theme"), set.theme); apply(); };
    $("#cssB").onclick = () => {
      const css = `:root {\n  --gallery-columns: ${set.cols};\n  --gallery-gap: ${set.gap}px;\n  --gallery-radius: ${set.radius}px;\n  --gallery-image-ratio: ${set.ratio};\n  --gallery-image-fit: ${set.fit};\n  --font-title: 'GT Ultra', sans-serif;\n  --font-num: 'GT Ultra', sans-serif;\n  --font-body: ${set.font === "literata" ? "'Literata', serif" : "'GT Standard L', sans-serif"};\n  --font-ui: 'GT Standard L', sans-serif;\n}`;
      navigator.clipboard.writeText(css).then(() => G.toast("Réglages copiés"));
    };
    apply();
  };
  G.toast = (t) => { const e = $("#toast"); e.textContent = t; e.classList.add("show"); clearTimeout(G.toast.k); G.toast.k = setTimeout(() => e.classList.remove("show"), 2200); };
  G.search = (onChange) => { const s = $("#q"); s.value = LS("zg-q-" + location.pathname) || ""; s.addEventListener("input", () => { LS("zg-q-" + location.pathname, s.value); onChange(s.value.trim().toLowerCase()); }); onChange(s.value.trim().toLowerCase()); };

  // ---- sounds: one audio at a time, a thin scrubber under the media, the waveform drawn once from the decoded file
  let ctx = null, current = null;
  G.playSound = (tile, url) => {
    if (current && current.tile !== tile) { current.audio.pause(); current.tile.classList.remove("is-playing"); }
    if (current && current.tile === tile) { if (current.audio.paused) { current.audio.play(); tile.classList.add("is-playing"); } else { current.audio.pause(); tile.classList.remove("is-playing"); } return; }
    const a = new Audio(url), fill = $(".scrub i", tile); a.addEventListener("timeupdate", () => { if (a.duration) fill.style.width = (100 * a.currentTime / a.duration) + "%"; });
    a.addEventListener("ended", () => { tile.classList.remove("is-playing"); fill.style.width = "0"; current = null; });
    current = { tile, audio: a }; a.play(); tile.classList.add("is-playing");
  };
  G.wave = async (canvas, url) => {
    try {
      ctx = ctx || new (window.AudioContext || window.webkitAudioContext)(); const buf = await ctx.decodeAudioData(await (await fetch(url)).arrayBuffer());
      const w = canvas.width = canvas.clientWidth * 2 || 600, h = canvas.height = canvas.clientHeight * 2 || 340, c = canvas.getContext("2d"), d = buf.getChannelData(0), step = Math.max(1, Math.floor(d.length / w));
      c.clearRect(0, 0, w, h); c.fillStyle = getComputedStyle(root).getPropertyValue("--accent").trim() || "#0a84ff";
      for (let x = 0; x < w; x++) { let mx = 0; for (let i = 0; i < step; i += 8) mx = Math.max(mx, Math.abs(d[x * step + i] || 0)); const bh = Math.max(1, mx * h * 0.9); c.globalAlpha = 0.9; c.fillRect(x, (h - bh) / 2, 1, bh); }
    } catch (e) { console.warn('wave', canvas.dataset.src, e); /* a sound that cannot be decoded keeps an empty frame */ }
  };
  const io = "IntersectionObserver" in window ? new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { io.unobserve(e.target); G.wave(e.target, e.target.dataset.src); } }), { rootMargin: "300px" }) : null;
  G.lazyWave = (canvas) => { if (io) io.observe(canvas); else G.wave(canvas, canvas.dataset.src); };
})();
