        r.appendChild(el("span", "t", `<b>${String(m.n).padStart(3, "0")} ${A().esc(m.title)}</b><small>${A().esc(m.category)} · ${m.tempoBpm ? Math.round(m.tempoBpm) + " bpm · " : ""}${m.duration ? Math.round(m.duration) + " s" : ""}</small>`));
        r.appendChild(btn(on ? "Dans le projet" : "Utiliser", async () => {
          try {
            const blob = await (await fetch(m.url)).blob();
            await A().upload([new File([blob], m.file, { type: "audio/mpeg" })]);
            const name = (A().S.assets.find((a) => a.name.startsWith(m.file.replace(/\.mp3$/, ""))) || {}).name || m.file;
            A().change((p) => { p.music = { mode: "file", file: { file: name } }; });
            A().loadBank(); A().toast("Musique du projet : " + m.title); render();
