  async function sfx(body) {
    const j = await get("sfx", "/api/motion/banks/sfx"), picks = ((A().S.project.sfx || {}).pick) || {};
    head(body, "Effets sonores", `${j.count} effets : ${j.count - (j.kinds.synth || 0)} isolés des références, ${j.kinds.synth || 0} synthétisés. « Assigner » fait jouer cet effet à chaque repère de ce type dans le projet.`);
    if (Object.keys(picks).length) {
      const cur = el("div", "filters");
