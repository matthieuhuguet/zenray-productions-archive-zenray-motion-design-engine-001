        A().change((p) => { delete p.sfx.pick[k]; }); render();
      }, "Retirer cette assignation")));
      body.appendChild(cur);
    }
    const f = el("div", "filters");
    [["", "Tous"], ...Object.entries(j.kinds).sort((a, b) => b[1] - a[1]).map(([k, n]) => [k, `${k} · ${n}`])].forEach(([k, label]) => {
      const b = btn(label, () => { G.kind = k; render(); }); if (G.kind === k) b.className = "on"; f.appendChild(b);
    });
    body.appendChild(f);
    const grid = el("div", "sfxgrid");
    j.sfx.filter((x) => !G.kind || x.kind === G.kind).forEach((x) => {
