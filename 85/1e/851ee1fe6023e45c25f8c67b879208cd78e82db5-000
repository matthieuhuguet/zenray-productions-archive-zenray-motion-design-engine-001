  async function music(body) {
    const j = await get("music", "/api/motion/banks/music"), cur = (A().S.project.music || {});
    // 16 October 2026: the music player (music-player.js): a list, one click plays, a variation chip changes the mix at once on the running music
    body.classList.add("mp-page");
    const vcount = j.music.reduce((n, m) => n + (m.variations || []).length, 0);
    body.appendChild(el("h3", "", "Musiques reproduites"));
    body.appendChild(el("p", "sub", `${j.count} musiques reproduites à 99,9 % depuis les références, ${vcount} variations. Clique une musique pour l'écouter, puis une variation : le mix change tout de suite.`));
    window.ZS_MUSIC.mount(body, {
      music: j.music, current: cur, esc: A().esc,
