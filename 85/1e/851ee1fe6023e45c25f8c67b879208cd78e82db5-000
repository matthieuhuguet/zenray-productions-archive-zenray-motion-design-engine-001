  // the media value of the selected scene (or sub-scene), when its template has one
  const mediaTarget = () => {
    const { S } = A(), sc = S.project.scenes[S.sel], obj = S.child != null && sc.children ? sc.children[S.child] : sc;
    const tpl = ZS.templates[obj && obj.template], d = tpl && tpl.params.find((x) => x.type === "media");
