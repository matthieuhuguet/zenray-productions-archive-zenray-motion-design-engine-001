          const keep = { track: m.id, volume: (p.music.bank || {}).volume ?? -8, offset: (p.music.bank || {}).offset, fadeOut: (p.music.bank || {}).fadeOut };
          p.music.bank = Object.fromEntries(Object.entries(keep).filter(([, x]) => x !== undefined));
          const v = (m.variations || []).find((x) => x.id === vid);
          if (v) Object.assign(p.music.bank, v.values, { variation: v.id });
        });
        A().loadBank(); A().toast(vid ? `« ${m.id} » en variation ${vid}, dans le projet` : "Musique du projet : " + m.id);
      },
    });
    // the audio of the references, stored for editing (local, never published): listen, or put it under the project's film
    const st = j.stored || [];
    if (st.length) {
      body.appendChild(el("h3", "", `Pistes des références rangées pour le montage (${st.length})`));
      body.appendChild(el("p", "hint", "Le son d'origine de chaque vidéo du corpus, gardé en local pour monter dessus. « Utiliser » l'importe dans le projet comme fichier audio."));
      const list = el("div", "mp-stored");
      st.forEach((m) => {
        const on = cur.mode === "file" && (cur.file || {}).file === m.file;
        const r = el("div", "mp-srow" + (on ? " on" : ""));
