      const c = el("div", "sfx" + (used.length ? " on" : ""));
      const pb = btn("▶", (bb) => listen(x.url, bb)); pb.className = "play";
      const info = el("div", "", `<div class="k">${A().esc(x.kind === "synth" ? x.name : x.kind)}${used.length ? " · " + used.join(", ") : ""}</div><div class="src">${A().esc(x.reference)}${x.duration ? " · " + x.duration.toFixed(2) + " s" : ""}</div>`);
      const acts = el("div", "acts"), sel = el("select");
      sel.innerHTML = `<option value="">Assigner à…</option>` + Object.entries(CUE_LABELS).map(([k, l]) => `<option value="${k}">${l}</option>`).join("");
      sel.onchange = () => {
