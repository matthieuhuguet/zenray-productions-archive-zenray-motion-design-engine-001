    document.addEventListener("keydown", E.key);
    body.appendChild(root);
    if (E.track) E.track = tracks.find((x) => x.id === E.track.id) || E.track;
    else { const on = cur.mode === "bank" && tracks.find((x) => x.id === (cur.bank || {}).track); if (on) { E.track = on; E.variation = (cur.bank || {}).variation || ""; } else E.track = tracks[0]; }
    if (E.track) stemsOf(E.track).catch(() => {});          // the first music is decoded while the page is read
    paint();
    return root;
  }
  window.ZS_MUSIC = { mount, engine: E, playTrack, setVariation, toggle, values };
})();
