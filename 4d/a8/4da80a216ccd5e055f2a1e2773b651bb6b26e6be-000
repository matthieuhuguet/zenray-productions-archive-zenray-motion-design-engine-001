  }
  const values = (track, id) => {
    const v = (track.variations || []).find((x) => x.id === id);
    return Object.assign({}, DEF, v ? v.values : {}, { volume: DEF.volume });     // the listening volume is the slider's, not the variation's
  };
  const pos = () => { if (!E.track) return 0; const d = E.track.duration || 30; return ((E.off + (ctx().currentTime - E.t0) * E.rate) % d + d) % d; };

  // the whole mix (one small file) starts the music at once when the four stems are not decoded yet; the stems then take over at the same instant
  const mixOf = (track) => {
