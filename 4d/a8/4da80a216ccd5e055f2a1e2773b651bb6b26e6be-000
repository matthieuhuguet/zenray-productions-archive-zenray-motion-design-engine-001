      E.master = c.createGain(); E.master.connect(c.destination);
      E.rin = c.createGain(); const conv = c.createConvolver(); conv.buffer = ir(c); E.rin.connect(conv); conv.connect(E.master);
    }
    return E.ctx;
  };

  // ------------------------------------------------------------------------------------------------------------- engine
  function stemsOf(track) {
    if (!E.cache.has(track.id)) {
      const c = ctx();
      E.cache.set(track.id, Promise.all(STEMS.filter((s) => track.previews[s]).map(async (s) => {
        const ab = await (await fetch(track.previews[s])).arrayBuffer();
        return [s, await c.decodeAudioData(ab)];
      })).then((o) => { E.ready.add(track.id); return Object.fromEntries(o); }));
      // a decoded track weighs about 40 MB: the cache keeps the last six (the playing one never leaves it)
      while (E.cache.size > 6) { const old = [...E.cache.keys()].find((k) => !E.track || k !== E.track.id); if (!old) break; E.cache.delete(old); E.ready.delete(old); }
    }
    return E.cache.get(track.id);
  }
  function curve(k) { const n = 1024, a = new Float32Array(n); for (let i = 0; i < n; i++) { const x = i / (n - 1) * 2 - 1; a[i] = Math.tanh(k * x) / Math.tanh(k); } return a; }
  let IR = null;
  function ir(c) {
    if (IR) return IR;
    const len = Math.floor(c.sampleRate * 2.6); IR = c.createBuffer(2, len, c.sampleRate);
    for (let ch = 0; ch < 2; ch++) { const d = IR.getChannelData(ch); let r = 12345 + ch * 777; for (let i = 0; i < len; i++) { r = (r * 1664525 + 1013904223) >>> 0; d[i] = ((r / 4294967296) * 2 - 1) * Math.pow(1 - i / len, 3); } }
    return IR;
  }
  // the graph of one playing track; set(values) ramps every value of it
  function graph(bufs) {
    const c = ctx(), G = { src: {}, sg: {} };
    G.out = c.createGain(); G.out.gain.value = 0; G.out.connect(E.master);
    G.bus = c.createGain(); G.split = c.createChannelSplitter(2); G.merge = c.createChannelMerger(2);
    G.ll = c.createGain(); G.lr = c.createGain(); G.rl = c.createGain(); G.rr = c.createGain();
    G.bus.connect(G.split); G.split.connect(G.ll, 0); G.split.connect(G.lr, 0); G.split.connect(G.rl, 1); G.split.connect(G.rr, 1);
    G.ll.connect(G.merge, 0, 0); G.rl.connect(G.merge, 0, 0); G.lr.connect(G.merge, 0, 1); G.rr.connect(G.merge, 0, 1);
    G.lo = c.createBiquadFilter(); G.lo.type = "lowshelf"; G.lo.frequency.value = 250;
    G.hi = c.createBiquadFilter(); G.hi.type = "highshelf"; G.hi.frequency.value = 3000;
    G.hp = c.createBiquadFilter(); G.hp.type = "highpass"; G.hp.Q.value = 0.7;
    G.lp = c.createBiquadFilter(); G.lp.type = "lowpass"; G.lp.Q.value = 0.7;
    G.merge.connect(G.lo); G.lo.connect(G.hi); G.hi.connect(G.hp); G.hp.connect(G.lp);
    G.dry = c.createGain(); G.wet = c.createGain(); G.ws = c.createWaveShaper(); G.ws.curve = curve(8); G.ws.oversample = "2x";
    G.vol = c.createGain();
    G.lp.connect(G.dry); G.lp.connect(G.ws); G.ws.connect(G.wet); G.dry.connect(G.vol); G.wet.connect(G.vol);
    G.rev = c.createGain(); G.lp.connect(G.rev); G.rev.connect(E.rin);
    G.vol.connect(G.out);
    Object.entries(bufs).forEach(([s, b]) => {
      const src = c.createBufferSource(), sg = c.createGain(); src.buffer = b; src.loop = true; src.connect(sg); sg.connect(G.bus);
      G.src[s] = src; G.sg[s] = sg;
    });
    G.set = (v, snap) => {
      const t = c.currentTime, T = snap ? 0.001 : 0.03, S = (p, x) => p.setTargetAtTime(x, t, T);
      STEMS.forEach((s) => { if (G.sg[s]) S(G.sg[s].gain, v[s] <= -59 ? 0 : db(v[s])); });
      S(G.lo.gain, -v.tilt / 2); S(G.hi.gain, v.tilt);
      S(G.hp.frequency, Math.max(20, v.lowCut)); S(G.lp.frequency, Math.min(20000, v.highCut));
      S(G.dry.gain, 1 - 0.7 * v.drive); S(G.wet.gain, 0.7 * v.drive * 0.8); S(G.rev.gain, v.reverb * 0.6 * db(v.volume));
      const w = Math.max(0, v.width), a = (1 + w) / 2, b = (1 - w) / 2;
      S(G.ll.gain, a); S(G.rr.gain, a); S(G.lr.gain, b); S(G.rl.gain, b);
