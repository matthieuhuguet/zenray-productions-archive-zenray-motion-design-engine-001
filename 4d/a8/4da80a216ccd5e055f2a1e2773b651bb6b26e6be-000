    if (!E.cache.has(k)) E.cache.set(k, fetch(track.previews.mix).then((r) => r.arrayBuffer()).then((ab) => ctx().decodeAudioData(ab)).then((b) => ({ mix: b })));
    return E.cache.get(k);
  };
  function launch(track, bufs, from, v) {
    const c = ctx(), old = E.g, G = graph(bufs);
    G.set(v, true); E.rate = Math.pow(2, v.semitones / 12);
    const t = c.currentTime;
    G.out.gain.setValueAtTime(0.0001, t); G.out.gain.linearRampToValueAtTime(1, t + 0.05);
    E.off = from || 0; E.t0 = t; E.g = G; E.playing = true;
    Object.values(G.src).forEach((s) => s.start(t, E.off % (track.duration || 30)));
    if (old) { old.out.gain.cancelScheduledValues(t); old.out.gain.setTargetAtTime(0, t, 0.03); setTimeout(() => { Object.values(old.src).forEach((s) => { try { s.stop(); } catch (e) { /* stopped */ } }); old.out.disconnect(); }, 400); }
    paint(); tick();
  }
  async function playTrack(track, variation, from) {
    const c = ctx(); if (c.state === "suspended") await c.resume();
    E.track = track; E.variation = variation === undefined ? (E.per[track.id] || "") : variation; E.per[track.id] = E.variation;
    paint();
    const my = (E.token = (E.token || 0) + 1);
    // the neighbours are decoded in the background: Up, Down and the next click start at once
    const all = (E.ui && E.ui.tracks) || [], k = all.indexOf(track);
    [all[k + 1], all[k - 1]].forEach((n, i) => n && setTimeout(() => stemsOf(n).catch(() => {}), 600 + i * 400));
    if (E.ready.has(track.id)) { const bufs = await stemsOf(track); if (my === E.token) launch(track, bufs, from, values(track, E.variation)); return; }
    const quick = await mixOf(track);
    if (my !== E.token) return;
    launch(track, quick, from, Object.assign(values(track, E.variation), { drums: 0, bass: 0, other: 0, vocals: 0 }));
    const bufs = await stemsOf(track);
    if (my === E.token) launch(track, bufs, pos(), values(track, E.variation));       // the stems take over at the same position, with the variation of the moment
  }
  function setVariation(id) {
    if (!E.track) return;
    E.variation = id; E.per[E.track.id] = id;
    if (E.g) E.g.set(values(E.track, id), false);       // the running music changes at once: only the values move
    else playTrack(E.track, id);
    paint();
  }
  function toggle() {
    const c = ctx();
    if (!E.track) return;
    if (!E.g) { playTrack(E.track); return; }
    if (E.playing) { E.off = pos(); c.suspend(); E.playing = false; } else { c.resume().then(() => { E.t0 = c.currentTime; E.playing = true; tick(); }); }
    paint();
  }
  function seek(frac) {
    if (!E.track) return;
    const d = E.track.duration || 30;
    if (E.g) { playTrack(E.track, E.variation, frac * d); } else { E.off = frac * d; paint(); }
  }
  function tick() {
    cancelAnimationFrame(E.raf);
    const u = E.ui;
    if (u && u.head && u.root.isConnected) { const f = pos() / (E.track.duration || 30); u.head.style.setProperty("--p", (f * 100).toFixed(2) + "%"); u.time.textContent = `${fmt(pos())} / ${fmt(E.track.duration || 30)}`; }
    if (E.playing) E.raf = requestAnimationFrame(tick);
  }
  const fmt = (s) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;

  // ------------------------------------------------------------------------------------------------------------- interface
  const el = (tag, cls, html) => { const n = document.createElement(tag); if (cls) n.className = cls; if (html !== undefined) n.innerHTML = html; return n; };
  let paint = () => {};

  function mount(body, o) {
    const esc = o.esc, tracks = o.music, cur = o.current || {};
    body.classList.add("mp-body");
    const root = el("div", "mp"), list = el("aside", "mp-list"), main = el("section", "mp-main");
    root.append(list, main);
    const ui = (E.ui = { root, tracks });

    // ---- the list
    const search = el("input"); search.type = "text"; search.placeholder = `Chercher parmi ${tracks.length} musiques…`; search.className = "mp-search";
    const rows = el("div", "mp-rows"); list.append(search, rows);
    const rowEls = new Map();
    const io = "IntersectionObserver" in window ? new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { const w = e.target.querySelector(".w"); if (w && !w.style.backgroundImage) w.style.backgroundImage = `url(/motion/gallery/wave/${encodeURIComponent(e.target.dataset.id)}.png)`; io.unobserve(e.target); } }), { root: rows, rootMargin: "200px" }) : null;
    tracks.forEach((t, i) => {
      const r = el("button", "mp-row"); r.type = "button"; r.dataset.id = t.id;
      r.innerHTML = `<span class="i">${i + 1}</span><span class="t"><b>${esc(t.id)}</b><small>${t.bpm} bpm · ${esc(t.key)}${t.fidelity ? " · " + t.fidelity + " %" : ""}</small></span><span class="w"></span><span class="u"></span>`;
      r.onclick = () => { if (E.track === t && E.g) toggle(); else playTrack(t); };
      r.onmouseenter = () => { stemsOf(t).catch(() => {}); };           // decoded before the click: the music starts at once
      rows.appendChild(r); rowEls.set(t.id, r); io && io.observe(r);
    });
    search.oninput = () => { const q = search.value.trim().toLowerCase(); rowEls.forEach((r, id) => { r.hidden = q && !id.toLowerCase().includes(q); }); };

    // ---- the main part: now playing, transport, variations
    const head = el("div", "mp-head"), time = el("span", "mp-time", "0:00 / 0:30");
    head.innerHTML = `<div class="mp-wave"></div><div class="mp-bar"></div>`;
    head.onclick = (e) => { const b = head.getBoundingClientRect(); seek(Math.max(0, Math.min(1, (e.clientX - b.left) / b.width))); };
    const title = el("div", "mp-title"), meta = el("div", "mp-meta");
    const tr = el("div", "mp-transport");
    const prev = el("button", "round", "⏮"), play = el("button", "round primary", "▶"), next = el("button", "round", "⏭");
    [prev, play, next].forEach((b) => (b.type = "button"));
    const vol = el("input"); vol.type = "range"; vol.min = -30; vol.max = 0; vol.step = 0.5; vol.value = -8; vol.className = "mp-vol"; vol.title = "Volume d'écoute";
    vol.oninput = () => { DEF.volume = Number(vol.value); if (E.track && E.g) E.g.set(values(E.track, E.variation), false); };
    tr.append(prev, play, next, time, el("span", "grow"), el("span", "hint", "Volume"), vol);
    const vlbl = el("div", "mp-lbl"), chips = el("div", "mp-chips"), why = el("div", "mp-why");
    const acts = el("div", "mp-acts"), use = el("button", "primary", "Utiliser dans le projet"); use.type = "button";
    acts.append(use, el("span", "hint", "Espace : lecture · ← → : variation · ↑ ↓ : musique"));
    main.append(title, meta, head, tr, vlbl, chips, why, acts);
    ui.head = head; ui.time = time;

    const idx = () => tracks.findIndex((t) => t === E.track);
    const go = (d) => { const i = Math.max(0, Math.min(tracks.length - 1, (idx() < 0 ? 0 : idx()) + d)); playTrack(tracks[i]); rowEls.get(tracks[i].id).scrollIntoView({ block: "nearest" }); };
    prev.onclick = () => go(-1); next.onclick = () => go(1); play.onclick = () => (E.track ? toggle() : playTrack(tracks[0]));
    use.onclick = () => { if (E.track) o.use(E.track, E.variation, values(E.track, E.variation)); };

    paint = () => {
      if (!root.isConnected) return;
      rowEls.forEach((r, id) => { r.classList.toggle("on", !!E.track && E.track.id === id); r.classList.toggle("playing", !!E.track && E.track.id === id && E.playing); r.querySelector(".u").textContent = cur.mode === "bank" && (cur.bank || {}).track === id ? "dans le projet" : ""; });
      play.textContent = E.playing ? "⏸" : "▶";
      const t = E.track;
      if (!t) { title.innerHTML = "Choisis une musique"; meta.textContent = `${tracks.length} musiques reproduites à 99,9 %. Un clic la joue ; une variation change le mix tout de suite.`; vlbl.textContent = ""; chips.replaceChildren(); why.textContent = ""; use.disabled = true; return; }
      use.disabled = false;
      title.textContent = t.id; meta.textContent = `${t.bpm} bpm · ${t.key} · ${Math.round(t.duration)} s${t.fidelity ? " · fidélité " + t.fidelity + " %" : ""}${t.polished ? " · polie" : ""}`;
      head.firstChild.style.backgroundImage = `url(/motion/gallery/wave/${encodeURIComponent(t.id)}.png)`;
      vlbl.textContent = `${(t.variations || []).length + 1} variations`;
      if (chips.dataset.track !== t.id) {
        chips.dataset.track = t.id; chips.replaceChildren();
        [{ id: "", label: "Original", why: "le mix reproduit, tel quel" }].concat(t.variations || []).forEach((v) => {
          const b = el("button", "chip"); b.type = "button"; b.textContent = v.label; b.dataset.id = v.id; b.title = v.why || ""; b.onclick = () => setVariation(v.id);
          chips.appendChild(b);
        });
      }
      chips.querySelectorAll(".chip").forEach((b) => b.classList.toggle("on", b.dataset.id === E.variation));
      const vv = [{ id: "", why: "le mix reproduit, tel quel" }].concat(t.variations || []).find((x) => x.id === E.variation);
