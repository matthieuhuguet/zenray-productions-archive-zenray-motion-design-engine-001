// ZenRay Motion Design, the music player of the gallery (16 October 2026): the 33 reproduced musics as a list you click, like a streaming app.
// A click plays at once; a variation chip changes the mix IMMEDIATELY on the running music (no reload, the position is kept): the four stems are
// small AAC previews decoded once and mixed live (stem levels, tilt, cuts, reverb, drive, width, pitch), every value ramped over 30 ms.
// Keyboard: Space play and pause, Up and Down the track, Left and Right the variation. FR : le lecteur de musiques ; on clique, ca joue ; une variation change le mix en direct.
(function () {
  "use strict";
  const STEMS = ["drums", "bass", "other", "vocals"];
  const DEF = { drums: 0, bass: 0, other: 0, vocals: 0, tilt: 0, semitones: 0, lowCut: 20, highCut: 20000, reverb: 0, drive: 0, width: 1, volume: -8 };
  const db = (x) => Math.pow(10, x / 20);
  const E = { ctx: null, cache: new Map(), ready: new Set(), g: null, track: null, variation: "", playing: false, t0: 0, off: 0, rate: 1, per: {}, raf: 0, ui: null };
  // one reverb for the whole player, built once (a convolver is slow to prepare: it is never made per track)
  const ctx = () => {
    if (!E.ctx) {
