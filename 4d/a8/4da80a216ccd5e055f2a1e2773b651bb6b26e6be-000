      const rate = Math.pow(2, v.semitones / 12);
      Object.values(G.src).forEach((s) => S(s.playbackRate, rate));
      if (rate !== E.rate && E.playing) { const p = pos(); E.off = p; E.t0 = t; }
      E.rate = rate;
    };
