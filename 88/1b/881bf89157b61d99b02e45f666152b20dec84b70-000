# 23 October 2026: outlines of the Inter capitals at a given weight, written as window.ZSInterFont (SVG paths in font units, y down).
# FR : contours des capitales d'Inter a une graisse donnee. Usage: InterFontData.py [--wght 700]
import argparse, io, json, sys
from fontTools.ttLib import TTFont
from fontTools.varLib import instancer
from fontTools.pens.svgPathPen import SVGPathPen
from fontTools.pens.transformPen import TransformPen

ap = argparse.ArgumentParser()
ap.add_argument("--src", default="/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/public/fonts/InterVariable.woff2")
ap.add_argument("--wght", type=float, default=700)
ap.add_argument("--out", default="motion/runtime/zs-templates-playstation-font-3.js")
a = ap.parse_args()
f = TTFont(a.src)
f = instancer.instantiateVariableFont(f, {"wght": a.wght, "opsz": 32} if "opsz" in [x.axisTag for x in f["fvar"].axes] else {"wght": a.wght})
gs, cmap, hmtx = f.getGlyphSet(), f.getBestCmap(), f["hmtx"]
cap = f["OS/2"].sCapHeight
out = {}
for ch in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
    n = cmap[ord(ch)]
    pen = SVGPathPen(gs, ntos=lambda v: ("%.1f" % v).rstrip("0").rstrip("."))
    gs[n].draw(TransformPen(pen, (1, 0, 0, -1, 0, cap)))
    out[ch] = (hmtx[n][0], pen.getCommands())
# kerning of every capital pair (GPOS, read through raqm at the em size), so that AY, LT, TA... close up like in the real font
from PIL import ImageFont
pf = ImageFont.truetype(a.src, int(f["head"].unitsPerEm))
axes = [x["name"] for x in pf.get_variation_axes()]
pf.set_variation_by_axes([32, a.wght] if len(axes) == 2 else [a.wght])
kern = {}
for x in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
    for y in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
        k = pf.getlength(x + y, features=["kern"]) - pf.getlength(x) - pf.getlength(y)
        if abs(k) >= 1: kern[x + y] = round(k)
js = ["// 23 October 2026: Inter capitals at wght %g (SIL OFL), generated by Scripts/InterFontData.py. upm %d, cap %d, y down, origin = top left of the cap box." % (a.wght, f["head"].unitsPerEm, cap),
      "window.ZSInterFont = { wght: %g, upm: %d, cap: %d, glyphs: {" % (a.wght, f["head"].unitsPerEm, cap)]
js += ['  %s: { w: %d, d: "%s" },' % (k, w, d) for k, (w, d) in out.items()]
js.append("}, kern: " + json.dumps(kern) + " };")
open(a.out, "w").write("\n".join(js) + "\n")
print(a.out, "cap", cap, "Z w", out["Z"][0])
