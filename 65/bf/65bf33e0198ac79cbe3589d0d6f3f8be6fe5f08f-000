// 12 October 2026: Gaussian halo exp(-r^2 / 2 sigma^2), coloured. Colour block for the add blend.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: color (sRGB 0..1), center (uv), sigma (uv (height units)), intensity (gain), aspect (width / height).
vec4 glow_gaussian(vec2 uv, vec3 color, vec2 center, float sigma, float intensity, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float g = intensity * exp(-dot(p, p) / (2.0 * sigma * sigma));
  return vec4(clamp(color * g, 0.0, 1.0), 1.0);
}
