// 12 October 2026: Band along an angle between two edges with smootherstep (6t^5 - 15t^4 + 10t^3) feathers. Mask block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: angle (degrees (0 = left to right, 90 = top to bottom)), edge0 (ramp position), edge1 (ramp position), feather (ramp units).
float ease_smootherstep_band_axis(vec2 uv, float angle) {
  float a = radians(angle);
  vec2 dir = vec2(cos(a), sin(a));
  return 0.5 + dot(uv - 0.5, dir) / (abs(dir.x) + abs(dir.y));
}
vec4 ease_smootherstep_band(vec2 uv, float angle, float edge0, float edge1, float feather) {
  float t = ease_smootherstep_band_axis(uv, angle);
  float e0 = min(edge0, edge1), e1 = max(edge0, edge1);
  float x0 = clamp((t - e0 + feather) / (2.0 * feather), 0.0, 1.0);
  float x1 = clamp((t - e1 + feather) / (2.0 * feather), 0.0, 1.0);
  float s0 = x0 * x0 * x0 * (x0 * (x0 * 6.0 - 15.0) + 10.0);
  float s1 = x1 * x1 * x1 * (x1 * (x1 * 6.0 - 15.0) + 10.0);
  return vec4(1.0, 1.0, 1.0, s0 * (1.0 - s1));
}
