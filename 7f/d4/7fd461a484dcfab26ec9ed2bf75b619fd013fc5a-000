# 12 October 2026: numpy twin of block.glsl (same formula, vectorised). Returns HxWx3 in 0..255 (colour block).
import numpy as np


def render(params, u, v):
    a = np.radians(params["angle"])
    dx, dy = np.cos(a), np.sin(a)
    t = np.clip(0.5 + ((u - 0.5) * dx + (v - 0.5) * dy) / (abs(dx) + abs(dy)), 0.0, 1.0)[..., None]
    c0, c1, c2, c3 = (np.asarray(params[k], dtype=float) for k in ("c0", "c1", "c2", "c3"))
    p1, p2 = min(params["s1"], params["s2"]), max(params["s1"], params["s2"])
    seg0 = c0 + (c1 - c0) * (t / max(p1, 1e-6))
    seg1 = c1 + (c2 - c1) * ((t - p1) / max(p2 - p1, 1e-6))
    seg2 = c2 + (c3 - c2) * ((t - p2) / max(1.0 - p2, 1e-6))
    col = np.where(t < p1, seg0, np.where(t < p2, seg1, seg2))
    return col * 255.0
