"""Contour sizes of the lens flare, reference against the motion (23 October 2026, workflow Premier Plan Mesure).
For each instant it opens the reference frame (ffmpeg, video + offset) and the saved motion frame (CompareReference.py --save-frames), removes the thin streak
(binary opening) and prints the width and height of the L>230, L>200 and L>150 regions and the mean RGB, side by side with their ratio.
FR : tailles des contours de l'eclat, reference contre motion, pour caler les cles de rayon.
Usage: python3 Scripts/FlareProfile.py <video> <offset> <frames dir> t1 t2 ..."""
import subprocess
import sys
import tempfile
from pathlib import Path

import numpy as np
from PIL import Image
from scipy import ndimage as ndi


def contours(path):
    im = np.asarray(Image.open(path).convert("RGB").resize((960, 540))).astype(float)
    L = im.mean(2)
    out = []
    for thr in (230, 200, 150):
        m = ndi.binary_opening(L > thr, iterations=2)
        ys, xs = np.where(m)
        out.append((int((xs.max() - xs.min()) * 2), int((ys.max() - ys.min()) * 2)) if len(xs) else (0, 0))
    return out, im.reshape(-1, 3).mean(0)


def main():
    video, off, frames, times = sys.argv[1], float(sys.argv[2]), Path(sys.argv[3]), sys.argv[4:]
    with tempfile.TemporaryDirectory() as d:
        for t in times:
            ref = Path(d) / "r.png"
            subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", f"{float(t) + off:.3f}", "-i", video, "-frames:v", "1", str(ref)], check=True)
            a, ma = contours(ref)
            b, mb = contours(frames / f"frame-{float(t):.2f}.png")
            ratio = [round(x[0] / max(1, y[0]), 2) for x, y in zip(a, b)]
            print(f"{float(t):.1f} ref {a} mine {b} width ratio ref/mine {ratio} meanRGB ref {ma.round(0)} mine {mb.round(0)}")


if __name__ == "__main__":
    main()
