"""Timing variations of the ZenRay film "Sony then PlayStation" (26 October 2026, Matthieu), workflow Premier Plan Mesure. New copies only: the 14.5 s film is untouched.
Act 1 (the Sony style reveal, 6.5 s of reference time) plays `s1` times faster, act 2 (the PlayStation opening) `s2` times faster, the logo fades out much earlier than the original (fade from `fs`, source time, over `fl` s,
the scene is cut at the end of the fade), and a 0.5 s pulse of red and blue chromatic aberration hits the frame when the ZenRay logo has just come up (4.5 s into act 2, which was the 11th second of the 14.5 s film).
Every number below is a parameter of the variation (`ab_px` and `ab_len` per variant: peak separation and duration of the aberration). FR : variations de rythme du film ZenRay (nouvelles copies) : partie 1 acceleree, partie 2 acceleree, fondu du logo plus tot, impulsion d'aberration chromatique.
Usage: python3 motion/reproductions/zenray_sony_playstation_timing.py [projet ...]"""
import sys

import ppm
import zenray_sony_playstation as BASE

# id, title, s1 (act 1 speed), s2 (act 2 speed)
VARIANTS = {
    "zenray-sony-playstation-a-ppm": {"title": "ZenRay : Sony puis PlayStation, rythme A (10 s)", "s1": 2.0, "s2": 1.0},
    "zenray-sony-playstation-b-ppm": {"title": "ZenRay : Sony puis PlayStation, rythme B (8,5 s)", "s1": 2.0, "s2": 1.25},
    "zenray-sony-playstation-c-ppm": {"title": "ZenRay : Sony puis PlayStation, rythme C (7 s)", "s1": 2.5, "s2": 1.5},
    # D: 6 s in total (it was 5.47 s) and an aberration of 1 s (Matthieu, 26 October 2026: shorter, it cannot be seen); the fade starts at 5.15 s of the film, 0.15 s before the pulse ends
    "zenray-sony-playstation-d-ppm": {"title": "ZenRay : Sony puis PlayStation, rythme D (6 s)", "s1": 3.0, "s2": 2.0, "total": 6.0, "ab_len": 1.0, "fade_from": 5.15},
    # E: D with a shorter and softer aberration (Matthieu, 26 October 2026, after seeing D in his Chrome window: "it stays too long": twice shorter, three times weaker in scaling and offset): 1.0 s -> 0.5 s, 28 px -> 28 / 3 px; the timing, the fade and the 6 s total are those of D
    "zenray-sony-playstation-e-ppm": {"title": "ZenRay : Sony puis PlayStation, rythme E (6 s, aberration douce)", "s1": 3.0, "s2": 2.0, "total": 6.0, "ab_len": 0.5, "ab_px": 28.0 / 3.0, "fade_from": 5.15},
}
ACT1 = BASE.HANDOFF            # reference seconds of act 1 that are played (the word has reached its paper white)
LOGO_UP = 4.5                  # act 2 source time at which the ZenRay logo has just come up (the 11th second of the 14.5 s film)
AB_PX, AB_LEN = 28.0, 0.5      # chromatic aberration pulse: peak separation (px of the 1920 frame; 9 px was invisible in the Validate cards, which show the frame at 0.29 scale) and duration (s of film time)
FADE_START, FADE_LEN = 5.3, 1.3   # act 2 source time: the logo holds 0.8 s after the pulse, then fades out in 1.3 s (the original holds from 4.5 to 6.0 and fades in 2.0 s)
ORIG_FADE = [(6.0, 1), (6.4, 0.944), (6.8, 0.81), (7.2, 0.607), (7.6, 0.327), (7.9, 0.033), (8.0, 0)]   # the shape of the original fade (time, opacity)


def fade_keys(fs: float = FADE_START, fl: float = FADE_LEN) -> list:
    return [f"{fs + (t - 6.0) * fl / 2.0:.3f} | {o}" for t, o in ORIG_FADE]


def build_one(pid: str) -> dict:
    v = VARIANTS[pid]; s1, s2 = v["s1"], v["s2"]
    pr = BASE.build_one(BASE.PID)
    pr["title"] = v["title"]
    pr["controls"] = [c for c in pr["controls"] if c["id"] != "palette"]   # the palette toggle did not work in the app: not in the new copies
    a1, a2 = pr["scenes"]
    a1["params"]["speed"] = s1; a1["duration"] = round(ACT1 / s1, 4)
    d1 = a1["duration"]; fs, fl, ab_len = FADE_START, FADE_LEN, v.get("ab_len", AB_LEN)
    if "total" in v: fs = (v["fade_from"] - d1) * s2; fl = (v["total"] - v["fade_from"]) * s2   # a variant can fix its total length and where the fade starts in the film (seconds of film time)
    a2["params"]["speed"] = s2; a2["params"]["fadeKeys"] = fade_keys(fs, fl); a2["duration"] = round((fs + fl) / s2, 4)
    start = d1 + LOGO_UP / s2
    pr["post"] = {"abPx": round(v.get("ab_px", AB_PX), 3), "abStart": round(start, 3), "abLen": ab_len}
    pr["doc"] = (f"26 October 2026: timing variation of the ZenRay film: act 1 x{s1}, act 2 x{s2}, logo fade from {fs:.2f} s of act 2, "
                 f"chromatic aberration pulse {ab_len} s at {start:.2f} s of the film (workflow Premier Plan Mesuré).")
    return pr


if __name__ == "__main__":
    for pid in sys.argv[1:] or list(VARIANTS):
        out = ppm.run(pid, build_one(pid)); print(out)
