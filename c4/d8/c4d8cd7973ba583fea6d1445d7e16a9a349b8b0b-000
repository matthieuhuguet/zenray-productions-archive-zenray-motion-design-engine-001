"""Trace the SONY wordmark from the resting frame of the Sony logo 2021 reference (23 October 2026), workflow Premier Plan Mesure.
Each letter is a connected component of the text row; its coverage field (white 220 on black) is zoomed x8 (cubic), cut at 0.5 and traced by potrace.
Writes motion/runtime/zs-templates-sony-font-1.js (window.ZSSonyFont): per letter the path, its transform and its box in reference pixels (1280x720), the cap height and the natural gaps.
FR : decalque des lettres de SONY sur l'image de repos de la reference. Usage: python3 Scripts/SonyTrace.py <frame.png>"""
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

import numpy as np
from PIL import Image
from scipy import ndimage

ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / "motion" / "runtime" / "zs-templates-sony-font-1.js"
REGION = (350, 295, 945, 425)   # x0, y0, x1, y1 of the wordmark on the reference (1280x720)
PAPER, K = 220.0, 8
WORD = "SONY"


def main():
    L = np.asarray(Image.open(sys.argv[1]).convert("L")).astype(float)
    x0, y0, x1, y1 = REGION
    reg = L[y0:y1, x0:x1]
    lab, n = ndimage.label(reg > 100)
    boxes = sorted(((sl[1].start + x0, sl[1].stop + x0, sl[0].start + y0, sl[0].stop + y0, i + 1) for i, sl in enumerate(ndimage.find_objects(lab))))
    boxes = [b for b in boxes if b[1] - b[0] > 20]
    if len(boxes) != len(WORD):
        raise SystemExit(f"expected {len(WORD)} letters, found {len(boxes)}: {boxes}")
    letters, glyphs = [], {}
    cap_top = min(b[2] for b in boxes)
    cap = int(np.median([b[3] - b[2] for b, ch in zip(boxes, WORD) if ch in "NY"]))
    for (bx0, bx1, by0, by1, idx), ch in zip(boxes, WORD):
        pad = 3
        crop = L[by0 - pad:by1 + pad, bx0 - pad:bx1 + pad]
        mask = (lab[by0 - y0 - pad:by1 - y0 + pad, bx0 - x0 - pad:bx1 - x0 + pad] > 0)
        cov = np.clip(crop / PAPER, 0, 1) * ndimage.binary_dilation(mask, iterations=3)
        big = ndimage.zoom(cov, K, order=3) > 0.5
        with tempfile.TemporaryDirectory() as d:
            pbm = Path(d) / "g.pbm"
            Image.fromarray((~big * 255).astype("uint8")).convert("1").save(pbm)
            svg = Path(d) / "g.svg"
            subprocess.run(["potrace", str(pbm), "-b", "svg", "-o", str(svg), "-t", "30", "-a", "1.0", "-O", "0.4", "--tight"], check=True)
            text = svg.read_text()
        tr = re.search(r'<g transform="([^"]+)"', text).group(1)
        m = re.match(r"translate\(([-\d.]+),([-\d.]+)\) scale\(([-\d.]+),([-\d.]+)\)", tr)
        a, b = float(m.group(1)), float(m.group(2))
        d_all = " ".join(" ".join(re.findall(r'<path d="([^"]+)"', text)).split())
        vb = re.search(r'viewBox="([^"]+)"', text).group(1).split()
        glyphs[ch] = {"d": d_all, "tf": f"scale({1 / K}) translate({a},{b}) scale(0.1,-0.1)", "w": round(float(vb[2]) / K, 2), "h": round(float(vb[3]) / K, 2)}
        letters.append({"ch": ch, "x": bx0 - boxes[0][0], "top": by0 - cap_top, "w": bx1 - bx0, "h": by1 - by0})
    gaps = [letters[i + 1]["x"] - (letters[i]["x"] + letters[i]["w"]) for i in range(len(letters) - 1)]
    data = {"word": WORD, "cap": cap, "capTop": cap_top, "left": boxes[0][0], "gaps": gaps, "letters": letters, "glyphs": glyphs}
    OUT.write_text("// 23 October 2026: the letters of SONY traced on the Sony logo 2021 reference by Scripts/SonyTrace.py (coverage field, potrace); coordinates in reference pixels (1280x720). FR : lettres decalquees de SONY.\nwindow.ZSSonyFont = " + json.dumps(data, ensure_ascii=False) + ";\n")
    print("wrote", OUT, "cap", cap, "gaps", gaps, [(l["ch"], l["x"], l["w"], l["h"], l["top"]) for l in letters])


if __name__ == "__main__":
    main()
