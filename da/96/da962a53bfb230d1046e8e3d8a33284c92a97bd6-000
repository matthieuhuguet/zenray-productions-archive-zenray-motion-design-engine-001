// 12 October 2026: Two-colour ramp along an angle shaped by an in-out power ease (exponent p). Colour block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: angle (degrees (0 = left to right, 90 = top to bottom)), c0 (sRGB 0..1), c1 (sRGB 0..1), exponent (p).
float ease_power_ramp_axis(vec2 uv, float angle) {
  float a = radians(angle);
  vec2 dir = vec2(cos(a), sin(a));
  return 0.5 + dot(uv - 0.5, dir) / (abs(dir.x) + abs(dir.y));
}
vec4 ease_power_ramp(vec2 uv, float angle, vec3 c0, vec3 c1, float exponent) {
  float t = clamp(ease_power_ramp_axis(uv, angle), 0.0, 1.0);
  float e = t < 0.5 ? 0.5 * pow(2.0 * t, exponent) : 1.0 - 0.5 * pow(2.0 - 2.0 * t, exponent);
  return vec4(mix(c0, c1, e), 1.0);
}
