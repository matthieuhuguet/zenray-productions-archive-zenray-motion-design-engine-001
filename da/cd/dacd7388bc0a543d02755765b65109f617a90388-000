// 12 October 2026: Four-corner bilinear gradient (top left, top right, bottom left, bottom right). Colour block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: c_tl (sRGB 0..1), c_tr (sRGB 0..1), c_bl (sRGB 0..1), c_br (sRGB 0..1).
vec4 bilinear_gradient4(vec2 uv, vec3 c_tl, vec3 c_tr, vec3 c_bl, vec3 c_br) {
  vec3 top = mix(c_tl, c_tr, uv.x), bottom = mix(c_bl, c_br, uv.x);
  return vec4(mix(top, bottom, uv.y), 1.0);
}
