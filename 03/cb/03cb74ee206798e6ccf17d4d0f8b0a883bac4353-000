"""Measure the glowing titles of a sequence on the reference and write their parameters (22 October 2026): start, centre, size (fitted on the width of the real text), colour track by thirds.
Reads MEASURE and SEQUENCES of motion/reproductions/apple_macbook_pro.py, writes motion/reproductions/data/apple_macbook_pro.json.
FR : mesure les titres lumineux d'une sequence et ecrit leurs parametres. Usage: python3 Scripts/AppleMeasure.py <sequence id> [--step 0.1] [--font-weight 500] [--ls -0.012]"""
import argparse
import json
import subprocess
import sys
import tempfile
from pathlib import Path

import numpy as np
from PIL import Image, ImageFilter

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / "motion" / "reproductions")); sys.path.insert(0, str(REPO / "motion")); sys.path.insert(0, str(REPO / "Scripts"))
import apple_macbook_pro as A  # noqa: E402
import banks  # noqa: E402
from RefText import core  # noqa: E402


def text_metrics(text: str, weight: int, ls_em: float) -> tuple:
    """Width of the text at 100 px as the PAGE will lay it out (InterVariable at this weight and letter spacing), measured in the managed browser (Scripts/TextWidth.mjs)."""
    out = subprocess.run(["node", str(REPO / "Scripts" / "TextWidth.mjs"), str(weight), str(ls_em), text], capture_output=True, text=True, check=True).stdout.strip()
    w, dy = out.splitlines()[-1].split(); return float(w), float(dy)   # width at 100 px, ink centre offset below the line box centre (em)


def main() -> None:
    ap = argparse.ArgumentParser(); ap.add_argument("sid"); ap.add_argument("--step", type=float, default=0.1); ap.add_argument("--weight", type=int, default=500); ap.add_argument("--ls", type=float, default=-0.012); ap.add_argument("--lead", type=float, default=0.1); ap.add_argument("--soft", type=float, default=240)
    a = ap.parse_args(); title, start, length, tpl, params = A.SEQUENCES[a.sid]; ref = banks.reference_video(A.SLUG); tmp = Path(tempfile.mkdtemp(prefix="applem-"))
    items, keys, gkeys, pos = [], [], [], []
    for i, it in enumerate(A.MEASURE[a.sid]):
        x0, y0, x1, y1 = [int(v) for v in it["region"].split(",")]; frames, t = [], it["t0"]
        while t <= it["t1"] + 1e-6:   # pass 1: every frame, its bright pixels
            f = tmp / "f.png"; subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", f"{start + t:.3f}", "-i", str(ref), "-frames:v", "1", str(f)], check=True)
            im = np.asarray(Image.open(f).convert("RGB")).astype(float)[y0:y1, x0:x1]; lum = im.mean(2); m = lum > it["thr"]
            if it.get("cyan"):   # a label over a grey machine: only the bluish pixels count
                m = m & (im[:, :, 2] - im[:, :, 0] > it["cyan"])
            if m.sum() >= 30:
                ys, xs = np.where(m); frames.append((t, im, m, (xs.min() + x0, ys.min() + y0, xs.max() + x0, ys.max() + y0), lum.max()))
            t += a.step
        if not frames:
            print("nothing visible for item", i); continue
        lit = [fr for fr in frames if fr[4] >= 245 and fr[0] >= it.get("holdFrom", 0)] or [fr for fr in frames if fr[0] >= it.get("holdFrom", 0)] or frames   # the hold box: the median box of the frames where the title is fully lit
        hb = [int(np.median([fr[3][k] for fr in lit])) for k in range(4)]; first, last = frames[0][0], frames[-1][0]
        wbox = hb[2] - hb[0]; w100, dy = text_metrics(it.get("sizeText", it["text"]), a.weight, a.ls); size = it.get("size") or round(wbox / w100 * 100, 1)
        cx = round((hb[0] + hb[2]) / 2); cy = round((hb[1] + hb[3]) / 2 - dy * size + it.get("dy", 0))   # the ink centre is not the centre of the line box when the text has descenders or no capitals
        SOFT = a.soft; q = lambda x: 1 - (1 - min(1, max(0, x))) ** 2; qp = lambda x: 1 - (1 - min(1, max(0, x))) ** 1.5   # noqa: E731
        # entering edge: the visible right edge of the frames still being revealed, fitted by a start and a duration (visible edge = mask edge + 0.45 of the soft width)
        rise = [(t, (box[2] - hb[0])) for t, im, m, box, pk in frames if box[2] - hb[0] < 0.96 * wbox]
        best = (1e18, max(0.0, first - a.lead), 0.75)
        for s0 in np.arange(max(0.0, first - 0.35), first + 0.001, 0.01):
            for d in np.arange(0.15, 1.6, 0.01):
                err = sum((min(wbox, max(0, -SOFT + (wbox + SOFT) * q((t - s0) / d) + 0.45 * SOFT)) - r) ** 2 for t, r in rise) if rise else 0
                if err < best[0]: best = (err, float(s0), float(d))
        start_t, d_in = best[1], best[2] if rise else 0.4
        # leaving edge: when the left edge of the last frames moves right it is erased from the left (fit of the lead and the duration), else the title is simply cut
        fall = [(t, box[0] - hb[0]) for t, im, m, box, pk in frames if t > last - 1.2]
        erased = fall and fall[-1][1] > 0.08 * wbox and any(l > 0.05 * wbox for t, l in fall)
        d_out, lead_out = 0.0, 0.0; end_t = last + a.step
        if erased:
            bestx = (1e18, 0.9, 0.55)
            for d in np.arange(0.3, 1.6, 0.02):
                for lead in np.arange(0.1, 1.2, 0.02):
                    err = sum((min(wbox, max(0, -SOFT + (wbox + SOFT) * qp((t - (end_t - lead)) / d) + 0.55 * SOFT)) - l) ** 2 for t, l in fall)
                    if err < bestx[0]: bestx = (err, float(d), float(lead))
            d_out, lead_out = bestx[1], bestx[2]
        if it.get("track"):   # a title that moves with the machine: its centre at every measured frame
            # the centre comes from the LEFT edge (the reveal and the erase eat the box from the left or the right, the left edge is stable while the title is being revealed);
            # once the box shrinks from the left (the erase) the last full-width position is kept
            tfull = max(t for t, im, m, box, pk in frames if box[2] - box[0] >= 0.95 * wbox) if any(box[2] - box[0] >= 0.95 * wbox for t, im, m, box, pk in frames) else last
            xl = None
            for t, im, m, box, pk in frames:
                if t <= tfull or xl is None: xl = box[0]
                pos.append(f"{i} | {t - start_t:.2f} | {round(xl + w100 * size / 200)} | {round((box[1] + box[3]) / 2 - dy * size)}")
            cx, cy = [int(v) for v in pos[-len(frames)].split("|")[2:4]]
        start_t = it.get("start", start_t)
        d_in, d_out, lead_out = it.get("dIn", d_in), it.get("dOut", d_out), it.get("outLead", lead_out)   # an item that cannot be fitted (a tiny label) is given its values by hand
        items.append(f"{it['text']} | {cx} | {cy} | {size} | {start_t:.2f} | {end_t:.2f} | {d_in:.2f} | {d_out:.2f} | {lead_out:.2f} | {it.get('glowScale', 1)}")
        for t, im, m, box, pk in frames:   # pass 2: the colour of each third of the FINAL box (a third not yet revealed takes its neighbour's colour)
            cols = []; nc = it.get("cols", 3)
            for k in range(nc):
                lo, hi = hb[0] + wbox * k / nc - x0, hb[0] + wbox * (k + 1) / nc - x0
                sel = m & (np.arange(m.shape[1])[None, :] >= lo) & (np.arange(m.shape[1])[None, :] < hi)
                cols.append("#%02x%02x%02x" % tuple(int(v) for v in core(im, sel)) if sel.sum() >= 40 else (cols[-1] if cols else None))
            for k in range(nc - 2, -1, -1):
                if cols[k] is None and cols[k + 1] is not None: cols[k] = cols[k + 1]
            for k in range(1, nc):
                if cols[k] is None: cols[k] = cols[k - 1]
            if cols[0] is None:   # a title too small for any third to hold enough pixels: the core colour of all its pixels
                cols = ["#%02x%02x%02x" % tuple(int(v) for v in core(im, m))] * nc
            keys.append(f"{i} | {t - start_t:.2f} | " + " | ".join(cols))
            if it.get("glow"):   # the measured halo: the colour of the pixels at 5 to 12 px from the letters, third by third (neon titles: white letters, coloured halo)
                mk = Image.fromarray((m * 255).astype("uint8")); d_out_, d_in_ = np.asarray(mk.filter(ImageFilter.MaxFilter(41))) > 0, np.asarray(mk.filter(ImageFilter.MaxFilter(13))) > 0; ring = d_out_ & ~d_in_; gc = []
                for k in range(nc):
                    lo, hi = hb[0] + wbox * k / nc - x0, hb[0] + wbox * (k + 1) / nc - x0; sel = ring & (np.arange(m.shape[1])[None, :] >= lo) & (np.arange(m.shape[1])[None, :] < hi) & (im.mean(2) > 12)
                    px = im[sel]; top = px[np.argsort(-px.max(1))[: max(1, len(px) // 3)]].mean(0) if sel.sum() >= 40 else None; gc.append("#%02x%02x%02x" % tuple(int(v) for v in top * min(1.8, 255 / max(1, top.max()) * 0.9)) if top is not None else (gc[-1] if gc else None))   # the brightest third of the ring (6 to 20 px), lifted to a saturated colour
                for k in range(nc - 2, -1, -1):
                    if gc[k] is None and gc[k + 1] is not None: gc[k] = gc[k + 1]
                for k in range(1, nc):
                    if gc[k] is None: gc[k] = gc[k - 1]
                gkeys.append(f"{i} | {t - start_t:.2f} | " + " | ".join(c2 or "#000000" for c2 in gc))
        print(f"item {i} {it['text']!r}: visible {first:.2f}..{last:.2f}, hold box {hb}, size {size}, centre {cx},{cy}, dIn {d_in:.2f}, dOut {d_out:.2f} lead {lead_out:.2f}")
    data = json.loads(A.DATA.read_text(encoding="utf-8")) if A.DATA.is_file() else {}
    data.setdefault(a.sid, {"params": {}})["params"].update({"items": items, "keys": keys, "gkeys": gkeys, "pos": pos, "weight": a.weight, "ls": a.ls})
    A.DATA.write_text(json.dumps(data, indent=1, ensure_ascii=False), encoding="utf-8"); print("written", A.DATA)


if __name__ == "__main__":
    main()
