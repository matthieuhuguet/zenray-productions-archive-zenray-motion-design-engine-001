import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def render(params, u, v):
    q = params
    F = (-0.45, -0.2, 0.3, 0.7, 1.4)
    G = (1.6, 0.6, 1.0, 0.4, 2.2)
    asp = q['aspect']
    px, py = u * asp, v
    cx, cy = 0.5 * asp, 0.5
    sx, sy = q['source'][0] * asp, q['source'][1]
    col = np.zeros(u.shape + (3,))
    c = _v(q['color'])
    for k in range(5):
        gx = cx + (cx - sx) * F[k] * q['spread']
        gy = cy + (cy - sy) * F[k] * q['spread']
        r = q['size'] * G[k]
        d = np.hypot(px - gx, py - gy)
        disc = (1.0 - _ss(r - q['soft'], r, d)) * (0.4 + 0.6 * np.minimum(d / r, 1.0))
        tint = c + (c[[1, 2, 0]] - c) * (k / 4.0)
        col += tint * disc[..., None]
    return np.clip(q['intensity'] * col, 0.0, 1.0) * 255.0
