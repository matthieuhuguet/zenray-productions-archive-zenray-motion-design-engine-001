// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
float grade_exposure_saturation_axis(vec2 uv, float angle) {
  float a = radians(angle);
  vec2 dir = vec2(cos(a), sin(a));
  return clamp(0.5 + dot(uv - 0.5, dir) / (abs(dir.x) + abs(dir.y)), 0.0, 1.0);
}
vec3 grade_exposure_saturation_to_lin(vec3 c) {
  c = max(c, 0.0);
  return mix(pow((c + 0.055) / 1.055, vec3(2.4)), c / 12.92, vec3(lessThanEqual(c, vec3(0.04045))));
}
vec3 grade_exposure_saturation_to_srgb(vec3 c) {
  c = clamp(c, 0.0, 1.0);
  return mix(1.055 * pow(max(c, vec3(1e-10)), vec3(1.0 / 2.4)) - 0.055, c * 12.92, vec3(lessThanEqual(c, vec3(0.0031308))));
}
// 12 October 2026: the grading operator, reusable on any sRGB colour.
vec3 grade_exposure_saturation_apply(vec3 x, float exposure, float contrast, float pivot, float saturation) {
  vec3 s = grade_exposure_saturation_to_srgb(grade_exposure_saturation_to_lin(x) * exp2(exposure));
  s = (s - pivot) * contrast + pivot;
  float L = dot(s, vec3(0.2126, 0.7152, 0.0722));
  return clamp(mix(vec3(L), s, saturation), 0.0, 1.0);
}
vec4 grade_exposure_saturation(vec2 uv, float angle, vec3 c0, vec3 c1, float exposure, float contrast, float pivot, float saturation) {
  vec3 x = mix(c0, c1, grade_exposure_saturation_axis(uv, angle));
  return vec4(grade_exposure_saturation_apply(x, exposure, contrast, pivot, saturation), 1.0);
}
