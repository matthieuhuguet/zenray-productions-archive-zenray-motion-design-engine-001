/* 15 October 2026: the few rules every template shares; everything else is set from parameters. FR : regles communes aux modeles. */
.zs-scene { box-sizing: border-box; }
.zs-scene * { box-sizing: border-box; }
.zs-mask { display: inline-block; overflow: hidden; vertical-align: bottom; padding: 0.06em 0.02em 0.14em; margin: -0.06em -0.02em -0.14em; }
.zs-word { display: inline-block; will-change: transform; }
.zs-abs { position: absolute; }
.zs-center { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); }
.zs-pill { display: inline-block; border-radius: 0.28em; padding: 0.02em 0.22em 0.08em; }
.zs-panel { position: absolute; border-radius: 18px; box-shadow: 0 1px 0 rgba(0,0,0,0.04), 0 10px 40px -18px rgba(0,0,0,0.18); }
.zs-chip { display: inline-flex; align-items: center; gap: 0.4em; border-radius: 999px; padding: 0.25em 0.75em; }
video.zs-media, img.zs-media { width: 100%; height: 100%; display: block; }
