"""Compare a motion project with its reference video, image by image (15 October 2026).

The motion project is cooked exactly as for the export (same page, same fonts), HyperFrames captures it at the given instants,
ffmpeg takes the reference at the same instants, and one sheet puts them side by side (reference left, motion right), with the
measured difference of each pair. This is the verification of a reproduction: nothing is judged from memory.
FR : comparer un projet Motion a sa video de reference, aux memes instants, sur une planche cote a cote, avec l'ecart mesure.

Usage: python3 Scripts/CompareReference.py <project-id> --at 0.8,1.5,3 [--out DIR] [--width 640]
       python3 Scripts/CompareReference.py <project-id> --from 0 --to 4 --step 0.5
Prints JSON: per instant the mean absolute difference (0-255, grey, 160x90) and the sheet path.
"""
import argparse
import json
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

import numpy as np
from PIL import Image, ImageDraw, ImageFont

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / "motion"))
import banks  # noqa: E402
import server  # noqa: E402


def grab(video: Path, t: float, w: int, h: int) -> Image.Image:
    raw = subprocess.run(["ffmpeg", "-v", "error", "-ss", f"{t:.3f}", "-i", str(video), "-frames:v", "1", "-vf", f"scale={w}:{h}",
                          "-f", "rawvideo", "-pix_fmt", "rgb24", "-"], capture_output=True, check=True).stdout
    return Image.frombytes("RGB", (w, h), raw)


def diff(a: Image.Image, b: Image.Image) -> float:
    x = np.asarray(a.convert("L").resize((160, 90)), float)
    y = np.asarray(b.convert("L").resize((160, 90)), float)
    return round(float(np.abs(x - y).mean()), 2)


def inkbox(img: Image.Image, zone: str, bg: str):
    """Ink box [left, top, right, bottom] of a zone, in 1920x1080 pixels, and its ink share; None when the zone is empty."""
    x0, y0, x1, y1 = (float(v) for v in zone.split(","))
    big = np.asarray(img.resize((1920, 1080)), int)
    ref = np.array([int(v) for v in bg.split(",")]) if bg else np.median(big.reshape(-1, 3), axis=0)
    r = big[int(y0):int(y1), int(x0):int(x1)]
    ink = np.abs(r - ref).sum(2) > 60
    if not ink.any():
        return None
    ys, xs = np.where(ink)
    return [int(xs.min() + x0), int(ys.min() + y0), int(xs.max() + x0), int(ys.max() + y0), round(float(ink.mean()), 4)]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("project")
    ap.add_argument("--at", default="")
    ap.add_argument("--from", dest="t0", type=float, default=None)
    ap.add_argument("--to", dest="t1", type=float, default=None)
    ap.add_argument("--step", type=float, default=0.5)
    ap.add_argument("--width", type=int, default=640)
    ap.add_argument("--out", default="")
    ap.add_argument("--regions", default="", help="x0,y0,x1,y1;... in 1920x1080 coordinates: ink box of each zone in both images")
    ap.add_argument("--ref-video", default="", help="compare with this video instead of the project reference (e.g. a rectified child)")
    ap.add_argument("--ref-offset", type=float, default=0.0, help="reference time = project time + offset")
    ap.add_argument("--save-frames", default="", help="copy the rendered motion frames (full size) into this folder, named frame-<t>.png")
    ap.add_argument("--bg", default="", help="background colour r,g,b for the ink measure (default: the median of each image)")
    a = ap.parse_args()
    times = [float(x) for x in a.at.split(",") if x.strip()] if a.at else list(np.round(np.arange(a.t0, a.t1 + 1e-6, a.step), 3))
    p = server.read_project(a.project)
    ref = Path(a.ref_video) if a.ref_video else banks.reference_video(p.get("reference", ""))
    if not ref:
        raise SystemExit(f"no reference video for {a.project}")
    W, H = server.FORMATS[p["format"]]
    out = Path(a.out) if a.out else (server.project_dir(a.project) / "compare")
    out.mkdir(parents=True, exist_ok=True)
    work = Path(tempfile.mkdtemp(prefix="zrmd-compare-"))
    try:
        page = server.cook(a.project, work / "page")
        snaps = work / "snaps"
        r = server.hyperframes(page, "snapshot", "--at", ",".join(f"{t:.3f}" for t in times), "--no-end", "-o", str(snaps), timeout=300)
        files = sorted(snaps.glob("frame-*.png"))
        if len(files) != len(times):
            raise SystemExit(f"HyperFrames gave {len(files)} images for {len(times)} instants: {(r.stderr or r.stdout)[-600:]}")
        if a.save_frames:
            Path(a.save_frames).mkdir(parents=True, exist_ok=True)
            for t, f in zip(times, files):
                shutil.copy(f, Path(a.save_frames) / f"frame-{t:.2f}.png")
        w, h = a.width, round(a.width * H / W)
        font = ImageFont.load_default()
        rows, res = [], []
        for t, f in zip(times, files):
            mine = Image.open(f).convert("RGB").resize((w, h))
            theirs = grab(ref, t + a.ref_offset, w, h)
            d = diff(theirs, mine)
            item = {"t": t, "diff": d}
            if a.regions:
                item["boxes"] = [{"zone": z, "ref": inkbox(theirs, z, a.bg), "motion": inkbox(mine, z, a.bg)} for z in a.regions.split(";")]
            res.append(item)
            row = Image.new("RGB", (2 * w + 6, h + 18), (20, 20, 20))
            row.paste(theirs, (0, 18)); row.paste(mine, (w + 6, 18))
            ImageDraw.Draw(row).text((4, 3), f"{t:.2f} s   reference | motion   diff {d}", fill=(240, 240, 240), font=font)
            rows.append(row)
        sheet = Image.new("RGB", (rows[0].width, sum(r.height for r in rows)), (0, 0, 0))
        y = 0
        for r_ in rows:
            sheet.paste(r_, (0, y)); y += r_.height
        name = out / f"compare-{times[0]:.2f}-{times[-1]:.2f}.png"
        sheet.save(name)
        print(json.dumps({"sheet": str(name), "median": float(np.median([x["diff"] for x in res])), "frames": res}))
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    main()
