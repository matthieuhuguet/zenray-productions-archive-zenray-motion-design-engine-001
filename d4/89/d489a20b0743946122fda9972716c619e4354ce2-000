{
 "schema": "zrmd/image-parameters@1",
 "date": "14 October 2026",
 "_doc": "14 October 2026: the V1 parameter interface of the image (shader) chantier, HDA law, one place. 4 primary, 8 secondary (exposed in V1, at most 8 per category in params/exposed.json recipes.shader-field), 16 tertiary (listed; the ones with built=true already exist as bank block parameters and are not exposed in V1). Keys are dotted paths into a motion version's params.json (look.<id>); defaults are the neutral studio look of zrmd/shaders/look.py and every instance carries its own measured values. Each primary and secondary is proven by tests/test_image_look.py to change the rendered frame, with the GLSL of the same layer list equal to the numpy twin. FR : l'interface de parametres V1 du chantier image ; une seule place.",
 "family": "shader-field",
 "engine": {
  "look": "zrmd/shaders/look.py",
  "fit": "Scripts/ReproduceField.py",
  "exposed": "params/exposed.json (recipes.shader-field)",
  "test": "tests/test_image_look.py",
  "survey": "Scripts/ReproduceFieldSurvey.py",
  "measurement": "params/image-survey.json"
 },
 "limits": {
  "maxPerCategory": 8,
  "primary": 4,
  "secondary": 8,
  "tertiary": 16
 },
 "primary": [
  {
   "id": "colourMain",
   "key": "look.colourMain",
   "label": "Main colour",
   "kind": "color",
   "default": "#0b1630",
   "what": "colour at the start of the gradient axis (the field's main colour)",
   "test": "tests/test_image_look.py::colourMain"
  },
  {
   "id": "colourEnd",
   "key": "look.colourEnd",
   "label": "Gradient end colour",
