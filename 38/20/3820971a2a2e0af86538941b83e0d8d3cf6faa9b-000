<!doctype html>
<html lang="fr" data-theme="dark" data-body-font="gtstandard"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>ZenRay Motion Design · Galerie Motion</title><link rel="stylesheet" href="/motion/web/gallery.css" /></head><body>
<header class="deck"><div class="deck-top">
  <nav class="nav"><a href="/motion/">Éditeur</a><a href="/motion/validate">Validate</a><a class="on" href="/motion/gallery">Galerie Motion</a><a href="/motion/gallery-sfx">Galerie SFX</a><a href="/motion/threads">Threads</a><a href="/motion/previous">Previous Videos</a></nav>
  <div class="actions"><input id="q" class="search" type="search" placeholder="Chercher un film" />
    <div class="seg"><span class="tag">Corps :</span><button id="fGt" class="on" type="button">GT Standard L</button><button id="fLit" type="button">Literata</button></div>
    <button id="themeB" class="btn" type="button">🌓 Thème</button><button id="cssB" class="btn" type="button">📋 Copier CSS</button></div></div>
  <div class="sliders"><div class="g"><label for="colS">Colonnes :</label><input id="colS" type="range" min="2" max="6" step="1" /><span class="v" id="colV"></span></div>
    <div class="g"><label for="gapS">Espacement :</label><input id="gapS" type="range" min="8" max="36" step="2" /><span class="v" id="gapV"></span></div>
    <div class="g"><label for="radS">Arrondi :</label><input id="radS" type="range" min="0" max="24" step="2" /><span class="v" id="radV"></span></div>
    <div class="g"><label for="ratioS">Ratio :</label><select id="ratioS" class="pill"><option value="16 / 9">16 : 9</option><option value="4 / 3">4 : 3</option><option value="1 / 1">1 : 1</option></select></div>
    <div class="g"><label for="fitS">Ajustement :</label><select id="fitS" class="pill"><option value="cover">Cover</option><option value="contain">Contain</option></select></div></div>
</header>
<main class="container"><div class="hero"><div><h1 class="title">Galerie Motion</h1><p class="subtitle">Une seule carte par film : toutes ses variantes (rythmes, formats, copies) sont dedans. Clique une carte pour voir ses versions et les ouvrir dans l'éditeur.</p></div><div class="hero-meta" id="meta"></div></div>
<div class="grid" id="grid"></div></main><div class="toast" id="toast"></div>
<script src="/motion/web/gallery.js"></script>
<script>
(async () => {
  const G = ZSGallery, esc = G.esc, d = await G.api("/api/motion/gallery"); G.deck(d.view);
  const total = d.families.reduce((n, f) => n + f.count, 0);
  document.getElementById("meta").innerHTML = `<span><span class="num">${d.families.length}</span> films</span><span>·</span><span><span class="num">${total}</span> projets regroupés</span>`;
  const grid = document.getElementById("grid");
  const draw = (q) => {
    const list = d.families.filter((f) => !q || (f.title + " " + f.note + " " + f.tags.join(" ") + " " + f.members.map((m) => m.id).join(" ")).toLowerCase().includes(q));
    grid.innerHTML = list.map((f) => {
      const fps = Math.max(...f.members.map((m) => m.fps || 30)), fmts = [...new Set(f.members.map((m) => m.format))].join(" · ").replace(/x/g, ":");
      const dur = f.minDuration === f.maxDuration ? G.mmss(f.maxDuration) : `${G.mmss(f.minDuration)} à ${G.mmss(f.maxDuration)}`;
      return `<article class="tile" data-id="${esc(f.id)}"><div class="media"><img loading="lazy" src="/motion/gallery/poster/${esc(f.poster)}.jpg" alt="${esc(f.title)}" onerror="this.style.opacity=.15">
        <span class="badge num">${f.count} ${f.count > 1 ? "versions" : "version"}</span></div>
        <div class="caption"><div class="caption-title">${esc(f.title)}</div><div class="caption-note">${esc(f.note)}</div>
        <div class="tags"><span class="pill-tag num">${dur}</span><span class="pill-tag num">${fps} FPS</span><span class="pill-tag">${esc(fmts)}</span>${f.clips ? `<span class="pill-tag">${f.clips} SONS</span>` : ""}${f.validated ? `<span class="pill-tag ok">${f.validated} VALIDÉ${f.validated > 1 ? "S" : ""}</span>` : ""}${f.tags.map((t) => `<span class="pill-tag">${esc(t)}</span>`).join("")}</div>
        <div class="members">${f.members.map((m) => `<a class="member" href="#" data-open="${esc(m.id)}"><span>${esc(m.title)}</span><span class="num">${G.mmss(m.duration)}${m.validation === "validated" ? " ✓" : ""}</span></a>`).join("")}</div></div></article>`;
    }).join("") || `<div class="empty">Aucun film ne correspond.</div>`;
  };
  grid.addEventListener("click", (e) => {
    const a = e.target.closest("[data-open]");
    if (a) { e.preventDefault(); try { localStorage.setItem("zs-project", a.dataset.open); localStorage.setItem("zs-mode", "edit"); } catch (x) {} location.href = "/motion/"; return; }
    const t = e.target.closest(".tile"); if (t) t.classList.toggle("open");
  });
  G.search(draw);
})();
</script></body></html>
