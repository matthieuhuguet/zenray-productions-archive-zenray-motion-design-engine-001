import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def render(params, u, v):
    q = params
    r = np.hypot((u - q['center'][0]) * q['aspect'], v - q['center'][1])
    band = []
    for k in range(3):
        rk = q['radius'] * (1.0 + (k - 1.0) * q['dispersion'])
        e = (r - rk) / q['width']
        band.append(np.exp(-e * e))
    return np.clip(q['intensity'] * _v(q['color']) * np.stack(band, axis=-1), 0.0, 1.0) * 255.0
