SCHEMA = "zrmd/asset2d@1"
SHADER_HINTS = {"linear": ["linear_ramp4", "gradient_stops6"], "radial": ["radial_gradient3", "glow_gaussian"],
                "blur:circle": ["blur_disc_gaussian", "bloom_disc"], "blur:rect": ["blur_rect_gaussian", "bloom_rect"],
                "blur:rounded_rect": ["blur_rect_gaussian", "glow_rounded_rect"], "blur:ellipse": ["blur_disc_gaussian"]}


def _cfg() -> dict:
    return settings.get("vector.trace")


def _f(v, digits=4) -> str:
    return f"{round(float(v), digits):g}"


# ---------------------------------------------------------------- cooking params.json into SVG (12 October 2026)

def _resolve(colour: str, palette: dict, css: bool = False) -> str:
    """The colour of a paint: a palette entry '@key' becomes its hex, or var(--key) when `css` (14 October 2026: the HTML component
    names the variable at cook time, so two palette keys that hold the same hex stay two independent parameters)."""
    if colour.startswith("@"):
        key = colour[1:]
        if key not in palette:
            raise KeyError(f"palette has no colour '{key}' (palette: {sorted(palette)})")
        return f"var(--{key})" if css else palette[key]
    return colour


def _paint_defs(layer: dict, palette: dict, css: bool = False) -> tuple[str, str]:
    """(paint reference, defs markup) of a layer paint."""
    p = layer["paint"]
    gid = f"grad-{layer['id']}"
    if p["type"] == "flat":
        return _resolve(p["colour"], palette, css), ""
    stops = "".join(f'<stop offset="{_f(s["offset"], 5)}" stop-color="{_resolve(s["colour"], palette, css)}"/>' for s in p["stops"])
    if p["type"] == "linear":
        d = (f'<linearGradient id="{gid}" gradientUnits="userSpaceOnUse" x1="{_f(p["x1"])}" y1="{_f(p["y1"])}" '
             f'x2="{_f(p["x2"])}" y2="{_f(p["y2"])}">{stops}</linearGradient>')
    elif p["type"] == "radial":
        d = (f'<radialGradient id="{gid}" gradientUnits="userSpaceOnUse" cx="{_f(p["cx"])}" cy="{_f(p["cy"])}" '
             f'r="{_f(p["r"])}">{stops}</radialGradient>')
    else:
        raise ValueError(f"unknown paint type '{p['type']}'")
    return f"url(#{gid})", d


def _arc_d(g: dict) -> str:
    a0 = math.radians(g["start"])
    a1 = math.radians(g["start"] + g["sweep"])
    x0, y0 = g["cx"] + g["r"] * math.cos(a0), g["cy"] + g["r"] * math.sin(a0)
    x1, y1 = g["cx"] + g["r"] * math.cos(a1), g["cy"] + g["r"] * math.sin(a1)
    large = 1 if abs(g["sweep"]) > 180 else 0
    sweep = 1 if g["sweep"] >= 0 else 0
    return f"M{_f(x0)} {_f(y0)}A{_f(g['r'])} {_f(g['r'])} 0 {large} {sweep} {_f(x1)} {_f(y1)}"


def _stroke_d(nodes) -> str:
    parts = []
    for c in nodes:
        c = np.asarray(c, float)
        parts.append(f"M{_f(c[0, 0, 0])} {_f(c[0, 0, 1])}")
        for k in range(len(c) - 1):
            parts.append("C" + " ".join(f"{_f(x)} {_f(y)}" for x, y in (c[k, 1], c[k, 2], c[k + 1, 0])))
    return "".join(parts)


def cook_element(layer: dict, paint: str, stroke_k: float = 1.0, radius_k: float = 1.0) -> str:
    """The SVG element of one layer, with the same geometry semantics as primitives.skia_path. stroke_k scales the stroke widths and
    radius_k the corner radii (the view parameters strokeScale and radiusScale of zrmd/vector/v1.py, 14 October 2026)."""
    k, g = layer["kind"], layer["geometry"]
    if k in P.STROKE_KINDS:
        attrs = (f'fill="none" stroke="{paint}" stroke-width="{_f(g["width"] * stroke_k)}" stroke-linecap="{g.get("cap", "round")}" '
                 f'stroke-linejoin="{g.get("join", "round")}"')
    else:
        attrs = f'fill="{paint}"'
    rot = (f' transform="rotate({_f(g["angle"])} {_f(g["cx"])} {_f(g["cy"])})"'
           if k in ("ellipse", "rect", "rounded_rect") and g.get("angle") else "")
    if k == "circle":
        return f'<circle cx="{_f(g["cx"])}" cy="{_f(g["cy"])}" r="{_f(g["r"])}" {attrs}/>'
    if k == "ellipse":
        return f'<ellipse cx="{_f(g["cx"])}" cy="{_f(g["cy"])}" rx="{_f(g["rx"])}" ry="{_f(g["ry"])}"{rot} {attrs}/>'
    if k in ("rect", "rounded_rect"):
        rr = ""
        if k == "rounded_rect":
            rad = min(max(g["radius"] * radius_k, 0.0), g["w"] / 2, g["h"] / 2)
            rr = f' rx="{_f(rad)}" ry="{_f(rad)}"'
        return (f'<rect x="{_f(g["cx"] - g["w"] / 2)}" y="{_f(g["cy"] - g["h"] / 2)}" width="{_f(g["w"])}" '
                f'height="{_f(g["h"])}"{rr}{rot} {attrs}/>')
    if k == "line":
        return f'<line x1="{_f(g["x1"])}" y1="{_f(g["y1"])}" x2="{_f(g["x2"])}" y2="{_f(g["y2"])}" {attrs}/>'
    if k == "arc":
        if abs(g["sweep"]) >= 359.99:
            return f'<circle cx="{_f(g["cx"])}" cy="{_f(g["cy"])}" r="{_f(g["r"])}" {attrs}/>'
        return f'<path d="{_arc_d(g)}" {attrs}/>'
    if k == "polyline":
        # 12 October 2026: one <polyline> per run, so each run stays an editable list of points.
        return "".join(f'<polyline points="{" ".join(f"{_f(x)},{_f(y)}" for x, y in run)}" {attrs}/>'
                       for run in g["polylines"])
    if k == "stroke_path":
        return f'<path d="{_stroke_d(g["nodes"])}" {attrs}/>'
    if k == "path":
        return f'<path d="{g["d"]}" fill-rule="evenodd" {attrs}/>'
    raise ValueError(f"unknown layer kind '{k}'")


V1_SPEC = Path(__file__).resolve().parents[2] / "params" / "vector-v1-parameters.json"
# 14 October 2026: the defaults of the `view` block live in params/vector-v1-parameters.json, view.defaults (HDA law: one place).
VIEW_DEFAULTS = json.loads(V1_SPEC.read_text(encoding="utf-8"))["view"]["defaults"]


def view_of(params: dict) -> dict:
    """The `view` block of a component with its defaults (zrmd/vector/v1.py): how the whole component is presented, never what it
    is made of. 14 October 2026. FR : la presentation du composant entier."""
    return {**VIEW_DEFAULTS, **{k: v for k, v in (params.get("view") or {}).items() if k in VIEW_DEFAULTS and v is not None}}


def output_size(params: dict) -> tuple[int, int]:
    """Pixel size the cooked SVG declares: the canvas times view.scale (the viewBox stays the canvas, so every coordinate is unchanged)."""
    k = float(view_of(params)["scale"])
    return max(1, int(round(params["canvas"]["width"] * k))), max(1, int(round(params["canvas"]["height"] * k)))


def layer_bbox(layer: dict, pad: float = 0.0) -> tuple[float, float, float, float]:
    """A box (x0, y0, x1, y1) that holds the layer's geometry, padded: exact for ellipses and rectangles (rotation included by the circumscribed
    radius), the hull of every coordinate of a path or a polyline (Bezier control points included, a superset). FR : boite d'un calque."""
    import re
    k, g = layer["kind"], layer["geometry"]
    if k == "circle":
        return g["cx"] - g["r"] - pad, g["cy"] - g["r"] - pad, g["cx"] + g["r"] + pad, g["cy"] + g["r"] + pad
    if k in ("ellipse", "rect", "rounded_rect"):
        r = max(g["rx"], g["ry"]) if k == "ellipse" else math.hypot(g["w"], g["h"]) / 2
        return g["cx"] - r - pad, g["cy"] - r - pad, g["cx"] + r + pad, g["cy"] + r + pad
    if k == "line":
        sw = g.get("width", 0.0) / 2
        return min(g["x1"], g["x2"]) - sw - pad, min(g["y1"], g["y2"]) - sw - pad, max(g["x1"], g["x2"]) + sw + pad, max(g["y1"], g["y2"]) + sw + pad
    if k == "arc":
        r = g["r"] + g.get("width", 0.0) / 2
        return g["cx"] - r - pad, g["cy"] - r - pad, g["cx"] + r + pad, g["cy"] + r + pad
    if k == "polyline":
        pts = [p for run in g["polylines"] for p in run]
    elif k == "stroke_path":
        pts = [p for c in g["nodes"] for node in np.asarray(c, float) for p in node]
    elif k == "path":
        nums = [float(x) for x in re.findall(r"-?\d+(?:\.\d+)?(?:[eE]-?\d+)?", g["d"])]
        pts = list(zip(nums[0::2], nums[1::2]))
    else:
        return 0.0, 0.0, 1e9, 1e9
    xs, ys = [p[0] for p in pts], [p[1] for p in pts]
    sw = g.get("width", 0.0) / 2 if k in P.STROKE_KINDS else 0.0
    return min(xs) - sw - pad, min(ys) - sw - pad, max(xs) + sw + pad, max(ys) + sw + pad


def _adjust_filter(adj: dict, w: int, h: int) -> str:
    """The adjustment layers of the whole stack as ONE SVG filter (hue turn, saturation, brightness and contrast as colour matrices, softness as a
    gaussian blur), or "" when every value is 0 so the file is the traced component to the byte. FR : reglages de l'ensemble du calque."""
    hue, sat = float(adj.get("hue", 0.0)), float(adj.get("saturation", 0.0))
    bri, con, soft = float(adj.get("brightness", 0.0)), float(adj.get("contrast", 0.0)), max(0.0, float(adj.get("softness", 0.0)))
    if not (hue or sat or bri or con or soft):
        return ""
    prims, last = [], "SourceGraphic"

    def add(markup: str, name: str) -> None:
        nonlocal last
        prims.append(markup.replace("{in}", last).replace("{out}", name))
        last = name
    if hue:
        add(f'<feColorMatrix in="{{in}}" type="hueRotate" values="{_f(hue * 180.0)}" result="{{out}}"/>', "hue")
    if sat:
        add(f'<feColorMatrix in="{{in}}" type="saturate" values="{_f(max(0.0, 1.0 + sat))}" result="{{out}}"/>', "sat")
    if bri or con:
        k = max(0.0, 1.0 + con)
        o = 0.5 * (1.0 - k) + 0.5 * bri
        m = f"{_f(k)} 0 0 0 {_f(o)} 0 {_f(k)} 0 0 {_f(o)} 0 0 {_f(k)} 0 {_f(o)} 0 0 0 1 0"
        add(f'<feColorMatrix in="{{in}}" type="matrix" values="{m}" result="{{out}}"/>', "lum")
    if soft:
        add(f'<feGaussianBlur in="{{in}}" stdDeviation="{_f(soft * 8.0)}" result="{{out}}"/>', "soft")
    return f'<filter id="adjust" filterUnits="userSpaceOnUse" x="0" y="0" width="{w}" height="{h}" color-interpolation-filters="sRGB">{"".join(prims)}</filter>'


def cook_svg(params: dict, only: str | None = None, white: bool = False, css_vars: bool = False, live: str = "", view_group: bool = False) -> str:
    """asset.svg from params.json. only=layer id renders that layer alone; white=True paints it opaque white
    (used to measure a layer's coverage). 14 October 2026: `view` (scale, opacity, offset, rotation, flip, transparent background,
    stroke and radius scales) is applied only to the whole component, never to a single-layer measure; css_vars names the palette
    variables (HTML component); `live` is markup (live text elements) placed inside the view group so it follows the view; view_group
    always writes the <g id="view"> wrapper (the HTML component moves it from the browser)."""
    w, h = params["canvas"]["width"], params["canvas"]["height"]
    pal = params.get("palette", {})
    view = VIEW_DEFAULTS if (only or white) else view_of(params)
    defs, body = [], []
    text_items = []      # 14 October 2026: text layers (zrmd/vector/texts.py) are cooked as glyph outlines, stacked by z with the shapes
    if params.get("texts"):
        from zrmd.vector import texts as TX
        top = max([l["z"] for l in params["layers"]] or [0]) + 1
        for t in params["texts"]:
            if (only and t["id"] != only) or t.get("visible", True) is False:
                continue
            text_items.append((t["z"] if t.get("z") is not None else top, TX.cook_outline(t, pal, white=white, css=css_vars)))
    for layer in sorted(params["layers"], key=lambda l: l["z"]):
        if only and layer["id"] != only:
            continue
        if layer.get("visible", True) is False:
            continue
        if view["transparent_background"] and (layer.get("fit") or {}).get("background"):
            continue
        paint, d = ("#ffffff", "") if white else _paint_defs(layer, pal, css_vars)
        if d:
            defs.append(d)
        fx = layer.get("effects", {})
        extra = ""
        if fx.get("blur", 0) > 0:
            fid = f"blur-{layer['id']}"
            # 15 October 2026: the filter region is the box of the layer plus its blur tails, not the whole canvas: a stack of thousands of soft
            # layers rendered thousands of full-canvas blurs (minutes); the tails beyond 3 sigma are under 0.2 %. FR : region du filtre = boite du calque.
            bx0, by0, bx1, by1 = layer_bbox(layer, 3.0 * fx["blur"] + 2.0)
            bx0, by0, bx1, by1 = max(0.0, bx0), max(0.0, by0), min(float(w), bx1), min(float(h), by1)
            defs.append(f'<filter id="{fid}" filterUnits="userSpaceOnUse" x="{_f(bx0)}" y="{_f(by0)}" width="{_f(max(bx1 - bx0, 1.0))}" '
                        f'height="{_f(max(by1 - by0, 1.0))}"><feGaussianBlur stdDeviation="{_f(fx["blur"])}"/></filter>')
            extra += f' filter="url(#{fid})"'
        if not white and fx.get("opacity", 1.0) < 1.0:
            extra += f' opacity="{_f(fx["opacity"])}"'
        body.append((layer["z"], f'<g id="{layer["name"]}" data-kind="{layer["kind"]}"{extra}>'
                                 f'{cook_element(layer, paint, float(view["stroke_scale"]), float(view["radius_scale"]))}</g>'))
    body = [m for _, m in sorted(body + text_items, key=lambda e: e[0])]
    meta = {"schema": SCHEMA, "asset": params.get("asset"), "version": params.get("version"), "date": params.get("date")}
    sw, sh = (w, h) if float(view["scale"]) == 1.0 else (_f(w * float(view["scale"])), _f(h * float(view["scale"])))
    tf = []
    if view["offset_x"] or view["offset_y"]:
        tf.append(f'translate({_f(view["offset_x"])} {_f(view["offset_y"])})')
    if view["rotate_deg"]:
        tf.append(f'rotate({_f(view["rotate_deg"])} {_f(w / 2)} {_f(h / 2)})')
    if view["flip_x"]:
        tf.append(f'translate({_f(w)} 0) scale(-1 1)')
    opa = float(view["opacity"])
    inner = [*body, live] if live else body
    adj = view.get("adjust") or {}
    filt = _adjust_filter(adj, w, h)
    if filt:
        defs.append(filt)
    if tf or opa < 1.0 or filt or (view_group and not (only or white)):
        attrs = (f' transform="{" ".join(tf)}"' if tf else "") + (f' opacity="{_f(opa)}"' if opa < 1.0 else "") + (' filter="url(#adjust)"' if filt else "")
        inner = [f'<g id="view"{attrs}>', *inner, "</g>"]
    return "\n".join([f'<svg xmlns="http://www.w3.org/2000/svg" width="{sw}" height="{sh}" viewBox="0 0 {w} {h}">',
                      f"<metadata>{json.dumps(meta, ensure_ascii=False)}</metadata>",
                      "<defs>" + "".join(defs) + "</defs>", *inner, "</svg>"])


# ---------------------------------------------------------------- vectorisation (12 October 2026)

class _CpuBudget(Exception):
    """Raised inside a layer worker when its CPU-time allowance is spent."""


_SCENE = None   # (shared spent CPU seconds, scene allowance in CPU seconds, spent by short layers, their share of the allowance), see _pool_init


def _pool_init(shared, allowance, shared_short=None, short_allowance=None) -> None:
    """Pool initializer (14 October 2026): the scene CPU allowance. Every layer adds the CPU time it spent to `shared`; once the sum
    reaches `allowance` the layers not yet started keep the unrefined contour and say so. FR : l'enveloppe CPU de la scene."""
    global _SCENE
    _SCENE = (shared, float(allowance), shared_short, None if short_allowance is None else float(short_allowance))


def _layer_job(job: dict) -> dict:
    """Worker wrapper: runs the layer under its caps and records the CPU seconds it spent (cpu_s) so the cost of a scene is read from
    the numbers, and adds them to the shared scene allowance when there is one."""
    import time
    t0 = time.process_time()
    out = _layer_job_capped(job)
    spent = time.process_time() - t0
    out["cpu_s"] = round(spent, 3)
    if _SCENE is not None:
        with _SCENE[0].get_lock():
            _SCENE[0].value += spent
        if job.get("short") and _SCENE[2] is not None:
            with _SCENE[2].get_lock():
                _SCENE[2].value += spent
    return out


def _layer_job_capped(job: dict) -> dict:
    """Worker: primitive recognition, then a refined free path if no primitive passes. With job["cpu_limit_s"] (cost budget) the fit
    is abandoned when the worker has spent that much CPU time (not wall time, so a loaded machine does not change the result) and the
    unrefined contour is kept, flagged. With a scene allowance (budget.sceneCpuS) a layer that has not started when the whole scene has
    spent it keeps the unrefined contour too. FR : un plafond de temps CPU par couche et par scene, repli sur le contour non raffine."""
    import signal
    # 14 October 2026: the layers of a short boundary run first (cheap, big gain per second) but may spend only `shortShare` of the scene
    # allowance, so the cards that come after are not starved (x-anabology S44 measured with the short layers taking all of it: 112 layers
    # flagged scene-cpu, the cards at IoU 0.65). FR : les contours courts ne mangent pas toute l'enveloppe de la scene.
    over = _SCENE is not None and (_SCENE[0].value >= _SCENE[1] or (job.get("short") and _SCENE[2] is not None and _SCENE[3] is not None
                                                                       and _SCENE[2].value >= _SCENE[3]))
    if over and not job.get("unrefined") and not job.get("speck") and not job.get("force"):
        out = _layer_job_full({**job, "unrefined": True})
        out["tried"] = [{"kind": "any", "budget": f"scene cpu allowance {_SCENE[1]:g} s spent"}]
        if out.get("fit"):
            out["fit"]["budget"] = "scene-cpu"
        return out
    limit = job.get("cpu_limit_s")
    if not limit:
        return _layer_job_full(job)

    def _stop(signum, frame):
        raise _CpuBudget()

    old = signal.signal(signal.SIGPROF, _stop)
    signal.setitimer(signal.ITIMER_PROF, float(limit))
    try:
        return _layer_job_full(job)
    except _CpuBudget:
        pass
    finally:
        signal.setitimer(signal.ITIMER_PROF, 0)
        signal.signal(signal.SIGPROF, old)
    cheap = {**job, "unrefined": True}
    out = _layer_job_full(cheap)
    out["tried"] = [{"kind": "any", "budget": f"cpu limit {limit} s spent"}]
    if out.get("fit"):
        out["fit"]["budget"] = "cpu-limit"
    return out


def _layer_job_full(job: dict) -> dict:
    os.environ.setdefault("OMP_NUM_THREADS", "1")
    cfg = job["cfg"]
    tgt, wt, cm, origin, blur = job["target"], job["weight"], job["contour_mask"], job["origin"], job["blur"]
    rec = {"accepted": False, "tried": [], "stats": None}
    if job.get("speck"):          # 14 October 2026: under the tracing floor, never fitted (budget.specklePx)
        return {"index": job["index"], "tried": [], "stats": None, "kind": None, "rejected": "speck", "blur": blur}
    if job.get("unrefined") and not job.get("force"):   # 14 October 2026: over the cost budget, the unrefined Bezier contour only
        tr = T.trace_layer(tgt, wt, cm, origin, blur, cfg, refine=False)
        return {"index": job["index"], "tried": [{"kind": "path", "budget": "unrefined"}], "stats": None, "kind": "path", "blur": tr["blur"],
                "geometry": {"d": tr["d"], "segments": tr["segments"]}, "fit": {"refine": tr["refine"], "unrefined": True}}
    if cfg["primitives"]["enabled"] or job.get("force"):
        rec = P.recognise(tgt, wt, cm, origin, blur, cfg, force=job.get("force"), refine=job["refine"],
                          sabotage=job["sabotage"])
    out = {"index": job["index"], "tried": rec["tried"], "stats": rec["stats"]}
    if rec["accepted"]:
        b = rec["best"]
        out.update(kind=b["kind"], geometry=P.geometry_json(b["kind"], b["geometry"]), blur=b["blur"],
                   fit={"iou": b["iou"], "edge_mean": b["edge"]["mean"], "nfev": b["nfev"]})
        return out
    if job.get("force"):
        out.update(kind=None, rejected=job["force"])
        return out
    tr = T.trace_layer(tgt, wt, cm, origin, blur, cfg, refine=job["refine"])
    out.update(kind="path", geometry={"d": tr["d"], "segments": tr["segments"]}, blur=tr["blur"],
               fit={"refine": tr["refine"]})
    return out


def analyse(rgb: np.ndarray, cfg: dict | None = None) -> dict:
    """Segmentation, colour models, stacking and per-layer coverage targets (full canvas)."""
    cfg = cfg or _cfg()
    rgb = np.asarray(rgb)[..., :3]
    seg = T.segment(rgb, cfg)
    labels, n = seg["labels"], seg["n"]
    models = {i: T.fit_colour_model(rgb, labels == i, cfg) for i in range(n)}
    st = T.stack_order(labels, n, cfg)
    labels, models, merged = T.merge_revealed(rgb, labels, models, st, cfg)
    if merged:
        n = len(models)
        st = T.stack_order(labels, n, cfg)
    layers = []
    for idx, lab in enumerate(st["order"]):
        if lab == st["background"]:
            layers.append({"label": lab, "background": True})
            continue
        tg = T.layer_target(rgb, labels, models, st["order"], idx, st["filled"], cfg)
        blur = T.estimate_blur(tg["alpha"], tg["weight"], tg["signed_dist"], cfg)
        if blur > 0:
            tg = T.layer_target(rgb, labels, models, st["order"], idx, st["filled"], cfg,
                                band=max(cfg["band_px"], int(math.ceil(3 * blur)) + 2))
        # 14 October 2026: the signed distance and the stacked mask are only read above; keeping them for every layer cost two canvases
        # per layer (hundreds of layers on a video crop). The weight is binary, so float32 holds it exactly.
        tg.pop("signed_dist", None)
        tg.pop("stacked", None)
        tg["weight"] = tg["weight"].astype(np.float32)
        layers.append({"label": lab, "background": False, "blur": blur, **tg})
    return {"labels": labels, "n": n, "models": models, "stack": st, "layers": layers,
            "merged": {int(k): int(v) for k, v in merged.items()}}


def _crop_box(mask: np.ndarray, margin: int):
    ys, xs = np.nonzero(mask)
    h, w = mask.shape
    return max(0, ys.min() - margin), min(h, ys.max() + 1 + margin), max(0, xs.min() - margin), min(w, xs.max() + 1 + margin)


def vectorise(rgb: np.ndarray, asset_id: str, source: dict | None = None, force: dict | None = None,
              refine: bool = True, sabotage: bool = False, workers: int | None = None, cfg: dict | None = None) -> dict:
    """Vectorise a crop into params (not yet written). force maps a layer z index to a primitive kind."""
    cfg = cfg or _cfg()
    rgb = np.asarray(rgb)[..., :3]
    h, w = rgb.shape[:2]
    an = analyse(rgb, cfg)
    jobs = []
    for z, L in enumerate(an["layers"]):
        if L["background"]:
            continue
        m = int(cfg["crop_margin_px"] + math.ceil(3 * L["blur"]))
        y0, y1, x0, x1 = _crop_box(L["contour_mask"] | (L["alpha"] > 0.01), m)
        jobs.append({"index": z, "target": L["alpha"][y0:y1, x0:x1], "weight": L["weight"][y0:y1, x0:x1],
                     "contour_mask": L["contour_mask"][y0:y1, x0:x1], "origin": (x0, y0), "blur": L["blur"],
                     "force": (force or {}).get(z), "refine": refine, "sabotage": sabotage, "cfg": cfg})
    bud = cfg.get("budget")
    submit = list(range(len(jobs)))
    if bud:   # 14 October 2026: a cost budget for video crops (hundreds of layers); absent = every layer fully fitted as before
        from scipy import ndimage as ndi
        order = sorted(range(len(jobs)), key=lambda i: -float(jobs[i]["target"].sum()))
        for rank, i in enumerate(order):
            j = jobs[i]
            hard = j["target"] >= 0.5
            area, perim = float(j["target"].sum()), int((hard & ~ndi.binary_erosion(hard)).sum())
            j["perim"], j["area"] = perim, area
            j["short"] = perim <= bud.get("rankFreeBoundaryPx", 0)
            j["speck"] = area < bud["specklePx"]
            # 14 October 2026: the rank cap (maxRefined) is a count of the layers that are EXPENSIVE; a layer of a short boundary
            # (rankFreeBoundaryPx, a glyph, an icon) costs seconds and is exempt from it, subject to the CPU caps. Counted by area over
            # all classes, 48 of the 71 vector layers of x-anabology S44 (glyphs of 20 to 100 px, IoU 0.29 to 0.8) were left unrefined
            # behind big blurred shader layers. FR : la limite de rang ne frappe pas les couches a contour court.
            rank_cap = rank >= bud["maxRefined"] and perim > bud.get("rankFreeBoundaryPx", 0)
            j["unrefined"] = bool(rank_cap or perim > bud["maxBoundaryPx"] or area > bud["maxAreaPx"])
            j["cpu_limit_s"] = bud.get("layerCpuS")
        # 14 October 2026: the layers of a short boundary (budget.rankFreeBoundaryPx) go FIRST, cheapest first, then the others by
        # area. A glyph costs seconds and wins tenths of IoU, a card costs a minute and wins hundredths: with the biggest first, the
        # scene allowance was spent before the glyphs of x-anabology S44 were reached (27 of its layers kept the unrefined contour
        # with the scene-cpu flag). FR : le contour court d'abord, il rapporte le plus par seconde de CPU.
        short = bud.get("rankFreeBoundaryPx", 0)
        submit = sorted(order, key=lambda i: (0, jobs[i]["perim"], i) if jobs[i]["perim"] <= short else (1, -jobs[i]["area"], i))
    workers = workers or (bud or {}).get("workers") or cfg["workers"]
    scene_cpu = (bud or {}).get("sceneCpuS")
    import time as _time
    wall0 = _time.time()
    ordered = [jobs[i] for i in submit]
    if workers > 1 and len(jobs) > 1:
        done = 0
        results = []
        kw = {}
        if scene_cpu is not None:
            import multiprocessing as mp
            ctx = mp.get_context("spawn")
            kw = {"mp_context": ctx, "initializer": _pool_init,
                  "initargs": (ctx.Value("d", 0.0), scene_cpu, ctx.Value("d", 0.0), scene_cpu * float(bud.get("shortShare", 1.0)))}
        with ProcessPoolExecutor(max_workers=min(workers, len(jobs)), **kw) as ex:
            for r in ex.map(_layer_job, ordered):
                results.append(r)
                done += 1
                if bud and done % 25 == 0:
                    print(f"[vectorise] {done}/{len(jobs)} layers, {_time.time() - wall0:.0f} s", file=sys.stderr, flush=True)
    else:
        if scene_cpu is not None:
            import multiprocessing as mp
            _ctx = mp.get_context("spawn")
            _pool_init(_ctx.Value("d", 0.0), scene_cpu, _ctx.Value("d", 0.0), scene_cpu * float(bud.get("shortShare", 1.0)))
        try:
            results = [_layer_job(j) for j in ordered]
        finally:
            globals()["_SCENE"] = None
    by_index = {r["index"]: r for r in results}
    cost = {"layers": len(results), "cpuS": round(sum(r.get("cpu_s", 0.0) for r in results), 2),
            "maxLayerCpuS": round(max([r.get("cpu_s", 0.0) for r in results] or [0.0]), 2),
            "layerCapHits": sum(1 for r in results if (r.get("fit") or {}).get("budget") == "cpu-limit"),
            "sceneCapHits": sum(1 for r in results if (r.get("fit") or {}).get("budget") == "scene-cpu"),
            "unrefined": sum(1 for r in results if (r.get("fit") or {}).get("unrefined")),
            "specks": sum(1 for r in results if r.get("rejected") == "speck"), "wallS": round(_time.time() - wall0, 1),
            "workers": min(workers, max(1, len(jobs))), "sceneCpuS": scene_cpu}
    palette, pal_keys = {}, {}

    def paint_of(model):
        m = {k: v for k, v in model.items() if k not in ("rms",)}
        if m["type"] == "flat":
            c = m["colour"]
            if c not in pal_keys:
                pal_keys[c] = f"c{len(pal_keys)}"
                palette[pal_keys[c]] = c
            m["colour"] = "@" + pal_keys[c]
        m["fit_rms"] = model.get("rms")
        return m

    layers, rejected = [], []
    for z, L in enumerate(an["layers"]):
        model = an["models"][L["label"]]
        lid = f"L{z:02d}"
        if L["background"]:
            layers.append({"id": lid, "name": f"{lid}-background", "z": z, "kind": "rect",
                           "geometry": {"cx": w / 2, "cy": h / 2, "w": float(w), "h": float(h), "angle": 0.0},
                           "paint": paint_of(model), "effects": {"blur": 0.0, "opacity": 1.0}, "fit": {"background": True},
                           "shader_hint": SHADER_HINTS.get(model["type"], ["solid_color"])})
            continue
        r = by_index[z]
        if r.get("kind") is None:
            rejected.append({"z": z, "kind": r.get("rejected"), "tried": r["tried"]})
            continue
        hints = list(SHADER_HINTS.get(model["type"], []))
        if r["blur"] > 0:
            hints += SHADER_HINTS.get(f"blur:{r['kind']}", ["blur_disc_gaussian"])
        layers.append({"id": lid, "name": f"{lid}-{r['kind']}", "z": z, "kind": r["kind"], "geometry": r["geometry"],
                       "paint": paint_of(model), "effects": {"blur": r["blur"], "opacity": 1.0},
                       "fit": {**r["fit"], "tried": r["tried"], "stats": r["stats"]}, "shader_hint": hints})
    params = {"schema": SCHEMA, "asset": asset_id, "date": V.today(), "canvas": {"width": int(w), "height": int(h)},
              "source": source or {}, "palette": palette, "layers": layers,
              "editing": "change palette colours, layer geometry, paint stops or effects here, then run "
                         "Scripts/Vectorise.py rebuild to cook a new version (12 October 2026)",
              "trace": {"refine": refine, "sabotage": sabotage, "rejected": rejected, "cost": cost,
                        "settings": {k: cfg[k] for k in ("smooth_step", "fit_error_px", "band_px")}}}
    if source and source.get("kind") == "reference-crop":
        params["rights"] = "private-1to1: benchmark of a reference, never published; publish variations only after rights validation"
    return {"params": params, "analysis": an}


# ---------------------------------------------------------------- fidelity (12 October 2026)

def _layer_box(params: dict, lid: str, target: np.ndarray, weight: np.ndarray, w: int, h: int, margin: int) -> tuple[int, int, int, int]:
    """The box (x0, y0, x1, y1) that holds all the ink of one layer, the fitted one and its target: the target comes from
    the analysis, the fitted ink from a plain 1x render of the layer (a supersampled pixel with ink touches a 1x pixel with ink within
    the margin). Outside this box both coverages are zero, so every sum of the fidelity is unchanged. FR : la boite de l'encre d'une couche."""
    cov1 = R.svg_mask(cook_svg(params, only=lid, white=True), w, h, engine="skia", ss=1)
    ink = (cov1 > 0) | (target > 0)
    ys, xs = np.nonzero(ink)
    if len(xs) == 0:
        return 0, 0, 1, 1
    return max(0, int(xs.min()) - margin), max(0, int(ys.min()) - margin), min(w, int(xs.max()) + 1 + margin), min(h, int(ys.max()) + 1 + margin)


def _layer_coverage(params: dict, lid: str, box: tuple[int, int, int, int], ss: int) -> np.ndarray:
    """Coverage 0..1 of one layer rendered alone over `box` only (same pixels as the full canvas, supersampled by ss): the root viewBox
    is moved to the box so user space, filters and gradients stay where they were."""
    import re
    x0, y0, x1, y1 = box
    bw, bh = x1 - x0, y1 - y0
    svg = cook_svg(params, only=lid, white=True)
    head = re.search(r"<svg\b[^>]*>", svg)
    tag = f'<svg xmlns="http://www.w3.org/2000/svg" width="{bw}" height="{bh}" viewBox="{x0} {y0} {bw} {bh}">'
    return R.svg_mask(svg[:head.start()] + tag + svg[head.end():], bw, bh, engine="skia", ss=ss).astype(np.float64)


def evaluate(params: dict, rgb: np.ndarray, analysis: dict | None = None, cfg: dict | None = None, crop: bool = True) -> dict:
    """Fidelity of a cooked asset against its source: every layer rendered alone (white, through skia.SVGDOM)
    against its coverage target, and the composite colour error. pass follows vector.trace.fidelity.
    14 October 2026: with crop (default) each layer is rendered and measured inside the box of its ink instead of on the whole canvas
    at supersampling (hundreds of layers of a video crop took minutes); the numbers are the same, crop=False keeps the whole-canvas
    reading as the reference of the test. FR : chaque couche est mesuree dans la boite de son encre."""
    cfg = cfg or _cfg()
    fc = cfg["fidelity"]
    rgb = np.asarray(rgb)[..., :3].astype(np.float64)
    w, h = params["canvas"]["width"], params["canvas"]["height"]
    ss = int(cfg.get("raster_ss", 1))                   # 12 October 2026: reference rasteriser (settings vector.trace)
    comp = R.render_svg(cook_svg({**params, "view": {}}), w, h, engine="skia", ss=ss)[..., :3].astype(np.float64)   # the view is not the trace
    err = np.abs(comp - rgb).max(-1)
    colour = {"mae": round(float(np.abs(comp - rgb).mean()), 4), "p99": round(float(np.percentile(err, 99)), 3),
              "max": round(float(err.max()), 3), "share_over_16": round(float((err > 16).mean()), 6)}
    per = []
    if analysis is not None:
        for z, L in enumerate(analysis["layers"]):
            if L["background"]:
                continue
            lid = f"L{z:02d}"
            if not any(l["id"] == lid for l in params["layers"]):
                per.append({"id": lid, "missing": True, "ok": False})
                continue
            if crop:
                x0, y0, x1, y1 = _layer_box(params, lid, L["alpha"], L["weight"], w, h, int(fc.get("box_margin_px", 4)) + int(math.ceil(3 * float(L.get("blur") or 0.0))))
                cov = _layer_coverage(params, lid, (x0, y0, x1, y1), ss)
                tgt, wt = L["alpha"][y0:y1, x0:x1], L["weight"][y0:y1, x0:x1]
                iou = M.weighted_iou(cov, tgt, wt)
                edge = M.subpixel_edge_distance(cov, tgt, wt, canvas=(h, w), occluder_margin_px=int(fc.get("occluder_margin_px", 1)))
            else:
                cov = R.svg_mask(cook_svg(params, only=lid, white=True), w, h, engine="skia", ss=ss).astype(np.float64)
                iou = M.weighted_iou(cov, L["alpha"], L["weight"])
                edge = M.subpixel_edge_distance(cov, L["alpha"], L["weight"], occluder_margin_px=int(fc.get("occluder_margin_px", 1)))
            ok = iou >= fc["iou_min"] and edge["mean"] <= fc["edge_mean_max_px"]
            kind = next(l["kind"] for l in params["layers"] if l["id"] == lid)
            per.append({"id": lid, "kind": kind, "iou": iou, "edge_mean": edge["mean"], "edge_p95": edge["p95"], "ok": ok})
    layers_ok = all(p["ok"] for p in per)
    colour_ok = colour["mae"] <= fc["colour_mae_max"] and colour["p99"] <= fc["colour_p99_max"]
    worst = min((p for p in per if "iou" in p), key=lambda p: p["iou"], default=None)
    return {"date": V.today(), "rule": fc, "layers": per, "colour": colour, "layers_ok": layers_ok,
            "colour_ok": colour_ok, "pass": bool(layers_ok and colour_ok),
            "worst_layer": worst, "min_iou": worst["iou"] if worst else None,
            "max_edge_mean": max((p["edge_mean"] for p in per if "edge_mean" in p), default=None)}


# ---------------------------------------------------------------- versions on disk (12 October 2026)

def assets_root() -> Path:
    return Path(_cfg()["assets_dir"])


def write_version(asset_dir: Path, params: dict, rgb: np.ndarray | None, fidelity: dict | None,
                  parent: str | None = None, note: str = "") -> Path:
    """Write V_NNN (never overwriting): params.json, asset.svg, render.png, fidelity.json, version.json."""
    from PIL import Image
    asset_dir = Path(asset_dir)
    asset_dir.mkdir(parents=True, exist_ok=True)
    name = V.next_version(asset_dir)
    vdir = asset_dir / name
    vdir.mkdir()
    params = copy.deepcopy(params)
    params["version"] = name
    params["parent"] = parent
    svg = cook_svg(params)
    (vdir / "params.json").write_text(json.dumps(params, indent=1, ensure_ascii=False), encoding="utf-8")
    (vdir / "asset.svg").write_text(svg, encoding="utf-8")
    w, h = output_size(params)            # 14 October 2026: the canvas times view.scale (1 for every traced scene)
    ss = int((params.get("trace") or {}).get("raster_ss", _cfg().get("raster_ss", 1)))       # a multi-layer fit is fitted and measured at 1x
    Image.fromarray(R.render_svg(svg, w, h, engine="skia", ss=ss)).save(vdir / "render.png")
    if fidelity is not None:
        (vdir / "fidelity.json").write_text(json.dumps(fidelity, indent=1), encoding="utf-8")
    (vdir / "version.json").write_text(json.dumps({"version": name, "parent": parent, "date": V.stamp(), "note": note},
                                                  indent=1), encoding="utf-8")
    return vdir


def apply_overrides(params: dict, overrides: dict) -> dict:
    """Overrides: {"palette": {...}, "layers": {"L02": {"geometry": {...}, "paint": {...}, "effects": {...}}}, ...}.
    Layers are addressed by id; an unknown id is an error that names it."""
    out = copy.deepcopy(params)
    ov = copy.deepcopy(overrides or {})
    by_id = {l["id"]: l for l in out["layers"]}
    for lid, change in (ov.pop("layers", None) or {}).items():
        if lid not in by_id:
            raise KeyError(f"no layer '{lid}' (layers: {sorted(by_id)})")
        merged = V.deep_merge(by_id[lid], change)
        by_id[lid].clear()
        by_id[lid].update(merged)
    return V.deep_merge(out, ov)


def sha256_file(path: str | Path) -> str:
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
