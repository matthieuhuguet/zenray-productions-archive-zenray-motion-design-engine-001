// 12 October 2026: Light beams: parallel lines at a spacing along an angle; each line is lit when its hash is below `coverage` (animate it to switch beams on), drawn as a gaussian core plus an exponential glow. Colour block, use with add.
// generated by Scripts/HarvestCriticGaps.py. Licence: original (pcg2d hash implemented from Jarzynski and Olano, Hash Functions for GPU Rendering, JCGT 2020; algorithm, no code copied), same licence as the engine.
// Source: https://jcgt.org/published/0009/03/02/
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
uvec2 beam_lines_field_pcg2d(uvec2 v) {
  v = v * 1664525u + 1013904223u;
  v.x += v.y * 1664525u;
  v.y += v.x * 1664525u;
  v = v ^ (v >> 16u);
  v.x += v.y * 1664525u;
  v.y += v.x * 1664525u;
  v = v ^ (v >> 16u);
  return v;
}
vec2 beam_lines_field_hash2(vec2 cell, float seed) {
  uint s = uint(max(seed, 0.0));
  uvec2 c = uvec2(ivec2(cell) + 32768) + uvec2(s * 747796405u, s * 2891336453u);
  uvec2 h = beam_lines_field_pcg2d(c);
  return vec2(h >> 8u) * (1.0 / 16777216.0);
}
vec4 beam_lines_field(vec2 uv, float angle, float spacing, float width, float glow, vec3 core_color, vec3 color, float coverage, float seed, float phase, float intensity, float aspect) {
  float a = radians(angle);
  vec2 n = vec2(-sin(a), cos(a));
  float x = dot(vec2(uv.x * aspect, uv.y), n) / spacing + phase + 0.000731;
  float k = floor(x);
  float d = (x - k - 0.5) * spacing;
  float lit = step(beam_lines_field_hash2(vec2(k, 0.0), seed).x, coverage - 1e-6);
  float g = exp(-0.5 * (d / width) * (d / width));
  float e = exp(-abs(d) / glow);
  return vec4(clamp((core_color * g + color * e) * intensity * lit, 0.0, 1.0), 1.0);
}
