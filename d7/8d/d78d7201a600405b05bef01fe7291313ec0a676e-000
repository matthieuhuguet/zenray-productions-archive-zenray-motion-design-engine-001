import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def _pcg2d(x, y):
    m, a, s16 = U32(1664525), U32(1013904223), U32(16)
    x = x * m + a
    y = y * m + a
    x = x + y * m
    y = y + x * m
    x = x ^ (x >> s16)
    y = y ^ (y >> s16)
    x = x + y * m
    y = y + x * m
    x = x ^ (x >> s16)
    y = y ^ (y >> s16)
    return x, y


def _hash2(cx, cy, seed):
    s = int(max(float(seed), 0.0)) & 0xFFFFFFFF
    ox, oy = U32((s * 747796405) & 0xFFFFFFFF), U32((s * 2891336453) & 0xFFFFFFFF)
    x = (np.asarray(cx).astype(np.int64) + 32768).astype(U32) + ox
    y = (np.asarray(cy).astype(np.int64) + 32768).astype(U32) + oy
    hx, hy = _pcg2d(x, y)
    return (hx >> U32(8)).astype(float) / 16777216.0, (hy >> U32(8)).astype(float) / 16777216.0


def render(params, u, v):
    q = params
    px = u * q['aspect'] * q['scale']
    py = v * q['scale']
    ix, iy = np.floor(px), np.floor(py)
    col = np.zeros(px.shape + (3,))
    s = q['seed']
    for y in (-1, 0, 1):
        for x in (-1, 0, 1):
            cx, cy = ix + x, iy + y
            hx, hy = _hash2(cx, cy, s)
            ox, oy = cx + 0.5 + 0.6 * (hx - 0.5), cy + 0.5 + 0.6 * (hy - 0.5)
            b = q['peak'] * _hash2(cx, cy, s + 1.0)[0]
            d = np.hypot(px - ox, py - oy)
            core = 1.0 - _ss(0.6 * q['core_radius'], q['core_radius'], d)
            glow = q['intensity'] * np.maximum(b - q['threshold'], 0.0) * np.exp(-0.5 * d * d / (q['glow_sigma'] ** 2))
            col += _v(q['core_color']) * np.minimum(b, 1.0)[..., None] * core[..., None] + _v(q['glow_color']) * glow[..., None]
    return np.clip(col, 0.0, 1.0) * 255.0
