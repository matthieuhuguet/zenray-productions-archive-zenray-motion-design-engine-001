// 12 October 2026: Long bloom tail as a sum of three gaussians of the distance outside a disc (radius 0 gives a point light); fits the measured halo falloffs (sigmas near 3, 15 and 60 px at 1080p). Colour block, use with add or screen.
// generated by Scripts/HarvestCriticGaps.py. Licence: original (written from the mathematics), same licence as the engine.
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
vec4 halo_tail3(vec2 uv, vec2 center, float radius, vec3 color, vec3 sigmas, vec3 weights, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float d = max(length(p) - radius, 0.0);
  vec3 e = d / sigmas;
  float g = dot(weights, exp(-0.5 * e * e));
  return vec4(clamp(color * g, 0.0, 1.0), 1.0);
}
