// 12 October 2026: Ring halo: Gaussian of the distance to a circle, exp(-(r - radius)^2 / 2 sigma^2). Colour block for the add blend.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: color (sRGB 0..1), center (uv), radius (uv (height units)), sigma (uv (height units)), intensity (gain), aspect (width / height).
vec4 glow_ring(vec2 uv, vec3 color, vec2 center, float radius, float sigma, float intensity, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float d = length(p) - radius;
  float g = intensity * exp(-d * d / (2.0 * sigma * sigma));
  return vec4(clamp(color * g, 0.0, 1.0), 1.0);
}
