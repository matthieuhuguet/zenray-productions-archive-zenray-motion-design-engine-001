"""Inoxtag collection 02 (J+89, SEMAINE 12, MOIS 2): pure white tall condensed numerals, a small plus, two small counters and two small spaced captions, as a custom font (18 October 2026). Native still 2000 x 1115.
Run: /Users/zenray/.venvs/zenray-motion/bin/python -I Scripts/CardInox2.py"""
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import numpy as np
from scipy import ndimage as ndi
import CardTrace as C

img, A = C.load("inox2"); H, W = A.shape[:2]; L = ndi.gaussian_filter(A.mean(2), 0.5); mn = A.min(2)
box = lambda *a: C.box_mask((H, W), *a)  # noqa: E731
mask = ndi.binary_opening(mn >= 228, iterations=1); MN = ndi.gaussian_filter(mn.astype(float), 0.7)  # the min channel: the white letters sit at 255, the brightest sky below 190
white = C.color_of(A, ndi.binary_erosion(mask & box(770, 430, 1160, 735), iterations=3))
main = C.glyphs_of(mask, MN, box(770, 428, 1158, 740), list("J+89"), mincontrast=40.0, minpx=60, band=3, sigma=0.5, plain=(175, 235))
n12 = C.glyphs_of(mask, MN, box(1178, 392, 1242, 484), list("12"), mincontrast=40.0, minpx=40, band=2, sigma=0.5, plain=(175, 235))
n2 = C.glyphs_of(mask, MN, box(1250, 438, 1300, 528), list("2"), mincontrast=40.0, minpx=40, band=2, sigma=0.5, plain=(175, 235))
smask = mn >= 185
t_sem = C.textline(smask, box(1050, 392, 1176, 418), "l2", "SEMAINE", "left", "Manrope", 700)
t_mois = C.textline(mn >= 215, box(1180, 505, 1236, 528), "l4", "MOIS", "left", "Manrope", 700, capfix=-1)
fb = {"w": 0.33, "sw": 0.13, "c": 0.0}
lines = [C.line_data("l1", "J+89", "num", 0, main, "right", fb, maxw=700), t_sem, C.line_data("l3", "12", "num", 0, n12, "left", {"w": 0.33, "sw": 0.14, "c": 0.0}), t_mois, C.line_data("l5", "2", "num", 0, n2, "left", {"w": 0.33, "sw": 0.14, "c": 0.0})]
for ln in lines: ln["aux"] = ln["k"] != "l1"
C.emit("inox2", W, H, {"main": white, "second": white}, lines, note="J+89, SEMAINE 12, MOIS 2.")
