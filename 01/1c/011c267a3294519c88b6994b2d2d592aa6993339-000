"""Inoxtag collection 03 (CUBA, 135M, VINALES): wide white grotesque capitals with a fuzzy edge in the reference (caught mid-dissolve), a triangle and two small spaced captions (18 October 2026). Native still 2000 x 1044.
The final state is the clean letter: the contour is cut at a fixed level of the min channel after a stronger smoothing, so the hair of the dissolve does not become the shape. Run: /Users/zenray/.venvs/zenray-motion/bin/python -I Scripts/CardInox3.py"""
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import numpy as np
from scipy import ndimage as ndi
import CardTrace as C

img, A = C.load("inox3"); H, W = A.shape[:2]; mn = A.min(2)
box = lambda *a: C.box_mask((H, W), *a)  # noqa: E731
MN = ndi.gaussian_filter(mn.astype(float), 1.1)
mask = ndi.binary_opening(MN >= 215, iterations=2)
white = C.color_of(A, ndi.binary_erosion(mask & box(700, 470, 1300, 650), iterations=4))
cuba = C.glyphs_of(mask, MN, box(700, 470, 1300, 650), list("CUBA"), mincontrast=40.0, minpx=400, band=3, sigma=0.8, plain=(150, 230), opening=1, closing=2)
smask = mn >= 200
t_alt = C.textline(smask, box(940, 392, 1100, 432), "l2", "135M", "left", "Manrope", 700, capfix=-2)
t_ville = C.textline(smask, box(880, 700, 1120, 735), "l3", "VIÑALES", "left", "Manrope", 700, capfix=-1)
# the triangle: a fixed shape
tm = ndi.binary_closing(smask & box(850, 396, 912, 432), iterations=1); rf = C.refine(tm, ndi.gaussian_filter(A.mean(2), 0.5), band=2, sig=4.0, mincontrast=40.0); td, tb = C.trace(rf > 0.5, soft=rf, sigma=0.5)
tri = [{"c": "^", "d": td, "b": tb}]
fixed = {"k": "tri", "text": "^", "face": "tri", "ci": 0, "align": "left", "x0": tb[0], "x1": tb[2], "cx": 0, "top": 0, "capH": 1, "gap": 0, "space": 0, "glyphs": tri, "fb": {}, "fixed": True, "upper": False, "maxw": 9999}
lines = [C.line_data("l1", "CUBA", "wide", 0, cuba, "center", {"w": 0.95, "sw": 0.22, "c": 0.0}, maxw=720), t_alt, t_ville, fixed]
for ln in lines: ln["aux"] = ln["k"] != "l1"
C.emit("inox3", W, H, {"main": white, "second": white}, lines, note="CUBA, 135M, VINALES, triangle.")
