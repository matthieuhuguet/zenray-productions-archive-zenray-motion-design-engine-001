// ZenRay Motion Design, the vector animation of a cut (16 October 2026): the keyframes traced from a reference shot by
// motion/htmlvec.py (one stacked SVG per keyframe, one palette per shot), played in time on the scene, with editable text over them.
// keys: lines "t file" (t in seconds from the scene start, file in the project's media). overlays: lines
// "start end x% y% size weight tracking colour | text". Colour grading and the camera are parameters, so the animation stays editable.
// FR : l'animation vectorielle d'une coupe : images cles SVG jouees dans le temps, texte editable par-dessus, etalonnage en parametres.
(function () {
  "use strict";
  const ZS = window.ZS, h = ZS.h;
  const P = (key, label, type, def, tier, extra) => ({ key, label, type, default: def, tier, ...(extra || {}) });
  const N = (key, label, def, min, max, step, tier, unit) => P(key, label, "number", def, tier, { min, max, step, unit });
  // a "lines" value reaches a template as an array (or as text in an old project): both are read
  const linesOf = (v) => (Array.isArray(v) ? v : String(v || "").split("\n")).map((l) => String(l).trim()).filter(Boolean);
  const keysOf = (txt) => linesOf(txt).map((l) => l.split(/\s+/)).filter((a) => a.length >= 2 && isFinite(+a[0]))
    .map((a) => ({ t: +a[0], file: a.slice(1).join(" ") })).sort((a, b) => a.t - b.t);
  const overlaysOf = (txt) => linesOf(txt).map((l) => {
    const i = l.indexOf("|");
    if (i < 0) return null;
    const a = l.slice(0, i).trim().split(/\s+/);
    return { t0: +a[0], t1: +a[1], x: +a[2], y: +a[3], size: +a[4], weight: +a[5] || 400, tracking: +a[6] || 0, colour: a[7] || "#111111", text: l.slice(i + 1).trim() };
  }).filter((o) => o && isFinite(o.t0));

  ZS.register({
    id: "vector-shot", label: "Animation vectorielle (images clés SVG)", group: "Média", duration: 2,
    params: [
      P("bg", "Fond", "color", "#ffffff", 1), N("sat", "Saturation", 1, 0, 3, 0.01, 1), N("lum", "Luminosité", 1, 0.2, 2, 0.01, 1), N("contrast", "Contraste", 1, 0.2, 3, 0.01, 1),
      N("hue", "Teinte", 0, -180, 180, 1, 2, "°"), P("fit", "Cadrage", "select", "cover", 2, { options: ["cover", "contain"] }),
      N("blend", "Fondu entre images clés", 0, 0, 1, 0.05, 2, "part de l'intervalle"),
      P("overlays", "Textes (début fin x% y% taille graisse interlettrage couleur | texte)", "lines", "", 2),
      P("font", "Police des textes", "font", "@fontBody", 2), P("ink", "Couleur des textes", "color", "#111111", 2),
      P("keys", "Images clés (t fichier)", "lines", "", 3),
      N("panX", "Glissement horizontal", 0, -0.5, 0.5, 0.005, 3), N("panY", "Glissement vertical", 0, -0.5, 0.5, 0.005, 3),
      N("zoomEnd", "Zoom de fin", 1, 0.5, 3, 0.01, 3), N("roll", "Roulis de fin", 0, -45, 45, 0.5, 3, "°"), N("scale", "Échelle", 1, 0.3, 3, 0.01, 3),
      N("opacity", "Opacité", 1, 0, 1, 0.01, 3), N("blur", "Flou", 0, 0, 40, 0.5, 3, "px"),
      N("fadeIn", "Entrée en fondu", 0, 0, 5, 0.05, 3, "s"), N("fadeOut", "Sortie en fondu", 0, 0, 5, 0.05, 3, "s"),
      N("preload", "Préchargement", 1.5, 0, 10, 0.1, 3, "s"),
    ],
    build(ctx) {
      const { el, p, W, H, u, tl, t0, dur, preview, asset, fit, safe } = ctx;
      h.css(el, { background: p.bg });
      // a thumbnail (gallery card) shows one picture of the scene and never loads the other keyframes
      const keys = ctx.thumb ? keysOf(p.keys).slice(0, 1) : keysOf(p.keys);
      const stage = h.css(h.el("div", "zs-abs", el), { inset: "0", overflow: "hidden", transformOrigin: "50% 50%",
        filter: `saturate(${p.sat}) brightness(${p.lum}) contrast(${p.contrast}) hue-rotate(${p.hue}deg)${p.blur ? ` blur(${p.blur * u}px)` : ""}`, opacity: p.opacity });
      const imgs = keys.map((k, i) => {
        const im = h.el("img", "zs-media", stage);
        h.css(im, { position: "absolute", inset: "0", width: "100%", height: "100%", objectFit: p.fit, visibility: i === 0 ? "visible" : "hidden",
          transform: `scale(${p.scale})` });
        im.decoding = "async";
        const url = asset(k.file);
        // the live editor loads a keyframe a little before its time (a long project has thousands); an export loads them all
        if (i === 0 || !preview) im.src = url;
        else tl.call(() => { if (!im.src) im.src = url; }, [], t0 + Math.max(0, k.t - p.preload));
        return im;
      });
      keys.forEach((k, i) => {
        if (i === 0) return;
        const prev = imgs[i - 1], cur = imgs[i], gap = Math.max(0.01, k.t - keys[i - 1].t), fade = p.blend * gap;
        tl.set(cur, { visibility: "hidden", opacity: 1 }, t0);
        if (fade > 0.01) {
          tl.fromTo(cur, { autoAlpha: 0 }, { autoAlpha: 1, duration: fade, ease: "none" }, t0 + k.t);
          tl.set(prev, { visibility: "hidden" }, t0 + k.t + fade);
        } else {
          tl.set(cur, { visibility: "visible" }, t0 + k.t);
          tl.set(prev, { visibility: "hidden" }, t0 + k.t);
        }
      });
      if (p.panX || p.panY || p.zoomEnd !== 1 || p.roll) {
        tl.fromTo(stage, { x: 0, y: 0, scale: 1, rotation: 0 }, { x: p.panX * W, y: p.panY * H, scale: p.zoomEnd, rotation: p.roll, duration: dur, ease: "none" }, t0);
      }
      if (p.fadeIn > 0) tl.fromTo(stage, { autoAlpha: 0 }, { autoAlpha: p.opacity, duration: p.fadeIn, ease: "none" }, t0);
      if (p.fadeOut > 0) tl.to(stage, { autoAlpha: 0, duration: p.fadeOut, ease: "none" }, t0 + Math.max(0, dur - p.fadeOut));
      // the texts are placed on the picture: with "contain" the picture is the 1920 x 1080 frame fitted whole, so sizes follow its width
      const k = p.fit === "contain" ? Math.min(W / 1920, H / 1080) : u;
      overlaysOf(p.overlays).forEach((o) => {
        const d = h.css(h.el("div", "zs-abs", el, o.text), { left: o.x / 100 * W + "px", top: o.y / 100 * H + "px", transform: "translate(-50%, -50%)", whiteSpace: "nowrap",
          fontFamily: h.font(p.font), fontSize: o.size * k + "px", fontWeight: o.weight, letterSpacing: o.tracking + "em", color: o.colour || p.ink, lineHeight: 1,
          visibility: "hidden" });
        fit(d, safe.w, safe.h);
        tl.set(d, { visibility: "visible", opacity: 1 }, t0 + o.t0);
        tl.fromTo(d, { autoAlpha: 0 }, { autoAlpha: 1, duration: Math.min(0.3, (o.t1 - o.t0) / 2), ease: "none" }, t0 + o.t0);
        tl.set(d, { visibility: "hidden" }, t0 + Math.min(dur, o.t1));
      });
    },
  });
})();
