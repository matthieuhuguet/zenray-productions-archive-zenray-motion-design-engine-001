// 12 October 2026: Sphere seen as a disc: Schlick fresnel f0 + (1 - f0)(1 - n.z)^power mixes base and rim colours; black outside. Colour block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: center (uv), radius (uv (height units)), base (sRGB 0..1), rim (sRGB 0..1), f0 (reflectance at normal), power (exponent), soft (uv (height units)), aspect (width / height).
float fresnel_rim_disc_cov(float d, float soft) { return 1.0 - smoothstep(-soft, soft, d); }
vec4 fresnel_rim_disc(vec2 uv, vec2 center, float radius, vec3 base, vec3 rim, float f0, float power, float soft, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float l = length(p);
  float r = l / radius;
  float nz = sqrt(max(1.0 - r * r, 0.0));
  float f = f0 + (1.0 - f0) * pow(1.0 - nz, power);
  return vec4(mix(base, rim, f) * fresnel_rim_disc_cov(l - radius, soft), 1.0);
}
