def _has(desc: str, words) -> bool:
    """A word of the list starts a word of the description ("arc" must not match "marche")."""
    return any(re.search(r"(?<![\wœ'])" + re.escape(w), desc) for w in words)


def _lab_l(hexc: str) -> float:
    r, g, b = (int(hexc[i:i + 2], 16) / 255 for i in (1, 3, 5))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def _ease(name: str) -> str:
    n = (name or "").lower()
    if "inout" in n or n in ("css.ease", "css.ease-in-out", "sine.inout"):
        return "sine.inOut" if n.startswith("sine") else "power1.inOut"
    if n in ("css.ease-in", "material.accelerate") or n.endswith(".in") or ".in(" in n:
        return "power2.in"
    if "expo" in n:
        return "expo.out"
    if n.endswith(".out") or ".out(" in n or n in ("css.ease-out", "material.decelerate"):
        return "power2.out"
    return "power1.inOut"


def illustration(shot: dict, offset: float = 0.0) -> dict:
    """15 October 2026: the measured shot redrawn as motion (zs-illustrate.js): subject from the description, colours from the palette,
    camera from the measured moves (clamped so the subject stays in the frame). offset: where the scene starts inside the shot."""
    desc = (shot.get("description") or "").lower()
    subject = next((name for name, words in SUBJECTS["rules"] if _has(desc, words)), None)
    if subject is None:   # nothing drawable named: a word or a sentence on a plain ground, else a texture
        subject = "aucun" if _has(desc, SUBJECTS["textOnly"]) else SUBJECTS["default"]
    roles = shot.get("roles") or {}
    bg = roles.get("background") or "#101114"
    cands = [c["hex"] for c in (shot.get("palette") or []) if c.get("hex") and c["hex"] != bg] or ["#e9e4da", "#8a8a8a"]
    chroma = {c["hex"]: c.get("chroma", 0) for c in (shot.get("palette") or [])}
    lb = _lab_l(bg)
    colour = max(cands, key=lambda c: abs(_lab_l(c) - lb) + 0.004 * chroma.get(c, 0))
    rest = [c for c in cands if c != colour] or [colour]
    colour2 = max(rest, key=lambda c: chroma.get(c, 0) + 30 * abs(_lab_l(c) - lb))
    colour3 = next((c for c in rest if c != colour2), rest[0])
    cam = SUBJECTS["camera"]
    ch = ((shot.get("camera") or {}).get("channels") or {})
    tot = lambda k: float((ch.get(k) or {}).get("total") or 0)
    clamp = lambda v, lo, hi: round(max(lo, min(hi, v)), 2)
    moves = [m for k in ("x", "y", "zoom") for m in ((ch.get(k) or {}).get("moves") or [])]
    big = max(moves, key=lambda m: abs(m.get("amplitude") or 0), default=None)
    p = {"subject": subject, "bg": bg, "colour": colour, "colour2": colour2, "colour3": colour3,
         "camX": clamp(tot("x"), -cam["maxShift"], cam["maxShift"]), "camY": clamp(tot("y"), -cam["maxShift"], cam["maxShift"]),
         "camZoom": clamp(tot("zoom"), cam["zoomMin"], cam["zoomMax"]), "roll": clamp(tot("roll"), -cam["maxRoll"], cam["maxRoll"]),
         "camEase": _ease(big.get("ease")) if big else "power1.inOut", "seed": int(float(shot.get("start", 0)) * 100) % 9999 + 1}
    if big:
        p["camAt"] = round(max(0.0, float(big.get("start") or 0) - offset), 3)
        p["camDur"] = round(max(0.0, float(big.get("duration") or 0)), 3)
    for flag, words in SUBJECTS["flags"].items():
        if _has(desc, words):
            p[flag] = True
    return p


def build(slug: str) -> dict:
    r = RECIPES[slug]
    bible = banks._json(banks.REFERENCES / slug / "bible.json")
    shots = bible["shots"]
    base = convert.convert(slug)                     # music, effects, font, measured durations
    # cut points: the measured shots, and every instant where the recipe brings something new (a caption that changes inside a long shot)
    entries = sorted(r.get("shots", []), key=lambda e: e[0])
    total = sum(float(x["duration"]) for x in shots)
    cuts = sorted({round(float(x["start"]), 3) for x in shots} | {round(e[0], 3) for e in entries if 0 < e[0] < total})
    scenes, last_text = [], None
    if "only" in r:
        tpl, params = r["only"]
        scenes = [{"id": "s01", "template": tpl, "duration": round(total, 3), "params": params}]
    else:
        for k, c0 in enumerate(cuts):
            c1 = cuts[k + 1] if k + 1 < len(cuts) else total
            if c1 - c0 < 0.02:
                continue
            shot = next((x for x in shots if x["start"] - 1e-6 <= c0 < x["end"]), shots[-1])
            entry = next((e for e in entries if abs(round(e[0], 3) - c0) < 1e-6), None)
            # no reference footage: the shot is redrawn as motion (15 October 2026); a caption read on the contact sheet sits on the drawing
            drawn = {**illustration(shot, c0 - float(shot["start"])), **{k: v for k, v in r.get("default", {}).items() if k in ("bw",)}}
            tpl, params = (entry[1], entry[2]) if entry else ("illustrated-shot", {})
            if entry and (entry[1] != "media-text" or entry[2].get("text") or entry[2].get("text2")):
                last_text = (entry[1], entry[2])
            # a word or a sentence on a plain ground with no recipe here: the last words read in this reference stay on screen,
            # so the animation still says something on its own (house rule, 15 October 2026)
            # a recipe with "hold" (a reference made of graphic windows) keeps its last window on every graphic shot it does not name
            if not entry and last_text and (drawn["subject"] == "aucun" or (r.get("hold") and shot.get("family") == "graphic")):
                tpl, params = last_text[0], dict(last_text[1])
                if tpl == "media-text":
                    params = {**drawn, **params}
            if tpl == "media-text":
                params = {**drawn, **params}
                if params.get("style") == "aucun" or not (params.get("text") or params.get("text2")):
                    tpl, params = "illustrated-shot", {k: v for k, v in params.items() if k in drawn or k == "bw"}
            elif tpl == "illustrated-shot":
                params = drawn
            scenes.append({"id": f"s{len(scenes) + 1:03d}", "template": tpl, "duration": round(c1 - c0, 4), "params": params,
                           "ref": {"shot": shot.get("id"), "start": round(c0, 4), "family": shot.get("family")}})
    project = {"schema": "zrmd/motion-project@1", "title": f"{slug} · base motion", "format": "16x9", "fps": 30, "reference": slug,
            "doc": f"15 October 2026: first motion base of {slug}: one scene per measured shot, the words and treatments read on the contact sheets; "
                   f"every filmed shot is redrawn as motion (illustrated-shot). To iterate against the reference.",
            "theme": base["theme"], "music": base["music"], "sfx": base["sfx"], "scenes": scenes}
    house.apply(project)   # the house style: coherent fonts, readable sizes (params/house.json)
    return project


def main(slugs):
    for slug in slugs or list(RECIPES):
        pid = convert.project_id(slug)
        if (server.project_dir(pid) / "project.json").is_file():
            server.save_version(pid, "avant la base motion du 15 octobre")
        p = build(slug)
        server.write_project(pid, p)
        print(json.dumps({"id": pid, "scenes": len(p["scenes"]), "plates left": len(house.plates(p)), "duration": round(sum(s["duration"] for s in p["scenes"]), 2)}))


if __name__ == "__main__":
    main(sys.argv[1:])
