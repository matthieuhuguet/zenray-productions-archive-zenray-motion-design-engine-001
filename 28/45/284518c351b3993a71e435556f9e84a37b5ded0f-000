// generated by Scripts/HarvestNoisePost.py. Licence: original (written from the mathematics), same licence as the engine.
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
float bloom_rect_box(vec2 p, vec2 b, float r) {
  r = min(r, min(b.x, b.y));
  vec2 q = abs(p) - b + r;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
vec4 bloom_rect(vec2 uv, vec2 center, vec2 half_size, float corner, vec3 core_color, vec3 glow_color, float glow_radius, float wide, float intensity, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float d = bloom_rect_box(p, half_size, corner);
  float cov = 1.0 - smoothstep(-0.002, 0.002, d);
  float e = max(d, 0.0) / glow_radius;
  float glow = intensity * ((1.0 - wide) * exp(-0.5 * e * e) + wide * exp(-max(d, 0.0) / (3.0 * glow_radius)));
  return vec4(clamp(core_color * cov + glow_color * glow * (1.0 - cov), 0.0, 1.0), 1.0);
}
