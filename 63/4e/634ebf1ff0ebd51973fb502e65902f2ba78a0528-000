import numpy as np

U32 = np.uint32


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)
EPS = 0.000731


def render(params, u, v):
    q = params
    x = np.abs(2.0 * (u - q['cx']))
    slope = 2.0 * q['k'] * q['p'] * np.maximum(x, 1e-4) ** (q['p'] - 1.0) / q['aspect']
    d = (v - (q['apex'] + q['k'] * x ** q['p'])) / np.sqrt(1.0 + slope * slope)
    sd = _ss(q['side'][0], q['side'][1], x + (v - x) * q['side_axis'])[..., None]
    rim = _v(q['c_rim']) + (_v(q['c_rim_side']) - _v(q['c_rim'])) * sd
    core = _v(q['c_core']) + (_v(q['c_core_side']) - _v(q['c_core'])) * sd
    o = -d
    a1 = _ss(0.0, q['w_rim'], o)[..., None]
    a2 = _ss(q['w_rim'], q['w_rim'] + q['w_core'], o)[..., None]
    a3 = _ss(q['w_rim'] + q['w_core'], q['w_rim'] + q['w_core'] + q['w_out'], o)[..., None]
    col = rim + (core - rim) * a1
    col = col + (_v(q['c_out']) - col) * a2
    col = col + (_v(q['c_top']) - col) * a3
    ins = _ss(-q['soft'], q['soft'], d)[..., None]
    col = col + (_v(q['c_in']) - col) * ins
    return col * 255.0
