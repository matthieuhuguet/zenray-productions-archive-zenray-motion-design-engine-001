END = 51.38


def T(scene: str, key: str) -> dict:
    return {"scene": scene, "key": key}


def project() -> dict:
    scenes = []
    for i, (t, params) in enumerate(BEATS):
        nxt = BEATS[i + 1][0] if i + 1 < len(BEATS) else END
        scenes.append({"id": f"b{i + 1:02d}", "template": "cs-shot", "duration": round(nxt - t, 4), "params": dict(params, film0=t), "ref": {"start": t}})
    ids = {b[1]["kind"]: f"b{i + 1:02d}" for i, b in enumerate(BEATS)}
    controls = [
        {"id": "hero", "label": "Titre d'ouverture", "type": "lines", "group": "Phrases", "targets": [T(ids["hero"], "lines")]},
        {"id": "buttons", "label": "Boutons du premier titre", "type": "lines", "group": "Phrases", "targets": [T(ids["hero"], "buttons")]},
        {"id": "chat", "label": "Question du chat", "type": "text", "group": "Phrases", "targets": [T(ids["chat"], "question")]},
        {"id": "product", "label": "Phrase produit", "type": "lines", "group": "Phrases", "targets": [T(ids["product"], "lines")]},
        {"id": "shortcut", "label": "Phrase du raccourci", "type": "lines", "group": "Phrases", "targets": [T(ids["shortcut"], "lines")]},
        {"id": "magic", "label": "Carte magique", "type": "lines", "group": "Phrases", "targets": [T(ids["dialog"], "magic")]},
        {"id": "next", "label": "Phrase du framework", "type": "lines", "group": "Phrases", "targets": [T(ids["next"], "lines")]},
        {"id": "command", "label": "Commande de la pastille", "type": "text", "group": "Commandes", "targets": [T(ids["command"], "command")]},
        {"id": "query", "label": "Recherche tapée", "type": "text", "group": "Commandes", "targets": [T(ids["search"], "query")]},
        {"id": "email", "label": "Titre serif", "type": "lines", "group": "Phrases", "targets": [T(ids["email"], "lines")]},
        {"id": "final", "label": "Commande finale", "type": "lines", "group": "Commandes", "targets": [T(ids["end"], "lines")]},
        {"id": "prism", "label": "Couleurs du prisme (gauche)", "type": "color", "group": "Prisme", "targets": [T(ids["prism"], "leftColor")]},
        {"id": "prismR", "label": "Couleurs du prisme (droite)", "type": "color", "group": "Prisme", "targets": [T(ids["prism"], "rightColor")]},
    ]
    return {"schema": "zrmd/motion-project@1", "workflow": {"id": "ppm", "name": "Premier Plan Mesuré"}, "title": "Cinematic Shot reproduit", "format": "16x9", "fps": 30, "reference": "cinematic-shot",
            "doc": "16 October 2026: Cinematic Shot film, foreground only (no photograph).",
            "theme": {"bg": "#000000", "ink": "#f4f4f4", "accent": "#ff3d6e", "fontTitle": "InterVariable", "fontBody": "InterVariable"},
            "music": {"mode": "none"}, "sfx": {"enabled": False}, "controls": controls, "scenes": scenes}


if __name__ == "__main__":
    pid = "cinematic-shot-motion"
    if (server.project_dir(pid) / "project.json").is_file():
        server.save_version(pid, "avant une nouvelle passe de reproduction")
    p = project()
    old = (server.project_dir(pid) / "project.json")
    if old.is_file():  # the verdict of Matthieu survives a rebuild
        p["validation"] = (json.loads(old.read_text(encoding="utf-8")).get("validation") or None) or p.get("validation")
        if not p["validation"]:
            p.pop("validation")
    server.write_project(pid, p)
    print(json.dumps({"id": pid, "scenes": len(p["scenes"]), "duration": round(sum(s["duration"] for s in p["scenes"]), 2)}))
