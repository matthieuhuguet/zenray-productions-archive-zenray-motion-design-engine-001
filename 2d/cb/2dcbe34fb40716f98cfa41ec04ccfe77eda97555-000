// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
vec4 arch_glow_field(vec2 uv, float cx, float apex, float k, float p, float soft, float w_rim, float w_core, float w_out, vec3 c_rim, vec3 c_rim_side, vec3 c_core, vec3 c_core_side, vec3 c_out, vec3 c_top, vec3 c_in, vec2 side, float side_axis, float aspect) {
  float x = abs(2.0 * (uv.x - cx));
  float slope = 2.0 * k * p * pow(max(x, 1e-4), p - 1.0) / aspect;
  float d = (uv.y - (apex + k * pow(x, p))) * inversesqrt(1.0 + slope * slope);
  float sd = smoothstep(side.x, side.y, mix(x, uv.y, side_axis));
  vec3 rim = mix(c_rim, c_rim_side, sd);
  vec3 core = mix(c_core, c_core_side, sd);
  float o = -d;
  vec3 col = mix(rim, core, smoothstep(0.0, w_rim, o));
  col = mix(col, c_out, smoothstep(w_rim, w_rim + w_core, o));
  col = mix(col, c_top, smoothstep(w_rim + w_core, w_rim + w_core + w_out, o));
  col = mix(col, c_in, smoothstep(-soft, soft, d));
  return vec4(col, 1.0);
}
