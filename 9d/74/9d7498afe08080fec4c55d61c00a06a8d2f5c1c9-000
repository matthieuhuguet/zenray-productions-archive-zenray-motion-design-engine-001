import numpy as np

U32 = np.uint32


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)
EPS = 0.000731


def _pcg2d(x, y):
    m, a, s16 = U32(1664525), U32(1013904223), U32(16)
    x = x * m + a
    y = y * m + a
    x = x + y * m
    y = y + x * m
    x = x ^ (x >> s16)
    y = y ^ (y >> s16)
    x = x + y * m
    y = y + x * m
    x = x ^ (x >> s16)
    y = y ^ (y >> s16)
    return x, y


def _hash2(cx, cy, seed):
    s = int(max(float(seed), 0.0)) & 0xFFFFFFFF
    ox, oy = U32((s * 747796405) & 0xFFFFFFFF), U32((s * 2891336453) & 0xFFFFFFFF)
    x = (np.asarray(cx).astype(np.int64) + 32768).astype(U32) + ox
    y = (np.asarray(cy).astype(np.int64) + 32768).astype(U32) + oy
    hx, hy = _pcg2d(x, y)
    return (hx >> U32(8)).astype(float) / 16777216.0, (hy >> U32(8)).astype(float) / 16777216.0


def render(params, u, v):
    q = params
    a = np.radians(q['angle'])
    nx, ny = -np.sin(a), np.cos(a)
    x = (u * q['aspect'] * nx + v * ny) / q['spacing'] + q['phase'] + EPS
    k = np.floor(x)
    d = (x - k - 0.5) * q['spacing']
    lit = (_hash2(k, np.zeros_like(k), q['seed'])[0] <= q['coverage'] - 1e-6).astype(float)
    g = np.exp(-0.5 * (d / q['width']) ** 2)
    e = np.exp(-np.abs(d) / q['glow'])
    col = (_v(q['core_color']) * g[..., None] + _v(q['color']) * e[..., None]) * (q['intensity'] * lit)[..., None]
    return np.clip(col, 0.0, 1.0) * 255.0
