// 12 October 2026: Glow along a parabola arch (Gaussian of the first-order distance) with an optional interior fill level. Colour block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: color (sRGB 0..1), vertex (uv), curvature (1 / uv), sigma (uv (height units)), fill (interior level), intensity (gain), aspect (width / height).
vec4 glow_parabola(vec2 uv, vec3 color, vec2 vertex, float curvature, float sigma, float fill, float intensity, float aspect) {
  vec2 p = (uv - vertex) * vec2(aspect, 1.0);
  float d = (curvature * p.x * p.x - p.y) / sqrt(1.0 + 4.0 * curvature * curvature * p.x * p.x);
  float g = max(exp(-d * d / (2.0 * sigma * sigma)), fill * (1.0 - smoothstep(-sigma, sigma, d)));
  return vec4(clamp(color * g * intensity, 0.0, 1.0), 1.0);
}
