{
  "id": "ease_expo_ramp",
  "family": "curve",
  "description": "Two-colour ramp along an angle shaped by a normalised exponential ease (1 - exp(-k t)) / (1 - exp(-k)). Colour block. (12 October 2026)",
  "params": [
    {
      "name": "angle",
      "type": "float",
      "default": 90.0,
      "min": -180.0,
      "max": 180.0,
      "unit": "degrees (0 = left to right, 90 = top to bottom)"
    },
    {
      "name": "c0",
      "type": "color",
      "default": [
        0.0,
        0.0,
        0.0
      ],
      "min": [
        0.0,
        0.0,
        0.0
      ],
      "max": [
        1.0,
        1.0,
        1.0
      ],
      "unit": "sRGB 0..1"
    },
    {
      "name": "c1",
      "type": "color",
      "default": [
        1.0,
        1.0,
        1.0
      ],
      "min": [
        0.0,
        0.0,
        0.0
      ],
      "max": [
        1.0,
        1.0,
        1.0
      ],
      "unit": "sRGB 0..1"
    },
    {
      "name": "k",
      "type": "float",
      "default": 4.0,
      "min": 0.5,
      "max": 12.0,
      "unit": "rate"
    }
  ],
  "source_url": "",
  "licence": "original (written from the mathematics), same licence as the engine",
  "attribution": "ZenRay Motion Design, 12 October 2026",
  "tags": [
    "ease",
    "exponential",
    "out",
    "falloff",
    "curve",
    "colour"
  ],
  "looks": [
    "ease-preview",
    "light-falloff"
  ]
}
