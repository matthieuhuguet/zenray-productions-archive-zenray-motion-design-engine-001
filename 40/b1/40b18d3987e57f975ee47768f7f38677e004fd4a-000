# 14 October 2026: reproduce the backdrop field of a shot as an EDITABLE shader-field motion (the V1 image interface), and
# iterate it by named parameters. A version is params.json = {canvas, look (named values), tracks (optional per-key
# animation), fit (what was measured)}; its render is the GLSL of the bank layers of the look, encoded H.264, then measured
# against the reference window in CIEDE2000 through the same pipeline (zrmd/shaders/lookrender.py).
#   fit      measure the shot, fit the look on three keyframes (start, middle, end), write V_001, render, measure
#   iterate  new version from the latest (or --parent) with --set look.<key>=<value>, same render and measure
#   render   re-render a version in place (no new version)
# Usage:
#   python -I Scripts/ReproduceField.py fit --slug kardashev-0-7 --start 12.29 --end 14.3 --motion <workshop>/motions/<id>
#   python -I Scripts/ReproduceField.py iterate --motion <dir> --set look.glow=0.9 --set look.colourEnd=#ff8844 --strict
# FR : reproduit le champ de fond d'un plan en motion shader-field editable (l'interface image V1) et l'itere par
# parametres nommes ; le rendu est le GLSL des calques du look, encode, puis mesure en CIEDE2000 par le meme pipeline.
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

import numpy as np

ENGINE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ENGINE))
from zrmd import exposed, settings, versions  # noqa: E402
from zrmd.media import iter_frames, read_frames  # noqa: E402
from zrmd.shaders import field, look, lookfit, lookrender  # noqa: E402

FPS = 60
TRACK_TOL = 0.02  # relative to the key's range (numbers) or RGB distance (colours): below it the key is held constant


def reference_video(slug: str) -> str:
    meta = json.loads((settings.path("workshop") / "references" / slug / "reference.json").read_text(encoding="utf-8"))
    return str(settings.path("refcache") / slug / meta["file_name"])


def poster(mp4: Path, target: Path) -> None:
    subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", "0.3", "-i", str(mp4), "-frames:v", "1", "-vf", "scale=640:-2", "-q:v", "3",
                    "-strict", "unofficial", str(target)], check=False)


def grain_level(video: str, t: float) -> float:
    """Grain strength from one full-size frame: high-pass standard deviation (same heuristic as ReproduceBackdrop)."""
    import cv2
    mid = read_frames(video, 960, 540, start=t, duration=1 / FPS)[0].astype(float).mean(2)
    hp = mid - cv2.GaussianBlur(mid, (0, 0), 2.0)
    return float(np.clip(np.median(np.abs(hp)) * 1.4826 / 255.0 * 2.0, 0.0, 0.2))


def tracks_from(keyframes: list[tuple[int, dict]]) -> list[dict]:
    """Piecewise-linear tracks through the fitted keyframes for every key that moves more than TRACK_TOL."""
    tracks = []
    for key, (default, kind, lo, hi) in look.SPEC.items():
        vals = [kf[1][key] for kf in keyframes]
        if kind == "color":
            c = [np.asarray(look.hex_to_rgb(v)) for v in vals]
            moves = max(float(np.linalg.norm(c[i + 1] - c[i])) for i in range(len(c) - 1)) > TRACK_TOL
        else:
            moves = max(abs(vals[i + 1] - vals[i]) for i in range(len(vals) - 1)) > TRACK_TOL * (hi - lo)
        if not moves:
            continue
        for (f0, l0), (f1, l1) in zip(keyframes[:-1], keyframes[1:]):
            tracks.append({"key": key, "start": int(f0), "frames": int(f1 - f0), "from": l0[key], "to": l1[key], "ease": "linear"})
    return tracks


def finish(vdir: Path, params: dict, motion: Path, source: dict | None, note: str) -> dict:
    mp4 = lookrender.render_mp4(params, vdir / "render.mp4")
    poster(mp4, vdir / "poster.jpg")
    report = None
    if source and source.get("slug") and "end" in source:
        meas = lookrender.measure(reference_video(source["slug"]), source["start"], source["end"], mp4)
        report = lookrender.fidelity_doc(meas, note)
        (vdir / "fidelity.json").write_text(json.dumps({**report, "perFrame": meas["perFrame"]}, indent=1) + "\n", encoding="utf-8")
    return {"version": vdir.name, "render": str(mp4), "score": report and report["score"],
            "dimensions": report and report["dimensions"]}


def cmd_fit(a) -> dict:
    video = reference_video(a.slug)
    dur = a.end - a.start
    n = int(round(dur * FPS))
    g = field.config()["grid"]
    frames = read_frames(video, g["width"], g["height"], start=a.start, duration=dur)
    idx = [0, len(frames) // 2, len(frames) - 1]
    fr = [int(round(i / max(len(frames) - 1, 1) * (n - 1))) for i in idx]
    grain = grain_level(video, a.start + dur / 2)
    mid = lookfit.fit(frames[idx[1]], grain=grain, nfev=a.nfev)
    cfg = field.config()
    ends = []
    for k in (0, 2):
        f = frames[idx[k]]
        own = lookfit.fit(f, start=mid["look"], grain=grain, nfev=a.nfev)
        on_mid = field.frame_metrics(f, np.round(look.render(mid["look"], f.shape[1], f.shape[0])), cfg)
        # A keyframe keeps the middle look when it explains that frame as well as its own fit (parameters are ambiguous
        # on a static backdrop, so a moving angle there is fit noise, never an animation).
        if on_mid["score"] is not None and own["metrics"]["score"] is not None and on_mid["score"] >= own["metrics"]["score"] - 0.003:
            own = {"look": dict(mid["look"]), "metrics": on_mid}
        ends.append(own)
    first, last = ends
    keyed = [(fr[0], first["look"]), (fr[1], mid["look"]), (fr[2], last["look"])]
    base = dict(mid["look"])
    params = {"schema": "zrmd/motion@1", "recipe": "shader-field",
              "canvas": {"width": a.width, "height": a.height, "fps": FPS, "frames": n},
              "look": base, "tracks": tracks_from(keyed),
              "fit": {"keyframes": [{"frame": f, "metrics": m["metrics"]} for f, m in zip(fr, (first, mid, last))],
                      "grain": round(grain, 5), "grid": g, "date": versions.stamp()}}
    motion = Path(a.motion)
    vdir = versions.create_version(motion, params, note=f"shader field fitted on 3 keyframes of {a.slug} {a.start:.3f}-{a.end:.3f}")
    m = versions.read_json(motion / "motion.json", {}) or {}
    m.update({"id": motion.name, "title": a.title, "recipe": "shader-field", "source": {"slug": a.slug, "start": a.start, "end": a.end},
              "tags": ["shader", "field", "backdrop", a.slug]})
    versions.write_json(motion / "motion.json", m)
    return finish(vdir, params, motion, m["source"], "fit")


def cmd_iterate(a) -> dict:
    motion = Path(a.motion)
    parent = a.parent or versions.latest_version(motion)
    params = versions.read_json(motion / parent / "params.json")
    overrides = {}
    for item in a.set or []:
        key, _, raw = item.partition("=")
        try:
            overrides[key] = json.loads(raw)
        except json.JSONDecodeError:
            overrides[key] = raw
    if a.strict:
        overrides = exposed.validate(params, "shader-field", overrides)
    for key, value in overrides.items():
        versions.set_path(params, key, value)
    look.resolve(params.get("look"))  # a value outside its range or an unknown key stops here, before any render
    vdir = versions.create_version(motion, params, parent=parent, note=a.note or "iteration", author=a.author)
    m = versions.read_json(motion / "motion.json", {}) or {}
    src = None if a.no_verify else m.get("source")
    return finish(vdir, params, motion, src, a.note or "iteration")


def cmd_render(a) -> dict:
    motion = Path(a.motion)
    v = a.version or versions.latest_version(motion)
    params = versions.read_json(motion / v / "params.json")
    m = versions.read_json(motion / "motion.json", {}) or {}
    return finish(motion / v, params, motion, m.get("source"), "re-render")


def cmd_floor(a) -> dict:
    out = Path(a.out or (settings.path("refcache") / a.slug / "reviews" / f"codec-floor-{a.start:.1f}.mp4"))
    return {"slug": a.slug, **lookrender.codec_floor(reference_video(a.slug), a.start, a.dur, out, crf=a.crf)}


def cmd_ceiling(a) -> dict:
    """The identity floor of a WHOLE reference: `windows` evenly spread windows of `dur` seconds, each against its own re-encode
    (lookrender.codec_floor), written to <workshop>/image/<slug>/codec-floor.json so the module table can say what no field model can beat."""
    import subprocess
    import tempfile

    video = reference_video(a.slug)
    total = float(subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", video], capture_output=True, text=True, check=True).stdout.strip())
    n = max(1, a.windows)
    rows = []
    with tempfile.TemporaryDirectory() as tmp:
        for k in range(n):
            start = round(total * (k + 0.5) / n, 2) if n > 1 else round(total * 0.5, 2)
            dur = min(a.dur, max(0.5, total - start - 0.1))
            rows.append(lookrender.codec_floor(video, start, dur, Path(tmp) / f"w{k}.mp4", crf=a.crf))
    doc = {"date": versions.stamp(), "slug": a.slug, "duration_s": round(total, 2), "crf": a.crf, "windows": rows,
           "mean": round(float(np.mean([r["score"] for r in rows])), 5), "min": round(float(min(r["score"] for r in rows)), 5),
           "within1Jnd": round(float(np.mean([r["within1Jnd"] for r in rows])), 4),
           "note": "identity floor: each window of the reference against its own H.264 re-encode (960x540, same grid and metric as the field fidelity); no reproduction that is encoded the same way can score above it"}
    dest = settings.path("workshop") / "image" / a.slug
    dest.mkdir(parents=True, exist_ok=True)
    versions.write_json(dest / "codec-floor.json", doc)
    return doc


def main() -> int:
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    f = sub.add_parser("fit")
    f.add_argument("--slug", required=True)
    f.add_argument("--start", type=float, required=True)
    f.add_argument("--end", type=float, required=True)
    f.add_argument("--motion", required=True)
    f.add_argument("--title", default="Shader field")
    f.add_argument("--width", type=int, default=960)
    f.add_argument("--height", type=int, default=540)
    f.add_argument("--nfev", type=int, default=60)
    i = sub.add_parser("iterate")
    i.add_argument("--motion", required=True)
    i.add_argument("--parent", default=None)
    i.add_argument("--set", action="append")
    i.add_argument("--strict", action="store_true", help="only exposed keys, inside their bounds (the site's door)")
    i.add_argument("--note", default="")
    i.add_argument("--author", default="zrmd")
    i.add_argument("--no-verify", action="store_true")
    r = sub.add_parser("render")
    r.add_argument("--motion", required=True)
    r.add_argument("--version", default=None)
    fl = sub.add_parser("floor", help="identity ceiling: a reference window against its own H.264 re-encode")
    fl.add_argument("--slug", required=True)
    fl.add_argument("--start", type=float, required=True)
    fl.add_argument("--dur", type=float, default=2.0)
    fl.add_argument("--crf", type=int, default=16)
    fl.add_argument("--out", default=None)
    ce = sub.add_parser("ceiling", help="identity floor of a whole reference (evenly spread windows), written to codec-floor.json")
    ce.add_argument("--slug", required=True)
    ce.add_argument("--windows", type=int, default=3)
    ce.add_argument("--dur", type=float, default=2.0)
    ce.add_argument("--crf", type=int, default=16)
    a = ap.parse_args()
    out = {"fit": cmd_fit, "iterate": cmd_iterate, "render": cmd_render, "floor": cmd_floor, "ceiling": cmd_ceiling}[a.cmd](a)
    print(json.dumps({"ok": True, **out}, indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
