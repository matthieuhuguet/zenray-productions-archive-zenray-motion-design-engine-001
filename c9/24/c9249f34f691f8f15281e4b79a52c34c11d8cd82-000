import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def _box(px, py, b, r):
    r = min(r, min(b[0], b[1]))
    qx = np.abs(px) - b[0] + r
    qy = np.abs(py) - b[1] + r
    return np.hypot(np.maximum(qx, 0.0), np.maximum(qy, 0.0)) + np.minimum(np.maximum(qx, qy), 0.0) - r


def render(params, u, v):
    q = params
    chans = []
    for k in range(3):
        sc = 1.0 + (1.0 - k) * q['strength']
        qu = q['optic'][0] + (u - q['optic'][0]) * sc
        qv = q['optic'][1] + (v - q['optic'][1]) * sc
        px = (qu - q['center'][0]) * q['aspect']
        py = qv - q['center'][1]
        d = _box(px, py, q['half_size'], q['corner'])
        chans.append(1.0 - _ss(-q['soft'], q['soft'], d))
    return _v(q['color']) * np.stack(chans, axis=-1) * 255.0
