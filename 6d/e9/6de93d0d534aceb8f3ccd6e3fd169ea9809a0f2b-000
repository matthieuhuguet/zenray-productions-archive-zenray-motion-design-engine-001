import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def _box(px, py, b, r):
    r = min(r, min(b[0], b[1]))
    qx = np.abs(px) - b[0] + r
    qy = np.abs(py) - b[1] + r
    return np.hypot(np.maximum(qx, 0.0), np.maximum(qy, 0.0)) + np.minimum(np.maximum(qx, qy), 0.0) - r


def render(params, u, v):
    q = params
    px = (u - q['center'][0]) * q['aspect']
    py = v - q['center'][1]
    d = _box(px, py, q['half_size'], q['corner'])
    cov = (1.0 - _ss(-0.002, 0.002, d))[..., None]
    e = np.maximum(d, 0.0) / q['glow_radius']
    w = q['wide']
    glow = (q['intensity'] * ((1.0 - w) * np.exp(-0.5 * e * e) + w * np.exp(-np.maximum(d, 0.0) / (3.0 * q['glow_radius']))))[..., None]
    return np.clip(_v(q['core_color']) * cov + _v(q['glow_color']) * glow * (1.0 - cov), 0.0, 1.0) * 255.0
