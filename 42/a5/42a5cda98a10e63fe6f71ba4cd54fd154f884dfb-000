"""Reproduction of the Claudia teaser (whatships.com/videos/claudia, 20.25 s) as an editable motion project (16 October 2026).

FOREGROUND ONLY (Matthieu's rule): typography, prompt bar, HUD frame, relay diagram, star, marquee, title card; no photo, no face.
FR : reproduction de Claudia, premier plan seulement (texte, barre de saisie, cadre HUD, schema) ; jamais de photo ni de visage.
Usage: python3 motion/reproductions/claudia.py
"""
import json
import sys
from pathlib import Path

MOTION = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(MOTION))
import server  # noqa: E402

BEATS = [
    (0.00, "cl-ask", {}),
    (2.95, "cl-relay", {"film0": 2.95}),
    (5.30, "cl-star", {"film0": 5.3}),
    (6.35, "cl-soul", {"film0": 6.35}),
    (9.00, "cl-marquee", {"film0": 9.0}),
    (10.80, "cl-output", {"kind": "still", "word": "STILL", "source": "STILL — MIDJOURNEY", "output": "OUTPUT 01 / 04", "film0": 10.8}),
    (11.60, "cl-output", {"kind": "clip", "word": "CLIP", "source": "CLIP — GROK IMAGINE", "output": "OUTPUT 02 / 04", "tag": "STAR CLIP ↗", "film0": 11.6}),
    (12.60, "cl-output", {"kind": "song", "word": "SONG", "source": "SONG — SUNO", "output": "OUTPUT 03 / 04", "tag": "134.7 BPM", "film0": 12.6}),
    (13.60, "cl-output", {"kind": "video", "word": "MUSIC VIDEO", "source": "MUSIC VIDEO — CLAUDE CODE", "output": "OUTPUT 04 / 04", "tag": "STAR CLIP ↗", "film0": 13.6}),
    (14.30, "cl-title", {"film0": 14.3}),
]
END = 20.25


def T(scene: str, key: str) -> dict:
    return {"scene": scene, "key": key}


# PROMOTED CONTROLS: what the storyboard of THIS film says can change: the sentence asked, the giant words, the two engines of the relay, the name and the
# serif word, the four outputs, the title card, the two colours.
CONTROLS = [
    {"id": "prompt", "label": "Phrase demandée", "type": "text", "group": "Demande", "targets": [T("b01", "prompt")]},
    {"id": "words", "label": "Mots géants (début fin MOT style)", "type": "lines", "group": "Demande", "targets": [T("b01", "words")]},
    {"id": "a", "label": "Premier moteur", "type": "text", "group": "Relais", "targets": [T("b02", "a")]},
    {"id": "aSub", "label": "Sa légende", "type": "text", "group": "Relais", "targets": [T("b02", "aSub")]},
    {"id": "b", "label": "Second moteur", "type": "text", "group": "Relais", "targets": [T("b02", "b")]},
    {"id": "bSub", "label": "Sa légende", "type": "text", "group": "Relais", "targets": [T("b02", "bSub")]},
    {"id": "name", "label": "Nom du lieu", "type": "text", "group": "Âme", "targets": [T("b04", "label"), T("b05", "name")]},
    {"id": "word", "label": "Mot en serif", "type": "text", "group": "Âme", "targets": [T("b04", "word"), T("b05", "word")]},
    {"id": "soulText", "label": "Texte décodé", "type": "text", "group": "Âme", "targets": [T("b04", "text")]},
    {"id": "o1", "label": "Sortie 1 (mot)", "type": "text", "group": "Sorties", "targets": [T("b06", "word")]},
    {"id": "o2", "label": "Sortie 2 (mot)", "type": "text", "group": "Sorties", "targets": [T("b07", "word")]},
    {"id": "o3", "label": "Sortie 3 (mot)", "type": "text", "group": "Sorties", "targets": [T("b08", "word")]},
    {"id": "o4", "label": "Sortie 4 (mot)", "type": "text", "group": "Sorties", "targets": [T("b09", "word")]},
    {"id": "t1", "label": "Titre, ligne 1", "type": "text", "group": "Titre", "targets": [T("b10", "line1")]},
    {"id": "t2", "label": "Titre, ligne 2", "type": "text", "group": "Titre", "targets": [T("b10", "line2")]},
    {"id": "tagline", "label": "Légende du titre", "type": "text", "group": "Titre", "targets": [T("b10", "tagline")]},
    {"id": "link", "label": "Lien", "type": "text", "group": "Titre", "targets": [T("b10", "link")]},
    {"id": "coral", "label": "Couleur corail", "type": "color", "group": "Marque", "targets": [T(f"b{i:02d}", "coral") for i in range(1, 11)]},
    {"id": "cream", "label": "Couleur crème", "type": "color", "group": "Marque", "targets": [T(f"b{i:02d}", "cream") for i in (1, 2, 3, 4, 5, 6, 7, 8, 9)]},
]


def project() -> dict:
    scenes = []
    for i, (t, tpl, params) in enumerate(BEATS):
        nxt = BEATS[i + 1][0] if i + 1 < len(BEATS) else END
        scenes.append({"id": f"b{i + 1:02d}", "template": tpl, "duration": round(nxt - t, 4), "params": params, "ref": {"start": t, "note": "instant read on the reference"}})
    return {"schema": "zrmd/motion-project@1", "workflow": {"id": "ppm", "name": "Premier Plan Mesuré"}, "title": "Claudia reproduit", "format": "16x9", "fps": 30, "reference": "claudia",
            "doc": "16 October 2026: Claudia teaser, foreground only (no photo, no face).",
            "theme": {"bg": "#0a0a0a", "ink": "#ede8e0", "accent": "#d27159", "fontTitle": "InterVariable", "fontBody": "InterVariable"},
            "music": {"mode": "none"}, "sfx": {"enabled": False}, "controls": CONTROLS, "scenes": scenes}


if __name__ == "__main__":
    pid = "claudia-motion"
    if (server.project_dir(pid) / "project.json").is_file():
        server.save_version(pid, "avant une nouvelle passe de reproduction")
    p = project()
    old = (server.project_dir(pid) / "project.json")
    if old.is_file():  # the verdict of Matthieu survives a rebuild
        p["validation"] = (json.loads(old.read_text(encoding="utf-8")).get("validation") or None) or p.get("validation")
        if not p["validation"]:
            p.pop("validation")
    server.write_project(pid, p)
    print(json.dumps({"id": pid, "scenes": len(p["scenes"]), "duration": round(sum(s["duration"] for s in p["scenes"]), 2)}))
