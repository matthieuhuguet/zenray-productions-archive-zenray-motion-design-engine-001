{
 "schema": "zrmd/vector-v1-parameters@1",
 "date": "14 October 2026",
 "doc": "The V1 parameter interface of a vector component (HDA law: ONE place). A component is the traced scene as params.json (palette, layers, texts, view); what a person changes without asking is listed here in three tiers: 4 PRIMARY (what changes the result most: the text string, the text colour, the main shape colour, the scale of the whole component), 8 SECONDARY, 16 TERTIARY. Each entry names its `target` in the component's parameter file (zrmd/vector/v1.py resolves the selectors main/second/shape/background/accent against the component, apply() writes the value, interface() lists the value of THIS component). `built` says the key is implemented and proven by tests/test_vector_v1.py (one proof per built key, the test fails when a built key has none); a tertiary entry that is `built: false` is listed for the next version, never silently missing. Ranges are enforced: an out-of-range value raises an error that NAMES the parameter and its range. The default of every value is the traced component itself (the interface reads it from the component), except the `view` block whose defaults are the `view.defaults` below (zrmd/vector/asset.py reads them from here). A text parameter exists only where the component has a text layer: the text-editable variant of a scene keeps a line when its font fit reaches soft IoU 0.8 (zrmd/vector/texts.py, params/vector-scene.json texts.minIou), a component composed from F3 marks always has them; elsewhere the interface says it has no main text layer instead of pretending. FR : l'interface V1 d'un composant vectoriel, un seul endroit.",
 "limits": {"primary": 4, "secondary": 8, "tertiary": 16},
 "view": {
  "doc": "How the whole component is PRESENTED (never what it is made of). The cooked SVG keeps its viewBox, so every coordinate is unchanged: scale changes the declared pixel size, offset/rotate/flip/opacity wrap the content in one <g id=\"view\">.",
  "defaults": {
   "scale": 1.0,
   "opacity": 1.0,
   "offset_x": 0.0,
   "offset_y": 0.0,
   "rotate_deg": 0.0,
   "flip_x": false,
   "transparent_background": false,
   "stroke_scale": 1.0,
   "radius_scale": 1.0,
   "adjust": {"hue": 0.0, "saturation": 0.0, "brightness": 0.0, "contrast": 0.0, "softness": 0.0}
  }
 },
 "selectors": {
  "main": "the visible text layer with the largest font size (ties: the widest traced string)",
  "second": "the visible text layer with the second largest font size",
  "shape": "the palette colour that paints the largest area of non-background shapes (measured by rendering every layer alone)",
  "background": "the palette colour of the background layer (the layer the tracer marked as background)",
  "accent": "the palette colour with the next largest painted area after the shape colour and the background"
 },
 "primary": [
  {"name": "text", "label": "Text", "kind": "text", "target": "text.main.text", "maxLength": 80, "built": true, "test": "tests/test_vector_v1.py::text",
   "doc": "The string of the main text layer. It is refitted to the width the traced string had (fit shrink: only shrinks, floor min_scale), anchor and baseline never move."},
  {"name": "textColour", "label": "Text colour", "kind": "colour", "target": "text.main.colour", "built": true, "test": "tests/test_vector_v1.py::textColour",
   "doc": "The colour of the main text layer only. It owns its palette entry: a shape that shared the colour keeps it."},
  {"name": "shapeColour", "label": "Main shape colour", "kind": "colour", "target": "palette.@shape", "built": true, "test": "tests/test_vector_v1.py::shapeColour",
   "doc": "The palette colour of the largest shape (every layer that uses it follows). A text layer that shared the entry keeps its colour."},
  {"name": "scale", "label": "Scale of the whole component", "kind": "number", "target": "view.scale", "min": 0.1, "max": 8.0, "step": 0.05, "unit": "x", "built": true, "test": "tests/test_vector_v1.py::scale",
   "doc": "Scale of the whole component (declared pixel size), 1.0 = traced size. Vector: no resolution is lost."}
 ],
 "secondary": [
  {"name": "backgroundColour", "label": "Background colour", "kind": "colour", "target": "palette.@background", "built": true, "test": "tests/test_vector_v1.py::backgroundColour",
   "doc": "The palette colour of the background layer."},
  {"name": "accentColour", "label": "Accent colour", "kind": "colour", "target": "palette.@accent", "built": true, "test": "tests/test_vector_v1.py::accentColour",
   "doc": "The palette colour with the next largest painted area (highlight, bar, badge)."},
  {"name": "textSize", "label": "Text size", "kind": "number", "target": "text.main.size_px", "min": 4, "max": 600, "step": 1, "unit": "px", "built": true, "test": "tests/test_vector_v1.py::textSize",
   "doc": "Font size of the main text layer at the traced box width; the fit still shrinks a long string."},
  {"name": "textTracking", "label": "Text tracking", "kind": "number", "target": "text.main.tracking_em", "min": -0.2, "max": 0.6, "step": 0.01, "unit": "em", "built": true, "test": "tests/test_vector_v1.py::textTracking",
   "doc": "Letter spacing of the main text layer."},
  {"name": "textAlign", "label": "Text alignment", "kind": "choice", "target": "text.main.align", "choices": ["left", "centre", "right"], "built": true, "test": "tests/test_vector_v1.py::textAlign",
   "doc": "Which edge of the traced box the string keeps when it is shorter or longer."},
  {"name": "opacity", "label": "Opacity of the whole component", "kind": "number", "target": "view.opacity", "min": 0.0, "max": 1.0, "step": 0.01, "unit": "", "built": true, "test": "tests/test_vector_v1.py::opacity",
   "doc": "Opacity of the whole component."},
  {"name": "offsetX", "label": "Offset X", "kind": "number", "target": "view.offset_x", "min": -4000, "max": 4000, "step": 1, "unit": "canvas px", "built": true, "test": "tests/test_vector_v1.py::offsetX",
   "doc": "Moves the whole component horizontally, in canvas pixels (before scale)."},
  {"name": "offsetY", "label": "Offset Y", "kind": "number", "target": "view.offset_y", "min": -4000, "max": 4000, "step": 1, "unit": "canvas px", "built": true, "test": "tests/test_vector_v1.py::offsetY",
   "doc": "Moves the whole component vertically, in canvas pixels (before scale)."}
 ],
 "tertiary": [
  {"name": "rotate", "label": "Rotation", "kind": "number", "target": "view.rotate_deg", "min": -180, "max": 180, "step": 0.5, "unit": "deg", "built": true, "test": "tests/test_vector_v1.py::rotate",
   "doc": "Rotates the whole component about the centre of the canvas."},
  {"name": "flipX", "label": "Mirror horizontally", "kind": "bool", "target": "view.flip_x", "built": true, "test": "tests/test_vector_v1.py::flipX",
   "doc": "Mirrors the whole component left to right."},
  {"name": "transparentBackground", "label": "Transparent background", "kind": "bool", "target": "view.transparent_background", "built": true, "test": "tests/test_vector_v1.py::transparentBackground",
   "doc": "Hides the background layer so the component sits over other content."},
  {"name": "strokeScale", "label": "Stroke width scale", "kind": "number", "target": "view.stroke_scale", "min": 0.1, "max": 8.0, "step": 0.05, "unit": "x", "built": true, "test": "tests/test_vector_v1.py::strokeScale",
   "doc": "Multiplies the width of every stroked shape (lines, arcs, polylines, stroke paths)."},
  {"name": "radiusScale", "label": "Corner radius scale", "kind": "number", "target": "view.radius_scale", "min": 0.0, "max": 8.0, "step": 0.05, "unit": "x", "built": true, "test": "tests/test_vector_v1.py::radiusScale",
   "doc": "Multiplies the corner radius of every rounded rectangle."},
  {"name": "text2", "label": "Second text", "kind": "text", "target": "text.second.text", "maxLength": 80, "built": true, "test": "tests/test_vector_v1.py::text2",
   "doc": "The string of the second text layer (same fit rules as the main text)."},
  {"name": "text2Colour", "label": "Second text colour", "kind": "colour", "target": "text.second.colour", "built": true, "test": "tests/test_vector_v1.py::text2Colour",
   "doc": "The colour of the second text layer only."},
  {"name": "textFit", "label": "Text fit mode", "kind": "choice", "target": "text.main.fit", "choices": ["shrink", "box", "keep"], "built": true, "test": "tests/test_vector_v1.py::textFit",
   "doc": "shrink: a long string is shrunk to the traced width; box: a short one also grows to it; keep: the size never changes (may overflow)."},
  {"name": "textMinScale", "label": "Smallest text scale", "kind": "number", "target": "text.main.min_scale", "min": 0.05, "max": 1.0, "step": 0.01, "unit": "x", "built": true, "test": "tests/test_vector_v1.py::textMinScale",
   "doc": "The legibility floor of the shrink: a string that would need less than this scale overflows instead."},
  {"name": "textBaseline", "label": "Text baseline shift", "kind": "number", "target": "text.main.baseline_shift_px", "min": -400, "max": 400, "step": 1, "unit": "canvas px", "built": true, "test": "tests/test_vector_v1.py::textBaseline",
   "doc": "Moves the main text layer vertically from its traced baseline."},
  {"name": "fontWeight", "label": "Font weight (wght axis)", "kind": "number", "target": "text.main.axes.wght", "min": 100, "max": 900, "step": 10, "unit": "", "built": true, "test": "tests/test_vector_v1.py::fontWeight",
   "doc": "The wght axis of the main text layer when its font is a variable font."},
  {"name": "layerVisible", "label": "Show or hide layers", "kind": "map:bool", "target": "layers.*.visible", "built": true, "test": "tests/test_vector_v1.py::layerVisible",
   "doc": "{layer id: true or false}; a text layer id (T00) works too."},
  {"name": "layerOpacity", "label": "Opacity of single layers", "kind": "map:number", "target": "layers.*.opacity", "min": 0.0, "max": 1.0, "built": true, "test": "tests/test_vector_v1.py::layerOpacity",
   "doc": "{layer id: 0..1}."},
  {"name": "layerBlur", "label": "Blur of single layers (shader hand-off)", "kind": "map:number", "target": "layers.*.blur", "min": 0.0, "max": 64.0, "unit": "px", "built": true, "test": "tests/test_vector_v1.py::layerBlur",
   "doc": "{layer id: sigma in px}; a blur is a shader value, the layer stays a shape."},
  {"name": "paletteColour", "label": "Any palette colour", "kind": "map:colour", "target": "palette.*", "built": true, "test": "tests/test_vector_v1.py::paletteColour",
   "doc": "{palette key: #rrggbb} for a colour the three named colour parameters do not reach."},
  {"name": "adjust", "label": "Whole-stack adjustments", "kind": "map:number", "target": "view.adjust.*", "min": -1.0, "max": 1.0, "step": 0.01, "unit": "-1 to 1",
   "keys": ["hue", "saturation", "brightness", "contrast", "softness"], "built": true, "test": "tests/test_vector_v1.py::adjust",
   "doc": "{hue, saturation, brightness, contrast, softness}: adjustment layers of the whole stack, the way a graphics editor stacks them over many layers. hue turns the colours by up to 180 degrees, saturation and contrast scale by 1 + value, brightness moves the level by up to half the range, softness is a gaussian blur of up to 8 px (negative = 0). All 0 is the traced component to the pixel."}
 ]
}
