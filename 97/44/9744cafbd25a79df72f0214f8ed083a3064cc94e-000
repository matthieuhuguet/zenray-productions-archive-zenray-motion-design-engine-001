    let t0 = null, last = 0, acc = 0, shift = false;
    return {
      down(now, isShift) { t0 = now; last = now; acc = 0; shift = !!isShift; },
      up() { t0 = null; acc = 0; },
      active() { return t0 !== null; },
      poll(now) {
