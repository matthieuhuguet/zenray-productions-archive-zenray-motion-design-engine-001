// ZenRay Motion Design, the logic of the hover player (18 October 2026), with no screen in it so that it is proven by node (motion/tests/test_hoverplay.mjs):
// the pointer over a video plays it, the space bar toggles pause and play, the arrows move by one image, and an arrow held down scrolls the images fast (own repeat, tunable, steady).
// The DOM glue (hoverplay.js) feeds it events; a player is described by an adapter { play, pause, playing, time, duration, seek, fps }.
// Every number is a parameter (PARAMS, saved by the settings panel). FR : la logique du lecteur au survol, sans ecran, prouvee par node.
(function (root, factory) {
  if (typeof module === "object" && module.exports) module.exports = factory(); else root.ZSHoverCore = factory();
