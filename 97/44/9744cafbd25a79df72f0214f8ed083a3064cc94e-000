  "use strict";
  // hover: play under the pointer · sound: the editor preview plays with its sound (off: image only) · holdDelay: seconds before a held arrow scrolls · holdRate: images per second when it starts
  // holdAccel: how many times faster it ends (reached after holdRamp seconds) · shiftRate: seconds of film per second with Shift held
  const DEFAULTS = { hover: true, sound: false, holdDelay: 0.25, holdRate: 30, holdAccel: 4, holdRamp: 1.5, shiftRate: 8 };
  // range and step of every number, read by the settings panel and by clean()
  const RANGE = { holdDelay: [0, 2, 0.05], holdRate: [2, 240, 1], holdAccel: [1, 16, 0.5], holdRamp: [0.1, 6, 0.1], shiftRate: [1, 60, 1] };
