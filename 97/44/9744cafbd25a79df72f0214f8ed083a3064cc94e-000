    Object.keys(RANGE).forEach((k) => { const v = Number(src[k]); r[k] = isFinite(v) && src[k] !== "" && src[k] !== null && src[k] !== undefined ? Math.max(RANGE[k][0], Math.min(RANGE[k][1], v)) : DEFAULTS[k]; });
    return r;
