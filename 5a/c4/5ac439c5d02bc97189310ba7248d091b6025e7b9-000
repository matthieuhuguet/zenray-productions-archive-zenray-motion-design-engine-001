// 12 October 2026: Point light glow 1 / (1 + (r / radius)^power), coloured, clamped. Colour block for the add blend.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: color (sRGB 0..1), center (uv), radius (uv (height units)), power (falloff exponent), intensity (gain), aspect (width / height).
vec4 glow_inverse_point(vec2 uv, vec3 color, vec2 center, float radius, float power, float intensity, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float g = intensity / (1.0 + pow(length(p) / radius, power));
  return vec4(clamp(color * g, 0.0, 1.0), 1.0);
}
