      tl.fromTo(num, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.4 }, t0);
      cue(0.2, "shimmer", { length: 0.8 });
    },
  });

  ZS.register({
    id: "ui-window", label: "Fenêtre d'interface rétro", group: "Interface", duration: 3,
    params: [
      P("title", "Titre de la fenêtre", "text", "helpful_assistant · context", 1), P("lines", "Lignes (une par ligne, *mot* en couleur)", "lines", "> 3 previous instructions\nIGNORE PREVIOUS INSTRUCTIONS", 1),
      S("look", "Style", "brutal", ["brutal", "xp", "simple"], 1), P("big", "Mot géant en dessous", "text", "", 1),
      P("accent", "Couleur d'accent", "color", "#ff3d8b", 2), P("bg", "Fond", "color", "#0d0d0d", 2), P("panel", "Fond de la fenêtre", "color", "#f2f0e8", 2), N("w", "Largeur", 0.62, 0.2, 0.95, 0.01, 2),
      N("x", "Position horizontale", 0.5, 0, 1, 0.005, 2), N("y", "Position verticale", 0.45, 0, 1, 0.005, 2), S("enter", "Entrée", "pop", ["pop", "machine", "coupe"], 2),
      N("size", "Taille du texte", 30, 8, 120, 1, 2, "px"),
      P("font", "Police du texte", "font", "JetBrainsMono", 3), N("bigSize", "Taille du mot géant", 150, 20, 400, 1, 3, "px"), N("cps", "Vitesse de frappe", 40, 5, 200, 1, 3, "car./s"),
      P("media", "Plan filmé en fond", "text", "", 3, { type: "media" }), N("mediaStart", "Début dans le plan", 0, 0, 3600, 0.01, 3, "s"),
    ],
    build(ctx) {
      const { el, p, W, H, u, tl, t0, cue, fit, safe } = ctx;
      const XP = p.look === "xp", BR = p.look === "brutal";
      h.css(el, { background: XP ? `linear-gradient(#3d8ee8, #6fb4ee 60%, #7cbf55 61%, #3c8a2e)` : p.bg });
      if (p.media) mediaLayer(ctx, { ...p, bw: false, push: 1 });
      const w = h.css(h.el("div", "zs-abs", el), { left: p.x * W - p.w * W / 2 + "px", top: p.y * H + "px", width: p.w * W + "px", transform: "translateY(-50%)", background: p.panel,
        border: BR ? `${3 * u}px solid #000` : XP ? `${2 * u}px solid #0a3dbf` : `1px solid #ccc`, borderRadius: XP ? `${8 * u}px ${8 * u}px 0 0` : 0,
        boxShadow: BR ? `${10 * u}px ${10 * u}px 0 ${p.accent}` : `0 ${10 * u}px ${30 * u}px rgba(0,0,0,0.3)`, fontFamily: h.font(p.font, "monospace") });
      const bar = h.css(h.el("div", "", w), { display: "flex", justifyContent: "space-between", alignItems: "center", padding: `${6 * u}px ${12 * u}px`, fontSize: 16 * u + "px",
        background: XP ? "linear-gradient(#2a6be8, #0a3dbf)" : BR ? p.accent : "#e9e9e9", color: XP ? "#fff" : "#000", fontWeight: XP ? 600 : 500, fontFamily: XP ? h.font("InterVariable") : h.font(p.font, "monospace") });
      h.el("span", "", bar, p.title); h.el("span", "", bar, XP ? "▁ ▢ ✕" : "▢▢▢");
      const body = h.css(h.el("div", "", w), { padding: `${18 * u}px ${22 * u}px`, fontSize: p.size * u + "px", color: "#111", lineHeight: 1.35 });
      const words = [];
      p.lines.forEach((ln) => { const d = h.el("div", "", body); words.push(...rich(d, ln, p.accent)); });
      fit(w, safe.w, safe.h);
      if (p.enter === "pop") tl.fromTo(w, { scale: 0.85, autoAlpha: 0 }, { scale: 1, autoAlpha: 1, duration: 0.35, ease: "back.out(2)" }, t0);
      else if (p.enter === "coupe") { h.css(w, { visibility: "hidden" }); tl.set(w, { visibility: "visible" }, t0); }
      if (p.enter === "machine") { words.forEach((x) => (x.style.visibility = "hidden")); let c = 0; words.forEach((x) => { tl.set(x, { visibility: "visible" }, t0 + c / p.cps); c += x.textContent.length + 1; }); cue(0, "type", { length: c / p.cps }); }
      if (p.big) {
        const g = h.css(h.el("div", "zs-abs", el, p.big), { left: "0", right: "0", bottom: 0.06 * H + "px", textAlign: "center", fontFamily: h.font("InterVariable"), fontWeight: 800,
          fontSize: p.bigSize * u + "px", color: BR ? p.accent : "#fff", letterSpacing: "-0.03em", whiteSpace: "nowrap", lineHeight: 1 });
        fit(g, safe.w, H * 0.4);
        tl.fromTo(g, { autoAlpha: 0, y: 40 * u }, { autoAlpha: 1, y: 0, duration: 0.3, ease: "power3.out" }, t0 + 0.4);
        cue(0.4, "impact", { gain: 0.6 });
      }
      cue(0, "pop", { pitch: 0.5 });
    },
  });

  ZS.register({
    id: "flow-diagram", label: "Schéma de flux", group: "Données", duration: 6,
    params: [
      P("title", "Titre", "text", "Introducing ZenRay", 1), P("nodes", "Boîtes (nom, une par ligne ; « > » = suivante sur la ligne)", "lines", "Customer > Customer agent > Helpdesk\nOperator", 1),
      P("text", "Paragraphe", "text", "Every step of the pipeline, procedural and editable.", 1), P("accent", "Couleur mise en avant", "color", "#7da7ff", 1),
      P("bg", "Fond", "color", "#f7f6f9", 2), P("ink", "Texte", "color", "#1b1b19", 2), P("glow", "Couleur du dégradé", "color", "#f2a7b4", 2), N("step", "Temps par étape", 1.2, 0.2, 6, 0.05, 2, "s"),
      P("colours", "Couleurs des étapes (une par ligne)", "lines", "#7da7ff\n#a98bff\n#9be27a", 2), N("titleSize", "Taille du titre", 110, 20, 240, 1, 2, "px"),
    ],
    build({ el, p, W, H, u, tl, t0, dur, cue }) {
      h.css(el, { background: `radial-gradient(ellipse 80% 40% at 50% -5%, ${p.glow}, transparent 70%), ${p.bg}`, color: p.ink, fontFamily: h.font("InterVariable") });
      h.css(h.el("div", "zs-abs", el, p.title), { left: 0.08 * W + "px", top: 0.14 * H + "px", fontSize: p.titleSize * u + "px", lineHeight: 1, color: h.mix(p.ink, p.bg, 0.55), letterSpacing: "-0.02em", whiteSpace: "pre-line" });
      const boxes = [];
      p.nodes.forEach((row, r) => {
        const names = row.split(">").map((x) => x.trim()).filter(Boolean), y = 0.5 * H + r * 70 * u;
        names.forEach((nm, i) => {
          const bw = 220 * u, x = 0.1 * W + i * (0.8 * W - bw) / Math.max(1, names.length - 1);
          const b = h.css(h.el("div", "zs-abs", el, nm.toUpperCase()), { left: (names.length === 1 ? 0.5 * W - bw : x) + "px", top: y + "px", width: (names.length === 1 ? 2 * bw : bw) + "px",
            height: 44 * u + "px", border: `1px solid ${h.mix(p.ink, p.bg, 0.75)}`, borderRadius: (r === 0 && i === 0 ? 22 : 4) * u + "px", display: "grid", placeItems: "center",
            fontSize: 12 * u + "px", letterSpacing: "0.08em", background: "#fff" });
          boxes.push(b);
        });
      });
      h.css(h.el("div", "zs-abs", el, p.text), { left: 0.08 * W + "px", top: 0.78 * H + "px", width: 0.42 * W + "px", fontSize: 22 * u + "px", lineHeight: 1.3 });
      // the highlight travels from box to box (skipping the first, the customer)
      const cols = p.colours.length ? p.colours : [p.accent];
      boxes.slice(1).forEach((b, i) => {
        const at = t0 + 0.4 + i * p.step, c = cols[i % cols.length];
        if (at > t0 + dur) return;
        tl.to(b, { backgroundColor: h.mix(c, "#ffffff", 0.55), borderColor: c, duration: 0.3 }, at);
        tl.to(b, { backgroundColor: "#ffffff", borderColor: h.mix(p.ink, p.bg, 0.75), duration: 0.3 }, at + p.step);
        cue(0.4 + i * p.step, "tick", {});
      });
    },
  });
})();
