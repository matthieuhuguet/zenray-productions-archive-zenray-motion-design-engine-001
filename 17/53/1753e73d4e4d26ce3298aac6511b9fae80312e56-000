// 12 October 2026: Cyclic conic (angular) gradient c0, c1, c2 and back to c0 around a centre, seamless. Colour block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: center (uv), offset (degrees), c0 (sRGB 0..1), c1 (sRGB 0..1), c2 (sRGB 0..1), aspect (width / height).
vec4 conic_gradient3(vec2 uv, vec2 center, float offset, vec3 c0, vec3 c1, vec3 c2, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float t = fract((atan(p.y, p.x) - radians(offset)) / 6.28318530718) * 3.0;
  vec3 col = t < 1.0 ? mix(c0, c1, t) : (t < 2.0 ? mix(c1, c2, t - 1.0) : mix(c2, c0, t - 2.0));
  return vec4(col, 1.0);
}
