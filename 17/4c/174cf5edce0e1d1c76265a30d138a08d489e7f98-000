def rel(path):
    """Absolute M/L/C/Z path -> relative m/l/c/z with one decimal: about half the bytes (the paths are applied by the browser, which accepts relative commands)."""
    import re
    toks = re.findall(r"[MLCZ]|-?\d+(?:\.\d+)?", path); out, i, cx, cy, sx, sy = [], 0, 0.0, 0.0, 0.0, 0.0
    def f(v):
        t = ("%.1f" % v).rstrip("0").rstrip(".")
        return "0" if t in ("-0", "") else t
    # deltas are taken against the ROUNDED current point, so rounding never drifts along the path
    while i < len(toks):
        c = toks[i]; i += 1
        if c == "Z": out.append("z"); cx, cy = sx, sy; continue
        n = 6 if c == "C" else 2; v = [float(x) for x in toks[i:i + n]]; i += n
        def d(val, cur): return round(round(val, 1) - round(cur, 1), 1)
        if c in ("M", "L"):
            dx, dy = d(v[0], cx), d(v[1], cy); out.append(c.lower() + f(dx) + " " + f(dy)); cx, cy = round(cx, 1) + dx, round(cy, 1) + dy
            if c == "M": sx, sy = cx, cy
        else:
            vals = []; px, py = round(cx, 1), round(cy, 1)
            for j in range(6):
                base = px if j % 2 == 0 else py; dv = d(v[j], base) if False else round(round(v[j], 1) - base, 1); vals.append(dv)
            out.append("c" + " ".join(f(x) for x in vals)); cx, cy = px + vals[4], py + vals[5]
    return "".join(out)

def r1(path):
    return rel(path)
