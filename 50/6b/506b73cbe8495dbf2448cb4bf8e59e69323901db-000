"""Trace the lettering of the word STUDIOS from the resting frame of the reference (23 October 2026), workflow Premier Plan Mesure.
Each letter is a connected component of the text row; its coverage field (white 236 on black) is zoomed x8 (cubic), cut at 0.5 and traced by potrace.
Writes motion/runtime/zs-templates-playstation-font-1.js (window.ZSPSFont): per letter the path, its transform to reference pixels (origin = the top left of the letter box),
its box and its offset to the cap line; plus the measured cap height, stem and natural gaps. The letters that STUDIOS does not contain are drawn by the procedural font of the template.
FR : decalque des lettres de STUDIOS sur l'image de repos de la reference. Usage: python3 Scripts/PlayStationFontTrace.py <frame.png>"""
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

import numpy as np
from PIL import Image
from scipy import ndimage

ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / "motion" / "runtime" / "zs-templates-playstation-font-1.js"
REGION = (735, 722, 1185, 810)   # x0, y0, x1, y1 of the text row on the reference
PAPER, K = 236.0, 8
WORD = "STUDIOS"


def main():
    L = np.asarray(Image.open(sys.argv[1]).convert("L")).astype(float)
    x0, y0, x1, y1 = REGION
    reg = L[y0:y1, x0:x1]
    lab, n = ndimage.label(reg > 110)
    boxes = sorted(((sl[1].start + x0, sl[1].stop + x0, sl[0].start + y0, sl[0].stop + y0, i + 1) for i, sl in enumerate(ndimage.find_objects(lab))))
    if len(boxes) != len(WORD):
        raise SystemExit(f"expected {len(WORD)} letters, found {len(boxes)}")
    flat = [b[3] - b[2] for b, ch in zip(boxes, WORD) if ch in "TUDI"]
    cap_top = min(b[2] for b in boxes if True)
    cap = int(np.median(flat))
    letters, glyphs = [], {}
    for (bx0, bx1, by0, by1, idx), ch in zip(boxes, WORD):
        pad = 3
        crop = L[by0 - pad:by1 + pad, bx0 - pad:bx1 + pad]
        mask = (lab[by0 - y0 - pad:by1 - y0 + pad, bx0 - x0 - pad:bx1 - x0 + pad] > 0)
        cov = np.clip(crop / PAPER, 0, 1) * ndimage.binary_dilation(mask, iterations=3)
        big = ndimage.zoom(cov, K, order=3) > 0.5
        with tempfile.TemporaryDirectory() as d:
            pbm = Path(d) / "g.pbm"
            Image.fromarray((~big * 255).astype("uint8")).convert("1").save(pbm)
            svg = Path(d) / "g.svg"
            subprocess.run(["potrace", str(pbm), "-b", "svg", "-o", str(svg), "-t", "30", "-a", "1.0", "-O", "0.4", "--tight"], check=True)
            text = svg.read_text()
        ys, xs = np.where(big)
        tr = re.search(r'<g transform="([^"]+)"', text).group(1)
        m = re.match(r"translate\(([-\d.]+),([-\d.]+)\) scale\(([-\d.]+),([-\d.]+)\)", tr)
        a, b = float(m.group(1)), float(m.group(2))
        d_all = " ".join(" ".join(re.findall(r'<path d="([^"]+)"', text)).split())
        vb = re.search(r'viewBox="([^"]+)"', text).group(1).split()
        w, h = float(vb[2]) / K, float(vb[3]) / K
        ox = (xs.min() / K) - pad + bx0 - bx0   # box left inside the crop, in reference px
        glyphs[ch] = {"d": d_all, "tf": f"scale({1 / K}) translate({a},{b}) scale(0.1,-0.1)", "w": round(w, 2), "h": round(h, 2)}
        letters.append({"ch": ch, "x": bx0 - boxes[0][0], "top": by0 - cap_top, "w": bx1 - bx0, "h": by1 - by0})
        del ox
    gaps = [letters[i + 1]["x"] - (letters[i]["x"] + letters[i]["w"]) for i in range(len(letters) - 1)]
    stem = min(l["w"] for l in letters if l["ch"] == "I")
    mean_gap = sum(gaps) / len(gaps)
    kern = {WORD[i] + WORD[i + 1]: round(gaps[i] - mean_gap, 2) for i in range(len(gaps))}   # kerning of the pairs of the reference: the measured gap minus the mean gap
    data = {"word": WORD, "cap": cap, "stem": stem, "gaps": gaps, "kern": kern, "letters": letters, "glyphs": glyphs}
    OUT.write_text("// 23 October 2026: the letters of STUDIOS traced on the reference by Scripts/PlayStationFontTrace.py (coverage field, potrace). FR : lettres decalquees de STUDIOS.\nwindow.ZSPSFont = " + json.dumps(data) + ";\n")
    print("wrote", OUT, "cap", cap, "stem", stem, "gaps", gaps, [(l["ch"], l["w"], l["h"], l["top"]) for l in letters])


if __name__ == "__main__":
    main()
