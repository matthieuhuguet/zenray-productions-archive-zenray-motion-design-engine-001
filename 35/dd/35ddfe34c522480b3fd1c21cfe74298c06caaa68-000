FAMILY = settings.REPO / "params" / "timeline.json"
MOTIONS = settings.path("workshop") / "motions"


class SpecError(ValueError):
    """A refused spec: the message names the track, the clip and the value."""


def family() -> dict:
    return json.loads(FAMILY.read_text(encoding="utf-8"))


def root() -> Path:
    """Where timelines are written: params/timeline.json 'root', or ZRMD_PATH_TIMELINES for an isolated test."""
    return Path(os.environ.get("ZRMD_PATH_TIMELINES") or family()["root"])


def motions_dir() -> Path:
    return Path(os.environ.get("ZRMD_PATH_MOTIONS") or (settings.path("workshop") / "motions"))


def _allowed_roots(fam: dict) -> list[Path]:
    return [Path(r.replace("{home}", str(Path.home()))).resolve() for r in fam["fileRoots"]]


def _inside(path: Path, roots: list[Path]) -> bool:
    p = path.resolve()
    return any(p == r or r in p.parents for r in roots)


def _num(clip: dict, key: str, default: float, lo: float, hi: float, where: str) -> float:
    v = clip.get(key, default)
    try:
        v = float(v)
    except (TypeError, ValueError):
        raise SpecError(f"{where}: {key} must be a number, got {v!r}")
    if not (lo <= v <= hi):
        raise SpecError(f"{where}: {key}={v} outside [{lo}, {hi}]")
    return v


def resolve_source(src: dict, fam: dict, where: str, kinds: tuple[str, ...]) -> tuple[Path, str]:
    """{'kind': 'motion', 'motion': id, 'version': 'V_045'} or {'kind': 'file', 'path': absolute}; returns (path, kind of media)."""
    k = src.get("kind")
    if k == "motion":
        motion = str(src.get("motion", ""))
        if not re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]*$", motion):
            raise SpecError(f"{where}: invalid motion id {motion!r}")
        folder = motions_dir() / motion
        version = src.get("version") or versions.latest_version(folder)
        if not version or not versions.VERSION_RE.match(version):
            raise SpecError(f"{where}: motion {motion} has no version {version!r}")
        path = folder / version / "render.mp4"
        media = "video"
    elif k == "file":
        path = Path(str(src.get("path", "")))
        if not path.is_absolute():
            raise SpecError(f"{where}: a file clip needs an absolute path")
        if not _inside(path, _allowed_roots(fam)):
            raise SpecError(f"{where}: file outside the allowed folders")
        ext = path.suffix.lower()
        if ext in fam["clipExtensions"]:
            media = "video"
        elif ext in fam["imageExtensions"]:
            media = "image"
        elif ext in fam["audioExtensions"]:
            media = "audio"
        else:
            raise SpecError(f"{where}: extension {ext} refused")
    else:
        raise SpecError(f"{where}: unknown source kind {k!r}")
    if media not in kinds:
        raise SpecError(f"{where}: a {media} source cannot go on this track")
    if not path.is_file():
        raise SpecError(f"{where}: file missing: {path}")
    return path, media


def plan(spec: dict, *, probe_fn=legacy.probe) -> dict:
    """Validate the spec and return the frame-exact plan shared by every format."""
    fam = family()
    if not isinstance(spec, dict):
        raise SpecError("the spec must be an object")
    tid = str(spec.get("id", ""))
    if not re.match(fam["idPattern"], tid):
        raise SpecError(f"timeline id {tid!r} must match {fam['idPattern']}")
    fps = int(spec.get("fps") or fam["fps"])
    if fps not in (24, 25, 30, 50, 60):
        raise SpecError(f"fps {fps} not in (24, 25, 30, 50, 60)")
    scale = int(spec.get("scale") or fam["export"]["defaultScale"])
    if scale not in fam["export"]["scales"]:
        raise SpecError(f"scale {scale} not in {fam['export']['scales']}")
    container = spec.get("container") or fam["export"]["defaultContainer"]
    if container not in fam["export"]["containers"]:
        raise SpecError(f"container {container!r} not in {fam['export']['containers']}")
    fit_default = spec.get("fit") or fam["defaultFit"]
    if fit_default not in fam["fits"]:
        raise SpecError(f"fit {fit_default!r} not in {fam['fits']}")
    formats = spec.get("formats") or ([spec["format"]] if spec.get("format") else [fam["defaultFormat"]])
    for f in formats:
        if f not in fam["formats"]:
            raise SpecError(f"unknown format {f!r}, expected one of {list(fam['formats'])}")
    tracks_in = spec.get("tracks") or []
    if not tracks_in or len(tracks_in) > fam["limits"]["tracks"]:
        raise SpecError(f"a timeline needs 1 to {fam['limits']['tracks']} tracks")
    T = fam["text"]
    tracks, end_f, seen_ids, text_total = [], 0, set(), 0
    for ti, tr in enumerate(tracks_in):
        kind = tr.get("kind")
        if kind not in ("video", "text", "audio"):
            raise SpecError(f"track {ti + 1}: kind {kind!r} not in video, text, audio")
        clips_in = tr.get("clips") or []
        if len(clips_in) > fam["limits"]["clipsPerTrack"]:
            raise SpecError(f"track {ti + 1}: more than {fam['limits']['clipsPerTrack']} clips")
        cursor, clips = 0.0, []
        for ci, c in enumerate(clips_in):
            where = f"track {ti + 1} clip {ci + 1}"
            cid = str(c.get("id") or f"t{ti + 1}c{ci + 1}")
            if not re.match(fam["clipIdPattern"], cid) or cid in seen_ids:
                raise SpecError(f"{where}: clip id {cid!r} invalid or repeated")
            seen_ids.add(cid)
            start = _num(c, "start", cursor, 0, fam["limits"]["seconds"], where)
            fx = {"fade_in": _num(c, "fadeIn", 0.0, *fam["fade"]["range"], where), "fade_out": _num(c, "fadeOut", 0.0, *fam["fade"]["range"], where)}
            if kind == "text":
                text = str(c.get("text", ""))
                if not text.strip():
                    raise SpecError(f"{where}: empty text")
                if len(text) > T["maxChars"]:
                    raise SpecError(f"{where}: text longer than {T['maxChars']} characters")
                font = c.get("font") or T["font"]
                if font not in T["fonts"]:
                    raise SpecError(f"{where}: font {font!r} not in {T['fonts']}")
                anim = c.get("anim") or T["defaultAnim"]
                if anim not in T["anims"]:
                    raise SpecError(f"{where}: anim {anim!r} not in {T['anims']}")
                color = str(c.get("color") or T["color"])
                if not re.match(r"^#[0-9a-fA-F]{6}$", color):
                    raise SpecError(f"{where}: color must be #rrggbb")
                dur = _num(c, "duration", 2.0, 0.1, fam["limits"]["seconds"], where)
                accent = str(c.get("accent") or T["accent"])
                if not re.match(r"^#[0-9a-fA-F]{6}$", accent):
                    raise SpecError(f"{where}: accent must be #rrggbb")
                item = {**fx, "accent": accent.lower(), "id": cid, "kind": "text", "text": text, "font": font, "anim": anim, "color": color.lower(),
                        "x": _num(c, "x", T["x"], 0, 1, where), "y": _num(c, "y", T["y"], 0, 1, where),
                        "size": _num(c, "size", T["size"], *T["sizeRange"], where),
                        "weight": int(_num(c, "weight", T["weight"], *T["weightRange"], where)),
                        "align": c.get("align") if c.get("align") in ("left", "center", "right") else T["align"],
                        "wrap": bool(c.get("wrap", False)),
                        "start_frame": int(round(start * fps)), "frames": max(1, int(round(dur * fps)))}
                text_total += 1
                if text_total > fam["limits"]["textClips"]:
                    raise SpecError(f"more than {fam['limits']['textClips']} text clips")
            else:
                kinds = ("video", "image") if kind == "video" else ("audio", "video")
                path, media = resolve_source(c.get("source") or {}, fam, where, kinds)
                text_only = bool(c.get("textOnly"))
                if text_only and (c.get("source") or {}).get("kind") != "motion":
                    raise SpecError(f"{where}: textOnly is for a motion source")
                if media == "image":
                    dur = _num(c, "duration", fam["imageSeconds"], 0.1, fam["limits"]["seconds"], where)
                    src_in, src_out, has_audio = 0.0, dur, False
                else:
                    info = probe_fn(path)
                    src_in = _num(c, "in", 0.0, 0, max(info["duration"] - 0.02, 0), where)
                    src_out = _num(c, "out", info["duration"], src_in + 0.02, info["duration"] + 0.001, where)
                    dur = src_out - src_in
                    has_audio = bool(info["audio"]) and not c.get("mute") and not text_only
                fit = c.get("fit") or fit_default
                if fit not in fam["fits"]:
                    raise SpecError(f"{where}: fit {fit!r} not in {fam['fits']}")
                G = fam["grade"]
                grade = {k: _num(c, k, G[k][2], G[k][0], G[k][1], where) for k in ("brightness", "contrast", "saturate")}
                item = {**fx, "grade": grade, "id": cid, "kind": media if kind == "video" else "audio", "src": str(path), "source": c.get("source"),
                        "textOnly": text_only, "fit": fit, "audio": has_audio, "volume": _num(c, "volume", 1.0, 0, 2, where),
                        "opacity": _num(c, "opacity", 1.0, 0, 1, where),
                        "start_frame": int(round(start * fps)), "frames": max(1, int(round(dur * fps))),
                        "media_start_frame": int(round(src_in * fps))}
            cursor = start + item["frames"] / fps
            end_f = max(end_f, item["start_frame"] + item["frames"])
            clips.append(item)
        tracks.append({"id": str(tr.get("id") or f"{kind}{ti + 1}"), "kind": kind, "clips": clips})
    if end_f == 0:
        raise SpecError("the timeline is empty")
    if end_f / fps > fam["limits"]["seconds"]:
        raise SpecError(f"the timeline lasts {end_f / fps:.1f} s, above {fam['limits']['seconds']} s")
    return {"id": tid, "fps": fps, "frames": end_f, "formats": formats, "scale": scale, "container": container, "background": spec.get("background") or fam["background"], "tracks": tracks}


# ------------------------------------------------------------------------------------------------ text-only overlay of a motion

def prepare_overlay(motion: str, version: str | None = None, *, render_fn=None) -> Path:
    """The motion rendered with its background layers hidden, as an alpha WebM (cached by motion, version and params hash)."""
    fam = family()
    folder = motions_dir() / motion
    version = version or versions.latest_version(folder)
    vdir = folder / version
    params = versions.read_json(vdir / "params.json", {}) or {}
    src = None
    for cand in sorted(vdir.iterdir()):
        if cand.is_dir() and (cand / "index.html").exists():
            src = cand
            break
    if src is None:
        raise SpecError(f"motion {motion} {version} has no cooked composition to render text only")
    hide = list(fam["overlay"]["hideLayers"])
    layers = params.get("layers") if isinstance(params, dict) else None
    if isinstance(layers, list):
        hide += [str(l.get("id")) for l in layers if isinstance(l, dict) and l.get("type") in ("solid", "field", "image", "video", "gradient") and l.get("id")]
    key = hashlib.sha256(json.dumps([motion, version, sorted(set(hide)), (vdir / "params.json").stat().st_mtime_ns], default=str).encode()).hexdigest()[:10]
    out = root() / "_overlays" / f"{motion}-{version}-{key}.webm"
    if out.exists():
        return out
    out.parent.mkdir(parents=True, exist_ok=True)
    work = out.parent / f"_work-{key}"
    if work.exists():
        shutil.rmtree(work)
    shutil.copytree(src, work)
    css = work / "styles.css"
    extra = "\n/* text only (14 October 2026) */\nhtml, body, #root { background: transparent !important; }\n" + "".join(
        f"#{re.sub(r'[^A-Za-z0-9_-]', '', lid)} {{ display: none !important; }}\n" for lid in sorted(set(hide)))
    css.write_text((css.read_text(encoding="utf-8") if css.exists() else "") + extra, encoding="utf-8")
    fps = int(params.get("canvas", {}).get("fps", 30)) if isinstance(params.get("canvas"), dict) else 30
    render = render_fn or _render
    try:
        render(work, out, fps=min(fps, 60), workers=1, quality=fam["render"]["overlayQuality"], fmt=fam["render"]["overlayFormat"])
    finally:
        shutil.rmtree(work, ignore_errors=True)
    return out


def _render(project: Path, out: Path, *, fps: int, workers: int, quality: str, fmt: str = "mp4") -> Path:
    from .. import render as R
    out = Path(out).resolve()
    out.parent.mkdir(parents=True, exist_ok=True)
    args = ["render", "-f", str(fps), "-q", quality, "-w", str(workers), "-o", str(out)]
    if fmt != "mp4":
        args += ["--format", fmt]
    result = R.hf(project, *args, check=False)
    if result.returncode != 0 or not out.exists():
        raise RuntimeError(f"render failed ({result.returncode}): {result.stdout[-1200:]} {result.stderr[-1200:]}")
    return out


# ------------------------------------------------------------------------------------------------ cook

def _t(frame: int, fps: int) -> str:
    return f"{frame / fps:.6f}"


def _accent(text: str, accent: str) -> str:
    """Words between stars take the accent colour; the rest is escaped text. FR : les mots entre etoiles prennent la couleur d'accent."""
    return re.sub(r"\*([^*]+)\*", lambda m: f'<span style="color:{accent}">{m.group(1)}</span>', html.escape(text))


def _faded_audio(path: str, c: dict, dest: Path, fps: int) -> bool:
    """A copy of the audio with its fade in and out (ffmpeg afade), so the render does not depend on the page's volume model."""
    if not (c["fade_in"] or c["fade_out"]):
        return False
    dur = c["frames"] / fps
    filt = []
    if c["fade_in"]:
        filt.append(f"afade=t=in:st=0:d={min(c['fade_in'], dur):.3f}")
    if c["fade_out"]:
        filt.append(f"afade=t=out:st={max(0.0, dur - c['fade_out']):.3f}:d={min(c['fade_out'], dur):.3f}")
    r = subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", f"{c['media_start_frame'] / fps:.3f}", "-t", f"{dur:.3f}", "-i", path, "-af", ",".join(filt), str(dest)], capture_output=True, text=True)
    return r.returncode == 0 and dest.exists()


def cook(p: dict, out_dir: str | Path, fmt: str, *, overlays: dict | None = None) -> Path:
    """Write <out_dir>/<fmt>/ as a HyperFrames project from the plan. `overlays` maps clip id -> alpha WebM path (text-only motions)."""
    fam = family()
    size = fam["formats"][fmt]
    k = p.get("scale", 1)
    w, h, fps, frames = size["width"] * k, size["height"] * k, p["fps"], p["frames"]
    T = fam["text"]
    project = Path(out_dir) / fmt
    if project.exists():
        shutil.rmtree(project)
    (project / "assets" / "clips").mkdir(parents=True)
    (project / "assets" / "fonts").mkdir(parents=True)
    (project / "vendor").mkdir()
    shutil.copy(settings.REPO / "vendor" / "gsap.min.js", project / "vendor" / "gsap.min.js")
    for name, src in fam["fontFiles"].items():
        if Path(src).exists():
            shutil.copy(src, project / "assets" / "fonts" / f"{name}{Path(src).suffix}")
    copied: dict[str, str] = {}

    def media(path: str) -> str:
        if path not in copied:
            ext = Path(path).suffix.lower()
            name = f"m{len(copied) + 1:02d}{ext}"
            shutil.copy(path, project / "assets" / "clips" / name)
            copied[path] = f"assets/clips/{name}"
        return copied[path]

    css = ["html, body { margin: 0; padding: 0; background: #000; }",
           f"#root {{ position: relative; width: {w}px; height: {h}px; overflow: hidden; isolation: isolate; background: {p['background']}; }}",
           ".env { position: absolute; inset: 0; }", ".env video, .env img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }",
           f".bgblur {{ object-fit: cover; filter: blur({fam['blur']['px'] * k}px) brightness({fam['blur']['brightness']}); transform: scale({fam['blur']['scale']}); }}",
           ".txt { position: absolute; white-space: pre; width: max-content; line-height: 1.15; will-change: transform, opacity; }"]
    for name in fam["fontFiles"]:
        ext = Path(fam["fontFiles"][name]).suffix
        css.append(f"@font-face {{ font-family: '{name}'; src: url('assets/fonts/{name}{ext}'); font-weight: 100 900; font-display: block; }}")
    nodes, anims, z = [], [], 0
    for ti, track in enumerate(p["tracks"]):
        base_idx = 10 * (ti + 1)
        for c in track["clips"]:
            z += 1
            timing = f'data-start="{_t(c["start_frame"], fps)}" data-duration="{_t(c["frames"], fps)}"'
            if track["kind"] == "text":
                px = round(c["size"] * h, 2)
                css.append(f"#{c['id']} {{ z-index: {z}; left: {c['x'] * 100:.3f}%; top: {c['y'] * 100:.3f}%; translate: "
                           f"{ {'left': '0', 'center': '-50%', 'right': '-100%'}[c['align']] } -50%; text-align: {c['align']}; font-family: '{c['font']}'; "
                           f"font-weight: {c['weight']}; font-size: {px}px; color: {c['color']}; max-width: {T['maxWidth'] * 100:.1f}%;"
                           + (f" white-space: pre-wrap; width: {T['maxWidth'] * 100:.1f}%;" if c["wrap"] else "") + " }")
                nodes.append(f'<div id="{c["id"]}" class="clip txt" {timing} data-track-index="{base_idx}"><span class="ink">{_accent(c["text"], c["accent"])}</span></div>')
                if c["fade_in"] or c["fade_out"]:
                    anims.append({"id": c["id"], "kind": "fade", "t0": c["start_frame"] / fps, "dur": c["frames"] / fps, "fadeIn": c["fade_in"], "fadeOut": c["fade_out"], "outer": True})
                anims.append({"id": c["id"], "kind": "text", "anim": "none" if c["fade_in"] else c["anim"], "t0": c["start_frame"] / fps, "dur": c["frames"] / fps, "basePx": px, "maxW": T["maxWidth"] * w, "wrap": c["wrap"]})
                continue
            if track["kind"] == "audio":
                fade_dest = project / "assets" / "clips" / f"{c['id']}-fade.wav"
                faded = _faded_audio(c["src"], c, fade_dest, fps)
                rel = f"assets/clips/{fade_dest.name}" if faded else media(c["src"])
                if faded:
                    c = {**c, "media_start_frame": 0}
                nodes.append(f'<audio id="{c["id"]}" src="{html.escape(rel)}" {timing} data-media-start="{_t(c["media_start_frame"], fps)}" '
                             f'data-track-index="{base_idx}" data-volume="{c["volume"]}"></audio>')
                continue
            src = overlays.get(c["id"]) if (overlays and c.get("textOnly")) else c["src"]
            rel = media(str(src))
            opacity = f" opacity: {c['opacity']};" if c["opacity"] < 1 else ""
            css.append(f"#{c['id']} {{ z-index: {z};{opacity} }}")
            g = c["grade"]
            if (g["brightness"], g["contrast"], g["saturate"]) != (1.0, 1.0, 1.0):
                css.append(f"#{c['id']} video:not(.bgblur), #{c['id']} img:not(.bgblur) {{ filter: brightness({g['brightness']}) contrast({g['contrast']}) saturate({g['saturate']}); }}")
            if c["fade_in"] or c["fade_out"]:
                anims.append({"id": c["id"], "kind": "fade", "t0": c["start_frame"] / fps, "dur": c["frames"] / fps, "fadeIn": c["fade_in"], "fadeOut": c["fade_out"]})
            if c["kind"] == "image":
                inner = f'<img id="{c["id"]}i" src="{html.escape(rel)}" style="object-fit: {"cover" if c["fit"] == "cover" else "contain"}">'
                if c["fit"] == "blur":
                    inner = f'<img class="bgblur" src="{html.escape(rel)}">' + inner
                nodes.append(f'<section id="{c["id"]}" class="clip env" {timing} data-track-index="{base_idx}">{inner}</section>')
                continue
            sound = f' data-has-audio="true" data-volume="{c["volume"]}"' if c["audio"] else " muted"
            fit = "cover" if c["fit"] == "cover" else "contain"
            vid = (f'<video id="{c["id"]}v" src="{html.escape(rel)}" {timing} data-media-start="{_t(c["media_start_frame"], fps)}" '
                   f'data-track-index="{base_idx + 1}"{sound} playsinline style="object-fit: {fit}"></video>')
            if c["fit"] == "blur":
                vid = (f'<video id="{c["id"]}b" class="bgblur" src="{html.escape(rel)}" {timing} data-media-start="{_t(c["media_start_frame"], fps)}" '
                       f'data-track-index="{base_idx + 2}" muted playsinline></video>') + vid
            nodes.append(f'<section id="{c["id"]}" class="clip env" {timing} data-track-index="{base_idx}">{vid}</section>')
    (project / "styles.css").write_text("\n".join(css) + "\n", encoding="utf-8")
    (project / "hyperframes.json").write_text(json.dumps({"$schema": "https://hyperframes.heygen.com/schema/hyperframes.json", "paths": {"assets": "assets"}}, indent=2) + "\n", encoding="utf-8")
    script = _timeline_script(anims, frames / fps, T)
    body = "\n    ".join(nodes)
    page = f"""<!doctype html>
<!-- Cooked by zrmd.app.timeline from the timeline plan (14 October 2026); never edit by hand. -->
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width={w}, height={h}" />
  <link rel="stylesheet" href="styles.css" />
  <script src="vendor/gsap.min.js"></script>
</head>
<body>
  <div id="root" data-composition-id="main" data-start="0" data-duration="{_t(frames, fps)}" data-width="{w}" data-height="{h}" data-fps="{fps}">
    {body}
  </div>
  <script>
{script}
  </script>
</body>
</html>
"""
    (project / "index.html").write_text(page, encoding="utf-8")
    (project / "timeline-plan.json").write_text(json.dumps({**p, "format": fmt, "width": w, "height": h}, indent=1, default=str) + "\n", encoding="utf-8")
    return project


def _timeline_script(anims: list[dict], seconds: float, T: dict) -> str:
    """One paused timeline of the full length: pure functions of time. Text auto-fit is measured in the page (fonts are the real ones)."""
    data = json.dumps(anims)
    return f"""(function () {{
    const tl = gsap.timeline({{ paused: true }});
    tl.to({{}}, {{ duration: {seconds:.6f} }}, 0);
    const items = {data};
    const POP = {T['popSeconds']}, FROM = {T['popFromScale']};
    function fit(el, basePx, maxW) {{
      el.style.fontSize = basePx + 'px';
      const w = el.scrollWidth;
      if (w > maxW) {{
        let px = Math.max(12, Math.floor(basePx * maxW / w));
        el.style.fontSize = px + 'px';
