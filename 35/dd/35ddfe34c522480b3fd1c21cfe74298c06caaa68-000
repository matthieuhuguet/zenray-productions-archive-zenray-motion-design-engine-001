def export(spec: dict, fmt: str | None = None, *, out_dir: str | Path | None = None, render_fn=None, overlay_fn=None) -> dict:
    """Plan, prepare the text-only overlays, cook and render one format; returns paths and numbers."""
    fam = family()
    p = plan(spec)
    fmt = fmt or p["formats"][0]
    if fmt not in p["formats"]:
        raise SpecError(f"format {fmt!r} not among the spec's formats {p['formats']}")
    base = Path(out_dir) if out_dir else root() / p["id"]
    overlays = {}
    for track in p["tracks"]:
        for c in track["clips"]:
            if c.get("textOnly"):
                s = c["source"]
                overlays[c["id"]] = (overlay_fn or prepare_overlay)(s["motion"], s.get("version"))
    project = cook(p, base, fmt, overlays=overlays)
    (base / "spec.json").write_text(json.dumps(spec, indent=1) + "\n", encoding="utf-8")
    out = base / "exports" / f"{p['id']}-{fmt}.mp4"
    (render_fn or _render)(project, out, fps=p["fps"], workers=fam["render"]["workers"], quality=fam["render"]["quality"], fmt="mp4")
    info = legacy.probe(out)
    mov = None
    if p["container"] == "mov":
        mov = out.with_suffix(".mov")
        subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(out), "-c", "copy", "-tag:v", "avc1", str(mov)], capture_output=True, check=True)
    return {"id": p["id"], "format": fmt, "path": str(out), "mov": str(mov) if mov else None, "scale": p["scale"], "project": str(project), "seconds": round(info["duration"], 3),
            "width": info["width"], "height": info["height"], "audio": info["audio"], "frames": p["frames"], "fps": p["fps"]}


_SRT_TIME = re.compile(r"(\d+):(\d\d):(\d\d)[,.](\d{1,3})")


def _srt_seconds(txt: str) -> float:
    m = _SRT_TIME.search(txt)
    if not m:
        raise SpecError(f"bad subtitle time {txt!r}")
    h, mi, se, ms = m.groups()
    return int(h) * 3600 + int(mi) * 60 + int(se) + int(ms.ljust(3, "0")) / 1000


def srt_clips(srt: str, **style) -> list[dict]:
    """Text clips from an .srt: one clip per cue, the family's text style plus any style given (size, y, color, accent, font, anim). FR : les sous-titres d'un .srt deviennent des clips texte."""
    fam = family()
    cues, out = re.split(r"\n\s*\n", srt.replace("\r\n", "\n").strip()), []
    for block in cues:
        lines = [ln for ln in block.split("\n") if ln.strip()]
        ti = next((i for i, ln in enumerate(lines) if "-->" in ln), None)
        if ti is None:
            continue
        a, b = (_srt_seconds(x) for x in lines[ti].split("-->"))
        text = " ".join(re.sub(r"<[^>]+>", "", ln).strip() for ln in lines[ti + 1:]).strip()
        if not text:
            continue
        out.append({"id": f"s{len(out) + 1:03d}", "text": text[: fam["text"]["maxChars"]], "start": round(a, 3), "duration": round(max(b - a, fam["subtitles"]["minSeconds"]), 3), **style})
        if len(out) >= fam["subtitles"]["maxCues"]:
            break
    if not out:
        raise SpecError("no subtitle cue found in the .srt")
    return out
