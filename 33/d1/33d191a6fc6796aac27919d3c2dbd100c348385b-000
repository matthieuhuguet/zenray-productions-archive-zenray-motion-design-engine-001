  H.safe = (W, H_, m) => { const g = Math.min(W, H_) * (m === undefined ? 0.06 : m); return { x: g, y: g, w: W - 2 * g, h: H_ - 2 * g }; };
  // a seeded random generator: the same seed gives the same layout in the studio and in the render
  H.rand = (seed) => { let s = (seed >>> 0) || 1; return () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296); };
  H.mix = (a, b, t) => {
    const p = (c) => [1, 3, 5].map((i) => parseInt(c.slice(i, i + 2), 16));
    const x = p(a), y = p(b);
    return "#" + x.map((v, i) => Math.round(v + (y[i] - v) * t).toString(16).padStart(2, "0")).join("");
  };

  // ---------------------------------------------------------------------------------------------------------- build
  ZS.size = (project) => ZS.FORMATS[project.format] || ZS.FORMATS["16x9"];
  // a measured shot can last one frame (1/30 s): the floor stays below it, so a converted reference keeps its exact length (15 October 2026)
  ZS.minScene = 0.02;
  ZS.seam = 1 / 60;   // half a frame at 30 fps
  ZS.duration = (project) => (project.scenes || []).reduce((s, sc) => s + Math.max(ZS.minScene, Number(sc.duration) || 0), 0);

  // build(project, root, {preview}) -> {tl, cues, duration, spans}. `cues` are the sound effects the scenes ask for, in seconds.
  ZS.build = function (project, root, opts) {
    opts = opts || {};
