    root.innerHTML = "";
    H.css(root, { position: "relative", width: W + "px", height: H_ + "px", overflow: "hidden", background: theme.bg,
                  fontFamily: H.font(theme.fontBody), color: theme.ink });
    root.dataset.compositionId = "main"; root.dataset.start = "0"; root.dataset.width = W; root.dataset.height = H_;
    root.dataset.fps = project.fps || 30;
    const tl = gsap.timeline({ paused: true }), cues = [], spans = [], videos = [];
    const fits = [], safe = H.safe(W, H_, ZS.safeMargin), sections = [];
    let t = 0;
    const trans = theme.transition === "fade" ? Math.max(0, Number(theme.transitionDuration) || 0) : 0;
    (project.scenes || []).forEach((sc, i) => {
      const tpl = ZS.templates[sc.template];
      const dur = Math.max(ZS.minScene, Number(sc.duration) || (tpl && tpl.duration) || 3);
      const el = H.el("section", "clip zs-scene", root);
      el.id = "scene-" + (sc.id || i);
      // a scene overlaps the next one by ZS.seam (under it, the next scene is drawn above): at the exact frame of a cut, a rounding of
      // the two boundaries can never leave the frame empty (measured on 15 October 2026: two blank frames at 4.0 s and 13.0 s)
      const seam = i < (project.scenes || []).length - 1 ? ZS.seam : 0;
      el.dataset.start = t.toFixed(6); el.dataset.duration = (dur + seam).toFixed(6); el.dataset.trackIndex = String(1 + (i % 2));
      sections.push({ el, scene: sc });
      // a later scene is always drawn above an earlier one (the seam overlap must show the NEW scene), whatever its track
      H.css(el, { position: "absolute", inset: "0", visibility: "hidden", opacity: "0", zIndex: String(i + 1) });
      if (!tpl) {
        H.css(H.el("div", "", el, `modèle inconnu : ${sc.template} (page plus ancienne que ce modèle : recharger avec Cmd+R)`), { position: "absolute", inset: "40px", color: "#c00", fontSize: 32 * u + "px" });
      } else {
        const p = ZS.resolve(tpl, sc.params || {}, theme);
        const ctx = { el, p, theme, W, H: H_, u, dur, seam, tl, t0: t, project, cue: (at, type, params) => cues.push({ t: t + at, type, params: params || {}, scene: sc.id }),
                      asset: (name) => ZS.assetUrl(name, opts), videos, preview: !!opts.preview, thumb: !!opts.thumb, safe,
                      fit: (node, mw, mh, hooks) => fits.push([node, mw === undefined ? safe.w : mw, mh === undefined ? safe.h : mh, hooks]), scene: sc };
        ctx.buildChildren = (container, W2, H2) => ZS.buildChildren(ctx, sc.children || [], container, W2, H2);
        try { tpl.build(ctx); } catch (e) {
          H.css(H.el("div", "", el, `${sc.template} : ${e.message}`), { position: "absolute", inset: "40px", color: "#c00", fontSize: 28 * u + "px" });
        }
      }
      const fadeIn = i > 0 ? trans : 0;
      // the first scene is visible from frame 0 (a fade from nothing would leave the first frame empty)
      if (i === 0) tl.set(el, { autoAlpha: 1 }, 0);
      else tl.fromTo(el, { autoAlpha: 0 }, { autoAlpha: 1, duration: Math.max(0.001, fadeIn), ease: "none", immediateRender: false }, t);
      if (i < project.scenes.length - 1) tl.to(el, { autoAlpha: 0, duration: Math.max(0.001, trans), ease: "none" }, t + dur);
      spans.push({ id: sc.id, template: sc.template, start: t, end: t + dur });
      t += dur;
    });
    fits.forEach((f) => ZS.fitOne(f));   // never crop: every text block fits its box once laid out
    tl.to({}, { duration: 0.001 }, Math.max(0, t - 0.001));   // the timeline is exactly the composition long
    root.dataset.duration = t.toFixed(6);
    // post-process (zs-post.js): the photo-style grade of the film and of each scene, live and in the export
    const post = ZS.post ? ZS.post.apply({ root, project, tl, W, H: H_, duration: t, sections }) : null;
    // live preview: a <video> follows the timeline (HyperFrames syncs its own videos at render time). A converted reference can hold
    // 160 excerpts of one file: a video gets its source only near the playhead and drops it far from it, so the page stays light.
    if (opts.preview && videos.length) {
      const near = ZS.videoWindow || 2;
      videos.forEach((v) => { if (v.node.src) { v.node.dataset.src = v.node.getAttribute("src"); v.node.removeAttribute("src"); } });
      tl.eventCallback("onUpdate", () => {
        const now = tl.time();
        videos.forEach((v) => {
          const local = now - v.start, inside = local >= 0 && local <= v.dur, close = local >= -near && local <= v.dur + near / 2;
          if (close && !v.node.getAttribute("src") && v.node.dataset.src) {
