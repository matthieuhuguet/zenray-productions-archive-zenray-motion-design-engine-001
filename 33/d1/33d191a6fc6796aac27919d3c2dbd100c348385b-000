        const poly = document.createElementNS(ns, "polygon");
        poly.setAttribute("points", [pt(0, w0), pt(L - c, w1), pt(L, w1 - c), pt(L, -w1 + c), pt(L - c, -w1), pt(0, -w0)].join(" "));
        poly.setAttribute("fill", colour);
        svg.appendChild(poly);
