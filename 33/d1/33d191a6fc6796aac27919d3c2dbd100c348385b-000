// 15 October 2026: ZenRay Motion Design motion runtime. A project (zrmd/motion-project@1) is a list of scenes, each a TEMPLATE with its parameters, plus
// a theme (global tokens), music and sound effects. build() turns it into DOM and ONE paused GSAP timeline (window.__timelines.main), the
// HyperFrames contract: the same file plays live in the studio (seek and play in real time, GPU-composited by the browser) and renders to MP4.
// Nothing here measures or reproduces pixels: every visible value is a parameter a person can change.
// FR : le runtime du studio ; un projet = des scenes (modeles + parametres), un theme, une musique, des effets ; une seule timeline GSAP.
(function () {
  const ZS = (window.ZS = window.ZS || {});
  ZS.version = "studio-1.0.0";
  ZS.templates = ZS.templates || {};
  ZS.FORMATS = { "16x9": [1920, 1080], "9x16": [1080, 1920], "1x1": [1080, 1080], "4x5": [1080, 1350] };
  ZS.THEME_DEFAULT = {
    bg: "#ecece2", panel: "#f7f7f2", ink: "#1b1b19", muted: "#8e8c84", line: "#d8d7cd", accent: "#e2552f", accentInk: "#ffffff",
    fontTitle: "AnthropicSerif", fontBody: "InterVariable", fontMono: "AnthropicMono", transition: "cut", transitionDuration: 0.35,
  };
  // the families the studio serves (studio/params/studio.json maps each to its file); a font parameter offers exactly these
  ZS.FONTS = ["InterVariable", "AnthropicSerif", "AnthropicSans", "AnthropicMono", "Geist", "InstrumentSerif", "SpaceGrotesk", "Fraunces",
              "Manrope", "Syne", "Unbounded", "JetBrainsMono", "PlayfairDisplay", "Sora", "VogunMedium", "AnthropicSerifLight", "AnthropicSansLight"];

  ZS.register = function (tpl) {
    if (!tpl.id || !tpl.build || !tpl.params) throw new Error("template needs id, params and build");
    const counts = { 1: 0, 2: 0, 3: 0, 4: 0 };
    tpl.params.forEach((p) => { counts[p.tier || 3]++; });
    // tier 4 « Détail » (15 October 2026): the precision values of a reproduction (gaps, small sizes), folded by default, 16 at most
    if (counts[1] > 4 || counts[2] > 8 || counts[3] > 16 || (counts[4] || 0) > 16) throw new Error(`template ${tpl.id}: tiers above 4/8/16/16 (${JSON.stringify(counts)})`);
    ZS.templates[tpl.id] = tpl;
