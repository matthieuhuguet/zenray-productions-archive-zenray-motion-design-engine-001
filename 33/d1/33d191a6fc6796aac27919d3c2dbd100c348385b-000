    return svg;
  };
  // NEVER CROP (15 October 2026): a block is measured once laid out and its type is scaled down until it fits the box it is allowed (the safe
  // area of the frame). Every font size inside the block keeps its ratio. Transforms do not change the measure, so a block measures the same
  // before and after its entrance animation. FR : jamais rogne ; le bloc est mesure puis sa typographie reduite pour tenir dans la zone sure.
  H.fit = (el, maxW, maxH) => {
    if (!el || !el.isConnected) return 1;
    const nodes = [el, ...el.querySelectorAll("*")];
    // a refit starts again from the sizes the template asked for (a font that loads later can need less reduction)
    nodes.forEach((n) => {
      if (n.dataset.zsFs !== undefined) n.style.fontSize = n.dataset.zsFs;
      if (n.dataset.zsMt !== undefined) n.style.marginTop = n.dataset.zsMt;
    });
    const w = el.scrollWidth, hh = el.scrollHeight;
    let k = 1;
    if (maxW > 0 && w > maxW) k = Math.min(k, maxW / w);
    if (maxH > 0 && hh > maxH) k = Math.min(k, maxH / hh);
    if (k < 1) {
      k *= 0.98;
      if (!el.style.fontSize) { el.dataset.zsFs = ""; el.style.fontSize = parseFloat(getComputedStyle(el).fontSize) + "px"; }
      nodes.forEach((n) => {
        if (n.style.fontSize.endsWith("px")) {
          if (n.dataset.zsFs === undefined) n.dataset.zsFs = n.style.fontSize;
          n.style.fontSize = parseFloat(n.style.fontSize) * k + "px";
        }
        if (n.style.marginTop.endsWith("px")) {
          if (n.dataset.zsMt === undefined) n.dataset.zsMt = n.style.marginTop;
          n.style.marginTop = parseFloat(n.style.marginTop) * k + "px";
        }
