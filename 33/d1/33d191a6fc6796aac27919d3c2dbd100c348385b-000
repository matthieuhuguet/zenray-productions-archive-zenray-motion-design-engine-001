        line.setAttribute("x2", (Math.cos(a) * 46).toFixed(2)); line.setAttribute("y2", (Math.sin(a) * 46).toFixed(2));
        line.setAttribute("stroke", colour); line.setAttribute("stroke-width", thick); line.setAttribute("stroke-linecap", "round");
        svg.appendChild(line);
