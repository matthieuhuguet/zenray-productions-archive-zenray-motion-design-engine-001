    window.__timelines.main = tl;
    return { tl, cues, duration: t, spans, W, H: H_, videos, fits, post };
  };
  // the URL of a media of a scene: an imported file of the project, or "ref:<slug>", the video of a measured reference
  // (served by the bank in the app; copied next to the page by the export, which passes opts.refs)
  ZS.assetUrl = (name, opts) => {
    opts = opts || {};
    if (typeof name === "string" && name.startsWith("ref:")) {
      if (opts.hideRefs) return "";      // the editor can hide the reference footage, to see the reproduced motion alone
      const slug = name.slice(4);
      return (opts.refs && opts.refs[slug]) || `/motion/bank/ref/${encodeURIComponent(slug)}`;
    }
    return (opts.assetBase || "") + name;
  };
  ZS.isVideo = (name) => typeof name === "string" && (name.startsWith("ref:") || /\.(mp4|mov|webm|m4v)$/i.test(name));
  // SUB-SCENES (15 October 2026): a scene can hold child scenes (scene.children: [{template, start, duration, params}]) played inside one
  // of its elements, e.g. the preview window of an application. A child is built at a size of its own (W2 x H2, usually 1920 x 1080)
  // in a container the parent scales; its times are relative to the parent scene. Every template can be a child.
  ZS.buildChildren = function (ctx, kids, container, W2, H2) {
    const out = [];
    kids.forEach((c, i) => {
      const tpl = ZS.templates[c.template];
      if (!tpl) return;
      const el = H.css(H.el("div", "zs-child", container), { position: "absolute", left: "0", top: "0", width: W2 + "px", height: H2 + "px", overflow: "hidden",
        visibility: "hidden", opacity: "0", zIndex: String(i + 1) });
      const start = Number(c.start) || 0, dur = Math.max(ZS.minScene, Number(c.duration) || tpl.duration || 2);
      const p = ZS.resolve(tpl, c.params || {}, ctx.theme), u2 = Math.min(W2, H2) / 1080, safe2 = H.safe(W2, H2, ZS.safeMargin);
      const sub = Object.assign({}, ctx, { el, p, W: W2, H: H2, u: u2, dur, t0: ctx.t0 + start, safe: safe2, scene: c, seam: 0,
        fit: (n, mw, mh, hk) => ctx.fit(n, mw === undefined ? safe2.w : mw, mh === undefined ? safe2.h : mh, hk),
        cue: (at, type, q) => ctx.cue(start + at, type, q) });
      sub.buildChildren = (cont, w3, h3) => ZS.buildChildren(sub, c.children || [], cont, w3, h3);
