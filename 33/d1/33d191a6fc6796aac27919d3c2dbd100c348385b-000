    svg.setAttribute("viewBox", "-50 -50 100 100");
    svg.setAttribute("width", size); svg.setAttribute("height", size);
    const irr = Math.max(0, Math.min(1, o.irregular || 0)), rnd = H.rand(o.seed || 7), taper = o.taper || 1;
    if (!irr && taper === 1 && !o.hub) {
