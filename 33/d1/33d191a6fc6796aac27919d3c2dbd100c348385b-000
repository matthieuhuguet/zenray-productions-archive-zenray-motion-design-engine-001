  // 16:9 frame (sentence-build); the scene's own background still covers the whole frame
  ZS.stage1920 = (el, W, H_) => {
    const k = W / 1920;
    return H.css(H.el("div", "zs-abs", el), { left: "0", top: (H_ - 1080 * k) / 2 + "px", width: "1920px", height: "1080px", transform: `scale(${k})`, transformOrigin: "0 0" });
  };
