              try { v.node.currentTime = v.mediaStart + Math.max(0, Math.min(v.dur, l)) * v.rate; } catch (e) { /* not seekable yet */ }
            }, { once: true });
          }
          else if (!close && v.node.getAttribute("src")) { v.node.pause(); v.node.removeAttribute("src"); v.node.load(); }
          if (!inside) return;
          const want = v.mediaStart + local * v.rate;
          if (Math.abs(v.node.currentTime - want) > (ZS.videoTolerance || 0.08)) { try { v.node.currentTime = want; } catch (e) { /* not loaded yet */ } }
        });
      });
    }
