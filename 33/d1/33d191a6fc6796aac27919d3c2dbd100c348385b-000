  ZS.cropCheck = function (project, format, tolerance) {
    const host = H.css(H.el("div", "", document.body), { position: "fixed", left: "-100000px", top: "0" });
    const proj = JSON.parse(JSON.stringify(project)); if (format) proj.format = format;
