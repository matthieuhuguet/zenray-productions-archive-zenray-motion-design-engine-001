// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
float grade_lift_gamma_gain_axis(vec2 uv, float angle) {
  float a = radians(angle);
  vec2 dir = vec2(cos(a), sin(a));
  return clamp(0.5 + dot(uv - 0.5, dir) / (abs(dir.x) + abs(dir.y)), 0.0, 1.0);
}
// 12 October 2026: the grading operator, reusable on any sRGB colour.
vec3 grade_lift_gamma_gain_apply(vec3 x, vec3 lift, vec3 gamma, vec3 gain) {
  vec3 y = gain * (x + lift * (1.0 - x));
  return clamp(pow(max(y, vec3(1e-8)), 1.0 / gamma), 0.0, 1.0);
}
vec4 grade_lift_gamma_gain(vec2 uv, float angle, vec3 c0, vec3 c1, vec3 lift, vec3 gamma, vec3 gain) {
  vec3 x = mix(c0, c1, grade_lift_gamma_gain_axis(uv, angle));
  return vec4(grade_lift_gamma_gain_apply(x, lift, gamma, gain), 1.0);
}
