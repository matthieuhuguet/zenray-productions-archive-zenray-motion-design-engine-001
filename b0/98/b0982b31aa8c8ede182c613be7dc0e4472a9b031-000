// 12 October 2026: four-stop linear colour ramp along an angle, written from the mathematics.
// uv: pixel centre in [0,1]^2, v from top to bottom. angle in degrees, 0 = left to right, 90 = top to bottom.
// The ramp parameter t covers the whole unit square: t = 0.5 + dot(uv - 0.5, dir) / (|cos| + |sin|).
// Stops: c0 at 0, c1 at min(s1, s2), c2 at max(s1, s2), c3 at 1, linear in between. Colour block: alpha 1.
vec4 linear_ramp4(vec2 uv, float angle, vec3 c0, vec3 c1, vec3 c2, vec3 c3, float s1, float s2) {
  float a = radians(angle);
  vec2 dir = vec2(cos(a), sin(a));
  float t = clamp(0.5 + dot(uv - 0.5, dir) / (abs(dir.x) + abs(dir.y)), 0.0, 1.0);
  float p1 = min(s1, s2), p2 = max(s1, s2);
  vec3 col;
  if (t < p1) col = mix(c0, c1, t / max(p1, 1e-6));
  else if (t < p2) col = mix(c1, c2, (t - p1) / max(p2 - p1, 1e-6));
  else col = mix(c2, c3, (t - p2) / max(1.0 - p2, 1e-6));
  return vec4(col, 1.0);
}
