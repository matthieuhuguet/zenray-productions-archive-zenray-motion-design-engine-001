// generated by Scripts/HarvestNoisePost.py. Licence: original (written from the mathematics), same licence as the engine.
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
vec4 blur_motion_bar(vec2 uv, vec2 center, vec2 half_size, float angle, float blur_len, float soft, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float a = radians(angle);
  vec2 l = vec2(cos(a) * p.x + sin(a) * p.y, -sin(a) * p.x + cos(a) * p.y);
  float h = 0.5 * blur_len;
  float cx = (clamp(l.x + h, -half_size.x, half_size.x) - clamp(l.x - h, -half_size.x, half_size.x)) / blur_len;
  float cy = 1.0 - smoothstep(-soft, soft, abs(l.y) - half_size.y);
  return vec4(1.0, 1.0, 1.0, cx * cy);
}
