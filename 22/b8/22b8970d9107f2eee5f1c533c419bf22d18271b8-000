// 12 October 2026: Lateral chromatic aberration of a ring: red, green and blue sample the shape at radially scaled positions around the optical centre. Colour block.
// generated by Scripts/HarvestNoisePost.py. Licence: original (written from the mathematics), same licence as the engine.
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
vec4 chroma_aberration_ring(vec2 uv, vec2 optic, vec2 center, float radius, float width, float soft, float strength, vec3 color, float aspect) {
  vec3 col;
  for (int k = 0; k < 3; k++) {
    float sc = 1.0 + (1.0 - float(k)) * strength;
    vec2 q = optic + (uv - optic) * sc;
    vec2 p = (q - center) * vec2(aspect, 1.0);
    float d = abs(length(p) - radius) - width;
    col[k] = 1.0 - smoothstep(-soft, soft, d);
  }
  return vec4(color * col, 1.0);
}
