// 12 October 2026: Anamorphic lens flare streak: exponential cross profile times gaussian length, plus a gaussian core, rotatable. Colour block.
// generated by Scripts/HarvestNoisePost.py. Licence: original (written from the mathematics), same licence as the engine.
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
vec4 flare_streak(vec2 uv, vec2 center, float angle, float streak_len, float thickness, float core, vec3 color, vec3 core_color, float intensity, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float a = radians(angle);
  vec2 l = vec2(cos(a) * p.x + sin(a) * p.y, -sin(a) * p.x + cos(a) * p.y);
  float sx = l.x / streak_len;
  float streak = exp(-abs(l.y) / thickness) * exp(-sx * sx);
  float r = dot(p, p) / (core * core);
  return vec4(clamp(intensity * (color * streak + core_color * exp(-r)), 0.0, 1.0), 1.0);
}
