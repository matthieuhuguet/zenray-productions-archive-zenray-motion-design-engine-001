"""Rectify the content of a window filmed by a moving camera (15 October 2026).

With the camera keys of a shot ("t z cx cy", canvas units) and the rectangle of the window content on the canvas, every frame of the
reference is warped so that the content fills a flat 1920x1080 (or --size) picture: the reference of the child scene, measurable
like any other video. FR : remettre a plat le contenu d'une fenetre filmee par une camera mobile.
Usage: python3 Scripts/ExtractChild.py <video> --camera keys.json --scene-start 4.0333 --rect 484,242,1504,816 --from 10.9 --to 16.75 --out child.mp4
"""
import argparse
import json
import subprocess

import cv2
import numpy as np


def cam_at(ks, t):
    if t <= ks[0][0]:
        return ks[0][1:]
    for a, b in zip(ks, ks[1:]):
        if t <= b[0]:
            u = (t - a[0]) / max(1e-9, b[0] - a[0])
            return [a[i] + (b[i] - a[i]) * u for i in (1, 2, 3)]
    return ks[-1][1:]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("video"); ap.add_argument("--camera", required=True); ap.add_argument("--scene-start", type=float, required=True)
    ap.add_argument("--rect", required=True); ap.add_argument("--from", dest="t0", type=float, required=True); ap.add_argument("--to", dest="t1", type=float, required=True)
    ap.add_argument("--fps", type=float, default=30); ap.add_argument("--size", default="1920x1080"); ap.add_argument("--out", required=True)
    a = ap.parse_args()
    ks = [list(map(float, k.split())) for k in json.load(open(a.camera))["keys"]]
    x0, y0, x1, y1 = (float(v) for v in a.rect.split(","))
    ow, oh = (int(v) for v in a.size.split("x"))
    W, H = 1920, 1080
    src = subprocess.Popen(["ffmpeg", "-v", "error", "-ss", f"{a.t0:.3f}", "-to", f"{a.t1:.3f}", "-i", a.video, "-vf", f"fps={a.fps},scale={W}:{H}",
                            "-f", "rawvideo", "-pix_fmt", "bgr24", "-"], stdout=subprocess.PIPE)
    dst = subprocess.Popen(["ffmpeg", "-v", "error", "-y", "-f", "rawvideo", "-pix_fmt", "bgr24", "-s", f"{ow}x{oh}", "-r", str(a.fps), "-i", "-",
                            "-c:v", "libx264", "-crf", "16", "-pix_fmt", "yuv420p", a.out], stdin=subprocess.PIPE)
    i = 0
    while True:
        buf = src.stdout.read(W * H * 3)
        if len(buf) < W * H * 3:
            break
        f = np.frombuffer(buf, np.uint8).reshape(H, W, 3)
        t = a.t0 + i / a.fps - a.scene_start
        z, cx, cy = cam_at(ks, t)
        # canvas -> screen: s = z (q - c) + C ; content corner (x0, y0) maps to the child origin
        M = np.float32([[z * (x1 - x0) / ow, 0, z * (x0 - cx) + W / 2], [0, z * (y1 - y0) / oh, z * (y0 - cy) + H / 2]])
        out = cv2.warpAffine(f, M, (ow, oh), flags=cv2.INTER_LINEAR | cv2.WARP_INVERSE_MAP, borderMode=cv2.BORDER_CONSTANT, borderValue=(0, 0, 0))
        dst.stdin.write(out.tobytes())
        i += 1
    dst.stdin.close(); dst.wait()
    print(a.out, i, "frames")


if __name__ == "__main__":
    main()
