/* 16 October 2026: the page Previous Videos. Tokens come from app.css. */
.pv-bar { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; padding: 12px 18px 6px; }
.pv-bar input[type=search] { flex: 1; min-width: 220px; max-width: 460px; }
.pv-drop { padding: 8px 18px 60px; min-height: 60vh; position: relative; }
.pv-drop.over::after { content: "Dépose les vidéos pour les ajouter"; position: absolute; inset: 8px 18px; display: grid; place-items: center; border: 2px dashed var(--accent); border-radius: 16px; background: color-mix(in srgb, var(--accent) 10%, transparent); color: var(--ink); font-size: 18px; z-index: 5; }
.pv-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
.pv-tile { border: 1px solid var(--line); border-radius: 14px; background: var(--surface); overflow: hidden; display: flex; flex-direction: column; }
.pv-media { position: relative; aspect-ratio: 16 / 9; background: #0e0e0e; display: grid; place-items: center; overflow: hidden; }
.pv-media img, .pv-media video { width: 100%; height: 100%; object-fit: contain; background: #000; display: block; }
.pv-play { position: absolute; inset: 0; display: grid; place-items: center; cursor: pointer; border: 0; background: transparent; }
.pv-play span { width: 54px; height: 54px; border-radius: 50%; background: rgba(0,0,0,0.55); color: #fff; display: grid; place-items: center; font-size: 20px; padding-left: 3px; }
.pv-body { padding: 10px 12px 12px; display: grid; gap: 6px; }
.pv-title { display: flex; gap: 8px; align-items: baseline; justify-content: space-between; }
.pv-title b { font-family: var(--f-serif); font-weight: 400; font-size: 17px; word-break: break-word; }
.pv-meta { color: var(--ink-2); font-size: 12px; display: flex; gap: 8px; flex-wrap: wrap; }
.pv-chip { border: 1px solid var(--line); border-radius: 999px; padding: 0 8px; font-size: 11.5px; }
.pv-chip.export { color: #2f7a12; border-color: #4f9d2a; }
.pv-chip.montage { color: #3355cc; border-color: #5b78e8; }
.pv-chip.upload { color: #8a6a12; border-color: #b8921f; }
.pv-actions { display: flex; gap: 6px; flex-wrap: wrap; }
.pv-actions a, .pv-actions button { font-size: 12px; padding: 3px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface-2); color: var(--ink); text-decoration: none; cursor: pointer; }
.pv-actions a.main { background: var(--accent); border-color: var(--accent); color: #fff; }
.pv-link { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
.pv-link select, .pv-link input { font-size: 12px; max-width: 150px; }
.pv-hint { color: var(--ink-2); text-align: center; padding: 40px; }
.pv-toast { position: fixed; left: 50%; bottom: 22px; transform: translateX(-50%); background: #111; color: #fff; padding: 8px 16px; border-radius: 10px; font-size: 13px; z-index: 20; }
