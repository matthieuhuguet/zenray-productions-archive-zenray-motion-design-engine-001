// 12 October 2026: One-pass bloom of a bright disc: core coverage plus a gaussian falloff of the outside distance, scaled by the energy above a threshold. Colour block.
// generated by Scripts/HarvestNoisePost.py. Licence: original (written from the mathematics), same licence as the engine.
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
vec4 bloom_disc(vec2 uv, vec2 center, float radius, float soft, vec3 core_color, vec3 glow_color, float core_level, float threshold, float glow_radius, float intensity, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float d = length(p) - radius;
  float cov = 1.0 - smoothstep(-soft, soft, d);
  float e = max(d, 0.0) / glow_radius;
  float glow = intensity * max(core_level - threshold, 0.0) * exp(-0.5 * e * e);
  return vec4(clamp(core_color * min(core_level, 1.0) * cov + glow_color * glow, 0.0, 1.0), 1.0);
}
