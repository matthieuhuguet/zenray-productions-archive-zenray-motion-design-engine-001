float chroma_aberration_rect_box(vec2 p, vec2 b, float r) {
  r = min(r, min(b.x, b.y));
  vec2 q = abs(p) - b + r;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
vec4 chroma_aberration_rect(vec2 uv, vec2 optic, vec2 center, vec2 half_size, float corner, float soft, float strength, vec3 color, float aspect) {
  vec3 col;
  for (int k = 0; k < 3; k++) {
    float sc = 1.0 + (1.0 - float(k)) * strength;
    vec2 q = optic + (uv - optic) * sc;
    vec2 p = (q - center) * vec2(aspect, 1.0);
    float d = chroma_aberration_rect_box(p, half_size, corner);
    col[k] = 1.0 - smoothstep(-soft, soft, d);
  }
  return vec4(color * col, 1.0);
}
