# 14 October 2026: the orchestrator core proves itself in an ISOLATED workshop (ZRMD_PATH_* overrides) with a fake pipeline
# of tiny commands, in BOTH directions: a good run is green, a failing step / a missing input / a cancel / a bad file are
# refused or reported, never hidden. No media of Matthieu is touched; the test video is generated by ffmpeg.
# FR : le coeur de l'orchestrateur se prouve dans un atelier isole avec un faux pipeline, dans les deux sens.
import json
import os
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

TMP = Path(tempfile.mkdtemp(prefix="zrmd-orch-test-"))
os.environ["ZRMD_PATH_WORKSHOP"] = str(TMP / "workshop")
os.environ["ZRMD_PATH_REFCACHE"] = str(TMP / "refcache")
os.environ["ZRMD_PATH_SOUND_OUT"] = str(TMP / "workshop" / "sound")

from zrmd import orchestrator as orch  # noqa: E402
from zrmd import registry  # noqa: E402

PY = sys.executable
REAL_NORMALIZE = json.loads((ROOT / "params" / "orchestrator.json").read_text(encoding="utf-8"))["ingest"]["normalize"]
FAKE = {
    "schema": "zrmd/orchestrator@1", "targets": {"default": 0.99, "stretch": 0.999},
    "paths": {"runs": "{workshop}/runs"}, "ingest": {"extensions": [".mp4", ".mov", ".mkv"], "slugMaxChars": 20, "minDurationS": 1.0, "maxDurationS": 60.0, "normalize": REAL_NORMALIZE},
    "defaults": {"mode": "fast"},
    "modules": [{"id": "music", "label": "Music", "hint": "x", "steps": ["a"], "score": "music"}],
    "steps": [
        {"id": "a", "label": "A", "module": "music", "argv": [PY, "-c", "print('a ok {mode}')"], "cwd": "{engine}"},
        {"id": "b", "label": "B", "module": "music", "argv": [PY, "-c", "import sys; print('b boom'); sys.exit(3)"], "cwd": "{engine}"},
        {"id": "c", "label": "C", "module": "music", "needs": ["music_best"], "argv": [PY, "-c", "print('c')"], "cwd": "{engine}"},
        {"id": "d", "label": "D", "module": "music", "okCodes": [0, 1], "argv": [PY, "-c", "import sys; sys.exit(1)"], "cwd": "{engine}"},
        {"id": "e", "label": "E", "module": "music", "timeoutS": 60, "argv": [PY, "-c", "import time; time.sleep(30)"], "cwd": "{engine}"},
    ],
}
FAIL = []


def check(name, cond, detail=""):
    print(("ok   " if cond else "FAIL ") + name + (f"  {detail}" if detail and not cond else ""))
    if not cond:
        FAIL.append(name)


def expect_refusal(name, fn):
    try:
        fn()
    except orch.OrchestratorError:
        check(name, True)
    else:
        check(name, False, "no refusal raised")


def make_video(path: Path, seconds=2, colour="red"):
    subprocess.run(["ffmpeg", "-v", "error", "-y", "-f", "lavfi", "-i", f"color=c={colour}:s=160x90:r=25:d={seconds}",
                    "-f", "lavfi", "-i", "sine=f=440:d=" + str(seconds), "-shortest", "-pix_fmt", "yuv420p", str(path)], check=True)


def run() -> int:
    fake = TMP / "orchestrator.json"
    fake.write_text(json.dumps(FAKE), encoding="utf-8")
    orch.DEF_PATH = fake

    # tokens: an unknown token names itself
    expect_refusal("unknown token is refused", lambda: orch.expand("{nope}", {}))
    check("known token expands", orch.expand("x-{a}", {"a": "1"}) == "x-1")

    # ingest: good video, idempotent, different bytes under the same name, bad inputs
    src = TMP / "My Clip.mp4"
    make_video(src)
    first = orch.ingest_local(src)
    check("ingest creates a slug", first["created"] and first["slug"] == "my-clip", first["slug"])
    meta = orch.read_json(TMP / "workshop" / "references" / first["slug"] / "reference.json")
    check("reference.json has duration and audio", abs(meta["duration_s"] - 2) < 0.2 and meta["has_audio"] is True)
    check("media copied into the refcache only", (TMP / "refcache" / first["slug"] / meta["file_name"]).exists())
    again = orch.ingest_local(src)
    check("same bytes reuse the reference", not again["created"] and again["slug"] == first["slug"])
    src2 = TMP / "My Clip 2.mp4"
    make_video(src2, colour="blue")
    other = orch.ingest_local(src2, slug="my-clip")
    check("different bytes, same name -> new slug", other["created"] and other["slug"] == "my-clip-2", other["slug"])
    check("dropped video appears in the registry", "my-clip" in registry.slugs() and "my-clip-2" in registry.slugs())
    # normalisation: a plain MP4 is never re-encoded; MKV / WebM / a variable-rate recording become a CFR MP4
    check("plain mp4 is kept as is", meta["normalized"] is False and meta["file_name"].endswith(".mp4"))
    mkv = TMP / "From Elsewhere.mkv"
    subprocess.run(["ffmpeg", "-v", "error", "-y", "-f", "lavfi", "-i", "testsrc=s=160x90:r=30:d=2", "-f", "lavfi", "-i", "sine=f=220:d=2",
                    "-shortest", "-pix_fmt", "yuv420p", str(mkv)], check=True)
    norm = orch.ingest_local(mkv)
    nm = norm["reference"]
    check("mkv is rewritten as mp4", nm["normalized"] is True and nm["file_name"].endswith(".mp4") and nm["has_audio"] is True, nm.get("file_name"))
    check("normalised fps is a known rate", nm["fps"] in (30.0, 29.97) or abs(nm["fps"] - 30) < 0.1, nm["fps"])
    vfr = TMP / "Screen Recording.mov"  # timestamps jump: the average and base rates disagree
    subprocess.run(["ffmpeg", "-v", "error", "-y", "-f", "lavfi", "-i", "testsrc=s=160x90:r=30:d=3", "-vf", "select=lt(mod(n\\,7)\\,4)",
                    "-fps_mode", "vfr", "-an", "-pix_fmt", "yuv420p", str(vfr)], check=True)
    if orch.probe_media(vfr)["vfr"]:
        vm = orch.ingest_local(vfr)["reference"]
        check("variable-rate recording becomes constant rate", vm["normalized"] is True and vm["vfr"] is False, vm)
    else:
        print("note: the generated recording was not variable rate on this ffmpeg; VFR branch not exercised")
    bad = TMP / "notes.txt"
    bad.write_text("not a video")
    expect_refusal("wrong extension refused", lambda: orch.ingest_local(bad))
    broken = TMP / "broken.mp4"
    broken.write_bytes(b"\x00" * 2048)
    expect_refusal("unreadable video refused", lambda: orch.ingest_local(broken))
    short = TMP / "short.mp4"
    make_video(short, seconds=0.2)
    expect_refusal("too short video refused", lambda: orch.ingest_local(short))
    expect_refusal("missing file refused", lambda: orch.ingest_local(TMP / "ghost.mp4"))

    slug = first["slug"]
    # run: good step done, failing step failed, missing input blocked, allowed code done, run state failed
    expect_refusal("run on an unknown reference refused", lambda: orch.new_run("ghost"))
    expect_refusal("run with an unknown step refused", lambda: orch.new_run(slug, ["zzz"]))
    expect_refusal("run with an unknown parameter refused", lambda: orch.new_run(slug, None, {"evil": "x"}))
    expect_refusal("run with a bad parameter value refused", lambda: orch.new_run(slug, None, {"mode": "a b; rm"}))
    r = orch.new_run(slug, ["a", "b", "c", "d"])
    check("steps not chosen are skipped", [s["state"] for s in r["steps"]] == ["pending"] * 4 + ["skipped"])
    done = orch.execute(r["id"])
    st = {s["id"]: s for s in done["steps"]}
    check("good step is done", st["a"]["state"] == "done" and "a ok fast" in orch.log_tail(r["id"], "a"))
    check("failing step is failed", st["b"]["state"] == "failed" and st["b"]["returncode"] == 3, st["b"])
    check("failed log is kept", "b boom" in orch.log_tail(r["id"], "b"))
    check("missing input is blocked, not run", st["c"]["state"] == "blocked" and "music_best" in st["c"]["note"], st["c"])
    check("allowed exit code is done", st["d"]["state"] == "done")
    check("a failed step makes the run failed", done["state"] == "failed")

    # resume: done steps are not run again unless forced
    mtime = (orch.run_folder(r["id"]) / "a.log").stat().st_mtime
    time.sleep(1.1)
    orch.execute(r["id"])
    check("resume skips done steps", (orch.run_folder(r["id"]) / "a.log").stat().st_mtime == mtime)

    # cancel: a sleeping step is killed and the run says cancelled
    r2 = orch.new_run(slug, ["e"])
    holder = {}
    t = threading.Thread(target=lambda: holder.update(run=orch.execute(r2["id"])))
    t.start()
    time.sleep(3)
    orch.request_cancel(r2["id"])
    t.join(timeout=30)
    check("cancel stops the step quickly", not t.is_alive() and holder["run"]["state"] == "cancelled" and holder["run"]["steps"][4]["state"] == "cancelled", holder.get("run", {}).get("state"))
    expect_refusal("cancel of a finished run refused", lambda: orch.request_cancel(r2["id"]))

    # a dead runner is reported as interrupted, never as running
    r3 = orch.new_run(slug, ["a"])
    run3 = orch.load_run(r3["id"])
    run3["state"], run3["pid"] = "running", 999999
    orch._save(run3)
    check("dead runner -> interrupted", orch.load_run(r3["id"])["state"] == "interrupted")

    # scores: nothing produced yet -> None, never a made-up number
    rows = orch.module_scores(slug)
    check("scores are None before any work", rows[0]["value"] is None and rows[0]["reached"] is False)
    sd = TMP / "workshop" / "vector" / slug
    sd.mkdir(parents=True)
    (sd / "scene.json").write_text(json.dumps({"shot": "S03", "version": "V_001", "classes": {"share": {"vector": 0.7, "shader": 0.2, "residual": 0.1}, "vectorLayersOk": "3/4",
                                                                                         "vectorLayerIouMean": 0.9912}, "verdict": {"explained": 0.97, "reading": "UI"}}))
    sv = orch.score_vector(slug)
    check("vector score reads the scene and keeps shader and residual apart", sv["value"] == 0.9912 and sv["detail"]["shaderShare"] == 0.2, sv)
    check("vector score is None before any scene", orch.score_vector("ghost") is None)
    check("vector detail has no ceiling until one is measured", "ceiling" not in sv["detail"] and sv["detail"]["iouArea"] is None, sv)
    (sd / "ceiling.json").write_text(json.dumps({"shot": "S03", "ceiling": {"vectorLayerIouMean": 0.945, "vectorLayerIouArea": 0.936}}))
    svc = orch.score_vector(slug)
    check("vector detail carries the measured codec ceiling", svc["detail"]["ceiling"]["value"] == 0.945 and svc["detail"]["ceiling"]["iouArea"] == 0.936, svc["detail"])
    # multi-layer fit (15 October 2026): the module reads the COMPOSITE fidelity of the stacked layers when it belongs to the scene's shot, and the
    # per-layer IoU of the single trace stays in the detail; a layered file of another shot is ignored (a scene re-picked after a re-cut)
    (sd / "layered.json").write_text(json.dumps({"applicable": True, "shot": "S03", "layers": 812, "fidelity": {"fidelity": 0.9981, "meanDE": 0.09},
                                                 "codecFloor": {"fidelity": 0.9975}, "seconds": 301.0, "dir": "/x/V_004"}))
    sl = orch.score_vector(slug)
    check("vector reads the composite of the multi-layer fit", sl["value"] == 0.9981 and sl["detail"]["iouMean"] == 0.9912 and sl["detail"]["layers"] == 812
          and sl["version"] == "S03 V_004", sl)
    (sd / "layered.json").write_text(json.dumps({"applicable": True, "shot": "S09", "fidelity": {"fidelity": 0.5}}))
    check("a multi-layer fit of another shot is ignored", orch.score_vector(slug)["value"] == 0.9912)
    (sd / "layered.json").unlink()
    # a measured ceiling under the stretch target marks the module as physically limited; without one nothing is claimed
    real = orch.READERS["music"]
    try:
        orch.READERS["music"] = lambda s: {"value": 0.97, "detail": {"ceiling": {"value": 0.995}}}
        r1 = orch.module_scores(slug)[0]
        orch.READERS["music"] = lambda s: {"value": 0.97, "detail": {"ceiling": {"value": 0.9995}}}
        r2 = orch.module_scores(slug)[0]
        orch.READERS["music"] = lambda s: {"value": 0.97, "detail": {}}
        r3 = orch.module_scores(slug)[0]
    finally:
        orch.READERS["music"] = real
    check("a ceiling under the stretch target is reported as limited", r1["ceiling"] == 0.995 and r1["limited"] is True, r1)
    check("a ceiling above the stretch target is not a limit", r2["ceiling"] == 0.9995 and r2["limited"] is False, r2)
    check("no measured ceiling, no claim", r3["ceiling"] is None and r3["limited"] is False, r3)
    check("run listing finds the runs", len(orch.list_runs(slug)) >= 3)
    check("a failed step note carries the last log line", "b boom" in st["b"]["note"], st["b"]["note"])
    expect_refusal("bad run id refused", lambda: orch.run_folder("../../etc"))

    # corpus members (14 October 2026): a reference made of excerpts is read as its WORST excerpt, and is never "reached" while an excerpt
    # has no reading; each module reads its own file. FR : une reference en extraits vaut son pire extrait, jamais atteinte s'il en manque un.
    agg = "aggref"
    for m, v in (("aggref-m1", 99.95), ("aggref-m2", 99.2)):
        (TMP / "refcache" / m).mkdir(parents=True)
        bench = TMP / "workshop" / "sound" / m / "music-bench" / "V_001"
        bench.mkdir(parents=True)
        (bench / "mix.wav").write_bytes(b"RIFF")
        (bench / "scores.json").write_text(json.dumps({"headline": {"mix": {"tfBands": v}}}))
    sm = orch.score_music(agg)
    check("music of a reference is its worst member", sm["value"] == 0.992 and sm["detail"]["worst"] == "aggref-m2" and sm["detail"]["complete"], sm)
    (TMP / "refcache" / "aggref-m3").mkdir()
    row = orch.module_scores(agg)[0]
    check("a member without a reading keeps the module from being reached", row["value"] == 0.992 and not row["detail"]["complete"] and not row["reached"], row)
    b3 = TMP / "workshop" / "sound" / "aggref-m3" / "music-bench" / "V_001"
    b3.mkdir(parents=True)
    (b3 / "mix.wav").write_bytes(b"RIFF")
    (b3 / "scores.json").write_text(json.dumps({"headline": {"mix": {"tfBands": 99.99}}}))
    row = orch.module_scores(agg)[0]
    check("every member read -> complete and reached", row["detail"]["complete"] and row["reached"] and row["value"] == 0.992, row)
    check("a single-member reference reads itself", orch.score_music("aggref-m1")["value"] == 0.9995)

    def sound_report(member, scores=None, trim=None):
        d = TMP / "workshop" / "sound" / member / "V_001"
        d.mkdir(parents=True, exist_ok=True)
        body = {"reports": {"full": {"scores": scores or {}}}}
        if trim is not None:
            body["trim"] = trim
        (d / "sound-fidelity.json").write_text(json.dumps(body))
    sound_report("aggref-m1", {"mix": 99.97, "sfx": 91.0}, {"events": [{"plossStochastic": [70.0, 99.9]}, {"plossStochastic": [60.0, 99.7]}], "gate": {"pass": True, "passMusic": True},
                                                          "critic": {"after": 99.9}, "auditMean": {"after": 99.8}})
    sound_report("aggref-m2", {"mix": 99.95, "sfx": 99.6})                              # no trim block: the exact loss of the assembled soundtrack
    sound_report("aggref-m3", {"mix": 99.91, "sfx": 100.0}, {"events": [], "gate": {}})  # trimmed, no event: 100 by definition
    sx = orch.score_sfx(agg)
    check("sfx reads the seed-invariant gate of a trimmed member, not the exact loss", sx["detail"]["members"]["aggref-m1"] == 0.998, sx)
    check("sfx of an untrimmed member falls back to the exact loss", sx["detail"]["members"]["aggref-m2"] == 0.996, sx)
    check("sfx of a member with no event is 100 by definition", sx["detail"]["members"]["aggref-m3"] == 1.0, sx)
    check("sfx of the reference is its worst member", sx["value"] == 0.996 and sx["detail"]["complete"], sx)
    mx = orch.score_mix(agg)
    check("mix of the reference is its worst member", mx["value"] == 0.9991 and mx["detail"]["worst"] == "aggref-m3", mx)
    check("mix is None for a member with no soundtrack", orch.score_mix("ghost-m1") is None)
    print(f"{len(FAIL)} failure(s)")
    return 1 if FAIL else 0


def test_orchestrator():
    assert run() == 0


if __name__ == "__main__":
    code = run()
    import shutil
    shutil.rmtree(TMP, ignore_errors=True)
    sys.exit(code)
