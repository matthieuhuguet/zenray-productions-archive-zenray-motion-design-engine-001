{
  "id": "light_sweep",
  "family": "light",
  "description": "Gaussian light sweep band across the frame along an angle (animate 'position' for a shine pass). Colour block for add or screen. (12 October 2026)",
  "params": [
    {
      "name": "color",
      "type": "color",
      "default": [
        1.0,
        1.0,
        1.0
      ],
      "min": [
        0.0,
        0.0,
        0.0
      ],
      "max": [
        1.0,
        1.0,
        1.0
      ],
      "unit": "sRGB 0..1"
    },
    {
      "name": "angle",
      "type": "float",
      "default": 90.0,
      "min": -180.0,
      "max": 180.0,
      "unit": "degrees (0 = left to right, 90 = top to bottom)"
    },
    {
      "name": "position",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "unit": "ramp position"
    },
    {
      "name": "width",
      "type": "float",
      "default": 0.06,
      "min": 0.01,
      "max": 0.2,
      "unit": "ramp units"
    },
    {
      "name": "intensity",
      "type": "float",
      "default": 1.0,
      "min": 0.2,
      "max": 2.0,
      "unit": "gain"
    }
  ],
  "source_url": "",
  "licence": "original (written from the mathematics), same licence as the engine",
  "attribution": "ZenRay Motion Design, 12 October 2026",
  "tags": [
    "sweep",
    "shine",
    "specular",
    "band",
    "light",
    "colour"
  ],
  "looks": [
    "shine-pass",
    "glass-sweep",
    "logo-shine"
  ]
}
