import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def render(params, u, v):
    q = params
    px = (u - q['center'][0]) * q['aspect']
    py = v - q['center'][1]
    a = np.radians(q['angle'])
    lx = np.cos(a) * px + np.sin(a) * py
    ly = -np.sin(a) * px + np.cos(a) * py
    h = 0.5 * q['blur_len']
    bx, by = q['half_size']
    cx = (np.clip(lx + h, -bx, bx) - np.clip(lx - h, -bx, bx)) / q['blur_len']
    cy = 1.0 - _ss(-q['soft'], q['soft'], np.abs(ly) - by)
    return cx * cy
