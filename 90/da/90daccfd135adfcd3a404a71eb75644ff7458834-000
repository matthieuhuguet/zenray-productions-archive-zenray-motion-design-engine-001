// 12 October 2026: Glow around a rounded rectangle: exp(-d / falloff) outside, mix(inner, 1, exp(d / falloff)) inside, continuous at the edge. Colour block.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: color (sRGB 0..1), center (uv), half_size (uv (height units)), radius (uv (height units)), falloff (uv (height units)), inner (inside level), intensity (gain), aspect (width / height).
float glow_rounded_rect_box(vec2 p, vec2 b, float r) {
  r = min(r, min(b.x, b.y));
  vec2 q = abs(p) - b + r;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
vec4 glow_rounded_rect(vec2 uv, vec3 color, vec2 center, vec2 half_size, float radius, float falloff, float inner, float intensity, float aspect) {
  vec2 p = (uv - center) * vec2(aspect, 1.0);
  float d = glow_rounded_rect_box(p, half_size, radius);
  float g = d < 0.0 ? mix(inner, 1.0, exp(d / falloff)) : exp(-d / falloff);
  return vec4(clamp(color * g * intensity, 0.0, 1.0), 1.0);
}
