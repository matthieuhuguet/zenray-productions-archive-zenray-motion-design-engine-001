{
 "schema": "zrmd/orchestrator@1",
 "date": "14 October 2026",
 "doc": "The single parameter interface of the local orchestrator (HDA law): the pipeline is DATA, the code only runs it. No language model is called anywhere: every step is a deterministic command, so any agent (Claude, Codex, Gemini, a shell script) or the GUI drives the same CLI/HTTP contract. Tokens: {py} {engine} {workshop} {refcache} {slug} {run} plus the resolvers listed under `resolvers`. FR : interface unique de l'orchestrateur ; le pipeline est une donnee, aucun LLM n'est appele.",
 "server": {
  "host": "127.0.0.1",
  "port": 3104,
  "maxUploadMB": 2048,
  "pollMs": 1500,
  "clientHeader": "x-zr-orchestrator-client",
  "clientValue": "1"
 },
 "paths": {
  "runs": "{workshop}/runs",
  "uploads": "{refcache}/_uploads",
  "logsKeep": 200
 },
 "gui": {
  "dir": "{engine}/app",
  "fontDir": "/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/public/fonts"
 },
 "ingest": {
  "extensions": [
   ".mp4",
   ".mov",
   ".mkv",
   ".webm",
   ".m4v"
  ],
  "slugMaxChars": 60,
  "minDurationS": 1.0,
  "maxDurationS": 600.0,
  "normalize": {
   "keepAsIs": [
    ".mp4",
    ".m4v"
   ],
   "fpsChoices": [
    23.976,
    24,
    25,
    29.97,
    30,
    50,
    59.94,
    60
   ],
   "crf": 12,
   "preset": "medium",
   "audioKbps": 256,
   "doc": "A dropped video that is not a constant-frame-rate MP4 (WebM, MKV, a QuickTime screen recording that varies its rate) is rewritten as a near-lossless CFR MP4 so every module can count frames exactly. A plain MP4 is never re-encoded."
  }
 },
 "targets": {
  "default": 0.99,
  "stretch": 0.999
 },
 "modules": [
  {
   "id": "rhythm",
   "label": "Rhythm",
   "hint": "cuts and timing",
   "steps": [
    "shots",
    "book",
    "film"
   ],
   "score": "rhythm"
  },
  {
   "id": "visual",
   "label": "Image",
   "hint": "shaders, 3D, 2D, fonts",
   "steps": [
    "film"
   ],
   "score": "visual"
  },
  {
   "id": "music",
   "label": "Music",
   "hint": "stems, notes, instruments",
   "steps": [
    "stems",
    "music",
    "music-iter"
   ],
   "score": "music"
  },
  {
   "id": "sfx",
   "label": "Sound effects",
   "hint": "events and synthesis",
   "steps": [
    "sfx"
   ],
   "score": "sfx"
  },
  {
   "id": "mix",
   "label": "Mix",
   "hint": "loudness and balance",
   "steps": [
    "soundtrack"
   ],
   "score": "mix"
  }
 ],
 "steps": [
  {
   "id": "shots",
   "label": "Cut detection",
   "module": "rhythm",
   "timeoutS": 900,
   "argv": [
    "{py}",
    "-I",
    "-m",
    "zrmd.cli",
    "shots",
    "{slug}"
   ],
   "cwd": "{engine}",
   "outputs": [
    "{workshop}/references/{slug}/analysis/shots.json"
   ]
  },
  {
   "id": "book",
   "label": "Bible and storyboard",
   "module": "rhythm",
   "timeoutS": 3600,
   "okCodes": [
    0
   ],
   "argv": [
    "{py}",
    "-I",
    "{engine}/Scripts/BuildReferenceBook.py",
    "--slug",
    "{slug}"
   ],
   "cwd": "{engine}",
   "outputs": [
    "{workshop}/references/{slug}/storyboard.html"
   ]
  },
  {
   "id": "stems",
   "label": "Stem separation",
   "module": "music",
   "timeoutS": 1800,
   "argv": [
    "{py}",
    "-I",
    "{engine}/Scripts/MusicRun.py",
    "--slug",
    "{slug}"
   ],
   "cwd": "{engine}",
   "outputs": [
    "{refcache}/{slug}/stems/out/htdemucs/mix/drums.wav"
   ]
  },
  {
   "id": "music",
   "label": "Music rebuild",
   "module": "music",
   "timeoutS": 14400,
   "okCodes": [
    0
   ],
   "argv": [
    "{py}",
    "-I",
    "{engine}/Scripts/MusicRun.py",
    "--slug",
    "{slug}",
    "--transcribe",
    "--stages",
    "{musicStages}",
    "--set",
    "residual.stems=[\"drums\",\"bass\",\"other\",\"vocals\"]",
    "--critic"
   ],
   "cwd": "{engine}",
   "watch": "{workshop}/sound/{slug}/music-bench",
   "score": "music"
  },
  {
   "id": "music-iter",
   "label": "Music stem iteration",
   "module": "music",
   "timeoutS": 43200,
   "okCodes": [
    0
   ],
   "argv": [
    "{py}",
    "-I",
    "{engine}/Scripts/MusicIterate.py",
    "--slug",
    "{slug}",
    "--critic"
   ],
   "cwd": "{engine}",
   "watch": "{workshop}/sound/{slug}/music-bench",
   "score": "music"
  },
  {
   "id": "sfx",
   "label": "Sound effects rebuild",
   "module": "sfx",
   "timeoutS": 14400,
   "okCodes": [
    0,
    1
   ],
   "argv": [
    "{py}",
    "-I",
    "{engine}/Scripts/ReproduceSound.py",
    "--slug",
    "{slug}",
    "--out",
    "{workshop}/sound/{slug}"
   ],
   "cwd": "{engine}",
   "watch": "{workshop}/sound/{slug}",
   "score": "sfx"
  },
  {
   "id": "soundtrack",
   "label": "Soundtrack assembly",
   "module": "mix",
   "timeoutS": 3600,
   "okCodes": [
    0,
    1
   ],
   "needs": [
    "music_best",
    "sfx_latest"
   ],
   "argv": [
    "{py}",
    "-I",
    "{engine}/Scripts/AssembleSoundtrack.py",
    "--slug",
    "{slug}",
    "--music",
    "{music_best}",
    "--sfx",
    "{sfx_latest}"
   ],
   "cwd": "{engine}",
   "watch": "{workshop}/sound/{slug}",
   "score": "mix"
  },
  {
   "id": "film",
   "label": "Film animatic",
   "module": "visual",
   "timeoutS": 7200,
   "okCodes": [
    0
   ],
   "argv": [
    "{py}",
    "-I",
    "{engine}/Scripts/ReproduceFilm.py",
    "--slug",
    "{slug}",
    "--id",
    "{slug}-film"
   ],
   "cwd": "{engine}",
   "optionalArgs": [
    {
     "when": "soundtrack_mix",
     "args": [
      "--audio",
      "{soundtrack_mix}"
     ]
    }
   ],
   "score": "rhythm"
  }
 ],
 "defaults": {
  "musicStages": "own,sms,bus,dev,gap,retag,bus"
 },
 "honestLimits": [
  "visual: only text cards and graphic shots are reproduced by code; photographed plates stay colour animatics",
  "sfx: not yet near the target on a new video",
  "the music chain and its stem iterations were proven by hand on OneKey (99.1) and on one more video (97.3); the automatic iteration is new"
 ]
}
