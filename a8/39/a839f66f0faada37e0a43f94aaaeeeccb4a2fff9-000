vec4 horizon_floor_reflect(vec2 uv, float horizon, vec3 c_sky, vec3 c_floor_top, vec3 c_floor_bottom, vec2 refl_x, float refl_height, vec3 refl_color, float strength, float falloff, float blur, float aspect) {
  vec3 col = c_sky;
  float dy = uv.y - horizon;
  if (dy > 0.0) {
    col = mix(c_floor_top, c_floor_bottom, clamp(dy / max(1.0 - horizon, 1e-4), 0.0, 1.0));
