    await document.fonts.ready;
    rebuild(); renderAll();
    let cmp = false; try { cmp = localStorage.getItem("zs-compare") === "1"; } catch (e) { /* private window */ }
    setCompare(cmp && !!S.project.reference);
    seek(Math.min(2.5, S.built.duration / 2));
  }
  async function createFrom(preset, title) {
    const j = await api("POST", "/api/motion/projects", { preset, title });
    await loadList(j.project.id);
  }
  function renderAll() { renderScenes(); renderPanel(); $("#formatSel").value = S.project.format; }
  $("#projectSel").onchange = (e) => openProject(e.target.value);
  $("#formatSel").onchange = (e) => change((p) => { p.format = e.target.value; });
  $("#dupBtn").onclick = async () => {
    const j = await api("POST", `/api/motion/projects/${S.project.id}/duplicate`, { title: S.project.title + " copie" });
    await loadList(j.project.id); toast("Copie créée : l'original reste intact.");
  };
  $("#newBtn").onclick = () => {
    const d = $("#dlg");
    d.innerHTML = `<h3 style="font-family:var(--f-serif);font-weight:400;margin:0">Nouveau projet</h3><div class="choices">${S.presets.map((p) =>
      `<button class="choice" data-p="${p.id}" type="button"><b>${esc(p.title)}</b><span class="hint">${esc(p.format)} · ${esc(p.doc || "")}</span></button>`).join("")}</div>
      <div class="row"><input type="text" id="newTitle" placeholder="Titre (facultatif)"><button type="button" id="dlgClose">Annuler</button></div>`;
    d.showModal();
    d.querySelectorAll("[data-p]").forEach((b) => (b.onclick = async () => { d.close(); await createFrom(b.dataset.p, $("#newTitle").value || undefined); }));
    $("#dlgClose").onclick = () => d.close();
  };

  fillAdd();
  loadList().catch((e) => toast(e.message, true));
  $("#hideRefBtn").onclick = () => setHideRefs(!S.hideRefs);
  $("#compareBtn").onclick = () => setCompare(!S.compare);
  try { S.hideRefs = localStorage.getItem("zs-hide-refs") === "1"; $("#hideRefBtn").classList.toggle("toggled", S.hideRefs); if (S.hideRefs) $("#hideRefBtn").textContent = "Référence masquée"; } catch (e) { /* private window */ }
  // 15 October 2026: a window opened before the code changed reloads itself (after the pending save), so a new template never shows
  // as "modèle inconnu". It asks the server for the code fingerprint every 4 s and when the window comes back to the front.
  let codeSeen = null;
  const checkCode = async () => {
    try {
      const j = await api("GET", "/api/motion/status");
      if (codeSeen === null) { codeSeen = j.code; return; }
      if (j.code && j.code !== codeSeen) {
        if (S.saveTimer && $("#saveState").textContent === "…") return;   // wait for the save in flight
        location.reload();
      }
    } catch (e) { /* server restarting: try again later */ }
  };
  checkCode(); setInterval(checkCode, 4000); window.addEventListener("focus", checkCode);
  window.ZS_STUDIO = S;
  // what the gallery (gallery.js) uses: the state and the editor's own actions, never a second copy of them
  window.ZS_APP = { S, api, change, toast, esc, openProject, loadList, renderPanel, renderTrack, renderScenes, setTab, seek, play, pause, loadBank, rebuild, upload };
  try { if (localStorage.getItem("zs-mode") === "gallery") setTimeout(() => window.ZS_MODE && window.ZS_MODE("gallery"), 0); } catch (e) { /* private window */ }
})();

// 15 October 2026: the mode switch (editor / gallery), undo and redo buttons, and what the gallery needs from the editor.
(function () {
  const $ = (q) => document.querySelector(q);
  const setMode = (m) => {
    [...$("#modeSeg").children].forEach((b) => b.classList.toggle("on", b.dataset.mode === m));
    $("#editView").hidden = m !== "edit"; $("#galleryView").hidden = m !== "gallery";
    if (m === "gallery" && window.ZSGallery) window.ZSGallery.render();
    if (m === "edit") window.dispatchEvent(new Event("resize"));
    try { localStorage.setItem("zs-mode", m); } catch (e) { /* private window */ }
  };
  $("#modeSeg").onclick = (e) => { if (e.target.dataset.mode) setMode(e.target.dataset.mode); };
  $("#undoBtn").onclick = () => document.dispatchEvent(new KeyboardEvent("keydown", { key: "z", metaKey: true }));
  $("#redoBtn").onclick = () => document.dispatchEvent(new KeyboardEvent("keydown", { key: "z", metaKey: true, shiftKey: true }));
  window.ZS_MODE = setMode;
})();
