// 15 October 2026: ZenRay Motion Design, the motion editor. The project lives in this page: every change rebuilds the composition (DOM + GSAP timeline) in a few
// milliseconds and the preview follows at once; the sound is generated live by Web Audio from the same project. The server only saves (PUT,
// debounced) and exports. Undo and redo keep 60 states. FR : l'interface du studio ; chaque valeur change l'apercu immediatement.
(function () {
  const $ = (s, r) => (r || document).querySelector(s);
  const HDR = { "x-zr-orchestrator-client": "1" };
  const S = { projects: [], presets: [], project: null, assets: [], sel: 0, built: null, time: 0, playing: false, tab: "scene",
