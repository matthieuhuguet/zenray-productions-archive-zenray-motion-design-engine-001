    const sv = ZS.audio.values(ZS.audio.SFX_PARAMS, S.project.sfx || {});
    if (sv.sceneCues) (S.built.cues || []).forEach((c) => { const i = document.createElement("i"); i.style.left = pc(c.t); i.title = c.type; sl.appendChild(i); });
    if (sv.refEvents) ((S.project.sfx || {}).events || []).forEach((e) => { const i = document.createElement("i"); i.className = "ref"; i.style.left = pc(e.t); i.title = e.kind; sl.appendChild(i); });
    updateTime();
