    const r = await fetch(path, opt), j = await r.json().catch(() => ({ ok: false, error: `HTTP ${r.status}` }));
    if (!r.ok || !j.ok) throw new Error(j.error || `HTTP ${r.status}`);
    return j;
  }
  function toast(msg, err) {
    const t = $("#toast"); t.textContent = msg; t.className = "toast show" + (err ? " err" : "");
    clearTimeout(toast.k); toast.k = setTimeout(() => (t.className = "toast"), err ? 6000 : 2600);
  }
  function save() {
    clearTimeout(S.saveTimer);
    $("#saveState").textContent = "…";
    S.saveTimer = setTimeout(async () => {
      try { await api("PUT", `/api/motion/projects/${S.project.id}`, S.project); $("#saveState").textContent = "enregistré"; }
      catch (e) { $("#saveState").textContent = "non enregistré"; toast(e.message, true); }
    }, 500);
  }
  // every change goes through here: it is undoable, saved, and rebuilt
  function change(fn, opts) {
    const now = Date.now();                                    // a slider drag is one undo step, not sixty
    if (now - (S.lastChange || 0) > 400) { S.undo.push(JSON.stringify(S.project)); if (S.undo.length > 60) S.undo.shift(); }
    S.lastChange = now; S.redo = [];
    fn(S.project);
    save();
    rebuild();
    if (!(opts && opts.keepPanel)) renderPanel();
    renderScenes();
    restartAudioSoon();
  }
  function undo(redo) {
    const from = redo ? S.redo : S.undo, to = redo ? S.undo : S.redo;
    if (!from.length) return;
    to.push(JSON.stringify(S.project));
    S.project = JSON.parse(from.pop());
    S.sel = Math.min(S.sel, S.project.scenes.length - 1);
    save(); rebuild(); renderAll(); restartAudioSoon();
  }

  // ------------------------------------------------------------------------------------------------ build and play
  function rebuild() {
    const keep = S.time;
    S.built = ZS.build(S.project, stage, { preview: true, assetBase: `/motion/files/${S.project.id}/`, hideRefs: !!S.hideRefs });
    // a face first used by this build (Vogun for example) loads now: fit the text again once it has arrived (15 October 2026)
    { const b = S.built; if (document.fonts) document.fonts.ready.then(() => { if (S.built === b) ZS.refit(b); }); }
    S.time = Math.min(keep, Math.max(0, S.built.duration - 0.001));
    S.built.tl.seek(S.time, false);
    fit();
    renderTrack();
    $("#totalDur").textContent = S.built.duration.toFixed(1) + " s";
  }
  function fit() {
    if (!S.built) return;
    // side by side with the reference: the motion takes the left half
    const W = S.built.W, H = S.built.H, r = stageWrap.getBoundingClientRect(), half = S.compare ? 0.5 : 1;
    const s = Math.min(r.width * half / W, r.height / H) * 0.94;
    stageScale.style.left = S.compare ? "25%" : "50%";
    stageScale.style.transform = `translate(${-W * s / 2}px, ${-H * s / 2}px) scale(${s})`;
  }
  // the reference video follows the playhead (reference time = project time + project.referenceOffset)
  function syncRef() {
    if (!S.compare) return;
    const v = $("#refVideo"), want = S.time + (Number(S.project.referenceOffset) || 0);
    if (S.playing) { if (v.paused) v.play().catch(() => {}); if (Math.abs(v.currentTime - want) > 0.15) v.currentTime = want; }
    else { if (!v.paused) v.pause(); if (Math.abs(v.currentTime - want) > 0.02) v.currentTime = want; }
  }
  function setCompare(on) {
    S.compare = !!on && !!S.project.reference;
    $("#refPane").hidden = !S.compare; $("#motionLbl").hidden = !S.compare;
    $("#compareBtn").classList.toggle("toggled", S.compare);
    const v = $("#refVideo");
    if (S.compare) { const src = `/motion/bank/ref/${encodeURIComponent(S.project.reference)}`; if (v.getAttribute("src") !== src) v.src = src; syncRef(); } else v.pause();
    if (on && !S.project.reference) toast("Ce projet n'a pas de vidéo de référence.", true);
    try { localStorage.setItem("zs-compare", S.compare ? "1" : ""); } catch (e) { /* private window */ }
    fit();
  }
  function setHideRefs(on) {
    S.hideRefs = !!on;
    $("#hideRefBtn").classList.toggle("toggled", S.hideRefs);
    $("#hideRefBtn").textContent = S.hideRefs ? "Référence masquée" : "Masquer la référence";
    try { localStorage.setItem("zs-hide-refs", S.hideRefs ? "1" : ""); } catch (e) { /* private window */ }
    rebuild();
  }
  window.addEventListener("resize", fit);
  // a reproduced music: an excerpt of its four stems around the film (offset to offset + duration at the highest pitch), decoded once
  async function bankBuffers() {
    const m = S.project.music || {}, v = ZS.audio.values(ZS.audio.BANK_PARAMS, m.bank || {});
    const track = ((S.bank && S.bank.music) || []).find((x) => x.id === v.track);
    if (!track) return;
    const a = Math.max(0, v.offset - 0.5), b = v.offset + S.built.duration * Math.pow(2, 4 / 12) + 1, key = `${track.id}@${a.toFixed(2)}-${b.toFixed(2)}`;
    if (S.audio.bankKey === key) return;
    const files = {}; Object.entries(track.stems).forEach(([st, url]) => { files[`bank:${track.id}:${st}`] = `${url}?from=${a}&to=${b}`; });
    if (!Object.keys(files).length) files[`bank:${track.id}:mix`] = `${track.mix}?from=${a}&to=${b}`;
    const got = await ZS.audio.decode(S.audio.ctx, files);
    Object.values(got).forEach((buf) => { if (buf) buf.zsStart = a; });
    Object.keys(S.audio.buffers).filter((k) => k.startsWith("bank:")).forEach((k) => delete S.audio.buffers[k]);
    Object.assign(S.audio.buffers, got); S.audio.bankKey = key;
  }
  // effects from the bank: the index by kind once, then only the samples the cues of this film will play
  async function sfxBuffers() {
    const s = ZS.audio.values(ZS.audio.SFX_PARAMS, S.project.sfx || {});
    const evs = ((S.project.sfx || {}).events || []);
    const picks = Object.keys((S.project.sfx || {}).pick || {}).length;
    if (!s.enabled || (s.source !== "banque" && !(s.refEvents && evs.length) && !picks)) return;
    if (!S.sfxBank) S.sfxBank = await api("GET", "/api/motion/banks/sfx");
    const index = {}, url = {};
    S.sfxBank.sfx.filter((x) => x.kind !== "synth").forEach((x) => { (index[x.kind] = index[x.kind] || []).push(x.id); url[x.id] = x.url; });
    S.audio.buffers.sfxIndex = index;
    const need = {};
    if (s.source === "banque" && s.sceneCues) (S.built.cues || []).forEach((c, i) => { const id = ZS.audio.pickSfx(index, c, i, s.bankSeed); if (id && S.audio.buffers[`sfx:${id}`] === undefined) need[`sfx:${id}`] = url[id]; });
    if (s.refEvents) evs.forEach((e) => { if (url[e.id] && S.audio.buffers[`sfx:${e.id}`] === undefined) need[`sfx:${e.id}`] = url[e.id]; });
    Object.values((S.project.sfx || {}).pick || {}).forEach((id) => { if (url[id] && S.audio.buffers[`sfx:${id}`] === undefined) need[`sfx:${id}`] = url[id]; });
    if (Object.keys(need).length) Object.assign(S.audio.buffers, await ZS.audio.decode(S.audio.ctx, need));
  }
  async function audioBuffers() {
    await sfxBuffers();
    if ((S.project.music || {}).mode === "bank") { await bankBuffers(); return S.audio.buffers; }
    const m = S.project.music || {}, f = m.mode === "file" && m.file && m.file.file;
    if (!f || S.audio.buffers[f] !== undefined) return S.audio.buffers;
    Object.assign(S.audio.buffers, await ZS.audio.decode(S.audio.ctx, { [f]: `/motion/files/${S.project.id}/${encodeURIComponent(f)}` }));
    return S.audio.buffers;
  }
  async function play() {
    if (!S.audio.ctx) S.audio.ctx = new AudioContext();
    await S.audio.ctx.resume();
    if (S.time >= S.built.duration - 0.05) S.time = 0;
    await audioBuffers();
    startAudio();
    S.playing = true; ZS.videoTolerance = 0.3;
    S.built.videos.forEach((v) => v.node.play().catch(() => {}));
    $("#playBtn").textContent = "❚❚";
    requestAnimationFrame(tick);
  }
  function startAudio() {
    if (S.audio.handle) S.audio.handle.stop();
    S.audio.handle = ZS.audio.schedule(S.audio.ctx, S.project, S.built.cues, S.time, S.built.duration, S.audio.buffers);
  }
  function restartAudioSoon() {
    if (!S.playing) return;
    clearTimeout(S.audioTimer);
    S.audioTimer = setTimeout(async () => { if (!S.playing) return; S.time = S.audio.ctx.currentTime - S.audio.handle.T0; await audioBuffers(); startAudio(); }, 250);
  }
  function pause() {
    S.playing = false; ZS.videoTolerance = 0.08;
    if (S.compare) $("#refVideo").pause();
    if (S.audio.handle) { S.audio.handle.stop(); S.audio.handle = null; }
    if (S.built) S.built.videos.forEach((v) => v.node.pause());
    $("#playBtn").textContent = "▶";
  }
  function tick() {
    if (!S.playing) return;
    const t = S.audio.ctx.currentTime - S.audio.handle.T0;
    if (t >= S.built.duration) { S.time = S.built.duration; S.built.tl.seek(S.time, false); pause(); updateTime(); return; }
    S.time = Math.max(0, t);
    S.built.tl.seek(S.time, false);
    updateTime();
    requestAnimationFrame(tick);
  }
  function seek(t) {
    S.time = Math.max(0, Math.min(S.built.duration, t));
    S.built.tl.seek(S.time, false);
    updateTime();
    if (S.playing) startAudio();
  }
  // ---- the timeline in pixels: pps = pixels per second (null = the whole film fits the visible width)
  const fmtT = (t) => { const m = Math.floor(t / 60), s2 = t - m * 60; return `${m}:${s2.toFixed(2).padStart(5, "0")}`; };
  const parseT = (v) => { v = String(v).trim().replace(",", "."); const m = /^(\d+):(\d+(?:\.\d+)?)$/.exec(v); return m ? +m[1] * 60 + +m[2] : isFinite(+v) ? +v : NaN; };
  const fps = () => Number(S.project.fps) || 30;
  function pps() {
    const vis = Math.max(100, $("#tlScroll").clientWidth - 2);
    return S.pps || vis / Math.max(0.5, S.built.duration);
  }
  function updateTime() {
    syncRef();
    const k = pps();
    if (document.activeElement !== $("#timeIn")) $("#timeIn").value = fmtT(S.time);
    $("#timeTot").textContent = "/ " + fmtT(S.built.duration);
    $("#playhead").style.left = S.time * k + "px";
    const i = S.built.spans.findIndex((sp) => S.time >= sp.start && S.time < sp.end);
    [...$("#segments").children].forEach((d, j) => d.classList.toggle("on", j === i));
    // while playing (or stepping), the playhead stays in view
    const sc = $("#tlScroll"), x = S.time * k;
    if (x < sc.scrollLeft + 20 || x > sc.scrollLeft + sc.clientWidth - 40) sc.scrollLeft = Math.max(0, x - sc.clientWidth * 0.3);
  }
  $("#playBtn").onclick = () => (S.playing ? pause() : play());
  // scrub: press anywhere in the timeline (except on a sub-scene block) and drag; the frame follows the pointer, snapped to the frame rate
  const tAt = (e) => { const r = $("#track").getBoundingClientRect(); return Math.max(0, Math.min(S.built.duration, (e.clientX - r.left) / pps())); };
  let scrubbing = false, scrubT = null, scrubRaf = 0;
  const scrubTo = (t) => { scrubT = Math.round(t * fps()) / fps(); if (!scrubRaf) scrubRaf = requestAnimationFrame(() => { scrubRaf = 0; if (scrubT != null) seek(scrubT); }); };
  $("#track").addEventListener("pointerdown", (e) => {
    if (e.target.closest("#childLane div")) return;
    scrubbing = true; try { $("#track").setPointerCapture(e.pointerId); } catch (err) { /* synthetic pointer */ }
    if (S.playing) pause();
    scrubTo(tAt(e));
  });
  $("#track").addEventListener("pointermove", (e) => {
    const t = tAt(e), hl = $("#hoverLine");
    hl.hidden = false; hl.style.left = t * pps() + "px"; hl.firstChild.textContent = fmtT(t);
    if (scrubbing) scrubTo(t);
  });
  $("#track").addEventListener("pointerleave", () => { $("#hoverLine").hidden = true; });
  const endScrub = () => {
    if (!scrubbing) return;
    scrubbing = false;
    const i = S.built.spans.findIndex((sp) => S.time >= sp.start && S.time < sp.end);
    if (i >= 0 && (i !== S.sel || S.child != null)) { S.sel = i; S.child = null; renderScenes(); if (S.tab === "scene") renderPanel(); renderTrack(); }
  };
  $("#track").addEventListener("pointerup", endScrub);
  $("#track").addEventListener("pointercancel", endScrub);
  // zoom: Cmd or Ctrl + wheel around the pointer, the buttons, or « Ajuster » for the whole film
  const zoomTo = (k, anchorX) => {
    const sc = $("#tlScroll"), old = pps(), ax = anchorX == null ? S.time * old - sc.scrollLeft : anchorX, tAnchor = (sc.scrollLeft + ax) / old;
    const fitK = Math.max(100, sc.clientWidth - 2) / Math.max(0.5, S.built.duration);
    S.pps = Math.max(fitK, Math.min(2000, k)); if (S.pps <= fitK * 1.001) S.pps = null;
    renderTrack(); sc.scrollLeft = Math.max(0, tAnchor * pps() - ax);
  };
  $("#tlScroll").addEventListener("wheel", (e) => {
    if (!(e.metaKey || e.ctrlKey)) return;
    e.preventDefault();
    const r = $("#tlScroll").getBoundingClientRect();
    zoomTo(pps() * Math.exp(-e.deltaY * 0.004), e.clientX - r.left);
  }, { passive: false });
  $("#zinBtn").onclick = () => zoomTo(pps() * 1.6);
  $("#zoutBtn").onclick = () => zoomTo(pps() / 1.6);
  $("#zfitBtn").onclick = () => { S.pps = null; renderTrack(); $("#tlScroll").scrollLeft = 0; };
  // precise time: type it, or step frame by frame
  $("#timeIn").addEventListener("keydown", (e) => {
    if (e.key === "Enter") { const t = parseT(e.target.value); if (isFinite(t)) seek(t); else toast("Instant non lu : écris 1:23.5 ou 83.5", true); e.target.blur(); }
    if (e.key === "Escape") { e.target.value = fmtT(S.time); e.target.blur(); }
  });
  const step = (d) => { if (S.playing) pause(); seek(Math.round((S.time + d) * fps()) / fps()); };
  $("#prevBtn").onclick = (e) => step(e.shiftKey ? -1 : -1 / fps());
  $("#nextBtn").onclick = (e) => step(e.shiftKey ? 1 : 1 / fps());
  window.addEventListener("resize", () => { if (S.built) renderTrack(); });
  document.addEventListener("keydown", (e) => {
    if (/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) return;
    if (e.code === "Space") { e.preventDefault(); S.playing ? pause() : play(); }
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "z") { e.preventDefault(); undo(e.shiftKey); }
    if (e.key === "ArrowLeft" || e.key === ",") { e.preventDefault(); step(e.shiftKey ? -1 : -1 / fps()); }
    if (e.key === "ArrowRight" || e.key === ".") { e.preventDefault(); step(e.shiftKey ? 1 : 1 / fps()); }
    if (e.key === "Home") { e.preventDefault(); seek(0); }
    if (e.key === "End") { e.preventDefault(); seek(S.built.duration); }
  });

  // ------------------------------------------------------------------------------------------------ scenes and track
  function renderTrack() {
    const D = Math.max(0.001, S.built.duration), k = pps(), pc = (t) => t * k + "px";
    const width = Math.max($("#tlScroll").clientWidth - 2, Math.ceil(D * k));
    $("#track").style.width = width + "px";
    // ruler: a labelled tick at least every 70 px, minor ticks between
    const STEPS = [0.04, 0.1, 0.2, 0.5, 1, 2, 5, 10, 15, 30, 60, 120];
    const major = STEPS.find((x) => x * k >= 70) || 120, minor = major / (major >= 1 && major % 5 === 0 ? 5 : major >= 1 ? 4 : 5);
    const ru = $("#ruler"); ru.innerHTML = "";
    for (let t = 0, n = 0; t <= D + 1e-6 && n < 4000; t = Math.round((t + minor) * 1000) / 1000, n++) {
      const isMajor = Math.abs(t / major - Math.round(t / major)) < 1e-6, sp = document.createElement("span");
      sp.style.left = pc(t);
      if (isMajor) sp.textContent = major < 1 ? fmtT(t).replace(/0$/, "") : fmtT(t).replace(/\.00$/, ""); else sp.className = "minor";
      ru.appendChild(sp);
    }
    const seg = $("#segments"); seg.innerHTML = "";
    S.built.spans.forEach((sp) => {
      const d = document.createElement("div");
      d.style.left = pc(sp.start); d.style.width = Math.max(1, (sp.end - sp.start) * k) + "px";
      d.textContent = (ZS.templates[sp.template] || {}).label || sp.template;
      d.title = `${d.textContent} · ${fmtT(sp.start)} → ${fmtT(sp.end)}`;
      seg.appendChild(d);
    });
    // sub-scenes: their blocks at their absolute time
    const cl = $("#childLane"); cl.innerHTML = "";
    S.project.scenes.forEach((sc, i) => (sc.children || []).forEach((c, k) => {
      const sp = S.built.spans[i]; if (!sp) return;
      const d = document.createElement("div"), t = sp.start + (Number(c.start) || 0);
      d.style.left = pc(t); d.style.width = pc(Math.max(0.05, Number(c.duration) || 1));
      d.textContent = (ZS.templates[c.template] || {}).label || c.template;
      if (i === S.sel && k === S.child) d.className = "on";
      d.onclick = (e) => { e.stopPropagation(); S.sel = i; S.child = k; renderScenes(); setTab("scene"); seek(t + 0.4); renderTrack(); };
      cl.appendChild(d);
    }));
    // music: the source and what plays
    const ml = $("#musicLane"); ml.innerHTML = "";
    const m = S.project.music || {}, md = document.createElement("div");
    md.style.left = "0"; md.style.width = "100%";
    md.textContent = m.mode === "bank" ? `Musique reproduite · ${(m.bank || {}).track || "(à choisir)"}${(m.bank || {}).variation ? " · " + m.bank.variation : ""}`
      : m.mode === "file" ? `Fichier · ${(m.file || {}).file || "(à choisir)"}` : m.mode === "none" ? "Sans musique" : `Musique générée · ${((m.generate || {}).tempo) || 104} bpm`;
    ml.appendChild(md);
