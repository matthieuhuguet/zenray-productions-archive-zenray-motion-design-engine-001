// generated by Scripts/HarvestNoisePost.py. Licence: original (written from the mathematics), same licence as the engine.
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
vec4 flare_ghosts(vec2 uv, vec2 source, float spread, float size, float soft, vec3 color, float intensity, float aspect) {
  const float F[5] = float[5](-0.45, -0.2, 0.3, 0.7, 1.4);
  const float G[5] = float[5](1.6, 0.6, 1.0, 0.4, 2.2);
  vec2 sc = vec2(aspect, 1.0);
  vec2 p = uv * sc, cen = vec2(0.5) * sc, s = source * sc;
  vec3 col = vec3(0.0);
  for (int k = 0; k < 5; k++) {
    vec2 g = cen + (cen - s) * F[k] * spread;
    float r = size * G[k];
    float d = length(p - g);
    float disc = (1.0 - smoothstep(r - soft, r, d)) * (0.4 + 0.6 * min(d / r, 1.0));
    col += mix(color, color.gbr, float(k) / 4.0) * disc;
  }
  return vec4(clamp(intensity * col, 0.0, 1.0), 1.0);
}
