// 26 October 2026: WebKit probe. The macOS app of ZenRay Motion Design is a WKWebView (shell/ZenRayMotionDesign.swift): WebKit, not Chromium. HyperFrames, the storyboards and the browser pane of the agent are Chromium,
// so something can look right everywhere except in the app. This probe loads a page offscreen in a WKWebView, runs an async JavaScript, prints its JSON result and writes a PNG of what WebKit drew.
// FR : sonde WebKit : charge une page hors ecran dans le meme moteur que l'app, execute un script, imprime le resultat et ecrit la capture.
// Usage: swiftc -O Scripts/WebKitProbe.swift -o /tmp/WebKitProbe && /tmp/WebKitProbe <url> <script.js file> <out.png> [width height]
import Cocoa
import WebKit

let args = CommandLine.arguments
guard args.count >= 4 else { print("usage: WebKitProbe <url> <script.js> <out.png> [w h]"); exit(2) }
let url = URL(string: args[1])!, script = (try? String(contentsOfFile: args[2], encoding: .utf8)) ?? "return 'no script'", outPath = args[3]
let W = args.count > 5 ? Double(args[4]) ?? 1280 : 1280, H = args.count > 5 ? Double(args[5]) ?? 860 : 860

final class Probe: NSObject, NSApplicationDelegate, WKNavigationDelegate {
    var web: WKWebView!, window: NSWindow!
    func applicationDidFinishLaunching(_ n: Notification) {
        web = WKWebView(frame: NSRect(x: 0, y: 0, width: W, height: H), configuration: WKWebViewConfiguration())
        web.navigationDelegate = self
        // the macOS app (shell/ZenRayMotionDesign.swift) uses a transparent web view and developer extras: ZR_SHELL=1 reproduces its configuration
        if ProcessInfo.processInfo.environment["ZR_SHELL"] == "1" {
            web.setValue(false, forKey: "drawsBackground")
            web.configuration.preferences.setValue(true, forKey: "developerExtrasEnabled")
            web.configuration.mediaTypesRequiringUserActionForPlayback = []
        }
        window = NSWindow(contentRect: NSRect(x: 0, y: 0, width: W, height: H), styleMask: [.titled], backing: .buffered, defer: false)
        window.contentView = web; window.ignoresMouseEvents = true
        // an invisible (alpha 0) window does not scroll or run IntersectionObserver like a shown one: keep it opaque but park it far off screen
        if ProcessInfo.processInfo.environment["ZR_LIVE"] == "1" {
            // a live capture needs a fully opaque window that WebKit counts as visible: borderless, opaque, and only 3 px of it inside the screen (the rest hangs over the right edge)
            window.styleMask = [.borderless]; window.alphaValue = 1; window.hasShadow = false
            let sf = NSScreen.main!.frame; window.setFrame(NSRect(x: sf.maxX - 3, y: sf.minY + 100, width: W, height: H), display: true)
        } else { window.alphaValue = 0.02 }
        // (the nearly transparent window of the snapshot probe)   // nearly invisible but not occluded: WebKit then scrolls, runs IntersectionObserver and animations like a shown window
        if ProcessInfo.processInfo.environment["ZR_LIVE"] != "1" { window.center() }; window.orderFrontRegardless()
        web.load(URLRequest(url: url))
        DispatchQueue.main.asyncAfter(deadline: .now() + 90) { print("{\"error\":\"timeout\"}"); exit(1) }
    }
    func webView(_ w: WKWebView, didFinish navigation: WKNavigation!) {
        w.callAsyncJavaScript(script, arguments: [:], in: nil, in: .page) { result in
            switch result {
            case .success(let v):
                print(v as? String ?? "\(String(describing: v))")
                if ProcessInfo.processInfo.environment["ZR_LIVE"] == "1" {
                    // what the user's window really shows: the live GPU-composited pixels of the window (screencapture -l), not WKWebView.takeSnapshot, which repaints everything in software
                    DispatchQueue.main.asyncAfter(deadline: .now() + 1.5) {
                        let p = Process(); p.executableURL = URL(fileURLWithPath: "/usr/sbin/screencapture"); p.arguments = ["-x", "-o", "-l\(self.window.windowNumber)", outPath]; try? p.run(); p.waitUntilExit()
                        print("wrote live \(outPath)"); exit(0)
                    }
                    return
                }
                let cfg = WKSnapshotConfiguration()
                w.takeSnapshot(with: cfg) { img, err in
                    if let img = img, let tiff = img.tiffRepresentation, let rep = NSBitmapImageRep(data: tiff), let png = rep.representation(using: .png, properties: [:]) {
                        try? png.write(to: URL(fileURLWithPath: outPath)); print("wrote \(outPath)")
                    } else { print("no snapshot: \(String(describing: err))") }
                    exit(0)
                }
            case .failure(let e): print("{\"error\": \"\(e.localizedDescription)\"}"); exit(1)
            }
        }
    }
}
let app = NSApplication.shared; let d = Probe(); app.delegate = d; app.setActivationPolicy(.accessory); app.run()
