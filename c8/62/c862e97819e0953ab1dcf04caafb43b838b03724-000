"""Smooth the measured motion keys of the Dishonored 2 loot note (26 October 2026), workflow Premier Plan Mesure.
The reference is a 30 fps video whose frames come in pairs, so keys read frame by frame form a STAIRCASE (a speed of 1.7 px per image for four images, then 3.1, then 2.5...): replayed at 60 fps it reads as stutter.
Each channel is fitted by a smoothing spline (error budget per channel: pixels, degrees, scale) and resampled every 1/60 s; opacity stays linear. The raw measured keys live in RAW below (the only place to change a measure),
the dense smooth tables are written into the defaults of the template.  FR : lisse les cles mesurees (le 30 images par seconde en escalier) pour une lecture fluide a 60 images par seconde.
Usage: /Users/zenray/.venvs/zenray-motion/bin/python -I Scripts/NoteSmooth.py [--check]"""
import re
import sys
from pathlib import Path

import numpy as np
from scipy.interpolate import PchipInterpolator, UnivariateSpline

TPL = Path(__file__).resolve().parents[1] / "motion" / "runtime" / "zs-templates-note-1.js"
RAW = {
    "panelKeys": ["4.1 | -400 | -40 | -14 | 0.88 | 1 | 0", "4.18 | -147 | -20 | -10 | 0.93 | 1.02 | 1", "4.267 | -110 | 0 | -4.5 | 0.97 | 1 | 1", "4.333 | -91 | 0 | -1.5 | 0.99 | 1 | 1", "4.4 | -76 | 0 | -0.4 | 1 | 1 | 1", "4.433 | -67 | 0 | -0.2 | 1 | 1 | 1", "4.467 | -59 | 0 | 0 | 1 | 1 | 1", "4.5 | -52 | 0 | 0 | 1 | 1 | 1", "4.567 | -45 | 0 | 0 | 1 | 1 | 1", "4.6 | -39 | 0 | 0 | 1 | 1 | 1", "4.633 | -34 | 0 | 0 | 1 | 1 | 1", "4.667 | -29 | 0 | 0 | 1 | 1 | 1", "4.7 | -24 | 0 | 0 | 1 | 1 | 1", "4.733 | -20 | 0 | 0 | 1 | 1 | 1", "4.8 | -16 | 0 | 0 | 1 | 1 | 1", "4.833 | -12 | 0 | 0 | 1 | 1 | 1", "4.9 | -6 | 0 | 0 | 1 | 1 | 1", "4.967 | 0 | 0 | 0 | 1 | 1 | 1"],
    "titleKeys": ["4.22 | -740 | 0", "4.267 | -740 | 1", "4.333 | -330 | 1", "4.4 | -120 | 1", "4.433 | -24 | 1", "4.467 | -3 | 1", "4.5 | 0 | 1"],
}
SIGMA = {"panelKeys": [1.6, 2.0, 0.35, 0.006, 0.006], "titleKeys": [6.0]}   # error budget per value column: x px, y px, rotation degrees, scale, scale / title x px
STEP = 1 / 60


def rows(lines):
    return np.array([[float(x) for x in l.split("|")] for l in lines])


TAIL_FROM = {"panelKeys": 4.18, "titleKeys": "power"}   # from this instant the channel is a smoothing spline (the deceleration); before it (the entry) a monotone cubic (a spline would ring and overshoot); None: monotone cubic everywhere


def smooth(name):
    R = rows(RAW[name]); t = R[:, 0]; ncol = R.shape[1] - 2   # value columns, then the opacity column
    tt = np.unique(np.concatenate([np.arange(t[0], t[-1] + 1e-9, STEP), t[[0, -1]]])); out = [tt]; t_s = TAIL_FROM[name]
    if t_s == "power":   # a slide that settles: x = x0 (1 - u)^p, u = (t - t0) / T, fitted on the measured rows (monotone, no ringing)
        from scipy.optimize import curve_fit
        m = R[:, -1] > 0.5; t0 = t[m][0]; x0 = R[m, 1][0]; f = lambda tq, T, pw: x0 * np.clip(1 - (tq - t0) / T, 0, 1) ** pw  # noqa: E731
        (T, pw), _ = curve_fit(f, t[m], R[m, 1], p0=[0.25, 2.5], bounds=([0.1, 1.2], [0.6, 5])); print(f"  {name}: slide fitted, T = {T:.3f} s, power = {pw:.2f}")
        return R, np.array([tt, np.where(tt < t0, x0, f(tt, T, pw)), np.interp(tt, t, R[:, -1])]).T
    for k in range(ncol):
        y = R[:, 1 + k]; sig = SIGMA[name][k]
        if np.ptp(y) < 1e-9: out.append(np.full_like(tt, y[0])); continue
        if t_s is None:
            out.append(PchipInterpolator(t, y)(tt)); continue
        m = t >= t_s - 1e-9; spl = UnivariateSpline(t[m], y[m], k=3, s=m.sum() * sig ** 2)
        head_t = np.concatenate([t[~m], [t_s]]); head_y = np.concatenate([y[~m], [float(spl(t_s))]])
        out.append(np.where(tt >= t_s - 1e-9, spl(np.clip(tt, t_s, None)), PchipInterpolator(head_t, head_y)(np.clip(tt, head_t[0], t_s))))
    out.append(np.interp(tt, t, R[:, -1]))
    D = np.array(out).T
    D[0, 1:-1] = R[0, 1:-1]; D[-1, 1:-1] = R[-1, 1:-1]   # the first and last rows are the measured ones
    return R, D


# the paper shards fly in and settle at the traced position at 5.0 s: x = xf + (x0 - xf) (1 - u)^2.5 on u = (t - ta) / (5.0 - ta), the size growing the same way; they were measured as 3 to 5 noisy samples each (the path zigzagged)
SHARDS = [(1, 4.833, 1581, 354, 0.3, 1588.7, 325.6), (2, 4.9, 296.2, 393.2, 0.85, 296.2, 393.2), (3, 4.867, 394, 588, 0.6, 263.3, 609.3), (4, 4.8, 1541, 648, 1.0, 1551.1, 634.2), (5, 4.867, 424, 643, 1.0, 418.9, 657.7)]
END = 5.0


def shard_rows():
    out = []
    for n, ta, x0, y0, s0, xf, yf in SHARDS:
        out.append(f"{ta - STEP:.4f} | {n} | {x0} | {y0} | {s0} | 0 | 0")
        for t in np.arange(ta, END + 1e-9, STEP):
            e = 1 - (1 - min(1, (t - ta) / (END - ta))) ** 2.5
            out.append(f"{t:.4f} | {n} | {x0 + (xf - x0) * e:.2f} | {y0 + (yf - y0) * e:.2f} | {s0 + (1 - s0) * e:.3f} | 0 | {1 if t > ta - 1e-9 else 0}")
        if abs(out[-1].split("|")[0].strip() and float(out[-1].split("|")[0]) - END) > 1e-3: out.append(f"{END} | {n} | {xf} | {yf} | 1 | 0 | 1")
    return out


def fmt(D):
    return [" | ".join(f"{v:.3f}".rstrip("0").rstrip(".") if i else f"{v:.4f}".rstrip("0").rstrip(".") for i, v in enumerate(r)) for r in D]


def main():
    check = "--check" in sys.argv; s = TPL.read_text(encoding="utf-8")
    for name in RAW:
        R, D = smooth(name); v = np.diff(D[:, 1]) / STEP; a = np.diff(v) / STEP
        raw_v = np.diff(np.interp(np.arange(R[0, 0], R[-1, 0], STEP), R[:, 0], R[:, 1]))
        print(f"{name}: {len(R)} measured rows -> {len(D)} smooth rows; speed jumps (max |change of speed| per image) raw {np.abs(np.diff(raw_v)).max():.2f} px, smooth {np.abs(np.diff(np.diff(D[:, 1]))).max():.2f} px")
        if check: continue
        pat = re.compile(r'(P\("' + name + r'", "[^"]*", "lines", )\[[^\]]*\]')
        if not pat.search(s): raise SystemExit(f"{name} not found in the template")
        s = pat.sub(lambda m: m.group(1) + "[" + ", ".join('"' + x + '"' for x in fmt(D)) + "]", s, count=1)
    pat = re.compile(r'(P\("shardKeys", "[^"]*", "lines", )\[[^\]]*\]')
    if not pat.search(s): raise SystemExit("shardKeys not found in the template")
    if not check: s = pat.sub(lambda m: m.group(1) + "[" + ", ".join('"' + x + '"' for x in shard_rows()) + "]", s, count=1)
    if not check: TPL.write_text(s, encoding="utf-8"); print("written")


if __name__ == "__main__":
    main()
