import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def render(params, u, v):
    q = params
    px = (u - q['center'][0]) * q['aspect']
    py = v - q['center'][1]
    d = np.hypot(px, py) - q['radius']
    cov = (1.0 - _ss(-q['soft'], q['soft'], d))[..., None]
    e = np.maximum(d, 0.0) / q['glow_radius']
    glow = (q['intensity'] * max(q['core_level'] - q['threshold'], 0.0) * np.exp(-0.5 * e * e))[..., None]
    return np.clip(_v(q['core_color']) * min(q['core_level'], 1.0) * cov + _v(q['glow_color']) * glow, 0.0, 1.0) * 255.0
