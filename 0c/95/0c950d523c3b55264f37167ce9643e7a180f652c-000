"""Detect crops in the frames of a still-visual project (18 October 2026): for every format and for frames spread over each scene, counts the foreground pixels that touch the border of the frame and compares them with the settled frame
of the same scene. A frame with clearly MORE border ink than the settled one has something cut by the frame (a letter, a banner, a plane scaled out of view). Usage: python3 Scripts/CropCheck.py <project-id> [--scene-len 4.2] [--formats 16x9,9x16,1x1,4x5]
Prints one line per (format, scene, time) that is flagged, and a summary; exit code 1 when something is flagged."""
import argparse, json, subprocess, sys
from pathlib import Path
import numpy as np
from PIL import Image

ROOT = Path(__file__).resolve().parents[1]

def frames(project, times, fmts, out):
    subprocess.run([sys.executable, str(ROOT / "Scripts" / "FormatSheet.py"), project, "--at", ",".join("%.2f" % t for t in times), "--formats", fmts, "--height", "300", "--out", str(out)], capture_output=True, text=True, cwd=ROOT)
    return Image.open(out).convert("RGB")

def main():
    ap = argparse.ArgumentParser(); ap.add_argument("project"); ap.add_argument("--formats", default="16x9,9x16,1x1,4x5"); ap.add_argument("--n", type=int, default=7); a = ap.parse_args()
    p = json.load(open(Path("~/.claude/tmp/tmp-zenray-motion-design/motion-projects").expanduser() / a.project / "project.json")); scenes = p["scenes"]; fmts = a.formats.split(",")
    flagged = 0
    for si, sc in enumerate(scenes):
        t0 = sum(float(x.get("duration", 4.2)) for x in scenes[:si]); d = float(sc.get("duration", 4.2)); times = [t0 + d * k for k in (0.03, 0.08, 0.15, 0.25, 0.4, 0.6, 0.9)][:a.n]
        sheet = frames(a.project, times, a.formats, Path("/tmp/cropcheck_%s_%d.png" % (a.project, si))); arr = np.asarray(sheet).astype(int)
        # layout of FormatSheet: one row per time, columns = formats, each cell has an 18 px label band; find cells by the dark separators: use equal division
        rows = len(times); cols = len(fmts); H = arr.shape[0] // rows
        widths = []; x = 0
        for f in fmts:
            w_, h_ = (int(v) for v in f.split("x")); widths.append(w_ / h_)
        total = sum(widths); xs = [0]
        for w in widths: xs.append(xs[-1] + int(round(arr.shape[1] * w / total)))
        for ci, f in enumerate(fmts):
            vals = []
            for ri in range(rows):
                cell = arr[ri * H + 18:(ri + 1) * H, xs[ci] + 2:xs[ci + 1] - 2]
                if cell.shape[0] < 20 or cell.shape[1] < 20: vals.append(0); continue
                bg = np.median(cell.reshape(-1, 3), axis=0); fg = np.abs(cell - bg).sum(2) > 60
                edge = int(fg[:2].sum() + fg[-2:].sum() + fg[:, :2].sum() + fg[:, -2:].sum()); vals.append(edge)
            settled = vals[-1]
            for ri, v in enumerate(vals[:-1]):
                if v > settled + 12 and v > 1.5 * max(settled, 1):
                    flagged += 1; print("CROP? %s scene %d t=%.2f edge ink %d (settled %d)" % (f, si + 1, times[ri], v, settled))
    print("flagged", flagged); sys.exit(1 if flagged else 0)

if __name__ == "__main__":
    main()
