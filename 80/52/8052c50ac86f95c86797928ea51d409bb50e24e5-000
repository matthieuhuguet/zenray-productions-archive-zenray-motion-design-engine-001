// 12 October 2026: Light streak: Gaussian of the distance to a segment between two points. Colour block for the add blend.
// generated by Scripts/HarvestShapesLight.py, written from the mathematics. uv: pixel centre in [0,1]^2, v downwards.
// Params: color (sRGB 0..1), a (uv), b (uv), width (uv (height units)), intensity (gain), aspect (width / height).
vec4 glow_segment(vec2 uv, vec3 color, vec2 a, vec2 b, float width, float intensity, float aspect) {
  vec2 s = vec2(aspect, 1.0);
  vec2 pa = (uv - a) * s, ba = (b - a) * s;
  float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-8), 0.0, 1.0);
  float d = length(pa - ba * h);
  float g = intensity * exp(-d * d / (2.0 * width * width));
  return vec4(clamp(color * g, 0.0, 1.0), 1.0);
}
