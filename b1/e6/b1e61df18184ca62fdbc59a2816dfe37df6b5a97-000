# 14 October 2026: the final 99.9 calibration of a music version as PARAMETERS, not only as audio. The spectral trim (trim.py) reshapes a stem or a
# mix with time-varying gains per band; until now only the resulting signal was stored, so any parameter change of the version (tempo,
# transposition, a voice macro) dropped the calibration. A calibration is stored as numbers next to params.json (calibration.npz, referenced by
# params.json["calibration"]): for each signal (the four stems and the mix) and each analysis layout, the deviation of OUR raw render from the
# reference band power, per channel (mid and side), band and frame, plus the trim configuration. Replay runs the same trim passes on the targets
# rebuilt from those deviations and the band power of the render it is given: the reference is not needed, and nothing of its samples is stored
# (band powers only: docs/ARCHITECTURE.md section 2). On the render the calibration was made from, replay gives the trimmed signal (tested at
# more than 80 dB SNR); on a variation it applies the SAME correction relative to what the variation has, time-warped with the tempo and, for the
# tonal stems, moved with the transposition. FR : la calibration finale en parametres, rejouable sans la reference.
from __future__ import annotations

import hashlib
import json
from concurrent.futures import ProcessPoolExecutor
from pathlib import Path
from typing import Callable

import numpy as np

from . import trim as T

SCHEMA = "zrmd/music-calibration@1"
FILE_NAME = "calibration.npz"
TONAL_STEMS = ("bass", "other", "vocals")


class CalibrationError(RuntimeError):
    """A calibration that is missing, unreadable or for another schema: the message names the file."""


def to_arrays(sig: str, cal: dict) -> tuple[dict, dict]:
    """(arrays, meta) of one signal's calibration, ready for np.savez."""
    arrays = {}
    for lname, L in cal["layouts"].items():
        arrays[f"{sig}__{lname}__d"] = np.asarray(L["d"], np.float32)
        arrays[f"{sig}__{lname}__rmax"] = np.asarray(L["rmax"], np.float64)
        arrays[f"{sig}__{lname}__omax"] = np.asarray(L["omax"], np.float64)
    meta = {k: cal[k] for k in ("config", "names", "fillSpec", "specs", "nRef", "nSamples", "channels", "finisherKept")}
    meta["layouts"] = sorted(cal["layouts"])
    return arrays, meta


def save(path: Path, signals: dict[str, dict], extra: dict | None = None) -> dict:
    """Write every signal's calibration into ONE compressed npz; returns the block to put in params.json (file, bytes, sha256, signals)."""
    path = Path(path)
    arrays, meta = {}, {"schema": SCHEMA, "signals": {}, **(extra or {})}
    for sig, cal in signals.items():
        a, m = to_arrays(sig, cal)
        arrays.update(a)
        meta["signals"][sig] = m
    np.savez_compressed(path, meta=np.array(json.dumps(meta, default=float)), **arrays)
    h = hashlib.sha256(path.read_bytes()).hexdigest()
    return {"schema": SCHEMA, "file": path.name, "bytes": path.stat().st_size, "sha256": h, "signals": list(signals)}


def load(path: Path) -> dict[str, dict]:
    """The calibration of every signal in the file. A missing or foreign file raises CalibrationError that names it."""
    path = Path(path)
    if not path.is_file():
        raise CalibrationError(f"calibration file not found: {path}")
    try:
        z = np.load(path, allow_pickle=False)
        meta = json.loads(str(z["meta"]))
    except Exception as e:  # noqa: BLE001
        raise CalibrationError(f"calibration file unreadable: {path} ({e})") from e
    if meta.get("schema") != SCHEMA:
        raise CalibrationError(f"calibration file {path} has schema {meta.get('schema')!r}, expected {SCHEMA!r}")
    return {sig: from_arrays(sig, z, m) for sig, m in meta["signals"].items()}


def from_arrays(sig: str, z, m: dict) -> dict:
    """The calibration of one signal from its arrays (an npz or a dict) and its meta block."""
    layouts = {n: {"d": z[f"{sig}__{n}__d"], "rmax": z[f"{sig}__{n}__rmax"], "omax": z[f"{sig}__{n}__omax"]} for n in m["layouts"]}
    return {**{k: m[k] for k in ("config", "names", "fillSpec", "specs", "nRef", "nSamples", "channels", "finisherKept")}, "layouts": layouts}


def locate(prm: dict, version_dir: Path) -> Path:
    """Where the calibration file of a version lives: its own folder, else the folder of the version that holds it (params.json
    ["calibration"]["version"]) in the same bench."""
    blk = prm.get("calibration")
    if not blk:
        raise CalibrationError(f"{version_dir}: params.json has no calibration block")
    own = Path(version_dir) / blk["file"]
    if own.is_file():
        return own
    return Path(version_dir).parent / blk.get("version", "") / blk["file"]


def _replay_job(args):
    sig, ours, cal, sr, warp = args
    y, info = T.replay(ours, cal, sr, warp)
    return sig, y, info


def stem_warp(sig: str, time_ratio: float, semitones: float, t0: float = 0.0) -> dict:
    """The warp of one signal: time follows the tempo for everything, pitch follows the transposition for the tonal stems only (the drums do not
    transpose, and the mix is a sum of both: its calibration stays at the original frequencies, which is reported as a limit)."""
    return {"timeRatio": time_ratio, "semitones": semitones if sig in TONAL_STEMS else 0.0, "t0": t0}


def apply(prm: dict, version_dir: Path, raw_stems: dict[str, np.ndarray], make_mix: Callable[[dict], np.ndarray], sr: int,
          time_ratio: float = 1.0, semitones: float = 0.0, workers: int = 4, t0: float = 0.0) -> dict:
    """Replay the stored calibration of a version on a render of its params: the four stems side by side, then the mix built from the calibrated
    stems by `make_mix` (the version's own bus) and calibrated in turn. Reference not needed. Returns {"stems", "mix", "info"}."""
    cal = load(locate(prm, version_dir))
    missing = [s for s in (*raw_stems, "mix") if s not in cal]
    if missing:
        raise CalibrationError(f"calibration {locate(prm, version_dir)} has no signal {missing}")
    jobs = [(s, raw_stems[s], cal[s], sr, stem_warp(s, time_ratio, semitones, t0)) for s in raw_stems]
    with ProcessPoolExecutor(max_workers=min(workers, len(jobs))) as ex:
        res = list(ex.map(_replay_job, jobs))
    stems = {s: y for s, y, _ in res}
    info = {s: i for s, _, i in res}
    mix_raw = make_mix(stems)
    _, mix, mi = _replay_job(("mix", mix_raw, cal["mix"], sr, {"timeRatio": time_ratio, "semitones": 0.0, "t0": t0}))
    info["mix"] = mi
    return {"stems": stems, "mix": mix, "info": info, "mixRaw": mix_raw}
