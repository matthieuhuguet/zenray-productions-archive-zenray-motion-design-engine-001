"""Where do two masks of the Zhong Kui visual disagree? (17 October 2026) Prints the largest regions that are in the reference only or in the motion only, farther than 3 px from the other (the DIoU rule of MaskIoU.py).
Run after `python3 Scripts/MaskIoU.py bmw-zhong-kui-ppm --at 3.9 --out /tmp/zkm` (it leaves /tmp/zkm/ink-motion-frame.png). Usage: python3 Scripts/ZhongKuiDiff.py cal|red MIN_PIXELS   (cal = grey calligraphy mask, red = red title mask).
"""
import numpy as np, sys
from PIL import Image, ImageFilter
from scipy import ndimage as ndi
which=sys.argv[1]
ref=Image.open("/Users/zenray/.claude/tmp/tmp-zenray-motion-design-refcache/_stills/still-zhong-kui.png").convert("RGB")
W,H=1920,1080; k=1.2
r2=ref.resize((round(ref.width*k),round(ref.height*k)),Image.LANCZOS); rf=Image.new("RGB",(W,H),(0,0,0)); rf.paste(r2,((W-r2.width)//2,(H-r2.height)//2))
mine=Image.open("/tmp/zkm/ink-motion-frame.png").convert("RGB")
def mk(img):
    a=np.asarray(img).astype(int); h,w=a.shape[:2]; m=np.zeros((h,w),bool)
    if which=="cal":
        x0,y0,x1,y1=int(0.18*w),int(0.12*h),int(0.78*w),int(0.9*h); r=a[y0:y1,x0:x1]; lum=r.mean(2); m[y0:y1,x0:x1]=(r.max(2)-r.min(2)<24)&(lum>20)&(lum<90)
    else:
        x0,y0,x1,y1=int(0.29*w),int(0.33*h),int(0.71*w),int(0.74*h); r=a[y0:y1,x0:x1]; m[y0:y1,x0:x1]=((r[...,0]-np.maximum(r[...,1],r[...,2]))>45)&(r[...,0]>110)
    return m
A,B=mk(rf),mk(mine)
def dil(m,px=3): return np.asarray(Image.fromarray((m*255).astype(np.uint8)).filter(ImageFilter.MaxFilter(2*px+1)))>0
for nm,m in (("ref-only",A&~dil(B)),("motion-only",B&~dil(A))):
    lab,n=ndi.label(ndi.binary_dilation(m,iterations=3)); out=[]
    for i in range(1,n+1):
        ys,xs=np.nonzero((lab==i)&m)
        if len(xs)>=int(sys.argv[2]): out.append((len(xs),int(xs.mean()),int(ys.mean())))
    print(nm,int(m.sum()),sorted(out,reverse=True)[:8])
