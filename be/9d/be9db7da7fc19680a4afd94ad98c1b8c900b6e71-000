// Source: https://jcgt.org/published/0009/03/02/
// uv: pixel centre in [0,1]^2, v from top to bottom. Parameters in block.json order.
uvec2 bloom_spots_pcg2d(uvec2 v) {
  v = v * 1664525u + 1013904223u;
  v.x += v.y * 1664525u;
  v.y += v.x * 1664525u;
  v = v ^ (v >> 16u);
  v.x += v.y * 1664525u;
  v.y += v.x * 1664525u;
  v = v ^ (v >> 16u);
  return v;
}
// 12 October 2026: two uniform values in [0, 1) per integer cell, exact 24-bit conversion (identical in numpy).
vec2 bloom_spots_hash2(vec2 cell, float seed) {
  uint s = uint(max(seed, 0.0));
  uvec2 c = uvec2(ivec2(cell) + 32768) + uvec2(s * 747796405u, s * 2891336453u);
  uvec2 h = bloom_spots_pcg2d(c);
  return vec2(h >> 8u) * (1.0 / 16777216.0);
}
vec4 bloom_spots(vec2 uv, float scale, float seed, float peak, float threshold, float core_radius, float glow_sigma, float intensity, vec3 core_color, vec3 glow_color, float aspect) {
  vec2 p = vec2(uv.x * aspect, uv.y) * scale;
  vec2 i = floor(p);
  vec3 col = vec3(0.0);
  for (int y = -1; y <= 1; y++) {
    for (int x = -1; x <= 1; x++) {
      vec2 c = i + vec2(float(x), float(y));
      vec2 o = c + 0.5 + 0.6 * (bloom_spots_hash2(c, seed) - 0.5);
      float b = peak * bloom_spots_hash2(c, seed + 1.0).x;
      float d = length(p - o);
      float core = 1.0 - smoothstep(0.6 * core_radius, core_radius, d);
      float glow = intensity * max(b - threshold, 0.0) * exp(-0.5 * d * d / (glow_sigma * glow_sigma));
      col += core_color * min(b, 1.0) * core + glow_color * glow;
    }
  }
  return vec4(clamp(col, 0.0, 1.0), 1.0);
}
