    fj = np.clip(v, 0.0, 1.0) * (NV - 1)
    i0 = np.minimum(np.floor(fi).astype(int), ND - 2); j0 = np.minimum(np.floor(fj).astype(int), NV - 2)
    a = _ss(fi - i0); b = _ss(fj - j0)
    W = np.zeros(fi.shape + (ND * NV,))
    for di, wa in ((0, 1 - a), (1, a)):
        for dj, wb in ((0, 1 - b), (1, b)):
            idx = (j0 + dj) * ND + (i0 + di)
            np.put_along_axis(W, idx[..., None], np.take_along_axis(W, idx[..., None], -1) + (wa * wb)[..., None], -1)
    return W


def render(params, u, v):
    C = np.array([params[n] for n in NAMES], float)
    return basis(params, u, v) @ C * 255.0
