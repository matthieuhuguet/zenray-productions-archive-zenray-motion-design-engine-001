# 14 October 2026: decode cache of the rhythm module. Every reference is decoded ONCE, frame-exact (no frame duplicated or
# dropped: passthrough timestamps), at two small sizes that every detector shares, and its codec packets are read once
# (size and key-frame flag per picture, the codec's own opinion of "this picture cannot be predicted").
# Cached files live beside the reference in the private reference cache (never archived, never published): they are
# derived from the reference pixels, so they stay where the reference stays.
# FR : cache de decodage du module rythme : une seule lecture exacte par reference, partagee par tous les detecteurs.
from __future__ import annotations

import json
import os
import subprocess
from pathlib import Path

import numpy as np

COARSE = (160, 90)   # exhaustive pass: every boundary of every reference
FINE = (480, 270)    # verification window around a candidate only (never the whole film)


def cache_dir(refcache: Path, slug: str) -> Path:
    return Path(refcache) / slug / "rhythm"


def _decode(video: str, width: int, height: int, threads: int = 2) -> np.ndarray:
    cmd = ["ffmpeg", "-v", "error", "-threads", str(threads), "-i", str(video), "-map", "0:v:0",
           "-vf", f"scale={width}:{height}:flags=area,format=rgb24", "-fps_mode", "passthrough",
           "-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
    raw = subprocess.run(cmd, capture_output=True, check=True).stdout
    size = width * height * 3
    n = len(raw) // size
    if n == 0:
        raise RuntimeError(f"no frame decoded from {video}")
    return np.frombuffer(raw[: n * size], dtype=np.uint8).reshape((n, height, width, 3))


def packets(video: str) -> dict:
    """Per picture (display order): compressed size in bytes and key-frame flag, from the container packets alone."""
    out = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                          "packet=pts_time,dts_time,size,flags", "-of", "csv=p=0", str(video)],
                         capture_output=True, text=True, check=True).stdout
    rows = []
    for line in out.splitlines():
        parts = line.strip().strip(",").split(",")
        if len(parts) < 4:
            continue
        pts = parts[0] if parts[0] not in ("", "N/A") else parts[1]
        try:
            rows.append((float(pts), int(parts[2]), 1 if "K" in parts[3] else 0))
        except ValueError:
            continue
    rows.sort(key=lambda r: r[0])
    return {"pts": np.array([r[0] for r in rows]), "size": np.array([r[1] for r in rows], dtype=np.int64),
            "key": np.array([r[2] for r in rows], dtype=np.int8)}


def stream_facts(video: str) -> dict:
    out = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                          "stream=width,height,r_frame_rate,avg_frame_rate,nb_frames,duration", "-of", "json", str(video)],
                         capture_output=True, text=True, check=True).stdout
    s = json.loads(out)["streams"][0]

    def rate(text):
        a, _, b = str(text or "0/1").partition("/")
        return float(a) / float(b or 1) if float(b or 1) else 0.0
    return {"width": s["width"], "height": s["height"], "r_fps": rate(s.get("r_frame_rate")), "avg_fps": rate(s.get("avg_frame_rate")),
            "nb_frames": int(s["nb_frames"]) if str(s.get("nb_frames", "")).isdigit() else None,
            "duration": float(s["duration"]) if s.get("duration") not in (None, "N/A") else None}


def build(video: str, folder: Path, force: bool = False, threads: int = 2) -> dict:
    """Decode once, write frames-160x90.npy, packets.npz and cache.json; return the metadata."""
    folder = Path(folder)
    folder.mkdir(parents=True, exist_ok=True)
    meta_path = folder / "cache.json"
    if meta_path.exists() and not force and (folder / "frames-160x90.npy").exists():
        return json.loads(meta_path.read_text(encoding="utf-8"))
    facts = stream_facts(video)
    frames = _decode(video, *COARSE, threads=threads)
    n = len(frames)
    pk = packets(video)
    fps = facts["avg_fps"] or facts["r_fps"] or 30.0
    # Display-order packet sizes line up with decoded frames one to one on these files; a mismatch is recorded, never hidden.
    sizes = pk["size"]
    aligned = len(sizes) == n
    np.save(folder / "frames-160x90.npy", frames)
    np.savez_compressed(folder / "packets.npz", size=sizes, key=pk["key"], pts=pk["pts"])
    meta = {"schema": "zrmd/rhythm-cache@1", "video": str(video), "bytes": os.path.getsize(video), "frames": n, "fps": fps, "r_fps": facts["r_fps"],
            "avg_fps": facts["avg_fps"], "nb_frames_container": facts["nb_frames"], "size": [facts["width"], facts["height"]],
            "coarse": list(COARSE), "packets": len(sizes), "packets_aligned": aligned,
            "duration": n / fps if fps else None}
    meta_path.write_text(json.dumps(meta, indent=1) + "\n", encoding="utf-8")
    return meta


def load(folder: Path) -> dict:
    folder = Path(folder)
    meta = json.loads((folder / "cache.json").read_text(encoding="utf-8"))
    frames = np.load(folder / "frames-160x90.npy", mmap_mode="r")
    pk = np.load(folder / "packets.npz")
    return {"meta": meta, "frames": frames, "size": pk["size"], "key": pk["key"], "pts": pk["pts"]}


def fine_window(video: str, start_frame: int, count: int, pts: np.ndarray, width: int = FINE[0], height: int = FINE[1]) -> np.ndarray:
    """`count` frames from frame index `start_frame`, decoded at the fine size. Frame-exact: the seek lands 0.4 frame before
    the packet time of the wanted picture, so the first picture ffmpeg outputs is that picture and no other."""
    fps_step = float(np.median(np.diff(pts[: min(len(pts), 200)]))) if len(pts) > 2 else 1 / 30
    t0 = max(0.0, float(pts[start_frame]) - 0.4 * fps_step)
    cmd = ["ffmpeg", "-v", "error", "-threads", "2", "-ss", f"{t0:.6f}", "-i", str(video), "-map", "0:v:0",
           "-vf", f"scale={width}:{height}:flags=area,format=rgb24", "-fps_mode", "passthrough",
           "-frames:v", str(count), "-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
    raw = subprocess.run(cmd, capture_output=True, check=True).stdout
    size = width * height * 3
    n = len(raw) // size
    return np.frombuffer(raw[: n * size], dtype=np.uint8).reshape((n, height, width, 3))
