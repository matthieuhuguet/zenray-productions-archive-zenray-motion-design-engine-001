"""Helper of the Premier Plan Mesuré workflow (ppm), 16 October 2026: builds and writes the project of one reproduction.

A reproduction script lists its scenes (BEATS: start, template, params) and its promoted controls, then calls `run(...)`. The project gets the workflow tag `ppm`,
the identifier `<slug>-ppm`, and keeps the verdict of Matthieu when it is rebuilt. FR : assistant du workflow Premier Plan Mesure : ecrit le projet d'une reproduction.
"""
import json
import sys
from pathlib import Path

MOTION = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(MOTION))
import server  # noqa: E402

WORKFLOW = {"id": "ppm", "name": "Premier Plan Mesuré"}


def T(scene: str, key: str) -> dict:
    return {"scene": scene, "key": key}


def build(title: str, slug: str, beats: list, end: float, controls: list, fmt: str = "16x9", bg: str = "#000000", ink: str = "#f4f4f4", accent: str = "#4f8ff7", doc: str = "") -> dict:
    scenes = []
    for i, (t, tpl, params) in enumerate(beats):
        nxt = beats[i + 1][0] if i + 1 < len(beats) else end
        scenes.append({"id": f"b{i + 1:02d}", "template": tpl, "duration": round(nxt - t, 4), "params": dict(params, film0=t), "ref": {"start": t}})
    return {"schema": "zrmd/motion-project@1", "workflow": WORKFLOW, "title": title, "format": fmt, "fps": 30, "reference": slug,
            "doc": doc or f"16 October 2026: {title}, premier plan seul (workflow Premier Plan Mesuré).",
            "theme": {"bg": bg, "ink": ink, "accent": accent, "fontTitle": "InterVariable", "fontBody": "InterVariable"},
            "music": {"mode": "none"}, "sfx": {"enabled": False}, "controls": controls, "scenes": scenes}


def run(pid: str, project: dict) -> dict:
    f = server.project_dir(pid) / "project.json"
    if f.is_file():
        server.save_version(pid, "avant une nouvelle passe de reproduction")
        v = json.loads(f.read_text(encoding="utf-8")).get("validation")
        if v:
            project["validation"] = v
    server.write_project(pid, project)
    out = {"id": pid, "scenes": len(project["scenes"]), "duration": round(sum(s["duration"] for s in project["scenes"]), 2)}
    print(json.dumps(out))
    return out


def split_beats(template: str, items: list, end: float, base: "dict | None" = None, cut: float = 100.0, key: str = "items") -> list:
    """A scene is at most 120 s: a long film made of timed items is cut in scenes of `cut` seconds, each item re-timed inside its scene (an item that crosses a cut is kept in both).
    FR : une scene dure 120 s au plus ; un long film d'elements chronometres est coupe en scenes, chaque element recale."""
    beats, lo = [], 0.0
    while lo < end - 0.01:
        hi = min(end, lo + cut)
        part = []
        for line in items:
            f = [q.strip() for q in line.split("|")]
            a, b = float(f[0]), float(f[1])
            if b <= lo or a >= hi:
                continue
            f[0], f[1] = f"{max(a, lo) - lo:.2f}", f"{min(b, hi) - lo:.2f}"
            part.append(" | ".join(f))
        params = dict(base or {}); params[key] = part
        if lo:
            params["film0"] = lo
        beats.append((lo, template, params))
        lo = hi
    return beats
