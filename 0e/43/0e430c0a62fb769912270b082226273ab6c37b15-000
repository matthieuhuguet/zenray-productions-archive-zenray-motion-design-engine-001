def layout_controls(layout: str) -> list:
    """The texts, the design handles of every holder of glyphs and the sliders of a layout, written by the template itself (ZS.stills.controls): what the code reads is what the editor offers."""
    import json
    import subprocess
    from pathlib import Path
    rt = Path(__file__).resolve().parents[1] / "runtime"
    req = "".join("require(%r);" % str(f) for f in sorted(rt.glob("zs-templates-card-*-1.js")))
    code = "global.window={ZS:{h:{},register(){}}};global.document={};require(%r);%sconsole.log(JSON.stringify(window.ZS.stills.controls(%r)))" % (str(rt / "zs-templates-stills-1.js"), req, layout)
    return json.loads(subprocess.check_output(["node", "-e", code], text=True))


