def template_defaults() -> dict:
    """The texts and colours the layouts start with, read from the template itself (ZS.stills.DEFAULTS), so a scene always carries real values the editor can show and change."""
    import json
    import subprocess
    from pathlib import Path
    js = Path(__file__).resolve().parents[1] / "runtime" / "zs-templates-stills-1.js"
    code = "global.window={ZS:{h:{},register(){}}};global.document={};require(%r);console.log(JSON.stringify(window.ZS.stills.DEFAULTS))" % str(js)
    return json.loads(subprocess.check_output(["node", "-e", code], text=True))
