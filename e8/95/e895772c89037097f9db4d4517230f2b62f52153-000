        if kind and f.is_file():
            out.append({"name": f.name, "kind": kind, "bytes": f.stat().st_size, "url": f"/motion/files/{pid}/{f.name}"})
    return out


# ---------------------------------------------------------------------------------------------------- fonts
def _font_files(spec: dict) -> list:
    return spec.get("files") or [[spec["file"], spec.get("weights", "400")]]


def fonts_css(prefix: str = "/motion/fonts/") -> str:
    rules = []
    for fam, spec in CFG["fonts"].items():
        for i, (path, weight) in enumerate(_font_files(spec)):
            rules.append(f"@font-face {{ font-family: '{fam}'; src: url('{prefix}{fam}-{i}{Path(path).suffix}'); font-weight: {weight}; font-display: block; }}")
    return "\n".join(rules)


def font_file(name: str) -> Path:
    m = re.fullmatch(r"([A-Za-z]+)-(\d+)(\.\w+)", name or "")
    if not m or m.group(1) not in CFG["fonts"]:
        raise Refusal("no such font", 404)
    files = _font_files(CFG["fonts"][m.group(1)])
    i = int(m.group(2))
    if i >= len(files):
        raise Refusal("no such font", 404)
    path = Path(os.path.expanduser(files[i][0]))
    return path if path.is_absolute() else REPO / path


