class Refusal(Exception):
    def __init__(self, msg: str, status: int = 400):
        super().__init__(msg)
        self.status = status


def J(data, status=200) -> dict:
    return {"json": data, "status": status}


def F(path: Path, mime: str | None = None) -> dict:
    if not Path(path).is_file():
        raise Refusal("not found", 404)
    return {"file": Path(path), "mime": mime or mimetypes.guess_type(Path(path).name)[0] or "application/octet-stream"}


def B(body: bytes, mime: str) -> dict:
    return {"bytes": body, "mime": mime}


# ---------------------------------------------------------------------------------------------------- projects
def projects_root() -> Path:
    p = Path(os.environ.get("ZRMD_MOTION_PROJECTS") or os.path.expanduser(CFG["paths"]["projects"]))
    p.mkdir(parents=True, exist_ok=True)
    return p


def project_dir(pid: str) -> Path:
    if not ID_RE.match(pid or ""):
        raise Refusal("bad project id")
    return projects_root() / pid


def read_project(pid: str) -> dict:
    f = project_dir(pid) / "project.json"
    if not f.is_file():
        raise Refusal(f"no motion project {pid}", 404)
    p = json.loads(f.read_text(encoding="utf-8"))
    if p.get("schema") in OLD_SCHEMAS:
        p["schema"] = SCHEMA
    return p


def validate(p: dict) -> dict:
    """The shape the runtime needs; the values themselves are bounded by the templates (an unknown value never breaks the page)."""
    if not isinstance(p, dict) or p.get("schema") not in {SCHEMA, *OLD_SCHEMAS}:
        raise Refusal(f"project must have schema {SCHEMA}")
    if p.get("format") not in FORMATS:
        raise Refusal("format must be 16x9, 9x16, 1x1 or 4x5")
    scenes = p.get("scenes")
    if not isinstance(scenes, list) or not scenes or len(scenes) > 400:
        raise Refusal("a project has 1 to 400 scenes")
    for s in scenes:
        if not isinstance(s, dict) or not isinstance(s.get("template"), str) or not isinstance(s.get("params", {}), dict):
            raise Refusal("every scene needs a template name and a params object")
        d = s.get("duration")
        if not isinstance(d, (int, float)) or not (0.02 <= d <= 120):
            raise Refusal(f"scene {s.get('id')}: duration between 0.02 and 120 s")
    if sum(s["duration"] for s in scenes) > 900:
        raise Refusal("a project lasts at most 15 minutes")
    return p


def write_project(pid: str, p: dict) -> dict:
    validate(p)
    d = project_dir(pid)
    d.mkdir(parents=True, exist_ok=True)
    p = {**p, "schema": SCHEMA, "id": pid, "updated": time.strftime("%d %B %Y, %H:%M")}
    tmp = d / "project.json.tmp"
    tmp.write_text(json.dumps(p, indent=1, ensure_ascii=False), encoding="utf-8")
    tmp.replace(d / "project.json")
    return p


def list_projects() -> list[dict]:
