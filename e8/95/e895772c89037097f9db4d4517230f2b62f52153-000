def save_version(pid: str, note: str) -> dict:
    p = read_project(pid)
    d = project_dir(pid) / "versions"
    d.mkdir(parents=True, exist_ok=True)
    n = 1 + max([int(f.stem[2:]) for f in d.glob("V_*.json")] + [0])
    v = f"V_{n:03d}"
    p = {**p, "versionNote": (note or "")[:200], "versionSaved": time.strftime("%d %B %Y, %H:%M"), "version": v}
    (d / f"{v}.json").write_text(json.dumps(p, indent=1, ensure_ascii=False), encoding="utf-8")
    return {"version": v, "note": p["versionNote"], "saved": p["versionSaved"]}


def restore_version(pid: str, v: str) -> dict:
    if not VER_RE.match(v or ""):
        raise Refusal("bad version")
    f = project_dir(pid) / "versions" / f"{v}.json"
    if not f.is_file():
        raise Refusal(f"no version {v}", 404)
    save_version(pid, f"avant le retour à {v}")          # the current state is kept: a restore never loses work
    p = json.loads(f.read_text(encoding="utf-8"))
    for k in ("versionNote", "versionSaved", "version"):
        p.pop(k, None)
    return write_project(pid, p)


