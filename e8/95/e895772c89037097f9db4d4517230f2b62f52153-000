def runtime_scripts() -> list[str]:
    """The runtime files in load order (16 October 2026): the core, the post-process, the base templates, then EVERY other zs-templates-*.js by name
    (one file per reproduced motion: zs-templates-agentplay-1.js, -2.js ...), so a new motion needs no list to edit."""
    extra = sorted(f.name for f in (MOTION / "runtime").glob("zs-templates-*.js") if f.name not in _BASE_TEMPLATES)
    return ["zs-core.js", "zs-post.js", *[s for s in _BASE_TEMPLATES if (MOTION / "runtime" / s).is_file()], *extra]


RUNTIME_SCRIPTS = runtime_scripts()


def code_version() -> str:
    """15 October 2026: a fingerprint of the page code (runtime and web files: name, size, time). An open page compares it to the one it
    loaded with and reloads itself when it changed, so a new template is never "unknown" in a window opened before the change."""
    h = hashlib.sha1()
    for d in ("runtime", "web"):
        for f in sorted((MOTION / d).glob("*")):
            if f.is_file():
                st = f.stat(); h.update(f"{f.name}:{st.st_size}:{st.st_mtime_ns};".encode())
    return h.hexdigest()[:12]


def cook(pid: str, out: Path) -> Path:
    """The HyperFrames project of a motion project: the runtime files, the fonts, the media and one index.html."""
    p = read_project(pid)
    w, h = FORMATS[p["format"]]
    if out.exists():
        shutil.rmtree(out)
    (out / "fonts").mkdir(parents=True)
    scripts = [s for s in runtime_scripts() if (MOTION / "runtime" / s).is_file()]
    for name in [*scripts, "zs-runtime.css", "gsap.min.js"]:
        shutil.copy(MOTION / "runtime" / name, out / name)
    for fam, spec in CFG["fonts"].items():
        for i, (path, _w) in enumerate(_font_files(spec)):
            src = font_file(f"{fam}-{i}{Path(path).suffix}")
            if src.is_file():
                shutil.copy(src, out / "fonts" / f"{fam}-{i}{Path(path).suffix}")
    if (project_dir(pid) / "assets").is_dir():
        shutil.copytree(project_dir(pid) / "assets", out / "assets")
    # an excerpt of a reference video used by a scene (ref:<slug>) is copied too: the input stays a file, the motion stays code
    refs = {s.get("params", {}).get("media", "") for s in p["scenes"]}
    ref_urls = {}
    for r in [x for x in refs if isinstance(x, str) and x.startswith("ref:")]:
        src = _bank().reference_video(r[4:])
        if src:
            (out / "assets").mkdir(exist_ok=True)
            shutil.copy(src, out / "assets" / f"ref-{r[4:]}{src.suffix}")
            ref_urls[r[4:]] = f"assets/ref-{r[4:]}{src.suffix}"
    (out / "hyperframes.json").write_text(json.dumps({"$schema": "https://hyperframes.heygen.com/schema/hyperframes.json", "paths": {"assets": "assets"}}, indent=2),
                                          encoding="utf-8")
    dur = sum(float(s["duration"]) for s in p["scenes"])
    page = EXPORT_PAGE.format(w=w, h=h, dur=f"{dur:.6f}", fps=int(p.get("fps") or CFG["export"]["fps"]), fonts=fonts_css("fonts/"),
                              scripts="".join(f'<script src="{s}"></script>' for s in scripts),
                              project=json.dumps(p, ensure_ascii=False).replace("</", "<\\/"), refs=json.dumps(ref_urls))
    (out / "index.html").write_text(page, encoding="utf-8")
    return out


def hyperframes(project: Path, *args: str, timeout: int) -> subprocess.CompletedProcess:
    return subprocess.run(["node", str(MOTION / "bin" / "RunHyperframes.mjs"), *args], cwd=str(project), capture_output=True, text=True, timeout=timeout)


def run_export(job: dict, pid: str, wav: bytes, draft: bool):
    ex = CFG["export"]
    try:
        stamp = time.strftime("%Y%m%d-%H%M%S")
        base = project_dir(pid) / "exports" / stamp
        base.mkdir(parents=True, exist_ok=True)
        job.update(state="cook", step="préparation de la page")
        hf = cook(pid, base / "page")
        (base / "mix.wav").write_bytes(wav)
        job.update(state="render", step="rendu des images (HyperFrames)")
        t0 = time.time()
        silent = base / "video.mp4"
        r = hyperframes(hf, "render", "-f", str(ex["fps"]), "-q", ex["draftQuality"] if draft else ex["quality"], "-w", str(ex["workers"]), "-o", str(silent),
                        timeout=int(ex["timeoutS"]))
        if r.returncode != 0 or not silent.exists():
            raise RuntimeError(f"HyperFrames: {(r.stderr or r.stdout)[-800:]}")
        job["renderSeconds"] = round(time.time() - t0, 1)
        job.update(state="mux", step="assemblage image et son")
        final = base / f"{pid}-{stamp}.mp4"
        m = subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(silent), "-i", str(base / "mix.wav"), "-map", "0:v:0", "-map", "1:a:0", "-c:v", "copy",
                            "-af", f"loudnorm=I={ex['loudnessLufs']}:TP={ex['truePeakDb']}:LRA=11", "-ar", "48000",
                            "-c:a", "aac", "-b:a", ex["audioBitrate"], "-shortest", "-movflags", "+faststart", str(final)], capture_output=True, text=True)
        if m.returncode != 0 or not final.exists():
            raise RuntimeError(f"ffmpeg: {m.stderr[-600:]}")
        shutil.rmtree(base / "page", ignore_errors=True)
        silent.unlink(missing_ok=True)
        job.update(state="done", step="terminé", file=str(final), url=f"/motion/exports/{pid}/{stamp}/{final.name}", bytes=final.stat().st_size,
                   seconds=round(time.time() - job["started"], 1))
    except Exception as e:  # noqa: BLE001  a failed export says why, never silently
        job.update(state="error", step="échec", error=f"{type(e).__name__}: {e}")


def start_export(pid: str, wav: bytes, draft: bool) -> dict:
    read_project(pid)
    if not wav.startswith(b"RIFF"):
        raise Refusal("the export needs the mix as a WAV body")
    with LOCK:
        if any(j["state"] in ("cook", "render", "mux") for j in JOBS.values()):
            raise Refusal("an export is already running: one at a time", 409)
        jid = uuid.uuid4().hex[:12]
        JOBS[jid] = {"id": jid, "project": pid, "state": "cook", "step": "", "started": time.time(), "draft": draft}
    threading.Thread(target=run_export, args=(JOBS[jid], pid, wav, draft), daemon=True).start()
    return JOBS[jid]


# ---------------------------------------------------------------------------------------------------- routing
def handle(method: str, path: str, q: dict, read, length: int) -> dict:
    """One request of the motion module: paths under /motion (page, runtime, fonts, media, exports, banks) and /api/motion (projects, versions,
    media upload, export, banks). Returns {"json"|"file"|"bytes"}. Raises Refusal with its status."""
    p = path
    if method == "GET":
        if p in ("/motion", "/motion/"):
            return F(MOTION / "web" / "index.html", "text/html; charset=utf-8")
        if p == "/motion/runtime/templates.js":
            # every template file in load order, as one script: the pages need no list of files to edit when a motion adds its own
            return B(b"\n".join((MOTION / "runtime" / f).read_bytes() for f in runtime_scripts() if f not in ("zs-core.js", "zs-post.js")), "text/javascript; charset=utf-8")
        m = re.fullmatch(r"/motion/(web|runtime)/([A-Za-z0-9._-]+)", p)
        if m:
            return F(MOTION / m.group(1) / m.group(2))
        if p == "/motion/fonts.css":
            return B(fonts_css().encode(), "text/css; charset=utf-8")
        if p.startswith("/motion/fonts/"):
            return F(font_file(p[len("/motion/fonts/"):]))
        m = re.fullmatch(r"/motion/files/([a-z0-9-]+)/(.+)", p)
        if m:
            return F(asset_path(m.group(1), m.group(2)))
        m = re.fullmatch(r"/motion/exports/([a-z0-9-]+)/(\d{8}-\d{6})/([A-Za-z0-9._-]+\.mp4)", p)
        if m:
            return F(project_dir(m.group(1)) / "exports" / m.group(2) / m.group(3), "video/mp4")
        # gallery pictures (15 October 2026): a frame of a reference video or of an imported video, the waveform of a reproduced music
        m = re.fullmatch(r"/motion/gallery/ref/([A-Za-z0-9._-]+)\.jpg", p)
        if m:
            return F(_bank().reference_thumb(m.group(1)), "image/jpeg")
        m = re.fullmatch(r"/motion/gallery/file/([a-z0-9-]+)/(.+)\.jpg", p)
        if m:
            return F(_bank().video_thumb(asset_path(m.group(1), m.group(2)), f"{m.group(1)}-{m.group(2)}"), "image/jpeg")
        m = re.fullmatch(r"/motion/gallery/wave/([A-Za-z0-9._-]+)\.png", p)
        if m:
            return F(_bank().waveform(m.group(1)), "image/png")
        m = re.fullmatch(r"/motion/bank/preview/([A-Za-z0-9._-]+)/(drums|bass|other|vocals|mix)\.m4a", p)
        if m:
            return F(_bank().preview_file(m.group(1), m.group(2)), "audio/mp4")
        m = re.fullmatch(r"/motion/bank/stored/([A-Za-z0-9._-]+\.mp3)", p)
        if m:
            return F(_bank().BANK / "corpus-music" / m.group(1), "audio/mpeg")
        m = re.fullmatch(r"/motion/bank/(music|sfx|synth|ref)/(.+)", p)
        if m:
            # ?from=&to= (seconds) returns only that excerpt of a music stem: a 30 s film never decodes a 3 min track in the browser
            if m.group(1) == "music" and ("from" in q or "to" in q):
                return B(_bank().excerpt(_bank().bank_file("music", m.group(2)), float(q.get("from", 0)), float(q.get("to", 0) or 0)), "audio/wav")
            return F(_bank().bank_file(m.group(1), m.group(2)))
        if p == "/api/motion/status":
            return J({"ok": True, "module": "motion", "release": CFG["release"], "projects": len(list_projects()), "code": code_version(),
                      "busy": any(j["state"] in ("cook", "render", "mux") for j in JOBS.values())})
        if p == "/api/motion/projects":
            return J({"ok": True, "projects": list_projects(), "presets": presets()})
        if p == "/api/motion/validate":
            return J({"ok": True, **validate_set()})
        if p == "/api/motion/not-validated":
            return J({"ok": True, **not_validated()})
        if p == "/api/motion/threads":
            return J({"ok": True, **threads()})
        if p in ("/motion/validate", "/motion/validate/", "/motion/not-validate", "/motion/not-validate/"):
            return F(MOTION / "web" / "validate.html", "text/html; charset=utf-8")
        if p == "/api/motion/previous":
            return J({"ok": True, **previous_items()})
        if p in ("/motion/previous", "/motion/previous/"):
            return F(MOTION / "web" / "previous.html", "text/html; charset=utf-8")
        m = re.fullmatch(r"/motion/previous/(video|thumb)/([a-z0-9]+)\.(mp4|jpg)", p)
        if m:
            pv = _previous_mod(); it = pv.find(Path(_bank().WORKSHOP), projects_root(), _timelines_root(), m.group(2))
            if not it:
                raise Refusal("no such video", 404)
            return F(Path(it["path"]), "video/mp4") if m.group(1) == "video" else F(pv.thumb(Path(_bank().WORKSHOP), it), "image/jpeg")
        if p in ("/motion/threads", "/motion/threads/"):
            return F(MOTION / "web" / "threads.html", "text/html; charset=utf-8")
        if p == "/api/motion/banks/music":
            return J({"ok": True, **_bank().music_bank()})
        if p == "/api/motion/banks/sfx":
            return J({"ok": True, **_bank().sfx_bank()})
        if p == "/api/motion/banks/references":
            return J({"ok": True, "references": _bank().references()})
        m = re.fullmatch(r"/api/motion/projects/([a-z0-9-]+)", p)
        if m:
            return J({"ok": True, "project": read_project(m.group(1)), "assets": list_assets(m.group(1)), "versions": list_versions(m.group(1))})
        m = re.fullmatch(r"/api/motion/jobs/([0-9a-f]{12})", p)
        if m:
            job = JOBS.get(m.group(1))
            if not job:
                raise Refusal("no such job", 404)
            return J({"ok": True, "job": job})
        raise Refusal("not found", 404)
    if method == "PUT":
        m = re.fullmatch(r"/api/motion/projects/([a-z0-9-]+)", p)
        if not m:
            raise Refusal("not found", 404)
        if length > 32 << 20:
            raise Refusal("body too large", 413)
        try:
            body = json.loads(read(length) or b"{}")
        except ValueError:
            raise Refusal("invalid JSON")
        return J({"ok": True, "project": write_project(m.group(1), body)})
    if method == "POST":
        def body_json():
            if length > 1 << 20:
                raise Refusal("body too large", 413)
            try:
                return json.loads(read(length) or b"{}") if length else {}
            except ValueError:
                raise Refusal("invalid JSON")
        m = re.fullmatch(r"/api/motion/validate/([a-z0-9-]+)", p)
        if m:
            b = body_json()
            state = str(b.get("state", ""))
            if state not in ("validated", "redo", "pending", ""):
                raise Refusal("state must be validated, redo, pending or empty")
            pr = read_project(m.group(1))
            if state:
                pr["validation"] = {"state": state, "note": str(b.get("note", ""))[:600], "at": time.strftime("%d %B %Y, %H:%M")}
            else:
                pr.pop("validation", None)
            return J({"ok": True, "validation": write_project(m.group(1), pr).get("validation")})
        if p == "/api/motion/previous":
            try:
                return J({"ok": True, **_previous_mod().save_upload(Path(_bank().WORKSHOP), q.get("name", ""), q.get("title", ""), read, length)})
            except ValueError as e:
                raise Refusal(str(e), 400)
        m = re.fullmatch(r"/api/motion/previous/([a-z0-9-]+)", p)
        if m:
            try:
                return J({"ok": True, "meta": _previous_mod().update(Path(_bank().WORKSHOP), m.group(1), body_json())})
            except ValueError as e:
                raise Refusal(str(e), 400)
            except LookupError as e:
                raise Refusal(str(e), 404)
        if p == "/api/motion/projects":
            b = body_json()
            return J({"ok": True, "project": create_project(str(b.get("preset", "")), b.get("title"))})
        m = re.fullmatch(r"/api/motion/projects/([a-z0-9-]+)/assets", p)
        if m:
            return J({"ok": True, "asset": save_upload(m.group(1), q.get("name", ""), read, length)})
        m = re.fullmatch(r"/api/motion/projects/([a-z0-9-]+)/duplicate", p)
        if m:
            b = body_json()
            return J({"ok": True, "project": duplicate(m.group(1), b.get("title") or (read_project(m.group(1)).get("title", "") + " copie"))})
        m = re.fullmatch(r"/api/motion/projects/([a-z0-9-]+)/versions", p)
        if m:
            b = body_json()
            return J({"ok": True, "version": save_version(m.group(1), str(b.get("note", ""))), "versions": list_versions(m.group(1))})
        m = re.fullmatch(r"/api/motion/projects/([a-z0-9-]+)/versions/(V_\d{3})/restore", p)
        if m:
            return J({"ok": True, "project": restore_version(m.group(1), m.group(2)), "versions": list_versions(m.group(1))})
        m = re.fullmatch(r"/api/motion/projects/([a-z0-9-]+)/export", p)
        if m:
            if length <= 0 or length > 512 << 20:
                raise Refusal("the export needs the mix (WAV) as its body")
            return J({"ok": True, "job": start_export(m.group(1), read(length), q.get("draft") == "1")})
        raise Refusal("not found", 404)
    raise Refusal("method not allowed", 405)


# ---------------------------------------------------------------------------------------------------- standalone server (tests)
class Handler(BaseHTTPRequestHandler):
    server_version = "ZenRayMotion/1"

    def log_message(self, fmt, *args):
        pass

    def _out(self, r: dict):
        if "json" in r:
            body, mime, status = json.dumps(r["json"], ensure_ascii=False, default=str).encode(), "application/json; charset=utf-8", r.get("status", 200)
        elif "bytes" in r:
            body, mime, status = r["bytes"], r["mime"], 200
        else:
            body, mime, status = Path(r["file"]).read_bytes(), r["mime"], 200
        self.send_response(status)
        self.send_header("Content-Type", mime)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _go(self, method):
        try:
            u = urlparse(self.path)
            origin = self.headers.get("Origin")
            if origin and origin not in {f"http://127.0.0.1:{self.server.server_port}", f"http://localhost:{self.server.server_port}"}:
                raise Refusal("origin refused", 403)
            if method != "GET" and self.headers.get(CFG["clientHeader"]) != CFG["clientValue"]:
                raise Refusal("missing client header", 403)
            self._out(handle(method, unquote(u.path), {k: v[0] for k, v in parse_qs(u.query).items()}, self.rfile.read,
                             int(self.headers.get("Content-Length") or 0)))
        except Refusal as e:
            self._out(J({"ok": False, "error": str(e)}, e.status))
        except Exception as e:  # noqa: BLE001
            self._out(J({"ok": False, "error": f"{type(e).__name__}: {e}"}, 500))

    def do_GET(self):
        self._go("GET")

    def do_PUT(self):
        self._go("PUT")

    def do_POST(self):
        self._go("POST")


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=3124)
    a = ap.parse_args()
    srv = ThreadingHTTPServer(("127.0.0.1", a.port), Handler)
    print(json.dumps({"ok": True, "url": f"http://127.0.0.1:{srv.server_port}/motion/", "projects": str(projects_root())}), flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
