def asset_path(pid: str, name: str) -> Path:
    if not NAME_RE.match(name or "") or ".." in name:
        raise Refusal("bad file name")
    p = project_dir(pid) / "assets" / name
    if not p.is_file():
        raise Refusal("no such file", 404)
    return p


def save_upload(pid: str, name: str, read, length: int) -> dict:
    project_dir(pid)
    ext = Path(name or "").suffix.lower()
    kind = next((k for k, exts in CFG["uploads"].items() if ext in exts), None)
    if not kind:
        raise Refusal(f"file type {ext or '?'} not accepted (video, image or audio)")
    if length <= 0 or length > CFG["maxUploadBytes"]:
        raise Refusal("file too large or empty", 413)
    clean = re.sub(r"[^A-Za-z0-9._ -]+", "_", Path(name).stem)[:80].strip() or "media"
    dest_dir = project_dir(pid) / "assets"
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest, n = dest_dir / f"{clean}{ext}", 2
    while dest.exists():
        dest, n = dest_dir / f"{clean}-{n}{ext}", n + 1
    with open(dest, "wb") as f:
        left = length
        while left > 0:
            block = read(min(1 << 20, left))
            if not block:
                break
            f.write(block)
            left -= len(block)
    return {"name": dest.name, "kind": kind, "bytes": dest.stat().st_size, "url": f"/motion/files/{pid}/{dest.name}"}


def list_assets(pid: str) -> list[dict]:
