def _free_id(base: str) -> str:
    base = re.sub(r"[^a-z0-9]+", "-", base.lower()).strip("-")[:60] or "motion"
    pid, n = base, 2
    while (projects_root() / pid).exists():
        pid, n = f"{base}-{n}", n + 1
    return pid


def create_project(preset: str, title: str | None) -> dict:
    f = REPO / CFG["presets"] / f"{preset}.json"
    if not ID_RE.match(preset or "") or not f.is_file():
        raise Refusal(f"no preset {preset}", 404)
    p = json.loads(f.read_text(encoding="utf-8"))
    pid = _free_id(title or p.get("title") or preset)
    p["title"] = title or p.get("title") or pid
    p.pop("doc", None)
    return write_project(pid, p)


def duplicate(src_id: str, title: str) -> dict:
    """A copy of a project (and of its media) under a new id: an experiment never touches the original."""
    p = copy.deepcopy(read_project(src_id))
    pid = _free_id(title)
    p["title"] = title
    out = write_project(pid, p)
    if (project_dir(src_id) / "assets").is_dir():
        shutil.copytree(project_dir(src_id) / "assets", project_dir(pid) / "assets")
    return out


