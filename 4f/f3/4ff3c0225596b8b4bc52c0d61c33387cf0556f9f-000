// 26 October 2026: engine version guard. A page that stays open (the macOS app keeps its window for days) holds the JavaScript it loaded, while the project data it fetches is current:
// a setting added by a newer engine (a chromatic aberration pulse) is then silently ignored and the agent, whose page is fresh, sees an effect that the user never sees.
// The page asks the server for the engine version when it loads, then on every focus and every 3 s; when it moved, a banner says so and the page reloads (it waits while a field is being typed in).
// FR : garde de version du moteur : une page ouverte depuis longtemps recharge seule quand le moteur a change.
(function () {
  "use strict";
  let boot = null, pending = false, banner = null;
  const ask = () => fetch("/api/motion/runtime-version", { cache: "no-store" }).then((r) => r.json()).then((j) => j.version).catch(() => null);
  const typing = () => { const a = document.activeElement; return !!a && (a.tagName === "TEXTAREA" || (a.tagName === "INPUT" && !/^(range|checkbox|radio|button)$/.test(a.type)) || a.isContentEditable); };
  const show = (text, button) => {
    if (!banner) { banner = document.createElement("div"); banner.style.cssText = "position:fixed;left:0;right:0;top:0;z-index:99999;padding:8px 14px;background:#c8431f;color:#fff;font:14px/1.3 system-ui,sans-serif;text-align:center"; document.body.appendChild(banner); }
    banner.textContent = text + " ";
    if (button) { const b = document.createElement("button"); b.textContent = "Recharger maintenant"; b.style.cssText = "margin-left:8px;padding:3px 10px;border:0;border-radius:6px;cursor:pointer"; b.onclick = () => location.reload(); banner.appendChild(b); }
  };
  const check = async () => {
    const v = await ask(); if (!v) return;
    if (boot === null) { boot = v; return; }
    if (v === boot || pending) return;
    pending = true; show("Le moteur de ce logiciel a changé : cette page est périmée, rechargement.", true);
    const go = () => { if (typing()) { setTimeout(go, 1500); return; } location.reload(); };
    setTimeout(go, 900);
  };
  check();
  setInterval(check, 3000);
  window.addEventListener("focus", check);
  document.addEventListener("visibilitychange", () => { if (!document.hidden) check(); });
})();
