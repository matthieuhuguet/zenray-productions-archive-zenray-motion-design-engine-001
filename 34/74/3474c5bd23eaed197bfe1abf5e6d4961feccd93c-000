# 14 October 2026: the static web report of the orchestrator. One self-contained HTML page (the GUI's own CSS and the three
# ZenRay fonts inlined) plus one JSON per reference, written to <workshop>/reports/. It carries NUMBERS and names only: no
# reference media, no path, no audio (the rights doctrine), so it is safe to archive in the Assets cloud and to open from any
# copy (LOAD) without the engine running. It is rebuilt at the end of every run and on demand: Scripts/Orchestrate.py report.
# FR : le rapport web statique ; une page autonome et un JSON par reference ; que des nombres, aucun media de reference.
from __future__ import annotations

import base64
import html
import json
import re
from pathlib import Path

from . import orchestrator as orch
from . import registry, settings


def reports_dir() -> Path:
    return settings.path("workshop") / "reports"


def _css() -> str:
    d = orch.definition()
    base = orch.base_tokens()
    css = (Path(orch.expand(d["gui"]["dir"], base)) / "orchestrator.css").read_text(encoding="utf-8")
    fonts = Path(d["gui"]["fontDir"])

    def inline(match):
        f = fonts / match.group(1)
        return f"url('data:font/woff2;base64,{base64.b64encode(f.read_bytes()).decode()}')" if f.exists() else match.group(0)

    return re.sub(r"url\('/fonts/([A-Za-z0-9._-]+)'\)", inline, css)


def reference_report(slug: str) -> dict:
    ref = next((r for r in registry.table() if r["slug"] == slug), None)
    if not ref:
        raise orch.OrchestratorError(f"unknown reference '{slug}'")
    runs = orch.list_runs(slug, 5)
    return {"schema": "zrmd/report@1", "slug": slug, "title": ref.get("title") or slug, "duration_s": ref.get("duration_s"),
            "date": orch.stamp(), "modules": orch.module_scores(slug),
            "status": {k: ref["status"][k] for k in ("shots", "stems", "sfx_versions", "motions")},
            "lastRun": {"id": runs[0]["id"], "state": runs[0]["state"], "created": runs[0]["created"],
                        "steps": [{k: s[k] for k in ("id", "state", "seconds", "score")} for s in runs[0]["steps"]]} if runs else None}


def _fmt(v) -> str:
    return "—" if v is None else f"{v * 100:.1f}"


def _row(rep: dict) -> str:
    mods = "".join(
        f'<div class="mod"><div class="mod-name"><span>{html.escape(m["label"])}</span><small>{html.escape(m["hint"])}</small></div>'
        f'<div class="track"><span class="fill {"reached" if m["reached"] else ""}" style="width:{0 if m["value"] is None else min(100, m["value"] * 100):.1f}%"></span>'
        f'<span class="tick" style="left:{m["target"] * 100}%"></span><span class="tick stretch" style="left:{m["stretch"] * 100}%"></span></div>'
        f'<div class="mod-score"><span class="score">{_fmt(m["value"])}</span><small>{html.escape(m["version"] or "")}</small></div></div>'
        for m in rep["modules"])
    last = rep["lastRun"]
    meta = f'{rep["duration_s"]:.1f} s · ' if rep.get("duration_s") else ""
    meta += f'last run {html.escape(last["created"])}: {html.escape(last["state"])}' if last else "no run yet"
    return (f'<section class="card"><h2>{html.escape(rep["title"])}</h2><div class="sub"><span class="mono">{html.escape(rep["slug"])}</span>'
            f'<span>{meta}</span></div><div class="mods" style="margin-top:14px">{mods}</div></section>')


def build() -> dict:
    d = orch.definition()
    out = reports_dir()
    out.mkdir(parents=True, exist_ok=True)
    reps = []
    for slug in registry.slugs():
        rep = reference_report(slug)
        orch.atomic_json(out / f"{slug}.json", rep)
        reps.append(rep)
    reps.sort(key=lambda r: -max([m["value"] or 0 for m in r["modules"]] or [0]))
    orch.atomic_json(out / "index.json", {"schema": "zrmd/report-index@1", "date": orch.stamp(), "targets": d["targets"], "limits": d["honestLimits"],
                                          "references": [{"slug": r["slug"], "title": r["title"], "modules": {m["module"]: m["value"] for m in r["modules"]}} for r in reps]})
    limits = "".join(f"<li>{html.escape(x)}</li>" for x in d["honestLimits"])
    page = (f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">'
            f'<title>Motion Design report</title><style>{_css()}\n.shell{{display:block}} .main{{margin:0 auto}}</style></head><body><main class="main">'
            f'<header><h1>Motion Design: fidelity by reference</h1><div class="sub"><span>{html.escape(orch.stamp())}</span>'
            f'<span>target {d["targets"]["default"] * 100:.0f} · stretch {d["targets"]["stretch"] * 100:.1f}</span></div></header>'
            f'{"".join(_row(r) for r in reps)}<section class="card"><h2>Honest limits</h2><ul class="limits">{limits}</ul></section>'
            f'<p class="legend">Numbers only: no reference media is in this page. Generated by Scripts/Orchestrate.py report.</p></main></body></html>')
    (out / "index.html").write_text(page, encoding="utf-8")
    return {"dir": str(out), "references": len(reps), "bytes": (out / "index.html").stat().st_size}
