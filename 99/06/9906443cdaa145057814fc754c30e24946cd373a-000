def controls(sid: str, template: str, items: list) -> list:
    ids = ["b01"]
    allt = lambda k: [T(i, k) for i in ids]  # noqa: E731
    c = [{"id": "items", "label": "Titres : texte | centre x | centre y | taille | début | fin", "type": "lines", "group": "Phrases", "targets": allt("items")}]
    c += [{"id": "dIn", "label": "Durée de l'apparition (s)", "type": "number", "group": "Mouvement", "min": 0.05, "max": 1.5, "step": 0.01, "targets": allt("dIn")},
          {"id": "dOut", "label": "Durée de l'effacement (s)", "type": "number", "group": "Mouvement", "min": 0, "max": 2, "step": 0.01, "targets": allt("dOut")},
          {"id": "outLead", "label": "L'effacement commence avant la fin de (s)", "type": "number", "group": "Mouvement", "min": 0, "max": 3, "step": 0.01, "targets": allt("outLead")},
          {"id": "push", "label": "Avance lente (part de la taille)", "type": "number", "group": "Mouvement", "min": 0, "max": 0.15, "step": 0.001, "targets": allt("push")},
          {"id": "fadeOut", "label": "Fondu de sortie (s)", "type": "number", "group": "Mouvement", "min": 0, "max": 2, "step": 0.05, "targets": allt("fadeOut")},
          {"id": "weight", "label": "Graisse", "type": "number", "group": "Texte", "min": 300, "max": 800, "step": 10, "targets": allt("weight")},
          {"id": "ls", "label": "Interlettrage (em)", "type": "number", "group": "Texte", "min": -0.1, "max": 0.2, "step": 0.002, "targets": allt("ls")},
          {"id": "keys", "label": "Couleurs mesurées : titre | temps | gauche | milieu | droite", "type": "lines", "group": "Couleurs", "targets": allt("keys")},
          {"id": "glow1", "label": "Halo proche (px)", "type": "number", "group": "Halo", "min": 0, "max": 60, "step": 0.5, "targets": allt("glow1")},
          {"id": "glow2", "label": "Halo large (px)", "type": "number", "group": "Halo", "min": 0, "max": 160, "step": 1, "targets": allt("glow2")},
          {"id": "glowA", "label": "Force du halo", "type": "number", "group": "Halo", "min": 0, "max": 2, "step": 0.01, "targets": allt("glowA")}]
    return c


def load_data() -> dict:
    return json.loads(DATA.read_text(encoding="utf-8")) if DATA.is_file() else {}


def build_one(sid: str) -> dict:
    title, start, length, tpl, params = SEQUENCES[sid]
    data = load_data().get(sid, {})
    params = dict(params); params.update(data.get("params", {}))
    pr = ppm.build(f"Apple MacBook Pro : {title}", SLUG, [(0.0, tpl, params)], length, controls(sid, tpl, params.get("items", [])), fmt="16x9", bg="#000000", ink="#e8f0f0", accent="#4fb0d0",
                   doc=f"22 October 2026: {title}, sequence of the Apple MacBook Pro film, foreground only (workflow Premier Plan Mesuré).")
    pr["scenes"][0]["params"]["film0"] = start; pr["scenes"][0]["ref"] = {"start": start}; pr["referenceOffset"] = start
    return pr


if __name__ == "__main__":
    ids = sys.argv[1:] or list(SEQUENCES)
    for sid in ids:
        ppm.run(f"{sid}-ppm", build_one(sid))
