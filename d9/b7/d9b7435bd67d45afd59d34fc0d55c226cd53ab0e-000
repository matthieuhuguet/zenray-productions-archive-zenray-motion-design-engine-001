import numpy as np

U32 = np.uint32
LUMA = np.array([0.2126, 0.7152, 0.0722])


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def _axis(u, v, angle):
    a = np.radians(angle)
    dx, dy = np.cos(a), np.sin(a)
    return np.clip(0.5 + ((u - 0.5) * dx + (v - 0.5) * dy) / (abs(dx) + abs(dy)), 0.0, 1.0)


def render(params, u, v):
    q = params
    x = _v(q['c0']) + (_v(q['c1']) - _v(q['c0'])) * _axis(u, v, q['angle'])[..., None]
    y = _v(q['gain']) * (x + _v(q['lift']) * (1.0 - x))
    y = np.power(np.maximum(y, 1e-8), 1.0 / _v(q['gamma']))
    return np.clip(y, 0.0, 1.0) * 255.0
