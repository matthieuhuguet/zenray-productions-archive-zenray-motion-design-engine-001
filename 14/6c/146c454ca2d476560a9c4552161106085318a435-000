# 14 October 2026: remove a project the user DROPPED into the app (the same function the app's delete button calls, zrmd.app.ingest.remove_dropped).
# It refuses any other origin, so a reference of the corpus can never be removed from here. FR : supprime un projet depose.
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from zrmd.app import ingest  # noqa: E402
from zrmd.app.projects import AppError  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("slug")
    ap.add_argument("--yes", action="store_true", help="really remove (without it, only lists what would go)")
    a = ap.parse_args()
    try:
        print(json.dumps({"ok": True, **ingest.remove_dropped(a.slug, dry_run=not a.yes)}, indent=1))
        return 0
    except AppError as e:
        print(json.dumps({"ok": False, "error": str(e)}))
        return 2


if __name__ == "__main__":
    sys.exit(main())
