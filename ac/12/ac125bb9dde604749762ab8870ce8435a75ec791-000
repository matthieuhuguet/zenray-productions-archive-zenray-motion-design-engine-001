def player_html(title: str, shot: dict, trace: dict, times: list[float]) -> str:
    vars_ = ";".join(f"--c{i}:{c}" for i, c in enumerate(trace["palette"]))
    svgs = "".join(f'<div class="k">{s}</div>' for s in trace["svgs"])
    w, h = trace["width"], trace["height"]
    return (PLAYER.replace("__TITLE__", _html.escape(title)).replace("__VARS__", vars_).replace("__SVGS__", svgs)
            .replace("__AR__", f"{w / h:.5f}").replace("__W__", str(w)).replace("__H__", str(h))
            .replace("__DUR__", f"{shot['duration']:.3f}").replace("__KEYS__", json.dumps([round(t - shot['start'], 3) for t in times]))
            .replace("__N__", str(len(trace["palette"]))).replace("__PALETTE__", ",".join(json.dumps(c) for c in trace["palette"])))


# ---------------------------------------------------------------------------------------------------- one video
def run_video(slug: str, video: str, workshop: Path, assets_dir: Path, html_dir: Path, log=print) -> dict:
    """Every shot of the bible of `slug`: keyframes, one palette, SVGs (written into assets_dir, flat names the project can use) and
    one standalone HTML per shot (html_dir). Resumable: a shot whose files exist is read back, not traced again."""
    bible = json.loads((workshop / "references" / slug / "bible.json").read_text(encoding="utf-8"))
    info = probe(video)
    shots = bible["shots"]
    total = max(float(s["end"]) for s in shots)
    hz = CFG["sampling"]["probeHz"]
    low = lowres(video, hz, min(total + 0.5, info["duration"]))
    width = CFG["trace"]["width"] if info["width"] >= info["height"] else CFG["trace"]["widthVertical"]
    assets_dir.mkdir(parents=True, exist_ok=True)
    html_dir.mkdir(parents=True, exist_ok=True)
    out, bytes_total = [], 0
    for s in shots:
        sid = s["id"]
        meta_file = assets_dir / f"{sid}.json"
        if meta_file.is_file():
            m = json.loads(meta_file.read_text(encoding="utf-8"))
            out.append(m)
            bytes_total += m["bytes"]
            continue
        t0, t1 = float(s["start"]), float(s["end"])
        times = pick_keys(low, hz, t0, t1)
        frames = [f for f in (grab(video, t, width) for t in times) if f is not None]
        if not frames:
            continue
        times = times[: len(frames)]
        tr = trace_shot(frames)
        files, size = [], 0
        for k, svg in enumerate(tr["svgs"]):
            name = f"{sid}-k{k:02d}.svg"
            (assets_dir / name).write_text(svg, encoding="utf-8")
            files.append({"t": round(times[k] - t0, 3), "file": name, "bytes": len(svg)})
            size += len(svg)
        shot = {"start": t0, "duration": round(t1 - t0, 4)}
        (html_dir / f"{sid}.html").write_text(player_html(f"{slug} {sid}", shot, tr, times), encoding="utf-8")
        m = {"id": sid, "start": t0, "end": t1, "duration": round(t1 - t0, 4), "family": s.get("family"), "keys": files, "palette": tr["palette"],
             "colors": tr["colors"], "width": tr["width"], "height": tr["height"], "bytes": size,
             "fidelityShare": min(f["share"] for f in tr["fidelity"]), "meanDeltaE": round(float(np.mean([f["meanDeltaE"] for f in tr["fidelity"]])), 2)}
        meta_file.write_text(json.dumps(m, ensure_ascii=False) + "\n", encoding="utf-8")
        out.append(m)
        bytes_total += size
    keys = sum(len(m["keys"]) for m in out)
    share = [m["fidelityShare"] for m in out]
    summary = {"slug": slug, "shots": len(out), "keys": keys, "bytes": bytes_total, "width": info["width"], "height": info["height"],
               "fidelityMeanShare": round(float(np.mean(share)), 4) if share else None,
               "fidelityMinShare": round(float(np.min(share)), 4) if share else None,
               "shotsAtTarget": sum(1 for x in share if x >= CFG["fidelity"]["targetShare"])}
    (assets_dir / "vector.json").write_text(json.dumps({"summary": summary, "shots": out}, ensure_ascii=False) + "\n", encoding="utf-8")
    return summary
