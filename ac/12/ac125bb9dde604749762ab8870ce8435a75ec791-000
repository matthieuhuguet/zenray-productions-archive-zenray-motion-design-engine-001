def player_html(title: str, shot: dict, trace: dict, times: list[float]) -> str:
    vars_ = ";".join(f"--c{i}:{c}" for i, c in enumerate(trace["palette"]))
    svgs = "".join(f'<div class="k">{s}</div>' for s in trace["svgs"])
    w, h = trace["width"], trace["height"]
    return (PLAYER.replace("__TITLE__", _html.escape(title)).replace("__VARS__", vars_).replace("__SVGS__", svgs)
            .replace("__AR__", f"{w / h:.5f}").replace("__W__", str(w)).replace("__H__", str(h))
            .replace("__DUR__", f"{shot['duration']:.3f}").replace("__KEYS__", json.dumps([round(t - shot['start'], 3) for t in times]))
            .replace("__N__", str(len(trace["palette"]))).replace("__PALETTE__", ",".join(json.dumps(c) for c in trace["palette"])))


# ---------------------------------------------------------------------------------------------------- one video
def erase_boxes(frame: np.ndarray, boxes: list) -> np.ndarray:
    """Text that stays editable is removed from the picture before tracing: each box (x0, y0, x1, y1 in % of the frame) is filled
    with the median colour of the ring around it."""
    h, w = frame.shape[:2]
    out = frame.copy()
    for x0, y0, x1, y1 in boxes:
        a, b, c, d = int(x0 / 100 * w), int(y0 / 100 * h), int(x1 / 100 * w), int(y1 / 100 * h)
        ring = np.concatenate([frame[max(0, b - 4):b, a:c].reshape(-1, 3), frame[d:d + 4, a:c].reshape(-1, 3),
                               frame[b:d, max(0, a - 4):a].reshape(-1, 3), frame[b:d, c:c + 4].reshape(-1, 3)])
        if len(ring):
            out[b:d, a:c] = np.median(ring, axis=0)
    return out


def temporal_error(low: np.ndarray, hz: float, t0: float, t1: float, times: list[float], rasters: list) -> dict:
    """The stepping error of a shot: at every probe sample, the picture of the reference against the keyframe on screen (64 x 36 grey)."""
    w, h = CFG["sampling"]["probeSize"]
    grey = [cv2.resize(cv2.cvtColor(r, cv2.COLOR_BGR2GRAY), (w, h), interpolation=cv2.INTER_AREA).astype(np.int16) if r is not None else None for r in rasters]
    errs, fracs = [], []
    guard = CFG["sampling"].get("cutGuardSamples", 1.5) / hz   # the probe's own timing is one sample loose: never judge next to a cut
    for i in range(int(math.ceil((t0 + guard) * hz)), min(len(low), int(math.ceil((t1 - guard) * hz)))):
        t = i / hz
        k = max(j for j, kt in enumerate(times) if kt <= t + 1e-6) if any(kt <= t + 1e-6 for kt in times) else 0
        if grey[k] is not None:
            # the probe and the exact grab of a keyframe can differ by one source frame: the nearest of three neighbouring samples is judged
            cands = [np.abs(low[j].astype(np.int16) - grey[k]) for j in (i - 1, i, i + 1) if 0 <= j < len(low)]
            d = min(cands, key=lambda c: float(c.mean()))
            errs.append(float(d.mean()))
            fracs.append(float((d > CFG["sampling"]["pixelDelta"]).mean()))
    return {"mean": round(float(np.mean(errs)), 2) if errs else 0.0, "max": round(float(np.max(errs)), 2) if errs else 0.0, "samples": len(errs),
            "areaMean": round(float(np.mean(fracs)), 4) if fracs else 0.0, "areaMax": round(float(np.max(fracs)), 4) if fracs else 0.0}


def trace_with_loops(video: str, low: np.ndarray, hz: float, t0: float, t1: float, base_width: int, ov: dict) -> dict:
    """One shot, measured: keys, then a rendered-fidelity loop (finer tracing) and a stepping-error loop (more keys)."""
    rc, fc = CFG["refine"], CFG["fidelity"]
    thr = ov.get("changeThreshold", CFG["sampling"]["changeThreshold"])
    width = ov.get("width", base_width)
    over = dict(ov.get("potrace") or {})
    best, passes = None, []
    for rnd in range(rc["passes"] + 1):
        times = pick_keys(low, hz, t0, t1, thr, ov)
        frames = [grab(video, t, width) for t in times]
        keep = [(t, f) for t, f in zip(times, frames) if f is not None]
        if not keep:
            return best or {}
        times, frames = [k[0] for k in keep], [erase_boxes(k[1], ov["erase"]) if ov.get("erase") else k[1] for k in keep]
        # fast sequences: every keyframe is on screen for a few frames only, so each one is traced lighter and the time resolution goes first
        fast = len(times) / max(0.1, t1 - t0) > CFG["fast"]["keysPerSecond"]
        if fast and width > CFG["fast"]["maxWidth"]:
            frames = [cv2.resize(f, (CFG["fast"]["maxWidth"], int(round(f.shape[0] * CFG["fast"]["maxWidth"] / f.shape[1]))), interpolation=cv2.INTER_AREA) for f in frames]
        tr = trace_shot(frames, over, ov.get("ladder"), CFG["fast"]["maxKeyBytes"] if fast else None)
        tr["fast"] = fast
        tr["times"] = times
        tr["temporal"] = temporal_error(low, hz, t0, t1, times, tr["rasters"])
        tr["share"] = min(f["share"] for f in tr["fidelity"])
        tr["rounds"] = rnd
        tr["bytesTotal"] = sum(len(x) for x in tr["svgs"])
        passes.append(tr)
        if best is None or (tr["share"], -tr["temporal"]["areaMax"]) > (best["share"], -best["temporal"]["areaMax"]):
            best = tr
        weak_pic = tr["share"] < fc["targetShare"] and width < rc["maxWidth"]
        weak_time = (tr["temporal"]["max"] > rc["temporalMax"] or tr["temporal"]["areaMax"] > rc["areaMax"]) and thr > rc["minThreshold"]
        if not (weak_pic or weak_time):
            break
        if weak_pic:
            width = min(rc["maxWidth"], int(width * rc["widthStep"]))
            over = {**over, **rc["finePotrace"]}
            lad_all = ov.get("ladder") or CFG["quantize"]["colorLadder"]
            nxt = [c for c in lad_all if c > tr["colors"]]
            if nxt:
                ov = {**ov, "ladder": nxt}
        if weak_time:
            thr = max(rc["minThreshold"], thr * rc["thresholdStep"])
    # diminishing returns: a finer pass that costs several times the bytes for a hair of fidelity is not kept
    ok = [t for t in passes if t["share"] >= best["share"] - rc["shareSlack"] and t["temporal"]["max"] <= max(rc["temporalMax"], best["temporal"]["max"])
          and t["temporal"]["areaMax"] <= max(rc["areaMax"], best["temporal"]["areaMax"])]
    return min(ok, key=lambda t: t["bytesTotal"]) if ok else best


_CTX: dict = {}


def _one_shot(s: dict) -> dict | None:
    """One shot, in a worker process (the context is inherited at fork): its keys, files and result."""
    c = _CTX
    sid = s["id"]
    t0, t1 = float(s["start"]), float(s["end"])
    for old in c["assets_dir"].glob(f"{sid}-k*.svg"):
        old.unlink()
    ov = (c["recipe"].get("shots") or {}).get(sid, {})
    tr = trace_with_loops(c["video"], c["low"], c["hz"], t0, t1, c["base"], ov | {k: v for k, v in c["recipe"].items() if k in ("potrace",) and k not in ov})
    if not tr:
        return None
    files, size = [], 0
    for k, svg in enumerate(tr["svgs"]):
        name = f"{sid}-k{k:02d}.svg"
        (c["assets_dir"] / name).write_text(svg, encoding="utf-8")
        files.append({"t": round(tr["times"][k] - t0, 3), "file": name, "bytes": len(svg)})
        size += len(svg)
    (c["html_dir"] / f"{sid}.html").write_text(player_html(f"{c['slug']} {sid}", {"start": t0, "duration": round(t1 - t0, 4)}, tr, tr["times"]), encoding="utf-8")
    m = {"id": sid, "start": t0, "end": t1, "duration": round(t1 - t0, 4), "family": s.get("family"), "keys": files, "palette": tr["palette"],
         "colors": tr["colors"], "width": tr["width"], "height": tr["height"], "bytes": size, "rounds": tr["rounds"], "fast": bool(tr.get("fast")),
         "fidelityShare": tr["share"], "meanDeltaE": round(float(np.mean([f["meanDeltaE"] for f in tr["fidelity"]])), 2), "temporal": tr["temporal"]}
    (c["assets_dir"] / f"{sid}.json").write_text(json.dumps(m, ensure_ascii=False) + "\n", encoding="utf-8")
    return m


def run_video(slug: str, video: str, workshop: Path, assets_dir: Path, html_dir: Path, recipe: dict | None = None, only: list[str] | None = None, log=print) -> dict:
    """Every shot of the bible of `slug` (or the shots in `only`): keyframes, one palette, SVGs (written into assets_dir, flat names the
    project plays) and one standalone HTML per shot (html_dir). The recipe of the video holds the per-shot decisions (erase, width,
    palette ladder, thresholds). Resumable: a shot whose result file exists is read back; delete it to measure the shot again.
    The shots of one video are traced by several processes at once (the video is the sequential unit, never the corpus)."""
    import concurrent.futures as cf
    import multiprocessing as mp
    recipe = recipe or {}
    bible = json.loads((workshop / "references" / slug / "bible.json").read_text(encoding="utf-8"))
    info = probe(video)
    shots = [s for s in bible["shots"] if not only or s["id"] in only]
    total = max(float(s["end"]) for s in bible["shots"])
    hz = CFG["sampling"]["probeHz"]
    low = lowres(video, hz, min(total + 0.5, info["duration"]))
    base = recipe.get("width") or (CFG["trace"]["width"] if info["width"] >= info["height"] else CFG["trace"]["widthVertical"])
    assets_dir.mkdir(parents=True, exist_ok=True)
    html_dir.mkdir(parents=True, exist_ok=True)
    _CTX.update({"video": video, "low": low, "hz": hz, "base": base, "assets_dir": assets_dir, "html_dir": html_dir, "recipe": recipe, "slug": slug})
    done_, todo = {}, []
    for s in shots:
        f = assets_dir / f"{s['id']}.json"
        if f.is_file():
            done_[s["id"]] = json.loads(f.read_text(encoding="utf-8"))
        else:
            todo.append(s)
    # the longest shots first, so the pool never ends on one big shot alone
    todo.sort(key=lambda s: -(float(s["end"]) - float(s["start"])))
    if todo:
        with cf.ProcessPoolExecutor(max_workers=CFG["workers"], mp_context=mp.get_context("fork")) as ex:
            futs = {ex.submit(_one_shot, s): s for s in todo}
            for fut in cf.as_completed(futs):
                m = fut.result()
                if m:
                    done_[m["id"]] = m
                    log(f"{slug} {m['id']} {m['start']:.2f}s keys {len(m['keys'])} colours {m['colors']} w{m['width']} share {m['fidelityShare']:.3f} "
                        f"step-err max {m['temporal']['max']:.1f} area {m['temporal']['areaMax']:.3f}")
    out = [done_[s["id"]] for s in shots if s["id"] in done_]
    return summarize(slug, out, info, assets_dir)


def summarize(slug: str, out: list, info: dict, assets_dir: Path) -> dict:
    share = [m["fidelityShare"] for m in out]
    summary = {"slug": slug, "shots": len(out), "keys": sum(len(m["keys"]) for m in out), "bytes": sum(m["bytes"] for m in out),
               "width": info["width"], "height": info["height"],
               "fidelityMeanShare": round(float(np.mean(share)), 4) if share else None,
               "fidelityMinShare": round(float(np.min(share)), 4) if share else None,
               "shotsAtTarget": sum(1 for x in share if x >= CFG["fidelity"]["targetShare"]),
               "steppingMax": round(max((m["temporal"]["max"] for m in out), default=0.0), 2),
               "steppingMean": round(float(np.mean([m["temporal"]["mean"] for m in out])), 2) if out else None,
               "stepAreaMax": round(max((m["temporal"].get("areaMax", 0.0) for m in out), default=0.0), 4)}
    (assets_dir / "vector.json").write_text(json.dumps({"summary": summary, "shots": out}, ensure_ascii=False) + "\n", encoding="utf-8")
    return summary
