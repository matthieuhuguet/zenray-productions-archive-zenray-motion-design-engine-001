"""ZenRay Motion Design, the vector animation of every cut as ONE self-contained HTML (16 October 2026).

For each shot of a measured reference (bible.json), the cut is turned into flat 2D vector motion: keyframes chosen where the picture
really changes (never a fixed rate), ONE palette fitted to the whole shot, and every keyframe traced to a single stacked SVG (the
colours painted in order, each over the previous one: no separate layers to edit, no holes). The palette is a set of CSS
variables (--c0 .. --cN), so the colours of an animation are parameters. Detail goes up until the traced image is within
`toleranceDeltaE` of the frame for `targetShare` of its pixels, or until the size cap of a keyframe is reached; the result is
reported as numbers, never as a promise. Nothing is copied from the reference: the SVG is a measurement of its shapes.
FR : l'animation vectorielle 2D de chaque coupe en UN seul HTML ; palette en variables CSS, pas de calques separes.
"""
from __future__ import annotations

import html as _html
import json
import math
import re
import subprocess
from pathlib import Path

import cv2
import numpy as np

CFG_PATH = Path(__file__).resolve().parent / "params" / "htmlvec.json"
CFG = json.loads(CFG_PATH.read_text(encoding="utf-8"))
POTRACE = CFG["potrace"]["binary"]


def probe(video: str) -> dict:
    r = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=width,height,r_frame_rate:format=duration",
                        "-of", "json", video], capture_output=True, text=True)
    j = json.loads(r.stdout)
    s = j["streams"][0]
    n, d = (s["r_frame_rate"].split("/") + ["1"])[:2]
    return {"width": int(s["width"]), "height": int(s["height"]), "fps": float(n) / max(1.0, float(d)), "duration": float(j["format"]["duration"])}


# ---------------------------------------------------------------------------------------------------- keyframe times
def lowres(video: str, hz: float, seconds: float) -> np.ndarray:
    """Every sample of the video at hz, 64 x 36 grey, in one pass: what the choice of the keyframes reads."""
    w, h = CFG["sampling"]["probeSize"]
    r = subprocess.run(["ffmpeg", "-v", "error", "-i", video, "-t", f"{seconds:.3f}", "-vf", f"fps={hz},scale={w}:{h}:flags=area,format=gray",
                        "-f", "rawvideo", "-pix_fmt", "gray", "-"], capture_output=True, timeout=1200)
    n = len(r.stdout) // (w * h)
    return np.frombuffer(r.stdout[: n * w * h], dtype=np.uint8).reshape(n, h, w)


def pick_keys(low: np.ndarray, hz: float, t0: float, t1: float, thr: float | None = None, ov: dict | None = None) -> list[float]:
    """The instants of a shot that get a traced image: the first one, then each time the picture moved by more than the threshold
    since the last one (at least minGap apart, at most maxKeys). A still shot is one image."""
    s = {**CFG["sampling"], **(ov or {})}
    thr = s["changeThreshold"] if thr is None else thr
    dur = max(1e-3, t1 - t0)
    first = t0 + min(s["firstOffsetS"], dur / 2)
    keys = [first]
    cap = max(1, min(s["maxKeysPerShot"], math.ceil(dur * s["maxKeysPerSecond"])))
    if len(low) == 0:
        return keys

    def at(t: float) -> np.ndarray:
        return low[min(len(low) - 1, max(0, int(round(t * hz))))].astype(np.int16)

    last = at(first)
    for i in range(int(math.ceil(first * hz)) + 1, int(t1 * hz)):
        t = i / hz
        if t >= t1 - 1e-3 or len(keys) >= cap:
            break
        d = np.abs(at(t) - last)
        # a small object moving on a flat ground changes few pixels a lot: the area that changed counts as well as the mean
        if t - keys[-1] >= s["minGapS"] and (float(d.mean()) >= thr or float((d > s["pixelDelta"]).mean()) >= s["areaThreshold"] * (thr / s["changeThreshold"])):
            keys.append(t)
            last = at(t)
    return keys


# ---------------------------------------------------------------------------------------------------- frames
def grab(video: str, t: float, width: int) -> np.ndarray | None:
    r = subprocess.run(["ffmpeg", "-v", "error", "-ss", f"{max(0.0, t):.3f}", "-i", video, "-frames:v", "1", "-vf", f"scale={width}:-2:flags=lanczos",
                        "-f", "image2pipe", "-vcodec", "png", "-"], capture_output=True, timeout=120)
    if not r.stdout:
        return None
    return cv2.imdecode(np.frombuffer(r.stdout, dtype=np.uint8), cv2.IMREAD_COLOR)


def to_lab(bgr: np.ndarray) -> np.ndarray:
    return cv2.cvtColor(bgr.astype(np.float32) / 255.0, cv2.COLOR_BGR2LAB)


def hexof(lab: np.ndarray) -> str:
    bgr = cv2.cvtColor(lab.reshape(1, 1, 3).astype(np.float32), cv2.COLOR_LAB2BGR).reshape(3)
    r, g, b = (int(round(float(np.clip(c, 0, 1)) * 255)) for c in (bgr[2], bgr[1], bgr[0]))
    return f"#{r:02x}{g:02x}{b:02x}"


# ---------------------------------------------------------------------------------------------------- palette and tracing
def fit_palette(labs: list[np.ndarray], n: int) -> np.ndarray:
    """One palette for all the keyframes of a shot (k-means in Lab), ordered by area, largest first: the background first."""
    rng = np.random.default_rng(CFG["quantize"]["seed"])
    per = max(1000, CFG["quantize"]["samples"] // max(1, len(labs)))
    pix = np.concatenate([l.reshape(-1, 3)[rng.integers(0, l.shape[0] * l.shape[1], size=min(per, l.shape[0] * l.shape[1]))] for l in labs]).astype(np.float32)
    k = max(2, min(n, len(np.unique(np.round(pix, 1), axis=0))))
    crit = (cv2.TERM_CRITERIA_EPS + cv2.TERM_CRITERIA_MAX_ITER, CFG["quantize"]["iterations"], 0.5)
    _, label, centers = cv2.kmeans(pix, k, None, crit, CFG["quantize"]["attempts"], cv2.KMEANS_PP_CENTERS)
    order = np.argsort(-np.bincount(label.ravel(), minlength=k))
    return centers[order]


def assign(lab: np.ndarray, centers: np.ndarray) -> np.ndarray:
    px = lab.reshape(-1, 3)
    d = ((px[:, None, :] - centers[None, :, :]) ** 2).sum(axis=2)
    return d.argmin(axis=1).reshape(lab.shape[:2]).astype(np.uint8)


def fidelity(lab: np.ndarray, labels: np.ndarray, centers: np.ndarray) -> dict:
    de = np.sqrt(((lab - centers[labels]) ** 2).sum(axis=2))
    tol = CFG["fidelity"]["toleranceDeltaE"]
    return {"share": round(float((de <= tol).mean()), 4), "meanDeltaE": round(float(de.mean()), 2)}


def potrace_mask(mask: np.ndarray, over: dict | None = None) -> tuple[str, str] | None:
    """One stacked colour: the black pixels of the mask traced to a path (data and the group transform potrace gives)."""
    h, w = mask.shape
    pbm = b"P4\n%d %d\n" % (w, h) + np.packbits(mask.astype(np.uint8), axis=1).tobytes()
    p = {**CFG["potrace"], **(over or {})}
    r = subprocess.run([POTRACE, "-b", "svg", "-t", str(p["speckle"]), "-a", str(p["cornerThreshold"]), "-O", str(p["curveTolerance"]),
                        "-o", "-", "-"], input=pbm, capture_output=True, timeout=120)
    txt = r.stdout.decode("utf-8", "replace")
    # potrace writes one <path> per connected region (with its holes): all of them are one colour, so they are joined into one path
    ds = re.findall(r'<path d="([^"]+)"', txt)
    tr = re.search(r'<g transform="([^"]+)"', txt)
    return (" ".join(d.replace("\n", " ") for d in ds), tr.group(1)) if ds and tr else None


def key_svg(labels: np.ndarray, hexes: list[str], width: int, height: int, over: dict | None = None) -> str:
    """The stacked SVG of one keyframe: colour 0 is the ground, every next colour is the union of itself and all the later ones
    (painter's order), so no gap shows between two regions and the number of nodes stays small."""
    parts = [f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {width} {height}" preserveAspectRatio="xMidYMid slice" '
             f'shape-rendering="geometricPrecision"><rect width="{width}" height="{height}" style="fill:var(--c0,{hexes[0]})"/>']
    for i in range(1, len(hexes)):
        mask = labels >= i
        if not mask.any():
            continue
        t = potrace_mask(mask, over)
        if t:
            parts.append(f'<g transform="{t[1]}" style="fill:var(--c{i},{hexes[i]})"><path d="{t[0]}"/></g>')
    parts.append("</svg>")
    return "".join(parts)


_VAR = re.compile(r"var\(--c\d+,(#[0-9a-fA-F]{6})\)")


def render_svg(svg: str, w: int, h: int) -> np.ndarray | None:
    """What the SVG really shows: rasterised by librsvg at the size of the frame."""
    r = subprocess.run([CFG["raster"]["binary"], "-f", "png", "-w", str(w), "-h", str(h)], input=_VAR.sub(r"\1", svg).encode(), capture_output=True, timeout=120)
    img = cv2.imdecode(np.frombuffer(r.stdout, dtype=np.uint8), cv2.IMREAD_COLOR) if r.stdout else None
    return img if img is not None and img.shape[:2] == (h, w) else None


def rendered_share(img: np.ndarray | None, frame: np.ndarray) -> dict:
    if img is None:
        return {"share": 0.0, "meanDeltaE": 99.0}
    de = np.sqrt(((to_lab(frame) - to_lab(img)) ** 2).sum(axis=2))
    return {"share": round(float((de <= CFG["fidelity"]["toleranceDeltaE"]).mean()), 4), "meanDeltaE": round(float(de.mean()), 2)}


def trace_shot(frames: list[np.ndarray], over: dict | None = None, ladder: list[int] | None = None, cap: int | None = None) -> dict:
    """Palette and SVGs of the keyframes of one shot, at the least detail that reaches the target (or the cap)."""
    q, fcfg = CFG["quantize"], CFG["fidelity"]
    ladder = ladder or q["colorLadder"]
    labs = [to_lab(f) for f in frames]
    h, w = frames[0].shape[:2]
    best = None
    for n in ladder:
        centers = fit_palette(labs, n)
        labels = [assign(l, centers) for l in labs]
        fid = [fidelity(l, lb, centers) for l, lb in zip(labs, labels)]
        share = min(f["share"] for f in fid)
        best = {"centers": centers, "labels": labels, "fid": fid, "n": len(centers)}
        if share >= fcfg["targetShare"]:
            break
    hexes = [hexof(c) for c in best["centers"]]
    svgs = [key_svg(lb, hexes, w, h, over) for lb in best["labels"]]
    # size cap: a keyframe over the cap is traced again with a coarser palette (never silently truncated)
    cap = cap or CFG["potrace"]["maxKeyBytes"]
    lad = [n for n in ladder if n < best["n"]]
    coarse = [dict(c) for c in CFG["potrace"]["coarsen"]]
    while max(len(s) for s in svgs) > cap and not lad and coarse:
        over = {**(over or {}), **coarse.pop(0)}
        hexes = [hexof(c) for c in best["centers"]]
        svgs = [key_svg(lb, hexes, w, h, over) for lb in best["labels"]]
    while max(len(s) for s in svgs) > cap and lad:
        n = lad.pop()
        centers = fit_palette(labs, n)
        labels = [assign(l, centers) for l in labs]
        hexes = [hexof(c) for c in centers]
        svgs = [key_svg(lb, hexes, w, h, over) for lb in labels]
        best = {"centers": centers, "labels": labels, "fid": [fidelity(l, lb, centers) for l, lb in zip(labs, labels)], "n": n}
    rasters = [render_svg(sv, w, h) for sv in svgs]
    rendered = [rendered_share(r, fr) for r, fr in zip(rasters, frames)]
    return {"palette": hexes, "svgs": svgs, "fidelity": rendered, "quantized": best["fid"], "colors": len(hexes), "width": w, "height": h, "rasters": rasters}


