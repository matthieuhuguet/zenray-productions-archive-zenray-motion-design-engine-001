import numpy as np

U32 = np.uint32


def _v(x):
    return np.asarray(x, dtype=float)


def _ss(e0, e1, x):
    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)
EPS = 0.000731


def _pcg2d(x, y):
    m, a, s16 = U32(1664525), U32(1013904223), U32(16)
    x = x * m + a
    y = y * m + a
    x = x + y * m
    y = y + x * m
    x = x ^ (x >> s16)
    y = y ^ (y >> s16)
    x = x + y * m
    y = y + x * m
    x = x ^ (x >> s16)
    y = y ^ (y >> s16)
    return x, y


def _hash2(cx, cy, seed):
    s = int(max(float(seed), 0.0)) & 0xFFFFFFFF
    ox, oy = U32((s * 747796405) & 0xFFFFFFFF), U32((s * 2891336453) & 0xFFFFFFFF)
    x = (np.asarray(cx).astype(np.int64) + 32768).astype(U32) + ox
    y = (np.asarray(cy).astype(np.int64) + 32768).astype(U32) + oy
    hx, hy = _pcg2d(x, y)
    return (hx >> U32(8)).astype(float) / 16777216.0, (hy >> U32(8)).astype(float) / 16777216.0


def _vnoise(px, py, seed):
    ix, iy = np.floor(px), np.floor(py)
    fx, fy = px - ix, py - iy
    wx = fx * fx * fx * (fx * (fx * 6.0 - 15.0) + 10.0)
    wy = fy * fy * fy * (fy * (fy * 6.0 - 15.0) + 10.0)
    a = _hash2(ix, iy, seed)[0]
    b = _hash2(ix + 1, iy, seed)[0]
    c = _hash2(ix, iy + 1, seed)[0]
    d = _hash2(ix + 1, iy + 1, seed)[0]
    top = a + (b - a) * wx
    bot = c + (d - c) * wx
    return top + (bot - top) * wy


def _axis(u, v, angle):
    a = np.radians(angle)
    dx, dy = np.cos(a), np.sin(a)
    return 0.5 + ((u - 0.5) * dx + (v - 0.5) * dy) / (abs(dx) + abs(dy))


def render(params, u, v):
    q = params
    a = np.radians(q['angle'])
    dx, dy = np.cos(a), np.sin(a)
    px = u * q['aspect']
    along = px * dx + v * dy
    across = -px * dy + v * dx
    n = _vnoise(along * q['scale'][0] + EPS, across * q['scale'][1] + EPS, q['seed'])
    t = np.clip(_axis(u, v, q['angle'] + 90.0), 0.0, 1.0)[..., None]
    col = (_v(q['c_dark']) + (_v(q['c_light']) - _v(q['c_dark'])) * t) * (1.0 + q['streak'] * (2.0 * n - 1.0))[..., None]
    s = (1.0 - _ss(q['strip'][1] * 0.6, q['strip'][1], np.abs(_axis(u, v, q['angle']) - q['strip'][0])))[..., None]
    col = col + (_v(q['strip_color']) - col) * s
    return np.clip(col, 0.0, 1.0) * 255.0
