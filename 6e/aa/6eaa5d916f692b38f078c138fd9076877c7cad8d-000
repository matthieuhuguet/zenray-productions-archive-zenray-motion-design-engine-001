// 23 October 2026: renders the lettering of the PlayStation opening (traced letters of STUDIOS + procedural capitals) so that it can be compared with the reference word.
// Usage: node Scripts/FontSheet.mjs <out.png> [TEXT ...]   FR : planche de la police (lettres decalquees et capitales procedurales).
import { spawnSync } from "node:child_process";
import { readFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { createRequire } from "node:module";
const ROOT = dirname(dirname(fileURLToPath(import.meta.url))), TOOLING = join(ROOT, "tooling");
const require = createRequire(join(TOOLING, "package.json"));
const puppeteer = require("puppeteer-core");
const [out, ...texts] = process.argv.slice(2);
const lines = texts.length ? texts : ["STUDIOS", "ZENRAY", "ABCDEFGHIJKLM", "NOPQRSTUVWXYZ"];
const font1 = readFileSync(join(ROOT, "motion/runtime/zs-templates-playstation-font-1.js"), "utf8"), font2 = readFileSync(join(ROOT, "motion/runtime/zs-templates-playstation-font-2.js"), "utf8");
const env = { ...process.env, HYPERFRAMES_NO_TELEMETRY: "1", DO_NOT_TRACK: "1", HYPERFRAMES_NO_UPDATE_CHECK: "1" };
const browserPath = spawnSync(join(TOOLING, "node_modules", ".bin", "hyperframes"), ["browser", "path"], { env, encoding: "utf8" }).stdout.trim();
const browser = await puppeteer.launch({ executablePath: browserPath, headless: true, args: ["--no-first-run"] });
try {
  const page = await browser.newPage(); await page.setViewport({ width: 1500, height: 130 * lines.length + 20 });
  await page.setContent(`<body style="margin:0;background:#000"><div id=r></div><script>${font1}</script><script>${font2}</script></body>`);
  await page.evaluate((lines) => {
    const NS = "http://www.w3.org/2000/svg", F = window.ZSPSFont, root = document.getElementById("r");
    lines.forEach((text) => {
      const svg = document.createElementNS(NS, "svg"); svg.setAttribute("width", 1480); svg.setAttribute("height", 130); svg.setAttribute("viewBox", "0 0 740 65"); root.appendChild(svg);
      let x = 6; const gap = 18;
      [...text].forEach((ch) => { const g = F.glyph(ch); const grp = document.createElementNS(NS, "g"); grp.setAttribute("transform", `translate(${x},${1 + (g.top || 0)})`); grp.setAttribute("fill", "#ececec"); svg.appendChild(grp);
        if (g.traced) { const p = document.createElementNS(NS, "path"); p.setAttribute("d", g.traced.d); p.setAttribute("transform", g.traced.tf); grp.appendChild(p); }
        else g.parts.forEach((pt) => { const p = document.createElementNS(NS, "path"); p.setAttribute("d", pt.d); if (pt.evenodd) p.setAttribute("fill-rule", "evenodd"); grp.appendChild(p); });
        x += g.w + gap; });
    });
  }, lines);
  await page.screenshot({ path: out });
  console.log(out);
} finally { await browser.close(); }
