def mask(img: np.ndarray, region, pred) -> np.ndarray:
    h, w = img.shape[:2]
    x0, y0, x1, y1 = (int(region[0] * w), int(region[1] * h), int(region[2] * w), int(region[3] * h))
    m = np.zeros((h, w), bool)
    r = img[y0:y1, x0:x1].astype(int)
    if pred[0] == "rgb":
        m[y0:y1, x0:x1] = np.abs(r - np.array(pred[1])).sum(2) < pred[2]
    elif pred[0] == "notrgb":
        m[y0:y1, x0:x1] = np.abs(r - np.array(pred[1])).sum(2) > pred[2]
    elif pred[0] == "dark":
        m[y0:y1, x0:x1] = r.max(2) < pred[1]
    elif pred[0] == "light":
        m[y0:y1, x0:x1] = r.min(2) > pred[1]
    elif pred[0] == "red":  # ("red", min redness r - max(g, b), min r)
        m[y0:y1, x0:x1] = ((r[:, :, 0] - np.maximum(r[:, :, 1], r[:, :, 2])) > pred[1]) & (r[:, :, 0] > pred[2])
    elif pred[0] == "grey":  # ("grey", min luminance, max luminance): neutral grey ink, not red
        lum = r.mean(2); m[y0:y1, x0:x1] = (r.max(2) - r.min(2) < 24) & (lum > pred[1]) & (lum < pred[2])
    elif pred[0] == "greenblack":  # dark with green >= red: the ink smear of the last banner (the cave rock is brown)
        m[y0:y1, x0:x1] = (r.max(2) < pred[1]) & (r[:, :, 1] >= r[:, :, 0])
    elif pred[0] == "chan":  # ("chan", [rmin, rmax, gmin, gmax, bmin, bmax]): a box in RGB
        lo = np.array(pred[1][0::2]); hi = np.array(pred[1][1::2]); m[y0:y1, x0:x1] = ((r >= lo) & (r <= hi)).all(2)
    elif pred[0] == "cyan":
        m[y0:y1, x0:x1] = (r[:, :, 0] < 150) & (r[:, :, 1] > 170) & (r[:, :, 2] > 225)
    return m


def dil(m: np.ndarray, px: int = 3) -> np.ndarray:
    im = Image.fromarray((m * 255).astype(np.uint8)).filter(ImageFilter.MaxFilter(2 * px + 1))
    return np.asarray(im) > 0


def bands(m: np.ndarray, gap: int = 6, min_rows: int = 6) -> list:
    """Row bands of ink [y0, y1, x0, x1], to compare line by line (a gap of at least `gap` empty rows separates two bands)."""
    rows = np.where(m.sum(1) > 2)[0]
    out, start, prev = [], None, None
    for y in rows:
        if start is None:
            start = prev = y
        elif y - prev > gap:
            out.append((start, prev)); start = y
        prev = y
    if start is not None:
        out.append((start, prev))
    res = []
    for y0, y1 in out:
        if y1 - y0 < min_rows:
            continue
        xs = np.where(m[y0:y1 + 1].sum(0) > 0)[0]
        res.append([int(y0), int(y1), int(xs.min()), int(xs.max())])
    return res


def score(ref: np.ndarray, mine: np.ndarray, cfg) -> list:
    out = []
    for name, region, pred in cfg:
        a, b = mask(ref, region, pred), mask(mine, region, pred)
        iou = (a & b).sum() / max(1, (a | b).sum())
        ad, bd = dil(a), dil(b)
        rec = (a & bd).sum() / max(1, a.sum()); prec = (b & ad).sum() / max(1, b.sum())
        diou = 2 * rec * prec / max(1e-9, rec + prec)
        out.append({"mask": name, "iou": round(float(iou), 3), "diou": round(float(diou), 3), "ref_px": int(a.sum()), "motion_px": int(b.sum()), "recall": round(float(rec), 3), "precision": round(float(prec), 3), "ref_bands": bands(a), "motion_bands": bands(b)})
    return out


def overlay(ref: np.ndarray, mine: np.ndarray, cfg) -> Image.Image:
    h, w = ref.shape[:2]
    A, B = np.zeros((h, w), bool), np.zeros((h, w), bool)
    for _, region, pred in cfg:
        A |= mask(ref, region, pred); B |= mask(mine, region, pred)
    o = np.zeros((h, w, 3), np.uint8) + 18
    o[A & ~B] = (255, 70, 70); o[B & ~A] = (60, 220, 255); o[A & B] = (255, 255, 255)
    return Image.fromarray(o)


def evaluate(project: str, at: float = 4.0, out: "Path | None" = None) -> dict:
    """Render the motion at `at`, compare its ink with the reference still, return the same dict main() prints. FR : un calcul d'alignement, appelable par l'optimiseur."""
    cfg = CFG[project]
    still = Path("~/.claude/tmp/tmp-zenray-motion-design-refcache/_stills").expanduser() / f"{REF_STILL[project]}.png"
    ref = Image.open(still).convert("RGB")
    p = server.read_project(project)
    W, H = server.FORMATS[p["format"]]
    work = Path(tempfile.mkdtemp(prefix="zrmd-iou-"))
    try:
        page = server.cook(project, work / "page")
        server.hyperframes(page, "snapshot", "--at", f"{at:.3f}", "--no-end", "-o", str(work / "snaps"), timeout=300)
        mine = Image.open(sorted((work / "snaps").glob("frame-*.png"))[0]).convert("RGB").resize((W, H))
        k = min(W / ref.width, H / ref.height)
        ref_fit = Image.new("RGB", (W, H), (0, 0, 0))
        r2 = ref.resize((round(ref.width * k), round(ref.height * k)), Image.LANCZOS)
        ref_fit.paste(r2, ((W - r2.width) // 2, (H - r2.height) // 2))
        ra, ma = np.asarray(ref_fit), np.asarray(mine)
        res = score(ra, ma, cfg)
        o = out or server.project_dir(project) / "compare"
        o.mkdir(parents=True, exist_ok=True)
        overlay(ra, ma, cfg).save(o / "ink-overlay.png"); mine.save(o / "ink-motion-frame.png")
        return {"project": project, "at": at, "size": [W, H], "masks": res, "overlay": str(o / "ink-overlay.png"), "score": round(float(np.mean([m["diou"] for m in res])), 3)}
    finally:
        shutil.rmtree(work, ignore_errors=True)


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("project")
    ap.add_argument("--at", type=float, default=4.0)
    ap.add_argument("--out", default="")
    ap.add_argument("--cfg", default="", help="mask configuration key (default: the project id), for a project that follows several reference stills")
    ap.add_argument("--still", default="", help="reference still slug (default: the one of the project)")
    a = ap.parse_args()
    cfg = CFG.get(a.cfg or a.project)
    if not cfg:
        raise SystemExit(f"no mask configuration for {a.cfg or a.project}")
    slug = a.still or REF_STILL[a.project]
    still = Path("~/.claude/tmp/tmp-zenray-motion-design-refcache/_stills").expanduser() / f"{slug}.png"
    ref = Image.open(still).convert("RGB")
    p = server.read_project(a.project)
    W, H = server.FORMATS[p["format"]]
    work = Path(tempfile.mkdtemp(prefix="zrmd-iou-"))
    try:
        page = server.cook(a.project, work / "page")
        snaps = work / "snaps"
        server.hyperframes(page, "snapshot", "--at", f"{a.at:.3f}", "--no-end", "-o", str(snaps), timeout=300)
        f = sorted(snaps.glob("frame-*.png"))[0]
        mine = Image.open(f).convert("RGB")
        # the motion frame is the plane of the format; the reference is fitted to it the way the template does (contain)
        k = min(W / ref.width, H / ref.height)
        ref_fit = Image.new("RGB", (W, H), (0, 0, 0))
        r2 = ref.resize((round(ref.width * k), round(ref.height * k)), Image.LANCZOS)
        ref_fit.paste(r2, ((W - r2.width) // 2, (H - r2.height) // 2))
        mine = mine.resize((W, H))
        ra, ma = np.asarray(ref_fit), np.asarray(mine)
        res = score(ra, ma, cfg)
        out = Path(a.out) if a.out else server.project_dir(a.project) / "compare"
        out.mkdir(parents=True, exist_ok=True)
        ov = overlay(ra, ma, cfg); ov.save(out / "ink-overlay.png"); mine.save(out / "ink-motion-frame.png")
        print(json.dumps({"project": a.project, "at": a.at, "size": [W, H], "masks": res, "overlay": str(out / "ink-overlay.png"), "score": round(float(np.mean([m["diou"] for m in res])), 3)}))
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    main()
