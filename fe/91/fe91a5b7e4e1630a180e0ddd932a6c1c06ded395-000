#!/usr/bin/env python3
# 15 October 2026: the MULTI-LAYER vector fit of a reference scene (zrmd/vector/layerfit.py). Takes the saved frame and crop of the scene of
# a reference (never re-picks the scene), paints the crop as a stack of editable layers, measures the composite in CIEDE2000 against the crop
# AND against the codec floor of the same crop, and writes a NEW version of the scene asset next to the old ones (never an overwrite).
#   VectorLayers.py --slug S [--max-layers N] [--max-seconds N] [--no-write]
# One JSON object on stdout. FR : trace multi-calques d'une scene, mesure composite contre le plancher du codec, nouvelle version.
from __future__ import annotations

import argparse
import json
import sys
import tempfile
import time
from pathlib import Path

ENGINE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ENGINE))
import numpy as np  # noqa: E402
from PIL import Image  # noqa: E402
from skimage.color import deltaE_ciede2000, rgb2lab  # noqa: E402

from zrmd import settings  # noqa: E402
from zrmd.vector import asset as A  # noqa: E402
from zrmd.vector import layerfit as LF  # noqa: E402
from zrmd.vector import render as R  # noqa: E402
from zrmd.vector import scene as S  # noqa: E402


def fidelity(a: np.ndarray, b: np.ndarray) -> dict:
    """1 - 0.01 x mean(dE00^2) (the image module's definition), mean dE00 and the share of pixels within 1 JND."""
    de = deltaE_ciede2000(rgb2lab(np.asarray(a, np.float64) / 255.0), rgb2lab(np.asarray(b, np.float64) / 255.0))
    return {"fidelity": round(1 - 0.01 * float((de ** 2).mean()), 5), "meanDE": round(float(de.mean()), 4), "within1Jnd": round(float((de <= 1).mean()), 4)}


def codec_floor(slug: str, d: dict, composite: np.ndarray, frame: np.ndarray) -> dict:
    """What a PERFECT vector render scores against this crop: the render itself, put back into the frame, encoded like the reference and
    decoded, against the render (the codec noise of the reference, measured on this content)."""
    sys.path.insert(0, str(ENGINE / "Scripts"))
    import importlib.util
    spec = importlib.util.spec_from_file_location("vector_ceiling", ENGINE / "Scripts" / "VectorCeiling.py")
    vc = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(vc)
    meta = json.loads((settings.path("workshop") / "references" / slug / "reference.json").read_text(encoding="utf-8"))
    info = vc.probe(settings.path("refcache") / slug / meta["file_name"])
    cr = d["crop"]
    h, w = composite.shape[:2]
    m = 32
    x0, y0 = max(0, (cr["x"] - m) // 16 * 16), max(0, (cr["y"] - m) // 16 * 16)
    x1, y1 = min(frame.shape[1], -(-(cr["x"] + w + m) // 16) * 16), min(frame.shape[0], -(-(cr["y"] + h + m) // 16) * 16)
    region = frame.copy()
    region[cr["y"]:cr["y"] + h, cr["x"]:cr["x"] + w] = composite
    region = np.ascontiguousarray(region[y0:y1, x0:x1])
    rate = max(100_000, int(info["bit_rate"] * region.shape[0] * region.shape[1] / float(info["width"] * info["height"])))
    with tempfile.TemporaryDirectory() as t:
        dec = vc.encode_decode(region, info, rate, Path(t))
    return fidelity(composite, dec[cr["y"] - y0:cr["y"] - y0 + h, cr["x"] - x0:cr["x"] - x0 + w])


def composite_of(layers, w, h):
    return R.render_svg(A.cook_svg({"canvas": {"width": w, "height": h}, "palette": {}, "layers": layers, "view": {}}), w, h, engine="skia", ss=1)[..., :3]


def run(slug: str, max_layers: int | None = None, max_seconds: float | None = None, write: bool = True, log=None, stop_de: float = 0.4, profile: str = "auto", resume: bool = False,
        checkpoint_s: float = 3600.0) -> dict:
    c = S.cfg()
    ws = settings.path("workshop")
    d = json.loads((S._path(c["paths"]["out"], slug) / "scene.json").read_text(encoding="utf-8"))
    if "classes" not in d:
        return {"slug": slug, "applicable": False, "skipped": d.get("skipped")}
    P0 = json.loads((Path(d["dir"]) / "params.json").read_text(encoding="utf-8"))
    frame = np.asarray(Image.open(S._path(c["paths"]["frames"], slug) / f"frame-{d['shot']}.png").convert("RGB"))
    cr = d["crop"]
    w, h = P0["canvas"]["width"], P0["canvas"]["height"]
    piece = frame[cr["y"]:cr["y"] + h, cr["x"]:cr["x"] + w]
    base_cfg = {"maxSeconds": float(max_seconds)} if max_seconds else {}
    full_levels = [dict(l) for l in LF.DEFAULTS["levels"]]
    direct = [{"scale": 1, "maxLayers": LF.DEFAULTS["maxLayers"], "stopDE": stop_de, "minDE": stop_de, "window": 60}]
    for lv in (direct, full_levels):
        lv[-1].update(stopDE=stop_de, minDE=stop_de, **({"maxLayers": int(max_layers)} if max_layers else {}))
    # Three moves, in this order (all measured on the interface scene): (1) a PROBE of both profiles at the same small budget, the better wins
    # (DIRECT: crisp UI and text, where a coarse wash only leaves traces to repair; PYRAMID: soft backdrops, glows, textures, far cheaper there:
    # fin-4 0.9987 direct against 0.9937 pyramid); (2) vertex polish and refine (a contour is placed to a tenth of a pixel, an edge of contrast 50
    # makes that a dE of 4: 400 layers 0.9948 -> 0.9958 in 20 s); (3) rounds of extend + polish until the budget or the gain runs out (3500 layers
    # polished 0.9978 against 6000 unpolished 0.9970). FR : sonde des deux profils, polissage des sommets, rondes prolonge + polis.
    probe_n = min(int(max_layers or 6000), 1500)
    profiles = {"direct": [{"scale": 1, "maxLayers": probe_n, "stopDE": stop_de, "minDE": stop_de, "window": 60}],
                "pyramid": [dict(l) for l in LF.DEFAULTS["levels"]]}
    profiles["pyramid"][-1].update(maxLayers=probe_n, stopDE=stop_de, minDE=stop_de)
    chosen = [profile] if profile in profiles else ["direct", "pyramid"]
    t0 = time.time()
    deadline = t0 + (float(max_seconds) if max_seconds else 7200.0)
    best, tried = None, {}
    if resume:                                     # continue the best existing multi-layer version instead of starting again
        prev = json.loads((S._path(c["paths"]["out"], slug) / "layered.json").read_text(encoding="utf-8"))
        prior = json.loads((Path(prev["dir"]) / "params.json").read_text(encoding="utf-8"))["layers"]
        best = (fidelity(composite_of(prior, w, h), piece), {"layers": prior, "report": {"seconds": 0.0, "resumedFrom": prev["dir"]}}, "resume")
        chosen = []

    def composite(layers):
        return composite_of(layers, w, h)
    for name in chosen:
        cfg = {"maxSeconds": max(60.0, (deadline - time.time()) / 3), "levels": profiles[name], "maxLayers": probe_n, "stopDE": stop_de, "minDE": stop_de}
        res_i = LF.fit(piece, cfg, log=log)
        f_i = fidelity(composite(res_i["layers"]), piece)
        tried[name] = {"fidelity": f_i["fidelity"], "layers": len(res_i["layers"]), "seconds": res_i["report"]["seconds"]}
        if best is None or f_i["fidelity"] > best[0]["fidelity"]:
            best = (f_i, res_i, name)
    res = best[1]
    layers = res["layers"]
    stages = []

    def polish():
        LF.refine(layers, piece, sweeps=1)
        v = LF.refine_vertices(layers, piece, deltas=(0.2, 0.1, 0.05), max_seconds=min(1500.0, max(30.0, deadline - time.time())))
        LF.refine(layers, piece, sweeps=1)
        return v
    polish()
    cur = fidelity(composite(layers), piece)["fidelity"]
    stages.append({"layers": len(layers), "fidelity": cur})
    def emit() -> dict:
        """Write the stack as it is now as a NEW version (every one is kept) and let the module read it when it is the best. Called at checkpoints of a
        long run and at its end: an interrupted six hour run no longer loses everything (15 October 2026). FR : une version par point de reprise."""
        res["report"]["layers"] = len(layers)
        res["report"]["groups"] = LF.assign_groups_and_roles(layers)
        res["report"]["profile"] = best[2]
        res["report"]["profilesTried"] = tried
        res["report"]["stages"] = stages
        params = {**{k: v for k, v in P0.items() if k not in ("layers", "texts", "palette")}, "layers": res["layers"], "palette": {}}
        params["trace"] = {**(P0.get("trace") or {}), "method": "multi-layer residual pursuit", "layers": len(res["layers"]), "raster_ss": 1}
        comp = R.render_svg(A.cook_svg({**params, "view": {}}), w, h, engine="skia", ss=1)[..., :3]
        got = fidelity(comp, piece)
        floor = codec_floor(slug, d, comp, frame)
        out = {"slug": slug, "shot": d["shot"], "applicable": True, "layers": len(res["layers"]), "fidelity": got, "codecFloor": floor,
               "normalised": round(got["fidelity"] / floor["fidelity"], 5) if floor["fidelity"] > 0 else None,
               "before": (d.get("layered") or {}).get("fidelity"), "seconds": round(time.time() - t0, 1), "report": res["report"], "date": "15 October 2026"}
        if write:
            folder = A.write_version(Path(d["dir"]).parent, params, piece, None, parent=Path(d["dir"]).name, note="multi-layer residual pursuit (zrmd/vector/layerfit.py)")
            (folder / "component.html").write_text(S.export_html(json.loads((folder / "params.json").read_text(encoding="utf-8")), f"{slug}-layers"), encoding="utf-8")
            (folder / "layered.json").write_text(json.dumps(out, indent=1, default=float), encoding="utf-8")
            out["dir"] = str(folder)
            sc = S._path(c["paths"]["out"], slug) / "layered.json"
            cur = json.loads(sc.read_text(encoding="utf-8")) if sc.is_file() else None
            if not cur or cur.get("shot") != d["shot"] or cur["fidelity"]["fidelity"] <= got["fidelity"]:     # the module keeps reading the best version
                sc.write_text(json.dumps(out, indent=1, default=float), encoding="utf-8")
        return out

    last_write = time.time()
    cap = int(max_layers or 6000)
    while len(layers) < cap and time.time() < deadline:
        add = min(cap - len(layers), max(500, len(layers) // 2))
        got = LF.extend(layers, piece, add, stop_de=stop_de)
        if got == 0:
            break
        polish()
        nxt = fidelity(composite(layers), piece)["fidelity"]
        stages.append({"layers": len(layers), "fidelity": nxt})
        if log:
            log(f"[stage] {stages[-1]}")
        gain, cur = nxt - cur, nxt
        if write and checkpoint_s and time.time() - last_write >= checkpoint_s and gain >= 5e-5:
            emit()
            last_write = time.time()
        if gain < 5e-5:
            break
    return emit()


def adopt(slug: str) -> dict:
    """Make the BEST version of a scene's multi-layer fits the one the module reads: the highest composite fidelity among the versions that carry a
    layered.json (runs differ by profile and budget; every one is kept, none is overwritten). FR : adopte la meilleure version multi-calques."""
    c = S.cfg()
    d = json.loads((S._path(c["paths"]["out"], slug) / "scene.json").read_text(encoding="utf-8"))
    best = None
    for f in sorted((Path(d["dir"]).parent).glob("V_*/layered.json")):
        j = json.loads(f.read_text(encoding="utf-8"))
        if j.get("shot") == d["shot"] and (best is None or j["fidelity"]["fidelity"] > best["fidelity"]["fidelity"]):
            best = {**j, "dir": str(f.parent)}
    if best:
        (S._path(c["paths"]["out"], slug) / "layered.json").write_text(json.dumps(best, indent=1, default=float), encoding="utf-8")
    return {"slug": slug, "adopted": best and {"version": Path(best["dir"]).name, "layers": best["layers"], "fidelity": best["fidelity"]["fidelity"]}}


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--slug", required=True)
    ap.add_argument("--adopt", action="store_true", help="only make the best existing multi-layer version the one the module reads")
    ap.add_argument("--max-layers", type=int, default=None)
    ap.add_argument("--max-seconds", type=float, default=None)
    ap.add_argument("--stop-de", type=float, default=0.4, help="stop when the smoothed CIEDE2000 error peak falls under this (also the smallest region repaired)")
    ap.add_argument("--profile", choices=["auto", "direct", "pyramid"], default="auto")
    ap.add_argument("--resume", action="store_true", help="continue the best existing multi-layer version (rounds of extend and polish) instead of starting again")
    ap.add_argument("--checkpoint-seconds", type=float, default=3600.0, help="write an interim version at most this often during a long run (0 = only at the end)")
    ap.add_argument("--no-write", action="store_true")
    a = ap.parse_args()
    if a.adopt:
        print(json.dumps(adopt(a.slug), default=float))
        return 0
    out = run(a.slug, a.max_layers, a.max_seconds, write=not a.no_write, log=lambda m: print(m, file=sys.stderr, flush=True), stop_de=a.stop_de, profile=a.profile, resume=a.resume, checkpoint_s=a.checkpoint_seconds)
    print(json.dumps(out, default=float))
    return 0


if __name__ == "__main__":
    sys.exit(main())
