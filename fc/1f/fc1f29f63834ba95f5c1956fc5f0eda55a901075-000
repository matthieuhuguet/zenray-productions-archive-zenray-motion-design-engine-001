#!/usr/bin/env python3
# 14 October 2026: the CODEC CEILING of the vector module on a traced scene. How high can the per-layer IoU go against a video frame
# when the shapes are EXACTLY right? The traced component of a scene (params.json of its version) is rendered, placed back into the
# real frame where it was cut, encoded with the reference's codec settings (stream codec, pixel format, bit rate scaled by the pixel
# count of the region), decoded, cropped, and run through the SAME pipeline as the reference crop: analyse, vectorise under the same
# budget, evaluate, classify. The numbers are the ones the pipeline reaches on a scene whose true geometry is known to be vector, so
# the gap between the reference's own numbers and these is the part a better trace could still win, and the part the codec has taken
# for good. Same method as Scripts/F3CodecCeiling.py (static image, reference bit rate). One JSON object on stdout.
#   VectorCeiling.py --slug interface [--bitrate 20000000] [--out DIR]
# FR : plafond du codec pour le vecteur : la scene tracee, rendue, recodee comme la reference, retracee par le meme pipeline.
from __future__ import annotations

import argparse
import json
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ENGINE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ENGINE))
import numpy as np  # noqa: E402
from PIL import Image  # noqa: E402

from zrmd import settings  # noqa: E402
from zrmd.vector import asset as A  # noqa: E402
from zrmd.vector import render as R  # noqa: E402
from zrmd.vector import scene as S  # noqa: E402

CODEC = {"h264": "libx264", "hevc": "libx265", "vp9": "libvpx-vp9", "av1": "libaom-av1"}


def probe(video: Path) -> dict:
    out = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=codec_name,profile,bit_rate,pix_fmt,r_frame_rate,width,height",
                          "-show_entries", "format=bit_rate", "-of", "json", str(video)], capture_output=True, text=True, check=True).stdout
    d = json.loads(out)
    st = d["streams"][0]
    num, den = (int(v) for v in st["r_frame_rate"].split("/"))
    bit = int(st.get("bit_rate") or d["format"].get("bit_rate") or 0)
    return {"codec": st["codec_name"], "profile": st.get("profile"), "pix_fmt": st.get("pix_fmt", "yuv420p"), "fps": num / den, "bit_rate": bit,
            "width": int(st["width"]), "height": int(st["height"])}


def encode_decode(region: np.ndarray, info: dict, bit_rate: int, tmp: Path) -> np.ndarray:
    h, w = region.shape[:2]
    Image.fromarray(region).save(tmp / "f.png")
    enc = CODEC.get(info["codec"], "libx264")
    cmd = ["ffmpeg", "-loglevel", "error", "-y", "-loop", "1", "-i", str(tmp / "f.png"), "-t", "2", "-r", f"{info['fps']:g}", "-c:v", enc, "-pix_fmt", info["pix_fmt"],
           "-b:v", str(bit_rate)]
    if enc == "libx264" and info.get("profile") and info["profile"].lower() in ("high", "main", "baseline"):
        cmd += ["-profile:v", info["profile"].lower()]
    subprocess.run(cmd + [str(tmp / "c.mp4")], check=True, timeout=600)
    subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-ss", "1.0", "-i", str(tmp / "c.mp4"), "-frames:v", "1", str(tmp / "d.png")], check=True, timeout=120)
    return np.asarray(Image.open(tmp / "d.png").convert("RGB"))


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--slug", required=True)
    ap.add_argument("--bitrate", type=int, default=None, help="default: the reference stream bit rate scaled to the pixel count of the region")
    ap.add_argument("--margin", type=int, default=32, help="pixels of the real frame kept around the crop (macroblock aligned)")
    ap.add_argument("--out", default=None)
    a = ap.parse_args()
    c = S.cfg()
    d = json.loads((S._path(c["paths"]["out"], a.slug) / "scene.json").read_text(encoding="utf-8"))
    if "classes" not in d:
        print(json.dumps({"slug": a.slug, "applicable": False, "skipped": d.get("skipped")}))
        return 1
    P = json.loads((Path(d["dir"]) / "params.json").read_text(encoding="utf-8"))
    P.pop("texts", None)             # the exact trace only: text layers of a variant are the same ink as the glyph layers it hides
    P["layers"] = [l for l in P["layers"] if l.get("visible", True) is not False]
    meta = json.loads((settings.path("workshop") / "references" / a.slug / "reference.json").read_text(encoding="utf-8"))
    video = settings.path("refcache") / a.slug / meta["file_name"]
    info = probe(video)
    cr = d["crop"]
    frame = np.asarray(Image.open(S._path(c["paths"]["frames"], a.slug) / f"frame-{d['shot']}.png").convert("RGB")).copy()
    H, W = frame.shape[:2]
    w, h = P["canvas"]["width"], P["canvas"]["height"]
    truth = R.render_svg(A.cook_svg({**P, "view": {}}), w, h, engine="skia", ss=4)[..., :3]
    frame[cr["y"]:cr["y"] + h, cr["x"]:cr["x"] + w] = truth
    m = max(0, int(a.margin))
    x0, y0 = max(0, (cr["x"] - m) // 16 * 16), max(0, (cr["y"] - m) // 16 * 16)
    x1, y1 = min(W, -(-(cr["x"] + w + m) // 16) * 16), min(H, -(-(cr["y"] + h + m) // 16) * 16)
    region = np.ascontiguousarray(frame[y0:y1, x0:x1])
    ref_area = info["width"] * info["height"]
    bit_rate = a.bitrate or max(100_000, int(info["bit_rate"] * region.shape[0] * region.shape[1] / float(ref_area)))
    t0 = time.time()
    with tempfile.TemporaryDirectory() as tmp:
        dec = encode_decode(region, info, bit_rate, Path(tmp))
    piece = dec[cr["y"] - y0:cr["y"] - y0 + h, cr["x"] - x0:cr["x"] - x0 + w]
    mae = float(np.abs(piece.astype(np.float32) - truth.astype(np.float32)).mean())
    budget = c["budget"]
    vcfg = {**A._cfg(), "budget": budget}
    res = A.vectorise(piece, f"{a.slug}-ceiling", source={"kind": "codec-ceiling", "slug": a.slug}, cfg=vcfg)
    fid = A.evaluate(res["params"], piece, res["analysis"], cfg=vcfg)
    cls = S.classify(res["params"], res["analysis"], fid)
    before = d["classes"]
    out = {"date": "14 October 2026", "slug": a.slug, "shot": d["shot"], "region": [x0, y0, x1 - x0, y1 - y0], "codec": info["codec"], "profile": info.get("profile"),
           "pix_fmt": info["pix_fmt"], "fps": info["fps"], "referenceBitRate": info["bit_rate"], "regionBitRate": bit_rate, "codecMae": round(mae, 3),
           "scene": {"layers": before["counts"], "vectorLayerIouMean": before["vectorLayerIouMean"], "vectorLayerIouArea": before.get("vectorLayerIouArea"),
                     "vectorLayersOk": before["vectorLayersOk"], "share": before["share"]},
           "ceiling": {"layers": cls["counts"], "vectorLayerIouMean": cls["vectorLayerIouMean"], "vectorLayerIouArea": cls.get("vectorLayerIouArea"),
                       "vectorLayerIouRefined": cls.get("vectorLayerIouRefined"), "vectorLayersOk": cls["vectorLayersOk"], "share": cls["share"],
                       "fragments": cls.get("fragments"), "unrefined": cls.get("unrefined"),
                       "layersAt0.99": sum(1 for r in cls["layers"] if r["class"] == "vector" and (r.get("iou") or 0) >= 0.99)},
           "seconds": round(time.time() - t0, 1), "note": "ceiling = the pipeline on the traced scene put through the reference codec (static image, reference bit rate scaled by pixels)"}
    (S._path(c["paths"]["out"], a.slug) / "ceiling.json").write_text(json.dumps(out, indent=1, default=float), encoding="utf-8")   # read by the module table
    if a.out:
        Path(a.out).mkdir(parents=True, exist_ok=True)
        Image.fromarray(piece).save(Path(a.out) / f"ceiling-{a.slug}-decoded.png")
        (Path(a.out) / f"ceiling-{a.slug}.json").write_text(json.dumps(out, indent=1, default=float), encoding="utf-8")
    print(json.dumps(out, default=float))
    return 0


if __name__ == "__main__":
    sys.exit(main())
