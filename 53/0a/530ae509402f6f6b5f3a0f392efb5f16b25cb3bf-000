"""Measure the camera of a shot by tracking the picture itself (15 October 2026).

Between consecutive frames, SIFT features are matched and a similarity (scale, translation, no rotation) is fitted with RANSAC;
the products give the camera of every frame relative to the first one: scale s and the position of the first frame's top-left
corner (x, y) in the current frame, in pixels of a 1920-wide frame. A pair that cannot be matched (cut, fade, flat frame) is
reported, never invented. FR : mesurer la camera d'un plan en suivant l'image elle-meme, image par image.
Usage: python3 Scripts/TrackCamera.py <video> --from 4.03 --to 21.03 [--fps 30] [--width 960] [--json out.json]
"""
import argparse
import json
import subprocess

import cv2
import numpy as np


def frames(video, t0, t1, fps, w):
    h = round(w * 9 / 16)
    raw = subprocess.run(["ffmpeg", "-v", "error", "-ss", f"{t0:.3f}", "-to", f"{t1:.3f}", "-i", video, "-vf", f"fps={fps},scale={w}:{h}",
                          "-f", "rawvideo", "-pix_fmt", "gray", "-"], capture_output=True, check=True).stdout
    return np.frombuffer(raw, np.uint8).reshape(-1, h, w)


def pair(a, b, det, bf):
    ka, da = det.detectAndCompute(a, None)
    kb, db = det.detectAndCompute(b, None)
    if da is None or db is None or len(ka) < 8 or len(kb) < 8:
        return None, 0
    m = bf.knnMatch(da, db, k=2)
    good = [x[0] for x in m if len(x) == 2 and x[0].distance < 0.8 * x[1].distance]
    if len(good) < 8:
        return None, len(good)
    pa = np.float32([ka[g.queryIdx].pt for g in good]); pb = np.float32([kb[g.trainIdx].pt for g in good])
    M, inl = cv2.estimateAffinePartial2D(pa, pb, method=cv2.RANSAC, ransacReprojThreshold=1.5)
    if M is None or inl is None or inl.sum() < 8:
        return None, int(0 if inl is None else inl.sum())
    return M, int(inl.sum())


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("video"); ap.add_argument("--from", dest="t0", type=float, required=True); ap.add_argument("--to", dest="t1", type=float, required=True)
    ap.add_argument("--fps", type=float, default=30); ap.add_argument("--width", type=int, default=960); ap.add_argument("--json", default="")
    a = ap.parse_args()
    F = frames(a.video, a.t0, a.t1, a.fps, a.width)
    det, bf = cv2.SIFT_create(nfeatures=1500, contrastThreshold=0.01), cv2.BFMatcher(cv2.NORM_L2)
    k = 1920 / a.width
    A = np.eye(3)                       # first frame -> current frame
    out = [{"t": round(a.t0, 3), "s": 1.0, "x": 0.0, "y": 0.0, "inliers": None}]
    for i in range(1, len(F)):
        M, n = pair(F[i - 1], F[i], det, bf)
        t = round(a.t0 + i / a.fps, 3)
        if M is None:
            out.append({"t": t, "lost": True, "inliers": n})
            continue
        A = np.vstack([M, [0, 0, 1]]) @ A
        s = float(np.hypot(A[0, 0], A[1, 0]))
        out.append({"t": t, "s": round(s, 4), "x": round(float(A[0, 2]) * k, 1), "y": round(float(A[1, 2]) * k, 1), "inliers": n})
    if a.json:
        json.dump(out, open(a.json, "w"), indent=0)
    for r in out:
        print(json.dumps(r))


if __name__ == "__main__":
    main()
