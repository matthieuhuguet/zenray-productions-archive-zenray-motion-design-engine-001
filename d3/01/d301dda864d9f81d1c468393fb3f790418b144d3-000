            o = np.zeros(T.m.shape + (3,), np.uint8); o[T.m & ~r] = (255, 80, 80); o[r & ~T.m] = (80, 160, 255); o[r & T.m] = (255, 255, 255); Image.fromarray(o).resize((o.shape[1] * 2, o.shape[0] * 2), Image.NEAREST).save("/tmp/fit_%s.png" % k)
        json.dump(out, open(a.score, "w")); print(out); return
    import copy
