def smooth(a, b, x):
    t = min(1, max(0, (x - a) / (b - a))); return t * t * (3 - 2 * t)

def norm(p):
    l = p[2] if len(p) > 2 else 1.0; return [p[0], p[1], l, p[3] if len(p) > 3 else l]

def sample(pts, steps):
    P = [norm(p) for p in pts]; n = len(P); out = []
    if n == 2:
        for i in range(steps * 2 + 1):
            t = i / (steps * 2); out.append([v + (P[1][j] - v) * t for j, v in enumerate(P[0])])
        return out
    at = lambda i: P[min(n - 1, max(0, i))]
    for i in range(n - 1):
        p0, p1, p2, p3 = at(i - 1), at(i), at(i + 1), at(i + 2)
        for s in range(steps):
            t = s / steps; t2 = t * t; t3 = t2 * t
            f = lambda a, b, c, d: 0.5 * ((2 * b) + (-a + c) * t + (2 * a - 5 * b + 4 * c - d) * t2 + (-a + 3 * b - 3 * c + d) * t3)
            out.append([f(p0[j], p1[j], p2[j], p3[j]) for j in range(4)])
    out.append(P[-1]); return out

def stroke_polygon(pts, o):
    line = sample(pts, o["steps"])
    closed = math.hypot(pts[0][0] - pts[-1][0], pts[0][1] - pts[-1][1]) < 8 and len(pts) > 4
    if closed:
        m = max(2, round(len(line) * 0.05)); line = line + [line[i] for i in range(1, m + 1)]
    n = len(line)
    dist = [0.0]
    for i in range(1, n): dist.append(dist[-1] + math.hypot(line[i][0] - line[i - 1][0], line[i][1] - line[i - 1][1]))
    total = dist[-1] or 1; L = []; R = []
    for i in range(n):
        t = dist[i] / total; a = line[max(0, i - 1)]; b = line[min(n - 1, i + 1)]
        dx, dy = b[0] - a[0], b[1] - a[1]; m = math.hypot(dx, dy) or 1; dx /= m; dy /= m
        f = (1 + o["flare"] * (1 - smooth(0, 0.14, t))) * (1 - o["taper"] * 0.65 * smooth(0.9 if closed else 0.72, 1, t))
        hl = max(0.6, o["width"] * f * line[i][2] / 2); hr = max(0.6, o["width"] * f * line[i][3] / 2)
        L.append([line[i][0] + dy * hl, line[i][1] - dx * hl]); R.append([line[i][0] - dy * hr, line[i][1] + dx * hr])
    def cap(i, kind, hw):
        a = line[max(0, i - 1)]; b = line[min(n - 1, i + 1)]; dx, dy = b[0] - a[0], b[1] - a[1]; m = math.hypot(dx, dy) or 1; dx /= m; dy /= m; pts_ = []
        for j in range(1, 6):
            ang = math.pi * j / 6; c = math.cos(ang); sn = math.sin(ang)
            pts_.append([line[i][0] + kind * (dy * c + dx * sn) * hw, line[i][1] + kind * (-dx * c + dy * sn) * hw])
        return pts_
    hw_at = lambda i: math.hypot(L[i][0] - R[i][0], L[i][1] - R[i][1]) / 2
    end_cap = [] if closed else cap(n - 1, 1, hw_at(n - 1)); start_cap = [] if closed else cap(0, -1, hw_at(0))
    return L + end_cap + R[::-1] + start_cap

def glyphs_from_js():
    js = "const f=require(%r);console.log(JSON.stringify(Object.assign({}, f.glyphs, Object.fromEntries(Object.entries(f.fine || {}).map(([k, v]) => ['s' + k, v])))))" % JS
    return json.loads(subprocess.check_output(["node", "-e", js]))

def raster(strokes, ox, oy, w, h, cap=None, sc=None):
    cap = CAP_PX if cap is None else cap; sc = S if sc is None else sc
    im = Image.new("L", (w * sc, h * sc), 0); d = ImageDraw.Draw(im); kk = cap / 100.0
    for st in strokes:
        poly = stroke_polygon(st, OPT); d.polygon([((p[0] * kk + ox) * sc, (p[1] * kk + oy) * sc) for p in poly], fill=255)
    return np.array(im) > 0

def disk(r):
    y, x = np.ogrid[-r:r + 1, -r:r + 1]; return (x * x + y * y) <= r * r

class Target:
    """One traced letter: its mask at S px per px, its dilated mask, and the glyph origin in the crop. Keys "sB", "sL"... are the letters of the small subtitle (fine style)."""
    def __init__(self, k, tol):
        if k.startswith("s") and len(k) == 2:
            self.cap, self.S, self.bear = 18.0, 8, BEAR; x0, y0 = SUB[k[1]] - 8, 341
            self.m = np.array(Image.open("%s/mask_sub_%s.png" % (TR, k[1]))) > 0
            self.w, self.h = self.m.shape[1] // self.S, self.m.shape[0] // self.S
            bx0 = json.load(open(TR + "/subtitle.json"))[k[1]]["x0"]; self.ox = bx0 - x0 - self.bear * self.cap / 100.0; self.oy = 349 - y0
        else:
            self.cap, self.S, self.bear = CAP_PX, S, BEAR; x0, y0 = ORIGIN[k]
            self.m = (np.array(Image.open("%s/mask_%s.png" % (TR, k))) > 0)[::2, ::2]
            self.w, self.h = self.m.shape[1] // self.S, self.m.shape[0] // self.S
            bx0 = json.load(open(TR + "/traced.json"))[k]["bbox"][0]; self.ox = bx0 - x0 - self.bear * self.cap / 100.0; self.oy = CAPTOP[k] - y0
        self.st = disk(int(round(tol * self.S))); self.md = ndi.binary_dilation(self.m, self.st); self.ma = self.m.sum()
    def measure(self, strokes):
        r = raster(strokes, self.ox, self.oy, self.w, self.h, self.cap, self.S)
        iou = (r & self.m).sum() / max(1, (r | self.m).sum())
        rd = ndi.binary_dilation(r, self.st); rec = (self.m & rd).sum() / max(1, self.ma); prec = (r & self.md).sum() / max(1, r.sum())
        f1 = 2 * rec * prec / max(1e-9, rec + prec); return f1, iou, r
    def obj(self, strokes):
        f1, iou, _ = self.measure(strokes); return 0.7 * f1 + 0.3 * iou

def subdivide(strokes):
    out = []
    for st in strokes:
        P = [norm(p) for p in st]; q = []
        for i, p in enumerate(P):
            q.append(p)
            if i < len(P) - 1: q.append([(p[j] + P[i + 1][j]) / 2 for j in range(4)])
        out.append(q)
    return out

def fmt_pt(p):
    p = norm(p); x, y, l, r = round(p[0], 1), round(p[1], 1), round(p[2], 2), round(p[3], 2)
    if abs(l - 1) < 0.02 and abs(r - 1) < 0.02: return "[%g, %g]" % (x, y)
    if abs(l - r) < 0.02: return "[%g, %g, %g]" % (x, y, l)
    return "[%g, %g, %g, %g]" % (x, y, l, r)

def fmt(strokes): return "[" + ", ".join("[" + ", ".join(fmt_pt(p) for p in st) + "]" for st in strokes) + "]"

def descend(T, strokes, passes, lock, k):
    best = T.obj(strokes)
    for step in [3.0, 1.5, 0.75, 0.4, 0.2][:passes + 1]:
        improved = True; rounds = 0
        while improved and rounds < 6:
            improved = False; rounds += 1
            for si, st in enumerate(strokes):
                if (k + ":" + str(si)) in lock: continue
                for pi in range(len(st)):
                    st[pi] = norm(st[pi])
                    for idx, amount in ((0, step), (1, step), (2, step * 0.06), (3, step * 0.06)):
                        for sgn in (-1, 1):
                            old = st[pi][idx]; nv = old + sgn * amount
                            if idx >= 2: nv = min(3.5, max(0.25, nv))
                            st[pi][idx] = nv; sc = T.obj(strokes)
                            if sc > best + 1e-5: best = sc; improved = True
                            else: st[pi][idx] = old
    return best

