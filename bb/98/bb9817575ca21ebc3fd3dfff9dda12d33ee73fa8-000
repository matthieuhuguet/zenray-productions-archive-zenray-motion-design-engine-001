"""Find the cuts of a video by measurement (16 October 2026), the first step of the Premier Plan Mesuré workflow.

Two signals at 20 images per second, on 96x54 grey images: the mean luminance (a run of near-black images is a fade through black: the scene begins when the run
ends) and the difference between two consecutive images (a spike is a hard cut). Both are checked against `ffmpeg -ss` frames, never against a sheet built with the
fps filter alone, whose labels can be off by up to half a second. A contact sheet (one image every --sheet-step seconds, labelled with its real time) is optional.
FR : coupes d'une video par la mesure : creux de luminance (fondu par le noir) et pics de difference (coupe seche), puis planche contact aux temps reels.

Usage: python3 Scripts/FindCuts.py <video> [--out cuts.json] [--sheet sheet.png --sheet-step 1.0] [--black 0.6] [--spike 2.2]
Prints JSON {duration, black: [{start, end}], hard: [t], scenes: [{start, end, in}]}.
"""
import argparse
import json
import subprocess
import sys
import tempfile
from pathlib import Path

import numpy as np
from PIL import Image, ImageDraw


def probe_duration(video: Path) -> float:
    out = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "default=nw=1:nk=1", str(video)], capture_output=True, text=True, check=True).stdout
    return float(out.strip())


def frames(video: Path, fps: int, w: int = 96, h: int = 54) -> np.ndarray:
    raw = subprocess.run(["ffmpeg", "-v", "error", "-i", str(video), "-vf", f"fps={fps},scale={w}:{h},format=gray", "-f", "rawvideo", "-"], capture_output=True, check=True).stdout
    return np.frombuffer(raw, np.uint8).reshape(-1, w * h).astype(float)


def find(video: Path, fps: int = 20, black: float = 0.6, spike: float = 2.2, min_black: float = 0.15) -> dict:
    d = frames(video, fps)
    mean = d.mean(1)
    diff = np.abs(np.diff(d, axis=0)).mean(1)
    runs, i = [], 0
    while i < len(mean):
        if mean[i] < black:
            j = i
            while j + 1 < len(mean) and mean[j + 1] < black:
                j += 1
            if (j - i + 1) / fps >= min_black:
                runs.append({"start": round(i / fps, 2), "end": round((j + 1) / fps, 2)})
            i = j + 1
        else:
            i += 1
    hard = [round((k + 1) / fps, 2) for k in range(len(diff)) if diff[k] > spike and not any(r["start"] - 0.1 <= (k + 1) / fps <= r["end"] + 0.1 for r in runs)]
    starts = sorted([(0.0, "start")] + [(r["end"], "black") for r in runs] + [(t, "hard") for t in hard])
    dur = probe_duration(video)
    scenes = [{"start": s, "end": round(starts[n + 1][0], 2) if n + 1 < len(starts) else round(dur, 2), "in": kind} for n, (s, kind) in enumerate(starts)]
    return {"duration": round(dur, 2), "fps": fps, "black": runs, "hard": hard, "scenes": scenes}


def sheet(video: Path, out: Path, step: float, cols: int = 4, width: int = 400) -> None:
    dur = probe_duration(video)
    times = [round(k * step, 2) for k in range(int(dur / step) + 1)]
    ims = []
    with tempfile.TemporaryDirectory() as td:
        for t in times:
            p = Path(td) / f"{t:.2f}.png"
            subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", f"{t:.3f}", "-i", str(video), "-frames:v", "1", "-vf", f"scale={width}:-1", str(p)], check=False)
            if p.is_file():
                ims.append((t, Image.open(p).convert("RGB")))
    if not ims:
        return
    w, h = ims[0][1].size
    rows = (len(ims) + cols - 1) // cols
    o = Image.new("RGB", (cols * (w + 2), rows * (h + 2)), "#666")
    d = ImageDraw.Draw(o)
    for k, (t, im) in enumerate(ims):
        x, y = (k % cols) * (w + 2), (k // cols) * (h + 2)
        o.paste(im, (x, y))
        d.rectangle((x, y, x + 44, y + 12), fill="black")
        d.text((x + 2, y), f"{t:.1f}", fill="yellow")
    o.save(out)


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("video")
    ap.add_argument("--out", default="")
    ap.add_argument("--sheet", default="")
    ap.add_argument("--sheet-step", type=float, default=1.0)
    ap.add_argument("--black", type=float, default=0.6)
    ap.add_argument("--spike", type=float, default=2.2)
    a = ap.parse_args()
    v = Path(a.video)
    if not v.is_file():
        print(json.dumps({"ok": False, "error": f"no video {v}"}))
        sys.exit(1)
    res = find(v, black=a.black, spike=a.spike)
    if a.sheet:
        sheet(v, Path(a.sheet), a.sheet_step)
        res["sheet"] = a.sheet
    if a.out:
        Path(a.out).write_text(json.dumps(res, indent=1), encoding="utf-8")
    print(json.dumps(res))


if __name__ == "__main__":
    main()
